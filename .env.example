# BotPlanet environment variables (EXAMPLE — no real values here).
# Real secrets live in Cloudflare Worker secrets / GitHub Actions secrets, NEVER in the repo.
# This file documents the *names* only.

# --- SEO intelligence (server-side jobs only) ---
# DataForSEO Basic Auth (login:password, base64) — set via `wrangler secret put`, never committed.
DATAFORSEO_BASIC_AUTH=

# --- Email (provisional: Resend) ---
RESEND_API_KEY=

# --- Cloudflare bindings are declared in wrangler config, not here ---
# D1, KV, R2, Queues, Analytics Engine bindings are added when the dedicated
# BotPlanet Cloudflare account + botplanet.io zone are confirmed.
