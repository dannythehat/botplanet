---
interface Props {
  title: string;
  section?: string;
}
const { title, section } = Astro.props;
const nav = [
  { href: "/admin", label: "Dashboard", key: "dash" },
  { href: "/admin/programmes", label: "Programmes", key: "prog" },
  { href: "/admin/offers", label: "Offers & /go", key: "offers" },
  { href: "/admin/reporting", label: "Reporting", key: "report" },
  { href: "/admin/evidence", label: "Evidence", key: "evidence" },
  { href: "/admin/media", label: "Media", key: "media" },
];
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · BotPlanet Admin</title>
    <style is:global>
      :root { --bg:#0a0a0c; --panel:#131317; --panel2:#1b1b20; --text:#f2f2f4; --muted:#8b8b95; --border:#26262c; --ok:#5ad19a; --warn:#f4c25a; --bad:#f28b82; --accent:#7aa2ff; }
      * { box-sizing:border-box; }
      body { margin:0; background:var(--bg); color:var(--text); font:14px/1.55 ui-sans-serif,-apple-system,"Segoe UI",Roboto,sans-serif; }
      a { color:var(--accent); text-decoration:none; }
      header { display:flex; align-items:center; gap:20px; padding:0 22px; height:56px; border-bottom:1px solid var(--border); background:#0d0d10; position:sticky; top:0; z-index:10; }
      header .brand { font-weight:700; display:flex; align-items:center; gap:9px; color:var(--text); }
      header nav { display:flex; gap:16px; }
      header nav a { color:var(--muted); font-weight:600; }
      header nav a.active, header nav a:hover { color:var(--text); }
      header .out { margin-left:auto; }
      main { padding:26px 22px 80px; max-width:1240px; margin:0 auto; }
      h1 { font-size:22px; margin:0 0 4px; letter-spacing:-0.02em; }
      h2 { font-size:15px; text-transform:uppercase; letter-spacing:0.05em; color:var(--muted); margin:30px 0 12px; }
      .sub { color:var(--muted); margin:0 0 18px; }
      .card { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:16px; }
      .grid { display:grid; gap:14px; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); }
      table { width:100%; border-collapse:collapse; }
      th,td { text-align:left; padding:9px 10px; border-bottom:1px solid var(--border); vertical-align:top; }
      th { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:0.04em; font-weight:600; }
      .tag { display:inline-block; font-size:11px; font-weight:700; padding:2px 8px; border-radius:999px; background:var(--panel2); border:1px solid var(--border); color:var(--muted); }
      .tag.ok { color:var(--ok); border-color:#264; } .tag.warn { color:var(--warn); border-color:#553; } .tag.bad { color:var(--bad); border-color:#633; }
      input,select,textarea { background:var(--panel2); color:var(--text); border:1px solid var(--border); border-radius:8px; padding:7px 9px; font-size:13px; font-family:inherit; }
      button { background:var(--text); color:#0a0a0c; border:none; border-radius:8px; padding:7px 12px; font-weight:700; font-size:13px; cursor:pointer; }
      button.ghost { background:transparent; color:var(--text); border:1px solid var(--border); }
      .muted { color:var(--muted); } .mono { font-family:ui-monospace,monospace; }
      form.inline { display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
      .banner { border:1px solid var(--border); background:var(--panel); border-radius:10px; padding:12px 14px; margin-bottom:14px; }
    </style>
  </head>
  <body>
    <header>
      <span class="brand"><img src="/favicon.svg" width="22" height="22" alt="" /> BotPlanet Admin</span>
      <nav>
        {nav.map((n) => <a href={n.href} class={section === n.key ? "active" : ""}>{n.label}</a>)}
      </nav>
      <form class="out" method="post" action="/api/admin/logout"><button class="ghost">Log out</button></form>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>
