---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import {
  buildMeta, isPreviewHost, schemaGraph, organizationSchema, websiteSchema, breadcrumbSchema, type Crumb,
} from "../lib/seo";

// Global design system. Order matters: tokens → element base → layout → components.
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/depth.css";
import "../styles/components.css";

interface Props {
  title: string;
  description?: string;
  /** Canonical path on production domain; defaults to current pathname. */
  path?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes (Product, Article, FAQPage, ItemList, Person…). */
  schema?: (Record<string, unknown> | null | undefined)[];
  /** Constrain main content width for long-form reading. */
  narrow?: boolean;
  /** Let a page own the full width (full-bleed bands) with no wrap/breadcrumbs. */
  bleed?: boolean;
}

const {
  title,
  // Neutral shell default: browsing-first, and never implies one questionnaire
  // covers the whole robotics market. Pages override with their own copy.
  description = "Browse, compare and choose real-world robots for the US — honest pricing, labelled evidence and clear limitations.",
  path,
  ogImage,
  ogType,
  noindex,
  breadcrumbs = [],
  schema = [],
  narrow = false,
  bleed = false,
} = Astro.props;

const host = Astro.request.headers.get("host");
const canonicalPath = path ?? Astro.url.pathname;
const meta = buildMeta({ title, description, path: canonicalPath, ogImage, ogType, noindex }, host);
const preview = isPreviewHost(host);

// Google Search Console HTML-tag verification. Not required in practice — the
// domain property sc-domain:botplanet.io is verified via DNS, which covers every
// URL prefix. The hook emits nothing when the value is unset (which it is).
const searchConsoleToken = (Astro.locals as App.Locals).runtime?.env?.GOOGLE_SITE_VERIFICATION;
const verifySearchConsole = Boolean(searchConsoleToken) && !preview;

/**
 * GA4 — the single production page-view system. Loaded once, here, and only on
 * the production host in a production build. The measurement ID is public by
 * design and lives in wrangler.toml [vars]; it is shape-checked before use.
 */
const gaId = (Astro.locals as App.Locals).runtime?.env?.GA_MEASUREMENT_ID;
const gaValid = typeof gaId === "string" && /^G-[A-Z0-9]{4,20}$/i.test(gaId);
const gaEnabled = gaValid && import.meta.env.PROD && !preview;

const graph = schemaGraph(
  organizationSchema(),
  websiteSchema(),
  breadcrumbs.length ? breadcrumbSchema(breadcrumbs) : null,
  ...schema,
);
---

<!doctype html>
<html lang="en-US" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <meta name="robots" content={meta.robots} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07070a" />
    <link rel="icon" type="image/png" href="/logo/favicon-128.png" />
    {verifySearchConsole && <meta name="google-site-verification" content={searchConsoleToken} />}
    <!-- Self-hosted display face: preloaded because it renders the first headline. -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta property="og:site_name" content="BotPlanet" />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:type" content={meta.ogType} />
    <meta property="og:url" content={meta.ogUrl} />
    <meta property="og:image" content={meta.ogImage} />
    <meta name="twitter:card" content={meta.twitterCard} />
    <meta name="twitter:title" content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.ogDescription} />
    <meta name="twitter:image" content={meta.ogImage} />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    {gaEnabled && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}
        />
      </Fragment>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main class:list={[{ narrow }]} id="main">
      {bleed ? (
        <slot />
      ) : (
        <div class="wrap">
          <Breadcrumbs items={breadcrumbs} />
          <slot />
        </div>
      )}
    </main>
    <Footer />
    <script is:inline>
      // Progressive enhancement flag: CSS then treats no-JS as "already visible".
      document.documentElement.classList.remove("no-js");

      // One-shot reveal on first scroll into view. Never loops, never re-hides,
      // and is skipped entirely when the visitor prefers reduced motion.
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var targets = document.querySelectorAll(".reveal");
        if (reduce || !("IntersectionObserver" in window) || !targets.length) {
          targets.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
