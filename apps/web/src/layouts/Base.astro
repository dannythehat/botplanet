---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import {
  buildMeta, isPreviewHost, schemaGraph, organizationSchema, websiteSchema, breadcrumbSchema, OG_IMAGE_DEFAULT, type Crumb,
} from "../lib/seo";

// Global design system. Order matters: tokens → element base → layout → components → metallic direction.
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/depth.css";
import "../styles/components.css";
import "../styles/metal-theme.css";

interface Props {
  title: string;
  description?: string;
  /** Canonical path on production domain; defaults to current pathname. */
  path?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes (Product, Article, FAQPage, ItemList, Person…). */
  schema?: (Record<string, unknown> | null | undefined)[];
  /** Constrain main content width for long-form reading. */
  narrow?: boolean;
  /** Let a page own the full width (full-bleed bands) with no wrap/breadcrumbs. */
  bleed?: boolean;
}

const {
  title,
  description = "Browse, compare and choose real-world robots for the US — honest pricing, labelled evidence and clear limitations.",
  path,
  ogImage,
  ogType,
  noindex,
  breadcrumbs = [],
  schema = [],
  narrow = false,
  bleed = false,
} = Astro.props;

const host = Astro.request.headers.get("host");
const canonicalPath = path ?? Astro.url.pathname;
const meta = buildMeta({ title, description, path: canonicalPath, ogImage, ogType, noindex }, host);
const preview = isPreviewHost(host);

const searchConsoleToken = (Astro.locals as App.Locals).runtime?.env?.GOOGLE_SITE_VERIFICATION;
const verifySearchConsole = Boolean(searchConsoleToken) && !preview;

const gaId = (Astro.locals as App.Locals).runtime?.env?.GA_MEASUREMENT_ID;
const gaValid = typeof gaId === "string" && /^G-[A-Z0-9]{4,20}$/i.test(gaId);
const gaEnabled = gaValid && import.meta.env.PROD && !preview;

/* CLOUDFLARE WEB ANALYTICS — a second beacon, deliberately, alongside GA4.
   Two reasons, and neither is "more numbers is better".

   FIRST, IT SETTLES A QUESTION THE EDGE DATA CANNOT. Cloudflare's edge log
   classifies visitors by user-agent string, and on 12 August 2026 that showed
   584 Safari page views across a fortnight — 40% of all browser traffic —
   arriving every single day. The owner has never owned an Apple device, so it
   is not him. It is either real iPhone users or scrapers wearing an iPhone
   user-agent, which is a common way to avoid being blocked, and the edge log
   cannot tell the two apart. A beacon can: bots do not execute JavaScript. If
   this reports Safari traffic, those are people.

   SECOND, IT IS THE ONE WE CAN READ. GA4 answers the same question, but there
   is no Google credential anywhere in this project by design (see
   lib/reporting.ts), so its numbers can only be read by a human opening a
   dashboard. Cloudflare's are available over an API this project already
   authenticates against, which is what lets scripts/traffic-report.mjs commit
   a dated report instead of somebody transcribing one.

   Also cookieless, so it raises no consent obligation that GA4 does not
   already raise.

   Gated exactly like GA4: production only, never on a preview host, and off
   entirely until CF_BEACON_TOKEN is set in wrangler.toml [vars]. The token is
   public by design — it identifies a site to Cloudflare, it does not authorise
   anything — which is why it sits in vars rather than in secrets. */
const cfBeacon = (Astro.locals as App.Locals).runtime?.env?.CF_BEACON_TOKEN;
const cfBeaconValid = typeof cfBeacon === "string" && /^[a-f0-9]{32}$/i.test(cfBeacon);
const cfBeaconEnabled = cfBeaconValid && import.meta.env.PROD && !preview;

const graph = schemaGraph(
  organizationSchema(),
  websiteSchema(),
  breadcrumbs.length ? breadcrumbSchema(breadcrumbs) : null,
  ...schema,
);
---

<!doctype html>
<html lang="en-US" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <meta name="robots" content={meta.robots} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050607" />
    <link rel="icon" type="image/png" href="/logo/favicon-128.png" />
    {verifySearchConsole && <meta name="google-site-verification" content={searchConsoleToken} />}
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta property="og:site_name" content="BotPlanet" />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:type" content={meta.ogType} />
    <meta property="og:url" content={meta.ogUrl} />
    <meta property="og:image" content={meta.ogImage} />
    {/* Dimensions let a platform reserve the card's shape before the file
        lands, instead of guessing and re-cropping once it arrives. Emitted
        only for the default card, whose size we know; a page supplying its
        own og:image would otherwise get another image's measurements. */}
    {meta.ogImage.endsWith(OG_IMAGE_DEFAULT) && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="BotPlanet — shop real-world robots with clearer comparisons and evidence" />
      </>
    )}
    <meta name="twitter:card" content={meta.twitterCard} />
    <meta name="twitter:title" content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.ogDescription} />
    <meta name="twitter:image" content={meta.ogImage} />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    {gaEnabled && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}
        />
      </Fragment>
    )}
    {cfBeaconEnabled && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token":"${cfBeacon}"}`}
      ></script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main class:list={[{ narrow, bleed }]} id="main">
      {bleed ? (
        <slot />
      ) : (
        <div class="wrap">
          <Breadcrumbs items={breadcrumbs} />
          <slot />
        </div>
      )}
    </main>
    <Footer />
    <script is:inline>
      document.documentElement.classList.remove("no-js");

      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var targets = document.querySelectorAll(".reveal");
        if (reduce || !("IntersectionObserver" in window) || !targets.length) {
          targets.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
