---
import { TRUST_LINKS } from "../lib/site";
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Shop the planet yourself, or let BotPlanet find your perfect robot." } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #0b0f17;
        --panel: #131a26;
        --panel-2: #1a2333;
        --text: #e8edf6;
        --muted: #93a1b8;
        --accent: #4fd1c5;
        --accent-2: #7c93ff;
        --border: #223049;
        --radius: 14px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: radial-gradient(1200px 600px at 70% -10%, #16223a 0%, var(--bg) 55%);
        color: var(--text);
        font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      header.site {
        border-bottom: 1px solid var(--border);
        background: rgba(11, 15, 23, 0.7);
        backdrop-filter: blur(8px);
        position: sticky; top: 0; z-index: 10;
      }
      header.site .bar { display: flex; align-items: center; gap: 22px; height: 62px; }
      .logo { font-weight: 800; font-size: 20px; letter-spacing: -0.02em; color: var(--text); }
      .logo span { color: var(--accent); }
      nav.main { display: flex; gap: 18px; flex-wrap: wrap; }
      nav.main a { color: var(--muted); font-weight: 600; font-size: 14px; }
      nav.main a:hover { color: var(--text); text-decoration: none; }
      .cta {
        margin-left: auto; background: linear-gradient(135deg, var(--accent), var(--accent-2));
        color: #05141a; padding: 9px 16px; border-radius: 10px; font-weight: 700; font-size: 14px;
      }
      .cta:hover { text-decoration: none; filter: brightness(1.05); }
      main { padding: 40px 0 80px; }
      h1 { font-size: clamp(28px, 5vw, 44px); line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 12px; }
      h2 { font-size: 22px; letter-spacing: -0.02em; margin: 36px 0 16px; }
      .muted { color: var(--muted); }
      .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
      .card {
        background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius);
        padding: 18px; display: flex; flex-direction: column; gap: 8px;
      }
      .card h3 { margin: 0; font-size: 17px; }
      .pill {
        display: inline-block; font-size: 12px; font-weight: 700; padding: 3px 9px; border-radius: 999px;
        background: var(--panel-2); color: var(--muted); border: 1px solid var(--border);
      }
      .pill.class { color: var(--accent); }
      .price { font-size: 20px; font-weight: 800; }
      .btn {
        display: inline-block; background: var(--panel-2); border: 1px solid var(--border);
        color: var(--text); padding: 9px 14px; border-radius: 10px; font-weight: 700; font-size: 14px;
      }
      .btn.primary { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #05141a; border: none; }
      .btn:hover { text-decoration: none; filter: brightness(1.06); }
      .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
      .hero {
        background: linear-gradient(135deg, var(--panel), var(--panel-2));
        border: 1px solid var(--border); border-radius: 20px; padding: 40px; margin-bottom: 28px;
      }
      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); }
      th { color: var(--muted); font-weight: 700; }
      footer.site { border-top: 1px solid var(--border); color: var(--muted); font-size: 13px; padding: 28px 0; }
      .note { font-size: 12.5px; color: var(--muted); }
      .badge-preview {
        position: fixed; bottom: 12px; right: 12px; background: #3a2a12; color: #ffd699;
        border: 1px solid #6b4f1f; padding: 6px 10px; border-radius: 8px; font-size: 12px; z-index: 50;
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="logo" href="/"><img src="/favicon.svg" alt="" width="30" height="30" style="vertical-align:-8px;margin-right:9px" />Bot<span>Planet</span></a>
        <nav class="main">
          <a href="/robots/robotic-pool-cleaners/">Shop Robots</a>
          <a href="/compare/robotic-pool-cleaners/">Compare</a>
          <a href="/botmatch/robotic-pool-cleaners/">Find My Robot</a>
        </nav>
        <a class="cta" href="/botmatch/robotic-pool-cleaners/">Start BotMatch</a>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <nav class="main" style="margin-bottom:14px;">
          {TRUST_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        BotPlanet — US preview. Prices are research snapshots, not live truth. Affiliate links are disclosed. Not yet a live commercial site.
      </div>
    </footer>
    <div class="badge-preview">⚙️ Preview build — provisional data</div>
  </body>
</html>
