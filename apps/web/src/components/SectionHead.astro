---
import { applyInternalLinks } from "../lib/internal-linker";
import { liveAnchorsFor } from "../content/internal-links";
/* ============================================================
   BotPlanet — Shared section header

   Every section below the hero opens with this, on every page
   of the site. One place to change the heading treatment for
   the whole template.

   Eyebrow rule + eyebrow + H2 (cosmic silver) + intro.
   ============================================================ */

interface Props {
  /** Short label, e.g. "Pool type". Sits above the heading. */
  eyebrow?: string;
  /** The H2. */
  title: string;
  /** 60–100 words. */
  intro: string;
  /**
   * Category whose internal-link anchors may be woven into the intro.
   *
   * THE ONE PLACE NINE HUBS' PROSE CAN GAIN A LINK. Every category hub carries
   * roughly 3,200 words and, until 14 August 2026, not one link from any of it
   * to a product — the full-site audit found the same defect on all nine. The
   * cause was structural rather than editorial: the internal-link injector runs
   * on MARKDOWN, so reviews and guides get links woven through their prose,
   * while hub sections are structured records rendered straight to HTML and
   * could never be reached by it.
   *
   * Every section on every hub renders its intro through this component, so
   * doing it here covers all nine and cannot drift from what a section says
   * next. Omit the prop and the intro renders as plain text exactly as before.
   */
  linkCategory?: string;
}

const { eyebrow, title, intro, linkCategory } = Astro.props;

/* The intro is plain prose from a content module, so the only escaping it
   needs is the three characters that would otherwise be read as markup. The
   injector then inserts anchors it built itself from the registry.

   Each anchor already carries its own cap of one occurrence, and a 60-to-100
   word paragraph rarely contains more than one registered phrase, so this
   yields a link or two rather than a link farm. */
const escapeHtml = (t: string) =>
  t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

/* SELF-PATH PASSED so the hub cannot link its own URL. Fragment anchors into
   this page survive that check by design — a jump to #coverage is navigation,
   not a self-link — and those are useful here: the intros are what a reader
   scans before deciding which section to read. */
const linked = linkCategory
  ? applyInternalLinks(escapeHtml(intro), liveAnchorsFor(linkCategory), `/robots/${linkCategory}/`).html
  : null;
---

<header class="bp-shead">
  {eyebrow && (
    <div class="bp-shead__eyebrow">
      <span class="bp-shead__rule" aria-hidden="true"></span>
      <span class="bp-shead__eyebrow-text">{eyebrow}</span>
    </div>
  )}
  <h2 class="bp-shead__title">{title}</h2>
  {linked ? <p class="bp-shead__intro" set:html={linked} /> : <p class="bp-shead__intro">{intro}</p>}
</header>

<style>
  .bp-shead {
    max-width: 64ch;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  /* ---------- eyebrow ---------- */
  .bp-shead__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.05rem;
  }

  .bp-shead__rule {
    width: 2.1rem;
    height: 1px;
    flex: none;
    background: var(--cs-rule);
  }

  .bp-shead__eyebrow-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    background: var(--cs-sheen);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ---------- heading ---------- */
  .bp-shead__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 4.8vw, 2.6rem);
    line-height: 1.11;
    letter-spacing: -0.021em;
    text-wrap: balance;
    background: linear-gradient(172deg, #ffffff 4%, #e4e9f1 44%, #a2aab8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ---------- intro ---------- */
  .bp-shead__intro {
    margin: 1.05rem 0 0;
    font-size: 1.0625rem; /* 17px */
    line-height: 1.66;
    color: var(--text-secondary);
  }

  @media (min-width: 860px) {
    .bp-shead__intro {
      font-size: 1.1875rem; /* 19px */
      line-height: 1.62;
    }
  }
</style>
