---
/* ============================================================
   BotPlanet — Article footer

   Step 17 of the approved component order: the affiliate
   disclosure and the date the page was last reviewed.

   There is already a disclosure in the site footer, but the FTC
   expects it near the affiliate links rather than at the bottom
   of the site, and a reader who lands mid-page never sees the
   site footer at all. This one belongs to the article.

   It renders regardless of whether the page currently carries a
   buy button, so the disclosure is already in place before the
   product modules arrive rather than being remembered afterwards.
   ============================================================ */

interface Props {
  /** ISO date the page content was last reviewed. */
  lastReviewed: string;
  /** Who reviewed it. */
  reviewedBy?: string;
  /** Where the method is explained. */
  methodologyHref?: string;
}

const {
  lastReviewed,
  reviewedBy = "Danny",
  methodologyHref = "/review-methodology/",
} = Astro.props;

const readable = new Date(`${lastReviewed}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
});
---

<footer class="bp-afoot">
  <p class="bp-afoot__disclosure">
    <strong>Affiliate disclosure.</strong> Some links on this page are affiliate links, and
    BotPlanet may earn a commission if you buy through one — at no extra cost to you.
    Commission plays no part in which robot we recommend: the part of BotMatch that decides
    what suits you cannot see prices, retailers or commission at all. It is only ever used to
    break a tie between shops selling the same machine on the same terms.
  </p>

  <p class="bp-afoot__meta">
    Last reviewed <time datetime={lastReviewed}>{readable}</time> by {reviewedBy}.
    <a href={methodologyHref}>How we research</a>.
    Prices and availability change — always confirm at the retailer before buying.
  </p>
</footer>

<style is:global>
  .bp-afoot {
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding-top: clamp(1.5rem, 3.5vw, 2rem);
    border-top: 1px solid var(--cs-line-soft);
  }

  .bp-afoot__disclosure {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.66;
    color: var(--text-tertiary);
  }

  .bp-afoot__disclosure strong { color: var(--cs-mid); }

  .bp-afoot__meta {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-quaternary);
  }

  .bp-afoot__meta a {
    color: var(--cs-mid);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .bp-afoot__meta a:hover { color: var(--cs-hi); }

  @media (min-width: 860px) {
    .bp-afoot__disclosure { max-width: 78ch; }
  }
</style>
