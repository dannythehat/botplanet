---
/* ============================================================
   BotPlanet — product comparison table

   The one place on a category page where every product is put
   side by side. Three rules shape it, and they are the reason
   it looks the way it does.

   1. A GAP IS SHOWN, NOT FILLED. Where a manufacturer does not
      publish a figure the cell says so, in words. It never
      borrows a sibling model's number, never estimates, and
      never leaves an empty cell that reads as "none".

   2. SIZE IS TWO MEASURES, NOT ONE. Makers publish a maximum
      length or a maximum area and rarely both. Showing only
      length would print "Not disclosed" against a robot whose
      maker states its capacity perfectly clearly in square feet.

   3. THE ORDER IS DECLARED. Rows are sorted by price band and
      then by name, and the caption says so. A comparison table
      that sorts by something it does not disclose is a ranking
      pretending to be a table — and commission must never be
      the hidden key. It is not available to this component:
      the row type has no price, offer or commission field.
   ============================================================ */

import SectionHead from "./SectionHead.astro";
import ProductImage from "./ProductImage.astro";

/** What a manufacturer has not said. One wording, used everywhere. */
export const NOT_DISCLOSED = "Not disclosed";

export interface ComparisonRow {
  productId: string;
  name: string;
  href: string;
  /** "Up to 100 ft", "Up to 1,076 sq ft", or NOT_DISCLOSED. */
  poolSize: string;
  /** Where it may be used, e.g. "In-ground". */
  environments: string;
  /** What it cleans, e.g. "Floor · Walls · Waterline". */
  cleans: string;
  /** "Cordless", "Corded", "Solar". */
  power: string;
  /** Price band label, e.g. "Mid". Never a figure. */
  band: string;
  /**
   * /go redirect key of an active offer, or null. A link target only — no
   * price or commission value reaches this component through it, and it
   * plays no part in the sort above. See the "Check price" action below.
   */
  redirectKey: string | null;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro: string;
  rows: ComparisonRow[];
  note?: string;
  /** Category slug, so the first two columns can be named for the category. */
  categorySlug?: string;
}

const { id, eyebrow, title, intro, rows, note, categorySlug } = Astro.props;

/**
 * THE FIRST TWO COLUMNS WERE CALLED "Pool size" AND "Pool type" ON EVERY PAGE.
 *
 * That was fine while pool was the only category and wrong from the day window
 * shipped on 5 August 2026. Found on 8 August when the first lawn mowers went
 * in and the table offered a robot mower's "Pool size" — but window, companion,
 * coding and pet camera hubs had been doing it for three days already, in
 * production, on the two columns a reader looks at first.
 *
 * The cells are generic — a size figure and a list of environments — so only
 * the labels were ever pool-specific. `data-label` matters as much as the
 * header: it is what the stacked mobile layout prints beside each value.
 */
const HEADINGS: Record<string, [string, string]> = {
  "robotic-pool-cleaners": ["Pool size", "Pool type"],
  "window-cleaning-robots": ["Reach", "Glass type"],
  "robotic-lawn-mowers": ["Lawn size", "Ground"],
  "robot-vacuums": ["Floor area", "Floor type"],
  "self-cleaning-litter-boxes": ["Capacity", "Cat size"],
  "grill-cleaning-robots": ["Grill size", "Grate type"],
  "companion-robots": ["Size", "Suits"],
  "pet-camera-robots": ["Range", "Suits"],
  "educational-coding-robots": ["Age range", "Suits"],
};
const [sizeLabel, typeLabel] = HEADINGS[categorySlug ?? ""] ?? ["Size", "Suits"];

const COLUMNS = [sizeLabel, typeLabel, "Cleans", "Power", "Price band"];
---

<section class="bp-cmp" id={id}>
  <SectionHead eyebrow={eyebrow} title={title} intro={intro} />

  <div class="bp-cmp__frame">
    <table class="bp-cmp__table">
      <caption class="sr-only">
        {rows.length} {title.toLowerCase()}, ordered by price band and then by name.
        Cells reading “{NOT_DISCLOSED}” mean the manufacturer does not publish that figure.
      </caption>
      <thead>
        <tr>
          <th scope="col">Robot</th>
          {COLUMNS.map((c) => <th scope="col">{c}</th>)}
          <th scope="col"><span class="sr-only">Read more</span></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row" class="bp-cmp__rowhead">
              <a href={r.href}>
                <span class="bp-cmp__thumb">
                  <ProductImage productId={r.productId} placement="comparison" compact sizes="96px" />
                </span>
                <span class="bp-cmp__name">{r.name}</span>
              </a>
            </th>

            <td data-label={sizeLabel}>
              <span class:list={["bp-cmp__figure", r.poolSize === NOT_DISCLOSED && "is-unknown"]} title={r.poolSize === NOT_DISCLOSED ? "The maker does not state a size" : undefined}>{r.poolSize === NOT_DISCLOSED ? "—" : r.poolSize}</span>
            </td>

            <td data-label={typeLabel}>
              <span class="bp-cmp__tags">
                {r.environments.split(" · ").map((v) => <span class="bp-cmp__tag">{v}</span>)}
              </span>
            </td>

            <td data-label="Cleans">
              <span class="bp-cmp__tags">
                {r.cleans.split(" · ").map((v) => <span class="bp-cmp__tag bp-cmp__tag--clean">{v}</span>)}
              </span>
            </td>

            <td data-label="Power"><span class="bp-cmp__tag">{r.power}</span></td>

            <td data-label="Price band"><span class="bp-cmp__band" data-band={r.band.toLowerCase()}>{r.band}</span></td>

            <td data-label="" class="bp-cmp__actions">
              <div class="bp-cmp__actionbox">
              <a class="bp-cmp__more" href={r.href}>
                Details<span aria-hidden="true">&#8594;</span>
              </a>
              {/* Only for a reader who has already decided from the row alone
                  and would otherwise open the review just to find a way to
                  buy. Same /go route and disclosure obligation as everywhere
                  else — this is a shortcut, not a second recommendation. */}
              {r.redirectKey && (
                <a class="bp-cmp__price" href={`/go/${r.redirectKey}`} rel="sponsored nofollow">
                  Check price
                </a>
              )}
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {note && <p class="bp-cmp__note">{note}</p>}

</section>

<style is:global>
  /* The frame is the lit metal plate the rest of the page uses, one step in
     from the section plate around it so the nesting reads as depth. */
  .bp-cmp__frame {
    position: relative;
    border: 1px solid var(--cs-line);
    border-radius: 16px;
    overflow: hidden;
    background: var(--cs-surface-lift);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  /* Horizontal scroll lives on an inner wrapper so the frame's rounded corners
     survive it — overflow on the bordered element square-cuts them. */
  .bp-cmp__frame { overflow-x: auto; }

  .bp-cmp__table {
    width: 100%;
    min-width: 54rem;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.94rem;
    table-layout: fixed;
  }

  /* Column widths are set rather than left to the browser, because auto layout
     starves the widest column — "Cleans" carries up to four tags and would
     stack them vertically, making one row three times the height of its
     neighbours and destroying the scannability the table exists for. */
  .bp-cmp__table :is(th, td):nth-child(1) { width: 22%; }
  .bp-cmp__table :is(th, td):nth-child(2) { width: 14%; }
  .bp-cmp__table :is(th, td):nth-child(3) { width: 12%; }
  .bp-cmp__table :is(th, td):nth-child(4) { width: 18%; }
  .bp-cmp__table :is(th, td):nth-child(5) { width: 8%; }
  .bp-cmp__table :is(th, td):nth-child(6) { width: 9%; }
  .bp-cmp__table :is(th, td):nth-child(7) { width: 17%; }

  /* ---------- head ---------- */
  .bp-cmp__table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 0.95rem 0.9rem;
    text-align: left;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cs-mid);
    background: linear-gradient(180deg, #171c23 0%, #10141a 100%);
    border-bottom: 1px solid var(--cs-line);
  }

  /* The one bright line in the table: the same sheen the section plates carry
     across their top edge, here separating head from body. */
  .bp-cmp__table thead th::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(246, 248, 252, 0.4), transparent);
  }

  /* ---------- body ---------- */
  .bp-cmp__table td,
  .bp-cmp__table tbody th {
    padding: 0.85rem 0.9rem;
    text-align: left;
    vertical-align: middle;
    color: var(--text-secondary);
    line-height: 1.45;
    border-top: 1px solid var(--cs-line-soft);
  }

  /* Alternating tint, so the eye tracks across a wide row without a rule
     between every column. */
  .bp-cmp__table tbody tr:nth-child(even) td,
  .bp-cmp__table tbody tr:nth-child(even) th {
    background: rgba(255, 255, 255, 0.014);
  }

  .bp-cmp__table tbody tr:hover td,
  .bp-cmp__table tbody tr:hover th {
    background: rgba(226, 232, 244, 0.05);
  }

  /* ---------- the robot ---------- */
  .bp-cmp__rowhead {
    font-weight: 400;
    /* Held in place while the rest scrolls sideways: on a wide table the name
       is the thing you must keep in view to know which row you are reading. */
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--cs-surface-lift);
  }

  .bp-cmp__rowhead a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 13.5rem;
    color: var(--cs-hi);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .bp-cmp__rowhead a:hover .bp-cmp__name,
  .bp-cmp__rowhead a:focus-visible .bp-cmp__name {
    background: linear-gradient(172deg, #ffffff 4%, #e8ecf3 46%, #a4acb9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bp-cmp__thumb {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 9px;
    overflow: hidden;
    background: var(--cs-surface);
    border: 1px solid var(--cs-line-soft);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .bp-cmp__thumb :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  /* ---------- values ---------- */

  /* Figures are monospaced so 100 ft and 40 ft line up down the column and can
     be compared at a glance rather than read one at a time. */
  .bp-cmp__figure {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    letter-spacing: 0.01em;
    color: var(--cs-bright);
    white-space: normal;
  }

  /* A gap reads as a gap. Dimmed, italic, not monospaced — deliberately
     unlike every real value in the column. */
  .bp-cmp__figure.is-unknown {
    font-family: inherit;
    font-size: 0.86rem;
    font-style: italic;
    color: var(--text-quaternary);
    letter-spacing: 0;
  }

  .bp-cmp__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .bp-cmp__tag {
    display: inline-block;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--cs-line-soft);
    background: rgba(255, 255, 255, 0.035);
    font-size: 0.76rem;
    line-height: 1.35;
    white-space: nowrap;
    color: var(--cs-bright);
  }

  /* What it cleans is the column people scan hardest, so it gets the chrome. */
  .bp-cmp__tag--clean {
    position: relative;
    padding-left: 1.05rem;
    border-color: rgba(200, 208, 222, 0.22);
  }

  .bp-cmp__tag--clean::before {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 50%;
    width: 0.3rem;
    height: 0.3rem;
    margin-top: -0.15rem;
    transform: rotate(45deg);
    background: var(--cs-sheen);
  }

  /* Bands are a scale, so they read as one: the same chip, brighter as it
     climbs. No colour coding — nothing here says "better". */
  .bp-cmp__band {
    display: inline-block;
    padding: 0.24rem 0.62rem;
    border-radius: 6px;
    border: 1px solid var(--cs-line-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cs-mid);
    background: rgba(255, 255, 255, 0.03);
    white-space: nowrap;
  }

  .bp-cmp__band[data-band="premium"] { color: var(--cs-bright); border-color: rgba(200, 208, 222, 0.26); }
  .bp-cmp__band[data-band="top"] {
    color: #0a0d11;
    background: var(--cs-sheen);
    border-color: transparent;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  /* ---------- the link out ---------- */
  /* THE FLEX LIVES ON A WRAPPER, NOT ON THE <td>. `display: flex` on a table
     cell takes it out of the table: the row silently has one cell fewer, the
     columns after it slide left, and the Details and Check price buttons land on
     top of the Price band cell. That is exactly what shipped on every comparison
     table from the day the Check price button was added, found on 1 October
     2026 from a screenshot of the solar skimmer page. */
  .bp-cmp__actionbox {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .bp-cmp__price {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(120, 176, 255, 0.55);
    background: linear-gradient(180deg, #2f7fe4 0%, #1a55b4 100%);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }

  .bp-cmp__price:focus-visible {
    outline: var(--focus-ring, 2px solid #dfe4ec);
    outline-offset: 2px;
  }

  .bp-cmp__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--cs-line-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cs-mid);
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .bp-cmp__more span { transition: transform 160ms ease; }

  .bp-cmp__table tbody tr:hover .bp-cmp__more {
    color: var(--cs-hi);
    border-color: rgba(226, 232, 244, 0.4);
    background: rgba(226, 232, 244, 0.07);
  }

  .bp-cmp__table tbody tr:hover .bp-cmp__more span { transform: translateX(3px); }

  .bp-cmp__more:focus-visible {
    outline: var(--focus-ring, 2px solid #dfe4ec);
    outline-offset: 2px;
  }

  .bp-cmp__note {
    margin: 0.95rem 0 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-quaternary);
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-cmp__more,
    .bp-cmp__more span { transition: none; }
    .bp-cmp__table tbody tr:hover .bp-cmp__more span { transform: none; }
  }

  /* ---------- mobile: one card per robot ----------
     Below 860px a seven-column table cannot be read without pinching, so the
     same DOM becomes stacked rows with the column name in front of each value.
     No second markup path, so the two can never disagree. */
  @media (max-width: 859px) {
    .bp-cmp__frame {
      border: 0;
      background: none;
      overflow: visible;
      box-shadow: none;
    }

    .bp-cmp__table,
    .bp-cmp__table tbody,
    .bp-cmp__table tr,
    .bp-cmp__table td,
    .bp-cmp__table tbody th { display: block; width: 100%; }

    /* The fixed desktop widths must not survive the switch to stacked cards. */
    .bp-cmp__table { min-width: 0; table-layout: auto; }
    .bp-cmp__table :is(th, td):nth-child(n) { width: 100%; }

    .bp-cmp__table thead {
      position: absolute;
      clip-path: inset(50%);
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    .bp-cmp__table tbody tr {
      position: relative;
      margin-bottom: 0.9rem;
      border: 1px solid var(--cs-line);
      border-radius: 14px;
      overflow: hidden;
      background: var(--cs-surface-lift);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .bp-cmp__table tbody tr:nth-child(even) td,
    .bp-cmp__table tbody tr:nth-child(even) th,
    .bp-cmp__table tbody tr:hover td,
    .bp-cmp__table tbody tr:hover th { background: none; }

    .bp-cmp__rowhead {
      position: static;
      padding: 0.95rem 1rem;
      border-top: 0;
      border-bottom: 1px solid var(--cs-line-soft);
      background: rgba(255, 255, 255, 0.025);
    }

    .bp-cmp__table td {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.55rem 1rem;
      border-top: 0;
    }

    .bp-cmp__table td::before {
      content: attr(data-label);
      flex: 0 0 auto;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--cs-low);
    }

    .bp-cmp__tags { justify-content: flex-end; }

    .bp-cmp__actions {
      padding: 0.7rem 1rem 1rem;
    }

    .bp-cmp__actionbox {
      width: 100%;
      align-items: stretch;
    }

    .bp-cmp__actions::before { display: none; }

    .bp-cmp__more {
      width: 100%;
      justify-content: center;
      padding: 0.62rem 0.8rem;
      color: var(--cs-bright);
      border-color: var(--cs-line);
    }

    .bp-cmp__price {
      width: 100%;
      justify-content: center;
      padding: 0.62rem 0.8rem;
      /* Above Details, not below — the reader who has already decided from
         the card alone should not have to scan past a second link to find
         the one that acts. */
      order: -1;
    }
  }
</style>
