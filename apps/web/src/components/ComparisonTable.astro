---
/* ============================================================
   BotPlanet — product comparison table

   The one place on a category page where every product is put
   side by side. Three rules shape it, and they are the reason
   it looks the way it does.

   1. A GAP IS SHOWN, NOT FILLED. Where a manufacturer does not
      publish a figure the cell says so, in words. It never
      borrows a sibling model's number, never estimates, and
      never leaves an empty cell that reads as "none".

   2. SIZE IS TWO MEASURES, NOT ONE. Makers publish a maximum
      length or a maximum area and rarely both. Showing only
      length would print "Not disclosed" against a robot whose
      maker states its capacity perfectly clearly in square feet.

   3. THE ORDER IS DECLARED. Rows are sorted by price band and
      then by name, and the caption says so. A comparison table
      that sorts by something it does not disclose is a ranking
      pretending to be a table — and commission must never be
      the hidden key. It is not available to this component:
      the row type has no price, offer or commission field.
   ============================================================ */

import SectionHead from "./SectionHead.astro";
import ProductImage from "./ProductImage.astro";

/** What a manufacturer has not said. One wording, used everywhere. */
export const NOT_DISCLOSED = "Not disclosed";

export interface ComparisonRow {
  productId: string;
  name: string;
  href: string;
  /** "Up to 100 ft", "Up to 1,076 sq ft", or NOT_DISCLOSED. */
  poolSize: string;
  /** Where it may be used, e.g. "In-ground". */
  environments: string;
  /** What it cleans, e.g. "Floor · Walls · Waterline". */
  cleans: string;
  /** "Cordless", "Corded", "Solar". */
  power: string;
  /** Price band label, e.g. "Mid". Never a figure. */
  band: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro: string;
  rows: ComparisonRow[];
  note?: string;
}

const { id, eyebrow, title, intro, rows, note } = Astro.props;

const COLUMNS = ["Pool size", "Pool type", "Cleans", "Power", "Price band"];
---

<section class="bp-cmp" id={id}>
  <SectionHead eyebrow={eyebrow} title={title} intro={intro} />

  <div class="bp-cmp__frame">
    <table class="bp-cmp__table">
      <caption class="sr-only">
        {rows.length} {title.toLowerCase()}, ordered by price band and then by name.
        Cells reading “{NOT_DISCLOSED}” mean the manufacturer does not publish that figure.
      </caption>
      <thead>
        <tr>
          <th scope="col">Robot</th>
          {COLUMNS.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row" class="bp-cmp__rowhead">
              <a href={r.href}>
                <span class="bp-cmp__thumb">
                  <ProductImage productId={r.productId} placement="comparison" compact sizes="96px" />
                </span>
                <span class="bp-cmp__name">{r.name}</span>
              </a>
            </th>
            <td data-label="Pool size" class:list={[r.poolSize === NOT_DISCLOSED && "is-unknown"]}>{r.poolSize}</td>
            <td data-label="Pool type">{r.environments}</td>
            <td data-label="Cleans">{r.cleans}</td>
            <td data-label="Power">{r.power}</td>
            <td data-label="Price band">{r.band}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {note && <p class="bp-cmp__note">{note}</p>}
</section>

<style is:global>
  .bp-cmp__frame {
    border: 1px solid var(--cs-line);
    border-radius: 16px;
    overflow-x: auto;
    background: var(--cs-surface);
  }

  .bp-cmp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.94rem;
  }

  .bp-cmp__table thead th {
    padding: 0.9rem 1rem;
    text-align: left;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cs-mid);
    border-bottom: 1px solid var(--cs-line);
  }

  .bp-cmp__table tbody tr + tr { border-top: 1px solid var(--cs-line-soft); }

  .bp-cmp__table td,
  .bp-cmp__table tbody th {
    padding: 0.95rem 1rem;
    text-align: left;
    vertical-align: middle;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .bp-cmp__rowhead { font-weight: 400; }

  .bp-cmp__rowhead a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 13rem;
    color: var(--cs-hi);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .bp-cmp__rowhead a:hover .bp-cmp__name { text-decoration: underline; }

  .bp-cmp__thumb {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--cs-surface-lift);
    border: 1px solid var(--cs-line-soft);
  }

  .bp-cmp__thumb :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  /* A gap reads as a gap: dimmed and italic, never mistakable for a value. */
  .bp-cmp__table .is-unknown {
    color: var(--text-quaternary);
    font-style: italic;
  }

  .bp-cmp__note {
    margin: 0.9rem 0 0;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-quaternary);
  }

  /* ---------- mobile: one card per robot ----------
     Below 860px a six-column table cannot be read without pinching, so the
     same DOM becomes stacked rows with the column name in front of each
     value. No second markup path, so the two can never disagree. */
  @media (max-width: 859px) {
    .bp-cmp__frame { border: 0; background: none; overflow-x: visible; }
    .bp-cmp__table,
    .bp-cmp__table tbody,
    .bp-cmp__table tr,
    .bp-cmp__table td,
    .bp-cmp__table tbody th { display: block; width: 100%; }

    .bp-cmp__table thead {
      position: absolute;
      clip-path: inset(50%);
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    .bp-cmp__table tbody tr {
      margin-bottom: 0.85rem;
      border: 1px solid var(--cs-line-soft);
      border-radius: 14px;
      overflow: hidden;
      background: var(--cs-surface);
    }

    .bp-cmp__table tbody tr + tr { border-top: 1px solid var(--cs-line-soft); }

    .bp-cmp__rowhead {
      padding: 0.9rem 1rem;
      border-bottom: 1px solid var(--cs-line-soft);
      background: var(--cs-surface-lift);
    }

    .bp-cmp__table td {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.6rem 1rem;
    }

    .bp-cmp__table td::before {
      content: attr(data-label);
      flex: 0 0 auto;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--cs-low);
    }

    .bp-cmp__table td:last-child { padding-bottom: 0.95rem; }
  }
</style>
