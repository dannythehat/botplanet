---
/* ============================================================
   BotPlanet — Specification table

   Facts only, in the manufacturer's own units, with both
   imperial and metric where the source gives both.

   A row whose value is null renders as "Not disclosed by the
   manufacturer" rather than being dropped. Dropping it hides the
   gap; stating it is the honest move and is what separates this
   from a review site that quietly borrowed the number from
   somewhere else.

   `note` on a row carries a variant conflict — the same field
   reading differently across regional SKUs — so the caveat sits
   with the fact rather than in a footnote nobody reads.
   ============================================================ */

import SectionHead from "./SectionHead.astro";

export interface SpecRow {
  label: string;
  /** null renders as "not disclosed". */
  value: string | null;
  /** Variant conflict or caveat attached to this exact field. */
  note?: string;
}

export interface SpecGroup {
  heading: string;
  rows: SpecRow[];
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro: string;
  groups: SpecGroup[];
  /** The SKU these specifications describe. */
  skuNote?: string;
}

const { id, eyebrow, title, intro, groups, skuNote } = Astro.props;
---

<section class="bp-spec" id={id}>
  <SectionHead eyebrow={eyebrow} title={title} intro={intro} />

  <div class="bp-spec__groups">
    {groups.map((g) => (
      <div class="bp-spec__group">
        <h3 class="bp-spec__gname">{g.heading}</h3>
        <dl class="bp-spec__rows">
          {g.rows.map((r) => (
            <div class="bp-spec__row">
              <dt>{r.label}</dt>
              <dd>
                {r.value === null ? (
                  <span class="bp-spec__undisclosed">Not disclosed by the manufacturer</span>
                ) : (
                  r.value
                )}
                {r.note && <span class="bp-spec__note">{r.note}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>

  {skuNote && <p class="bp-spec__sku">{skuNote}</p>}
</section>

<style is:global>
  .bp-spec { margin: 0 0 clamp(3.5rem, 8vw, 6rem); }

  .bp-spec__groups { display: grid; gap: clamp(0.9rem, 2vw, 1.15rem); }

  .bp-spec__group {
    padding: clamp(1.25rem, 3.2vw, 1.75rem);
    border: 1px solid var(--cs-line-soft);
    border-radius: 14px;
    background: var(--cs-surface);
  }

  .bp-spec__gname {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: var(--cs-sheen);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bp-spec__rows { margin: 0; }

  .bp-spec__row {
    display: grid;
    gap: 0.2rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--cs-line-soft);
  }

  .bp-spec__row:first-child { border-top: 0; padding-top: 0; }

  .bp-spec__row dt {
    font-size: 0.9rem;
    color: var(--text-tertiary);
  }

  .bp-spec__row dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--cs-hi);
  }

  .bp-spec__undisclosed {
    font-size: 0.93rem;
    font-style: italic;
    color: var(--text-quaternary);
  }

  .bp-spec__note {
    display: block;
    margin-top: 0.32rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--cs-mid);
  }

  .bp-spec__sku {
    margin: 1.1rem 0 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-quaternary);
  }

  @media (min-width: 760px) {
    .bp-spec__groups { grid-template-columns: repeat(2, 1fr); }
    .bp-spec__row {
      grid-template-columns: 12rem 1fr;
      gap: 1rem;
      align-items: baseline;
    }
  }
</style>
