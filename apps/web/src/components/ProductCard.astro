---
/**
 * Product card — the workhorse commercial component.
 *
 * It must look deliberate BEFORE real photography exists: a lit media stage
 * with the owned robot silhouette, a classification chip, meaningful metadata
 * and a clear price hierarchy. When rights-cleared imagery lands (Job 9), pass
 * `image` and it replaces the silhouette inside the same stage — no layout
 * change, no redesign.
 *
 * IMAGE RIGHTS: the silhouette is an original BotPlanet asset and is generic by
 * design, so it never implies it depicts the specific model named on the card.
 */
import RobotSilhouette from "./RobotSilhouette.astro";
import ProductImage from "./ProductImage.astro";
import { resolveImage } from "../lib/media-registry";

interface Props {
  href: string;
  name: string;
  /** Product classification, e.g. "Robotic pool cleaner". */
  classification?: string;
  /** Short facts shown under the title, e.g. ["Cordless", "Floor · Walls"]. */
  meta?: string[];
  /** Formatted price string, already localised. */
  price?: string | null;
  /** Note under the price, e.g. freshness caveat. */
  priceNote?: string;
  /**
   * Stable product ID. When supplied, the media registry decides what renders —
   * which is what makes a withdrawal take effect here without a code change.
   * Omitted only by surfaces that have no product (e.g. a category teaser).
   */
  productId?: string | null;
  /** Varies the silhouette so a grid isn't rubber-stamped. */
  variant?: number;
  /** Product id for the save affordance. */
  saveId?: string;
  /**
   * Redirect key of the product's active offer, when it has one. Renders a
   * "Check price on Amazon" action under the card.
   *
   * A SIBLING OF THE CARD LINK, NOT A CHILD. The card is one big <a>, and an
   * anchor inside an anchor is invalid HTML whose recovery differs by browser.
   * Found 1 October 2026: the first Amazon button on every category hub sat
   * 11,500 to 17,000px down a page 25,000 to 40,000px tall, because the only
   * place a reader could act was a table at the bottom. A reader who has
   * picked a card from the grid should not have to scroll thirty screens to
   * buy it.
   */
  buyKey?: string | null;
}

const {
  href,
  name,
  classification,
  meta = [],
  price,
  priceNote,
  productId,
  variant = 0,
  saveId,
  buyKey = null,
} = Astro.props;

/* Ask the registry how this card's image wants to be framed. ProductImage
   still does the rendering — this only decides where the chrome goes, because
   a full-bleed creative already carries branding in its own top corner and a
   chip dropped on top of it lands on the logo. */
const bleed = productId ? Boolean(resolveImage(productId, "listing_card")?.bleed) : false;
---
<div class="pcard-shell">
<a class="pcard elevated reveal" href={href} data-bleed={bleed ? "true" : undefined}>
  <div class="pcard__stage stage">
    {productId ? (
      <ProductImage productId={productId} placement="listing_card" variant={variant} class="pcard__img" />
    ) : (
      <RobotSilhouette variant={variant} class="pcard__sil" />
    )}
    {classification && !bleed && <span class="pcard__class">{classification}</span>}
    {saveId && (
      <button
        class="icon-btn pcard__save"
        type="button"
        data-save={saveId}
        aria-pressed="false"
        aria-label={`Save ${name}`}
      >
        <span aria-hidden="true">♡</span>
      </button>
    )}
  </div>

  <div class="pcard__body">
    {/* The classification does not vanish when it leaves the stage — it joins
        the facts under the title, where it reads as information rather than
        as a label stuck over someone's artwork. */}
    {classification && bleed && <span class="pcard__class pcard__class--inline">{classification}</span>}
    <h3 class="pcard__title">{name}</h3>
    {meta.length > 0 && (
      <ul class="pcard__meta">
        {meta.map((m) => <li>{m}</li>)}
      </ul>
    )}
    {/* A CARD NEVER SHOWS A BARE DASH. Defect B1-2, per-page audit 13 August
        2026: a product with no printable price rendered "—" here, which reads
        as broken rather than as honest. Every blank card on the companion hub
        and the Aiper Scuba S1 card on the pool hub were the same line.

        THE ABSENCE IS USUALLY DELIBERATE AND THAT IS THE POINT. The S1's only
        Amazon listing fails the identity register — its model field says S1
        and its part number says X5 Pro — so the product is held in a
        no-printed-price state ON PURPOSE while that reconciles. The card was
        rendering that decision as a dash. "Check current price" says the same
        thing in words a reader can act on, and it is what the review's own buy
        box already says for this exact case.

        Two states, no third: a dated figure, or this. */}
    <div class="pcard__foot">
      <span class:list={["price", { "price--unpriced": !price }]}>{price ?? "Check current price"}</span>
      <span class="pcard__go" aria-hidden="true">→</span>
    </div>
    {priceNote && <span class="pcard__note">{priceNote}</span>}
  </div>
</a>
{buyKey && (
  <a class="pcard-buy" href={`/go/${buyKey}`} rel="sponsored nofollow">
    <span>Check price on Amazon</span>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
)}
</div>

<style>
  .pcard-shell { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; }
  .pcard-shell > .pcard { flex: 1 1 auto; }

  .pcard-buy {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    min-height: 2.75rem;
    padding: 0 0.9rem 0 1.1rem;
    border-radius: 11px;
    border: 1px solid rgba(120, 176, 255, 0.55);
    background: linear-gradient(180deg, #2f7fe4 0%, #1a55b4 100%);
    color: #fff;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26), 0 6px 16px rgba(16, 60, 130, 0.35);
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }
  .pcard-buy svg { width: 1rem; height: 1rem; flex: none; }
  .pcard-buy:hover, .pcard-buy:focus-visible { transform: translateY(-1px); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 9px 22px rgba(16,60,130,.5); }
  .pcard-buy:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  .pcard {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  /* The single accent moment on a card: the edge and the affordance light up
     on intent. The card itself stays monochrome. */
  .pcard:hover,
  .pcard:focus-visible {
    transform: translateY(-3px);
    border-color: var(--accent-primary-border);
    box-shadow: inset 0 1px 0 var(--accent-primary-soft), var(--shadow-lg);
  }

  .pcard:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .pcard:active { transform: translateY(-1px); }

  /* ---- Media stage ---- */
  .pcard__stage {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    padding: var(--space-lg) var(--space-lg) var(--space-xl);
    border-bottom: 1px solid var(--border-subtle);
  }

  .pcard__sil {
    max-width: 72%;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .pcard:hover .pcard__sil { transform: translateY(-3px) scale(1.03); }

  .pcard__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .pcard:hover .pcard__img { transform: scale(1.04); }

  /* A full composition takes the whole stage: no padding to inset it, no fixed
     ratio to crop it, no hover zoom to push its own headline out of frame. The
     registry decides which images these are — see `presentation` in the asset
     record — so a packshot arriving later still lands on the lit stage above. */
  .pcard__stage:has(.pcard__img[data-bleed]) {
    aspect-ratio: auto;
    padding: 0;
    overflow: hidden;
  }

  .pcard__stage:has(.pcard__img[data-bleed]) .pcard__img {
    height: auto;
    object-fit: cover;
  }

  .pcard:hover .pcard__img[data-bleed] { transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .pcard:hover { transform: none; }
    .pcard:hover .pcard__sil,
    .pcard:hover .pcard__img { transform: none; }
  }

  /* Classification chip, pinned to the stage like an instrument label. */
  .pcard__class {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 3;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgba(6, 6, 9, 0.7);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-default);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .pcard__class--inline {
    position: static;
    align-self: start;
    margin-bottom: 2px;
    backdrop-filter: none;
    background: rgba(255, 255, 255, 0.045);
  }

  .pcard__save {
    position: absolute;
    top: var(--space-xs);
    right: var(--space-xs);
    z-index: 3;
    background: rgba(6, 6, 9, 0.7);
    backdrop-filter: blur(8px);
  }

  /* A blur costs the same whether it is 400px wide or 40px, and a grid page
     puts two of these on every card. Below 900px they go opaque: over product
     artwork at phone size the difference is not visible, and the saving is. */
  @media (max-width: 899px) {
    .pcard__class,
    .pcard__save {
      background: rgba(6, 6, 9, 0.9);
      backdrop-filter: none;
    }
  }

  /* ---- Body ---- */
  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    flex: 1;
  }

  .pcard__title {
    font-family: var(--font-display);
    font-size: var(--type-card);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-snug);
    color: var(--text-primary);
    margin: 0;
  }

  .pcard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--type-meta);
    color: var(--text-tertiary);
  }

  .pcard__meta li { margin: 0; display: flex; align-items: center; gap: var(--space-xs); }
  .pcard__meta li + li::before { content: "·"; color: var(--text-decorative); }

  .pcard__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--border-subtle);
  }

  .pcard__go {
    font-size: var(--type-body);
    color: var(--text-tertiary);
    transition: transform var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .pcard:hover .pcard__go,
  .pcard:focus-visible .pcard__go {
    transform: translateX(3px);
    color: var(--accent-primary-text);
  }

  .pcard__note {
    font-size: var(--type-meta);
    color: var(--text-quaternary);
    line-height: var(--leading-normal);
  }

  /* "Check current price" is a sentence where a figure normally sits, so it
     must not compete with a real price for weight. Smaller and quieter — it is
     an invitation, not a number. */
  .price--unpriced {
    font-size: var(--type-meta);
    font-weight: 500;
    color: var(--text-tertiary);
    letter-spacing: 0;
  }
</style>
