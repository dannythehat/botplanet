---
/* ============================================================
   BotPlanet — the review article.

   ONE TEMPLATE, EVERY REVIEW. Adding a review is two files and
   nothing else:

     1. an entry in content/reviews.ts — verdict, key facts,
        specification groups, and where the figures sit;
     2. the prose in src/reviews/<slug>.md.

   Everything on this page is assembled from those. No per-product
   layout, no per-product component, and no copy of this file.

   WHAT THE READER GETS, IN ORDER:
     verdict and four key facts, so the answer comes first
     → the prose, with figures placed under the headings they
       belong to
     → the full specification table, where an undisclosed value
       says so rather than borrowing a number
     → BotMatch, for the reader who wants the question answered
       for their own pool rather than in general
     → who wrote it and when it was last checked

   The figures are injected into the compiled Markdown rather than
   written into it — see lib/review-figures.ts for why.
   ============================================================ */
import ReviewHeader from "./ReviewHeader.astro";
import BotMatchSnapshot from "./BotMatchSnapshot.astro";
import BuyBox from "./BuyBox.astro";
import ArticleContents from "./ArticleContents.astro";
import Alternatives from "./Alternatives.astro";
import VideoSection from "./VideoSection.astro";
import SpecTable from "./SpecTable.astro";
import BotMatchCta from "./BotMatchCta.astro";
import ArticleFooter from "./ArticleFooter.astro";
import { botMatchCtaFor } from "../content/category-sections";
import { injectFigures } from "../lib/review-figures";
import { snapshotFor } from "../content/snapshots";
import { findAlternatives } from "../lib/alternatives";
import { applyInternalLinks } from "../lib/internal-linker";
import { anchorsFor } from "../content/internal-links";
import type { ReviewContent } from "../content/reviews";

interface Props {
  review: ReviewContent;
  /** Compiled Markdown for the prose, from the review's .md file. */
  html: string;
  /** Product name, for the snapshot heading. */
  productName: string;
  /** Live offers, already filtered to what may be published. */
  offers?: import("./BuyBox.astro").BuyOffer[];
  /** Sibling products, for answering the rule-outs. Catalogue facts only. */
  siblings?: import("../lib/alternatives").AlternativeCandidate[];
}

const { review, html, productName, offers = [], siblings = [] } = Astro.props;
const snapshot = snapshotFor(review.slug);
const bmCta = botMatchCtaFor(review.categorySlug);

/* Figures first, then links: the linker refuses to work inside a figure or a
   caption, so the figures have to exist before it runs for that to mean
   anything. */
const withFigures = injectFigures(html, review.figures, import.meta.env.DEV);
const { html: body } = applyInternalLinks(withFigures, anchorsFor(review.categorySlug));

/* Answers the rule-outs from the catalogue. Commission and price cannot
   reach findAlternatives — see the note at the top of lib/alternatives.ts. */
const alternatives =
  snapshot?.ruleOuts?.length && siblings.length
    ? findAlternatives(snapshot.ruleOuts, siblings, review.slug)
    : [];
---

<ReviewHeader
  eyebrow={review.eyebrow}
  title={review.title}
  verdict={review.verdict}
  bestFor={review.bestFor}
  notIdealFor={review.notIdealFor}
  image={review.image}
  facts={review.facts}
/>

{/* Before the long read, not after it: the reader who only wants the answer
    gets it here, and the reader who wants the reasoning scrolls on. */}
{snapshot && (
  <BotMatchSnapshot snapshot={snapshot} productName={productName} categorySlug={review.categorySlug} />
)}

<ArticleContents html={body} extra={[
  { id: "buy", text: "Where to buy" },
  { id: "specifications", text: "Full specification" },
]} />

<article class="bp-prose" set:html={body} />

<Alternatives matches={alternatives} categorySlug={review.categorySlug} productName={productName} />

{/* The buy box sits after the reasoning and before the specification detail:
    a reader who has decided does not have to scroll past a spec table to act,
    and one who has not is not asked to buy before the argument is made. */}
<BuyBox productName={productName} offers={offers} image={review.image ?? null} />

{review.video && <VideoSection video={review.video} productName={productName} />}

<SpecTable
  id="specifications"
  eyebrow="Specifications"
  title="The full specification"
  intro="Every figure below comes from the manufacturer's own product page for the exact SKU named underneath. Where a value is not published, it says so rather than borrowing a number from elsewhere."
  groups={review.specGroups}
  skuNote={review.skuNote}
/>

{bmCta && (
  <BotMatchCta
    categorySlug={review.categorySlug}
    headline={bmCta.headline}
    body={bmCta.body}
    points={bmCta.points}
    ctaLabel={bmCta.ctaLabel}
    note={bmCta.note}
    image={bmCta.image}
  />
)}

<ArticleFooter lastReviewed={review.lastReviewed} />

<style is:global>
  /* Long-form review prose. Measure is the whole point — anything
     wider than about 70 characters gets tiring on a big screen. */
  .bp-prose {
    max-width: 70ch;
    margin: 0 0 clamp(3rem, 7vw, 5rem);
  }

  /* A milled rule above every section heading, so the article reads as a
     stack of parts rather than one continuous column of text. Bright at the
     left where the eye starts and fading out to the right — a full-width line
     of even weight reads as a table border, not a divider. */
  .bp-prose h2::before {
    content: "";
    display: block;
    height: 2px;
    width: min(100%, 30rem);
    margin-bottom: clamp(1.4rem, 3vw, 2rem);
    border-radius: 2px;
    background: linear-gradient(
      90deg,
      rgba(246, 248, 252, 0.85) 0%,
      rgba(200, 208, 222, 0.5) 18%,
      rgba(160, 170, 186, 0.28) 40%,
      rgba(140, 150, 166, 0.1) 68%,
      transparent 100%
    );
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.5);
  }

  /* The first heading follows the snapshot plate, which already separates it. */
  .bp-prose > h2:first-child::before { display: none; }

  .bp-prose h2 {
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.45rem, 3.8vw, 1.9rem);
    line-height: 1.18;
    letter-spacing: -0.018em;
    text-wrap: balance;
    color: var(--cs-hi);
  }

  .bp-prose h3 {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.08rem, 2.4vw, 1.2rem);
    line-height: 1.28;
    color: var(--cs-hi);
  }

  .bp-prose p {
    margin: 1.05rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  /* An internal link inside the prose: underlined on a metallic hairline so
     it is visibly a link without shouting, and brightening on hover. */
  .bp-prose__link {
    color: var(--cs-hi);
    text-decoration: none;
    border-bottom: 1px solid rgba(200, 208, 222, 0.42);
    padding-bottom: 1px;
    transition: border-color 0.18s ease, color 0.18s ease;
  }

  .bp-prose__link:hover { color: #fff; border-color: rgba(246, 248, 252, 0.9); }
  .bp-prose__link:focus-visible { outline: var(--focus-ring, 2px solid #dfe4ec); outline-offset: 2px; }

  .bp-prose strong { color: var(--cs-hi); font-weight: 600; }
  .bp-prose em { color: var(--cs-mid); }

  .bp-prose ul { margin: 1.1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; }

  .bp-prose li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 1.0625rem;
    line-height: 1.66;
    color: var(--text-secondary);
  }

  .bp-prose li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.38rem;
    height: 0.38rem;
    transform: rotate(45deg);
    background: var(--cs-sheen);
  }

  .bp-prose hr {
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--cs-line), transparent 70%);
  }

  .bp-prose blockquote {
    margin: 1.5rem 0 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--cs-line);
    color: var(--cs-mid);
  }

  /* ---------- in-body figures ---------- */

  /* Framed like every other plate on the site, and allowed to run a little
     wider than the text measure — the prose is set at 70ch for reading, and a
     picture held to that width looks like an afterthought beside it. */
  .bp-prose .bp-figure {
    margin: clamp(1.6rem, 4vw, 2.2rem) 0 0;
    width: min(100%, 44rem);
    border: 1px solid var(--cs-line);
    border-radius: 18px;
    overflow: hidden;
    background: var(--cs-surface);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 22px 50px rgba(0, 0, 0, 0.45);
  }

  .bp-prose .bp-figure img { display: block; width: 100%; height: auto; }

  .bp-prose .bp-figure__cap {
    margin: 0;
    padding: 0.85rem 1.1rem 1rem;
    border-top: 1px solid var(--cs-line-soft);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-tertiary);
  }

  @media (min-width: 900px) {
    .bp-prose p, .bp-prose li { font-size: 1.1rem; }
  }
</style>
