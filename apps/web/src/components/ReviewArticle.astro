---
/* ============================================================
   BotPlanet — the review article.

   ONE TEMPLATE, EVERY REVIEW. Adding a review is two files and
   nothing else:

     1. an entry in content/reviews.ts — verdict, key facts,
        specification groups, and where the figures sit;
     2. the prose in src/reviews/<slug>.md.

   Everything on this page is assembled from those. No per-product
   layout, no per-product component, and no copy of this file.

   WHAT THE READER GETS, IN ORDER:
     verdict and four key facts, so the answer comes first
     → the prose, with figures placed under the headings they
       belong to
     → the full specification table, where an undisclosed value
       says so rather than borrowing a number
     → BotMatch, for the reader who wants the question answered
       for their own pool rather than in general
     → who wrote it and when it was last checked

   The figures are injected into the compiled Markdown rather than
   written into it — see lib/review-figures.ts for why.
   ============================================================ */
import ReviewHeader from "./ReviewHeader.astro";
import BotMatchSnapshot from "./BotMatchSnapshot.astro";
import BuyBox from "./BuyBox.astro";
import BuyStrip from "./BuyStrip.astro";
import ArticleContents from "./ArticleContents.astro";
import Alternatives from "./Alternatives.astro";
import VideoSection from "./VideoSection.astro";
import SpecTable from "./SpecTable.astro";
import BotMatchCta from "./BotMatchCta.astro";
import ArticleFooter from "./ArticleFooter.astro";
import { botMatchCtaFor } from "../content/category-sections";
import { injectFigures } from "../lib/review-figures";
import { foldSections } from "../lib/collapsible-sections";
import { snapshotFor } from "../content/snapshots";
import { findAlternatives } from "../lib/alternatives";
import { applyInternalLinks } from "../lib/internal-linker";
import { anchorsFor } from "../content/internal-links";
import type { ReviewContent } from "../content/reviews";

interface Props {
  review: ReviewContent;
  /** Compiled Markdown for the prose, from the review's .md file. */
  html: string;
  /** Product name, for the snapshot heading. */
  productName: string;
  /** Live offers, already filtered to what may be published. */
  offers?: import("./BuyBox.astro").BuyOffer[];
  /** Sibling products, for answering the rule-outs. Catalogue facts only. */
  siblings?: import("../lib/alternatives").AlternativeCandidate[];
}

const { review, html, productName, offers = [], siblings = [] } = Astro.props;
const snapshot = snapshotFor(review.slug);
const bmCta = botMatchCtaFor(review.categorySlug);

/* Figures first, then links: the linker refuses to work inside a figure or a
   caption, so the figures have to exist before it runs for that to mean
   anything. */
const withFigures = injectFigures(html, review.figures, import.meta.env.DEV);
const { html: linked } = applyInternalLinks(
  withFigures,
  anchorsFor(review.categorySlug),
  `/robots/${review.categorySlug}/${review.slug}/`,
);

/* Folding runs last, on the finished HTML. It only moves markup around — it
   does not rewrite text — so the linker and the figure injector never see the
   <details> wrappers and cannot trip over them.

   The contents list is built from `linked`, not from `body`: it needs every
   heading in the article, including the ones that ship shut. */
const { html: body } = foldSections(linked, review.folds, import.meta.env.DEV);

/* Answers the rule-outs from the catalogue. Commission and price cannot
   reach findAlternatives — see the note at the top of lib/alternatives.ts. */
const lead = offers.find((o) => o.redirectKey) ?? null;

const alternatives =
  snapshot?.ruleOuts?.length && siblings.length
    ? findAlternatives(snapshot.ruleOuts, siblings, review.slug)
    : [];
---

<ReviewHeader
  eyebrow={review.eyebrow}
  title={review.title}
  verdict={review.verdict}
  bestFor={review.bestFor}
  notIdealFor={review.notIdealFor}
  image={review.image}
  facts={review.facts}
/>

{/* Before the long read, not after it: the reader who only wants the answer
    gets it here, and the reader who wants the reasoning scrolls on. */}
{snapshot && (
  <BotMatchSnapshot snapshot={snapshot} productName={productName} categorySlug={review.categorySlug} />
)}

{lead?.redirectKey && (
  <BuyStrip
    retailerName={lead.retailerName}
    redirectKey={lead.redirectKey}
    line="Read the snapshot and it already sounds like your pool? The current price and delivery are one tap away."
  />
)}

{/* Video sits here, not at the foot of the page. Someone deciding wants to see
    the machine handled BEFORE working through two thousand words, and a
    section nobody scrolls to may as well not exist. */}
{review.video && <VideoSection video={review.video} productName={productName} />}

<ArticleContents html={linked} extra={[
  { id: "buy", text: "Where to buy" },
  { id: "specifications", text: "Full specification" },
]} />

<article class="bp-prose" set:html={body} />

{lead?.redirectKey && (
  <BuyStrip
    tone="strong"
    retailerName={lead.retailerName}
    redirectKey={lead.redirectKey}
    line="That is the whole case, good and bad. If it still fits your pool, here is where to get it."
  />
)}

<Alternatives matches={alternatives} categorySlug={review.categorySlug} productName={productName} />

{/* The buy box sits after the reasoning and before the specification detail:
    a reader who has decided does not have to scroll past a spec table to act,
    and one who has not is not asked to buy before the argument is made. */}
<BuyBox productName={productName} offers={offers} image={review.image ?? null} />

<SpecTable
  id="specifications"
  eyebrow="Specifications"
  title="The full specification"
  intro="Every figure below comes from the manufacturer's own product page for the exact SKU named underneath. Where a value is not published, it says so rather than borrowing a number from elsewhere."
  groups={review.specGroups}
  skuNote={review.skuNote}
/>

{bmCta && (
  <BotMatchCta
    categorySlug={review.categorySlug}
    headline={bmCta.headline}
    body={bmCta.body}
    points={bmCta.points}
    ctaLabel={bmCta.ctaLabel}
    note={bmCta.note}
    image={bmCta.image}
  />
)}

<ArticleFooter lastReviewed={review.lastReviewed} />

<script>
  /* A contents link that lands on a shut door is worse than no link: the
     heading is in the <summary>, so the jump resolves and the reader arrives
     at a section that looks empty. Open it on the way. Also covers arriving
     on the page with the fragment already in the URL, which is how anyone
     following a link from search or from another page gets here. */
  const openTarget = (hash: string) => {
    if (!hash || hash.length < 2) return;
    let el: Element | null = null;
    try {
      el = document.querySelector(hash);
    } catch {
      return; // a hash that is not a valid selector is not ours to handle
    }
    const fold = el?.closest("details.bp-fold");
    if (fold instanceof HTMLDetailsElement) fold.open = true;
  };

  document.addEventListener("click", (e) => {
    const a = (e.target as Element | null)?.closest?.("a[href^='#']");
    if (a instanceof HTMLAnchorElement) openTarget(a.hash);
  });

  window.addEventListener("hashchange", () => openTarget(location.hash));

  if (location.hash) {
    openTarget(location.hash);
    /* Opening changes the page height, so the browser's own scroll to the
       fragment — which already happened — is now pointing at the wrong
       place. Re-run it once the layout has settled. */
    requestAnimationFrame(() => document.querySelector(location.hash)?.scrollIntoView());
  }

  /* Nothing here for find-in-page: Chrome expands a <details> to reveal a
     match on its own, and no amount of script makes Safari or Firefox do the
     same. Using the native element is what buys that behaviour — a div with
     a click handler would have lost it. */
</script>

<style is:global>
  /* SCROLL COST.
     Six full-width plates down one page, each with a 50-70px blurred shadow,
     is six large rasters the compositor keeps alive whether or not they are on
     screen. content-visibility lets the browser skip layout and paint entirely
     for the ones that are not, and contain-intrinsic-size keeps the scrollbar
     honest so the page does not jump as you go. */
  .bp-snap,
  .bp-buy,
  .bp-vid,
  .bp-alt,
  .bp-spec,
  .bp-bmcta {
    content-visibility: auto;
    contain-intrinsic-size: auto 34rem;
  }

  /* Long-form review prose. Measure is the whole point — anything
     wider than about 70 characters gets tiring on a big screen. */
  .bp-prose {
    max-width: 70ch;
    margin: 0 0 clamp(3rem, 7vw, 5rem);
  }

  /* A milled rule above every section heading, so the article reads as a
     stack of parts rather than one continuous column of text. Bright at the
     left where the eye starts and fading out to the right — a full-width line
     of even weight reads as a table border, not a divider. */
  .bp-prose h2::before {
    content: "";
    display: block;
    height: 2px;
    width: min(100%, 30rem);
    margin-bottom: clamp(1.4rem, 3vw, 2rem);
    border-radius: 2px;
    /* The glint sits at the left, where the rule is brightest and the eye
       starts. It reads as a reflection catching the leading edge, and it is
       the one piece of colour in an otherwise silver column. */
    background: linear-gradient(
      90deg,
      rgba(246, 248, 252, 0.9) 0%,
      rgba(61, 142, 240, 0.55) 7%,
      rgba(200, 208, 222, 0.5) 20%,
      rgba(160, 170, 186, 0.28) 42%,
      rgba(140, 150, 166, 0.1) 68%,
      transparent 100%
    );
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.5);
  }

  /* The first heading follows the snapshot plate, which already separates it. */
  .bp-prose > h2:first-child::before { display: none; }

  .bp-prose h2 {
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.45rem, 3.8vw, 1.9rem);
    line-height: 1.18;
    letter-spacing: -0.018em;
    text-wrap: balance;
    color: var(--cs-hi);
  }

  .bp-prose h3 {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.08rem, 2.4vw, 1.2rem);
    line-height: 1.28;
    color: var(--cs-hi);
  }

  .bp-prose p {
    margin: 1.05rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  /* An internal link inside the prose: underlined on a metallic hairline so
     it is visibly a link without shouting, and brightening on hover. */
  .bp-prose__link {
    color: var(--cs-hi);
    text-decoration: none;
    border-bottom: 1px solid rgba(200, 208, 222, 0.42);
    padding-bottom: 1px;
    transition: border-color 0.18s ease, color 0.18s ease;
  }

  .bp-prose__link:hover { color: #fff; border-color: rgba(246, 248, 252, 0.9); }
  .bp-prose__link:focus-visible { outline: var(--focus-ring, 2px solid #dfe4ec); outline-offset: 2px; }

  .bp-prose strong { color: var(--cs-hi); font-weight: 600; }
  .bp-prose em { color: var(--cs-mid); }

  .bp-prose ul { margin: 1.1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; }

  .bp-prose li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 1.0625rem;
    line-height: 1.66;
    color: var(--text-secondary);
  }

  .bp-prose li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.38rem;
    height: 0.38rem;
    transform: rotate(45deg);
    background: var(--cs-sheen);
  }

  .bp-prose hr {
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--cs-line), transparent 70%);
  }

  .bp-prose blockquote {
    margin: 1.5rem 0 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--cs-line);
    color: var(--cs-mid);
  }

  /* ---------- folded sections ---------- */

  /* A shut section has to look like a door, not like a heading someone
     forgot to write under. It gets a plate, a chevron and a teaser line —
     three signals, because one is missed on a phone. */
  .bp-prose .bp-fold {
    margin: clamp(1.6rem, 4vw, 2.2rem) 0 0;
    border: 1px solid var(--cs-line-soft);
    border-radius: 16px;
    background: linear-gradient(178deg, rgba(20, 25, 32, 0.72), rgba(10, 13, 17, 0.72));
    scroll-margin-top: 5.5rem;
  }

  .bp-prose .bp-fold[open] {
    border-color: var(--cs-line);
    background: linear-gradient(178deg, rgba(20, 25, 32, 0.5), transparent 22%);
  }

  .bp-prose .bp-fold__sum {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.4rem 1rem;
    padding: clamp(1rem, 2.6vw, 1.3rem) clamp(1.1rem, 3vw, 1.5rem);
    cursor: pointer;
    list-style: none;
    border-radius: 15px;
  }

  /* Safari draws its own triangle unless this is said in its own dialect. */
  .bp-prose .bp-fold__sum::-webkit-details-marker { display: none; }

  .bp-prose .bp-fold__sum:hover { background: rgba(255, 255, 255, 0.03); }
  .bp-prose .bp-fold__sum:focus-visible { outline: var(--focus-ring, 2px solid #dfe4ec); outline-offset: 2px; }

  /* The milled rule above every other H2 would draw a line across the inside
     of the plate. Inside a summary the plate edge already does that job. */
  .bp-prose .bp-fold__h { margin: 0; font-size: clamp(1.2rem, 3.2vw, 1.5rem); }
  .bp-prose .bp-fold__h::before { display: none; }

  .bp-prose .bp-fold__teaser {
    grid-column: 1;
    margin-top: 0.3rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-tertiary);
  }

  .bp-prose .bp-fold[open] .bp-fold__teaser { display: none; }

  .bp-prose .bp-fold__chev {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    border: 1px solid var(--cs-line);
    border-radius: 50%;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.09), transparent),
      var(--cs-surface);
    position: relative;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .bp-prose .bp-fold__chev::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--cs-hi);
    border-bottom: 2px solid var(--cs-hi);
    transform: translateY(-2px) rotate(45deg);
  }

  .bp-prose .bp-fold[open] .bp-fold__chev { transform: rotate(180deg); }

  /* The door lights up cold when you reach for it. */
  .bp-prose .bp-fold__sum:hover .bp-fold__chev {
    border-color: rgba(61, 142, 240, 0.7);
    box-shadow: 0 0 12px rgba(61, 142, 240, 0.2);
  }

  .bp-prose .bp-fold[open] { box-shadow: inset 2px 0 0 rgba(61, 142, 240, 0.35); }

  .bp-prose .bp-fold__body {
    padding: 0 clamp(1.1rem, 3vw, 1.5rem) clamp(1.2rem, 3vw, 1.6rem);
  }

  /* The first paragraph inside an opened fold already has the summary above
     it; the standard top margin doubles the gap. */
  .bp-prose .bp-fold__body > :first-child { margin-top: 0.4rem; }

  @media (prefers-reduced-motion: reduce) {
    .bp-prose .bp-fold__chev { transition: none; }
  }

  /* ---------- in-body figures ---------- */

  /* Framed like every other plate on the site, and allowed to run a little
     wider than the text measure — the prose is set at 70ch for reading, and a
     picture held to that width looks like an afterthought beside it. */
  .bp-prose .bp-figure {
    margin: clamp(1.6rem, 4vw, 2.2rem) 0 0;
    width: min(100%, 44rem);
    border: 1px solid var(--cs-line);
    border-radius: 18px;
    overflow: hidden;
    background: var(--cs-surface);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 22px 34px rgba(0, 0, 0, 0.45);
  }

  .bp-prose .bp-figure img { display: block; width: 100%; height: auto; }

  .bp-prose .bp-figure__cap {
    margin: 0;
    padding: 0.85rem 1.1rem 1rem;
    border-top: 1px solid var(--cs-line-soft);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-tertiary);
  }

  @media (min-width: 900px) {
    .bp-prose p, .bp-prose li { font-size: 1.1rem; }
  }
</style>
