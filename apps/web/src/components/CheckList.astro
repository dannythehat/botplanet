---
/* ============================================================
   BotPlanet — Checklist section (section head + boxed checklist)

   The "check these before you buy" panel, reusable on every
   category page.

   A fifth element type. Unlike the coverage section, which gives
   every row its own panel, this is a single framed box with the
   items divided inside it — so it reads as one checklist rather
   than a set of separate points.

   Each item pairs the explanation with the exact question to ask,
   which is what turns a specification into a decision.
   ============================================================ */

import SectionHead from "./SectionHead.astro";

export interface CheckItem {
  /** The H3, e.g. "Filter access and maintenance". */
  title: string;
  /** Two or three sentences on why it matters in practice. */
  body: string;
  /** The exact question to ask before buying. */
  ask: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro: string;
  /** Label across the top of the box. */
  boxLabel?: string;
  items: CheckItem[];
}

const { id, eyebrow, title, intro, boxLabel = "Check these before buying", items } = Astro.props;
---

<section class="bp-chk" id={id}>
  <SectionHead eyebrow={eyebrow} title={title} intro={intro} />

  <div class="bp-chk__box">
    <p class="bp-chk__boxlabel">{boxLabel}</p>

    <ol class="bp-chk__list">
      {items.map((item) => (
        <li class="bp-chk__item">
          <span class="bp-chk__mark" aria-hidden="true"></span>
          <div class="bp-chk__content">
            <h3 class="bp-chk__title">{item.title}</h3>
            <p class="bp-chk__body">{item.body}</p>
            <p class="bp-chk__ask">
              <span class="bp-chk__ask-label">Ask</span>
              {item.ask}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .bp-chk {
    /* Outer spacing, padding, border and background come from the section
       plate rule in metal-theme.css, so every section shares one rhythm. */
  }

  /* ---------- the box ---------- */
  .bp-chk__box {
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--cs-line);
    border-radius: 16px;
    overflow: hidden;
    background: var(--cs-surface-lift);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 22px 34px rgba(0, 0, 0, 0.46);
  }

  .bp-chk__box::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(246, 248, 252, 0.5) 26%,
      rgba(246, 248, 252, 0.72) 50%,
      rgba(246, 248, 252, 0.42) 74%,
      transparent
    );
  }

  .bp-chk__boxlabel {
    margin: 0 0 clamp(1.35rem, 3vw, 1.85rem);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    background: var(--cs-sheen);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ---------- items ---------- */
  .bp-chk__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bp-chk__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.95rem;
    padding: clamp(1.25rem, 3vw, 1.6rem) 0;
    border-top: 1px solid var(--cs-line-soft);
  }

  .bp-chk__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .bp-chk__item:last-child {
    padding-bottom: 0;
  }

  /* chrome check-square */
  .bp-chk__mark {
    position: relative;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.12rem;
    flex: none;
    border: 1px solid var(--cs-line);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
  }

  .bp-chk__mark::after {
    content: "";
    position: absolute;
    left: 0.4rem;
    top: 0.22rem;
    width: 0.32rem;
    height: 0.62rem;
    border-right: 1.5px solid var(--cs-hi);
    border-bottom: 1.5px solid var(--cs-hi);
    transform: rotate(42deg);
  }

  .bp-chk__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.08rem, 2.2vw, 1.22rem);
    line-height: 1.24;
    letter-spacing: -0.012em;
    color: var(--cs-hi);
  }

  .bp-chk__body {
    margin: 0.55rem 0 0;
    font-size: 0.99rem;
    line-height: 1.62;
    color: var(--text-secondary);
  }

  /* the question to ask, set apart from the explanation */
  .bp-chk__ask {
    margin: 0.9rem 0 0;
    padding-left: 0.9rem;
    border-left: 2px solid var(--cs-line);
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--cs-mid);
  }

  .bp-chk__ask-label {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-quaternary);
  }

  /* ---------- wider screens ---------- */
  @media (min-width: 860px) {
    .bp-chk__item {
      gap: 1.35rem;
    }

    .bp-chk__body,
    .bp-chk__ask {
      max-width: 68ch;
    }
  }
</style>
