---
/* ============================================================
   BotPlanet — article contents.

   Twelve sections and 2,000-odd words with no way to navigate is a
   page that only rewards the reader who starts at the top and never
   stops. Most do not: they arrive with one question, and the section
   that answers it is four screens down.

   Built from the prose itself, not from a hand-written list. A
   contents block that has to be maintained alongside the writing is
   a contents block that goes stale, and a stale one is worse than
   none because it links to sections that moved.

   It renders nothing below four headings — a list of three is not
   navigation, it is clutter.
   ============================================================ */

interface Props {
  /** Compiled prose. Headings are read from it. */
  html: string;
  /** Extra destinations that are not H2s in the prose. */
  extra?: { id: string; text: string }[];
  /** Destinations that come before the prose headings, for a page whose picks lead. */
  before?: { id: string; text: string }[];
}

const { html, extra = [], before = [] } = Astro.props;

/**
 * Astro's markdown pipeline gives every heading an id, so this reads what is
 * actually in the document rather than re-slugifying the text and hoping the
 * two agree.
 */
const headings = [...html.matchAll(/<h2\b[^>]*\bid="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map((m) => ({
  id: m[1],
  text: m[2].replace(/<[^>]+>/g, "").trim(),
}));

const items = [...before, ...headings, ...extra];
const show = headings.length >= 4;
---

{show && (
  <nav class="bp-toc" aria-labelledby="toc-heading">
    {/* SHUT ON A PHONE, OPEN ON A DESKTOP.
        Fourteen rows is roughly a full phone screen of links standing
        between the reader and the first sentence of the article — and it
        is the same fourteen rows whether or not they wanted to navigate.
        <details open> plus a media query that removes the disclosure
        behaviour above 760px gives both without duplicating the markup or
        shipping a script. */}
    {/* Ships open. Without script — and on every desktop — a table of
        contents that cannot be opened is worse than one that is always
        shown, so the fallback is "shown" and the script only ever shuts it. */}
    <details class="bp-toc__fold" open>
      <summary class="bp-toc__sum">
        <span class="bp-toc__title" id="toc-heading">In this review</span>
        <span class="bp-toc__count">{items.length} sections</span>
        <span class="bp-toc__chev" aria-hidden="true"></span>
      </summary>
      <ol class="bp-toc__list">
        {items.map((h, i) => (
          <li>
            <a href={`#${h.id}`}>
              <span class="bp-toc__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="bp-toc__text">{h.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}

<script>
  /* Shuts the list on a phone, where fourteen rows is a screen of links
     standing between the reader and the article. With no script at all the
     markup's own `open` stands, which is the right way round: an always-open
     contents list is merely long, an always-shut one is broken.

     `touched` stops the breakpoint from overruling a reader who worked the
     control themselves — rotating a phone should not undo a tap. */
  const narrow = window.matchMedia("(max-width: 759px)");
  document.querySelectorAll<HTMLDetailsElement>(".bp-toc__fold").forEach((d) => {
    let touched = false;
    let mine = false;
    /* `toggle` is queued, not synchronous, so a flag set around the
       assignment would already be back to false by the time it fires. It is
       cleared in the handler instead. */
    d.addEventListener("toggle", () => {
      if (mine) mine = false;
      else touched = true;
    });
    const sync = () => {
      if (touched || d.open !== narrow.matches) return;
      mine = true;
      d.open = !narrow.matches;
    };
    sync();
    narrow.addEventListener("change", sync);
  });
</script>

<style is:global>
  .bp-toc {
    margin: clamp(2rem, 5vw, 3rem) 0;
    border: 1px solid var(--cs-line-soft);
    border-radius: 18px;
    background: var(--cs-surface);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .bp-toc__sum {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: clamp(1rem, 2.6vw, 1.2rem) clamp(1.2rem, 3vw, 1.7rem);
    cursor: pointer;
    list-style: none;
    border-radius: 17px;
  }

  .bp-toc__sum::-webkit-details-marker { display: none; }
  .bp-toc__sum:focus-visible { outline: var(--focus-ring, 2px solid #dfe4ec); outline-offset: 2px; }

  .bp-toc__count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text-quaternary);
  }

  .bp-toc__chev {
    position: relative;
    width: 1.6rem;
    height: 1.6rem;
    flex: 0 0 auto;
    border: 1px solid var(--cs-line-soft);
    border-radius: 50%;
    transition: transform 0.18s ease;
  }

  .bp-toc__chev::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0.42rem;
    height: 0.42rem;
    border-right: 2px solid var(--cs-mid);
    border-bottom: 2px solid var(--cs-mid);
    transform: translateY(-2px) rotate(45deg);
  }

  .bp-toc__fold[open] .bp-toc__chev { transform: rotate(180deg); }

  .bp-toc__title {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: var(--cs-sheen);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bp-toc__list {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0 clamp(0.7rem, 2vw, 1.2rem) clamp(1rem, 2.4vw, 1.3rem);
    list-style: none;
    counter-reset: none;
  }

  .bp-toc__list a {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    padding: 0.5rem 0.6rem;
    border-radius: 9px;
    text-decoration: none;
    transition: background 0.16s ease;
  }

  .bp-toc__list a:hover { background: rgba(255, 255, 255, 0.04); }
  .bp-toc__list a:focus-visible { outline: var(--focus-ring, 2px solid #dfe4ec); outline-offset: 2px; }

  .bp-toc__num {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-quaternary);
  }

  .bp-toc__text {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .bp-toc__list a:hover .bp-toc__text { color: var(--cs-hi); }

  /* Headings need clearance so a jump does not land them under the sticky
     header — the commonest bug in any table of contents. */
  .bp-prose h2 { scroll-margin-top: 5.5rem; }

  @media (min-width: 760px) {
    .bp-toc__list { grid-template-columns: 1fr 1fr; column-gap: 1.5rem; }

    /* There is room for the list on a wide screen, so there is no reason to
       make anyone ask for it. The control disappears rather than sitting
       there permanently open, which would only read as broken. */
    .bp-toc__sum { cursor: default; padding-bottom: 0.4rem; }
    .bp-toc__chev, .bp-toc__count { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-toc__chev { transition: none; }
  }
</style>
