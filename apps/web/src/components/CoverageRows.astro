---
/* ============================================================
   BotPlanet — Coverage section (section head + labelled rows)

   Same fixed shape as the decision section, different element
   on purpose: rows on their own panels rather than a card grid,
   so the page keeps a visual rhythm instead of repeating one
   component down the screen.

   Each row carries a real H3, so the sub-topics are headings in
   their own right. The image is optional.
   ============================================================ */

import SectionHead from "./SectionHead.astro";
import type { HeroImage } from "./CategoryHero.astro";

export interface CoverageRow {
  /** The H3, e.g. "Wall and waterline cleaning". */
  title: string;
  /** One short line: who genuinely needs this. */
  whoFor: string;
  /** Two to four sentences. */
  body: string;
  /**
   * Optional thumbnail for this row.
   *
   * Renders small and square beside the heading, so it has to be a tight
   * detail shot with one subject — a scene shrunk to 96px is a grey smudge.
   * The row is complete without it and lays out identically when absent.
   */
  image?: HeroImage;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro: string;
  /** Optional supporting visual, shown above the rows. */
  image?: HeroImage;
  rows: CoverageRow[];
}

const { id, eyebrow, title, intro, image, rows } = Astro.props;

import { srcsetFor } from "../lib/srcset";
---

<section class="bp-cov" id={id}>
  <SectionHead eyebrow={eyebrow} title={title} intro={intro} />

  {image?.src && (
    <figure class="bp-cov__figure">
      <picture>
        {image.mobileSrc && <source media="(max-width: 719px)" srcset={srcsetFor(image.mobileSrc) ?? image.mobileSrc} sizes="100vw" />}
        <img
          src={image.src}
          srcset={srcsetFor(image.src)}
          sizes="(min-width: 900px) 1100px, 100vw"
          alt={image.alt}
          style={image.focal ? `object-position: ${image.focal}` : undefined}
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>
  )}

  <div class="bp-cov__rows">
    {rows.map((row) => (
      <article class={row.image?.src ? "bp-crow bp-crow--img" : "bp-crow"}>
        {row.image?.src && (
          <img
            class="bp-crow__thumb"
            src={row.image.src}
            srcset={srcsetFor(row.image.src)}
            sizes="112px"
            alt={row.image.alt}
            style={row.image.focal ? `object-position: ${row.image.focal}` : undefined}
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="bp-crow__label">
          <h3 class="bp-crow__title">{row.title}</h3>
          <span class="bp-crow__who">{row.whoFor}</span>
        </div>
        <p class="bp-crow__body">{row.body}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .bp-cov {
    /* Outer spacing, padding, border and background come from the section
       plate rule in metal-theme.css, so every section shares one rhythm. */
  }

  /* ---------- optional visual ---------- */
  .bp-cov__figure {
    margin: 0 0 clamp(1.5rem, 3.5vw, 2.25rem);
    border: 1px solid var(--cs-line);
    border-radius: 16px;
    overflow: hidden;
    background: var(--cs-surface);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.055),
      0 22px 34px rgba(0, 0, 0, 0.44);
  }

  .bp-cov__figure img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* ---------- rows ---------- */
  .bp-cov__rows {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.15rem);
  }

  .bp-crow {
    position: relative;
    display: grid;
    gap: 0.85rem;
    padding: clamp(1.5rem, 3.6vw, 2rem);
    border: 1px solid var(--cs-line-soft);
    border-radius: 14px;
    background: var(--cs-surface);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.34);
  }

  /* vertical chrome rail marking each zone */
  .bp-crow::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.35rem;
    bottom: 1.35rem;
    width: 2px;
    border-radius: 0 2px 2px 0;
    background: linear-gradient(180deg, var(--cs-hi), rgba(138, 146, 161, 0.14));
  }

  /* With a thumbnail the row becomes two columns: picture, then the label and
     body stacked beside it. Without one the grid is untouched, which is what
     keeps an image optional rather than load-bearing. */
  .bp-crow--img {
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "thumb label"
      "thumb body";
    align-items: start;
    column-gap: clamp(1rem, 2.4vw, 1.4rem);
  }
  .bp-crow--img .bp-crow__label { grid-area: label; }
  .bp-crow--img .bp-crow__body { grid-area: body; }

  .bp-crow__thumb {
    grid-area: thumb;
    display: block;
    width: clamp(72px, 11vw, 112px);
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--cs-line);
    border-radius: 12px;
    background: var(--cs-surface);
  }

  /* On a narrow screen the two-column split leaves the body about twelve
     characters wide, so the picture goes back above the text. */
  @media (max-width: 560px) {
    .bp-crow--img {
      grid-template-columns: 1fr;
      grid-template-areas: "thumb" "label" "body";
    }
  }

  .bp-crow__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 2.3vw, 1.3rem);
    line-height: 1.22;
    letter-spacing: -0.012em;
    color: var(--cs-hi);
  }

  /* proper tag, not terminal text */
  .bp-crow__who {
    display: inline-block;
    margin-top: 0.65rem;
    padding: 0.32rem 0.68rem;
    border: 1px solid var(--cs-line);
    border-radius: 999px;
    font-size: 0.78rem;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: var(--cs-mid);
    background: rgba(255, 255, 255, 0.022);
  }

  .bp-crow__body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.66;
    color: var(--text-secondary);
  }

  /* ---------- wider screens ---------- */
  @media (min-width: 880px) {
    .bp-crow {
      grid-template-columns: 17rem 1fr;
      gap: clamp(1.75rem, 4vw, 3.25rem);
      align-items: start;
      padding: clamp(1.75rem, 3vw, 2.25rem);
    }

    .bp-crow__body {
      max-width: 64ch;
      padding-top: 0.15rem;
    }
  }
</style>
