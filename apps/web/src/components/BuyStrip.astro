---
/* ============================================================
   BotPlanet — the inline buy strip.

   ONE LINK AT THE BOTTOM IS A LINK MOST READERS NEVER SEE. A
   review is not read front to back: people land mid-page from
   search, skim to the section that answers their question, decide
   there, and look for a way to act. If the only way to act is four
   screens further down, they leave and buy somewhere else.

   So this is the compact version of the buy box, placed wherever
   a reader is likely to have decided. Same destination, same
   tracked /go route, same rel="sponsored nofollow", same
   disclosure obligation — it is a shortcut, not a second offer.

   WHAT IT DOES NOT DO. Repeat the price. The buy box carries the
   price with the date it was checked; printing a figure at three
   points on one page means three chances to be stale and no way to
   tell which is current.
   ============================================================ */

interface Props {
  retailerName: string;
  redirectKey: string;
  /** Why this reader, at this point on the page, might act now. */
  line: string;
  /** Compact enough to sit inside prose. */
  tone?: "inline" | "strong";
}

const { retailerName, redirectKey, line, tone = "inline" } = Astro.props;
---

<aside class="bp-strip" data-tone={tone}>
  <p class="bp-strip__line">{line}</p>
  <a class="bp-strip__cta" href={`/go/${redirectKey}`} rel="sponsored nofollow">
    <span>Check price on {retailerName}</span>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</aside>

<style is:global>
  .bp-strip {
    display: grid;
    gap: 0.9rem;
    align-items: center;
    margin: clamp(1.6rem, 4vw, 2.2rem) 0;
    padding: clamp(1rem, 2.6vw, 1.3rem) clamp(1.1rem, 3vw, 1.5rem);
    border: 1px solid rgba(120, 168, 240, 0.34);
    border-left: 3px solid #2f7fe4;
    border-radius: 14px;
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(47, 127, 228, 0.12), transparent 62%),
      linear-gradient(178deg, #12171f 0%, #0a0d11 100%);
  }

  .bp-strip__line {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .bp-strip__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
    min-height: 2.9rem;
    padding: 0 0.95rem 0 1.2rem;
    border-radius: 11px;
    border: 1px solid rgba(120, 176, 255, 0.55);
    background: linear-gradient(180deg, #2f7fe4 0%, #1a55b4 100%);
    color: #fff;
    font-weight: 700;
    font-size: 0.93rem;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26), 0 6px 16px rgba(16, 60, 130, 0.4);
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }

  .bp-strip__cta svg { width: 1rem; height: 1rem; flex: 0 0 auto; }
  .bp-strip__cta:hover { transform: translateY(-1px); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 10px 22px rgba(16,60,130,.5); }
  .bp-strip__cta:focus-visible { outline: var(--focus-ring, 2px solid #dfe4ec); outline-offset: 3px; }

  @media (min-width: 620px) {
    .bp-strip { grid-template-columns: 1fr auto; gap: 1.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-strip__cta, .bp-strip__cta:hover { transform: none; transition: none; }
  }
</style>
