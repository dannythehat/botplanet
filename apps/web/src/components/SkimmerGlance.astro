---
/* ============================================================
   BotPlanet — the four solar skimmers at a glance.

   WHY THIS IS A COMPONENT AND NOT A MARKDOWN TABLE. It was a Markdown table
   first, and it shipped looking like a spreadsheet pasted into a column: the
   prose column is about 600px wide, six columns do not fit in it, and the
   fourth machine sat behind a horizontal scrollbar. A comparison the reader
   has to scroll sideways to finish is not a comparison. This one takes the
   page's full width, shows each machine with its picture and a buy button, and
   turns into stacked cards on a phone, the same way ComparisonTable does.

   EVERY FIGURE HERE IS THE MAKER'S OWN CLAIM, and a cell that says "Not stated"
   means we did not find the figure in what we read. Nothing is estimated and
   nothing is borrowed from a sibling model.
   ============================================================ */
import ProductImage from "./ProductImage.astro";
import type { ComparisonRow } from "./ComparisonTable.astro";

interface Props {
  rows: ComparisonRow[];
}
const { rows } = Astro.props;

const NOT_STATED = "Not stated";

/* Keyed by the slug at the end of the row's href. */
const CLAIMS: Record<string, { runtime: string; basket: string; sensing: string; adapter: string; app: string; evidence: string }> = {
  "betta-se-plus": {
    runtime: "30 hours",
    basket: "200 micron mesh",
    sensing: "Ultrasonic radar",
    adapter: "3.5 hours",
    app: "No",
    evidence: "Manufacturer page and manual",
  },
  "aiper-ecosurfer-s2": {
    runtime: "35 hours",
    basket: "150 micron mesh",
    sensing: "Two dToF sensors",
    adapter: NOT_STATED,
    app: "Yes",
    evidence: "Listing",
  },
  "beatbot-iskim": {
    runtime: NOT_STATED,
    basket: "9 litres",
    sensing: "Dual ultrasonic",
    adapter: NOT_STATED,
    app: "Yes",
    evidence: "Listing",
  },
  "brinbo-sk01": {
    runtime: NOT_STATED,
    basket: "Large, no figure",
    sensing: "Ultrasonic",
    adapter: "2.5 hours",
    app: "Yes",
    evidence: "Listing",
  },
};
const slugOf = (href: string) => href.split("/").filter(Boolean).pop() ?? "";
const COLS = ["Runtime claim", "Basket or mesh", "Sensing", "Adapter charge", "App", "Evidence"];
const cells = (slug: string) => {
  const c = CLAIMS[slug];
  return c ? [c.runtime, c.basket, c.sensing, c.adapter, c.app, c.evidence] : [];
};
---

<section class="sg" id="at-a-glance" aria-label="The four solar skimmers at a glance">
  <div class="sg__frame">
    <table class="sg__table">
      <caption class="sr-only">
        The four solar skimmers compared on runtime claim, basket or mesh, sensing, adapter charge time, app and the
        evidence behind the figures. Every figure is the maker's own claim.
      </caption>
      <thead>
        <tr>
          <th scope="col">Skimmer</th>
          {COLS.map((c) => <th scope="col">{c}</th>)}
          <th scope="col"><span class="sr-only">Buy</span></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row" class="sg__rowhead">
              <a href={r.href}>
                <span class="sg__thumb"><ProductImage productId={r.productId} placement="comparison" compact sizes="72px" /></span>
                <span class="sg__name">{r.name}</span>
              </a>
            </th>
            {cells(slugOf(r.href)).map((v, i) => (
              <td data-label={COLS[i]}><span class:list={["sg__v", v === NOT_STATED && "is-unknown"]}>{v}</span></td>
            ))}
            <td class="sg__buy" data-label="">
              {r.redirectKey && (
                <a class="sg__btn" href={`/go/${r.redirectKey}`} rel="sponsored nofollow">Check price on Amazon</a>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="sg__note">
    Every figure is the maker's own claim. “Not stated” means we did not find it in what we read, and the review of
    each machine says the same.
  </p>
</section>

<style>
  .sg {
    /* Wider than the prose column it sits in, up to the page container. */
    width: min(66rem, calc(100vw - 2rem));
    max-width: none;
    margin: 1.6rem 0 2rem;
  }
  .sg__frame {
    border: 1px solid var(--cs-line);
    border-radius: 16px;
    background: var(--cs-surface-lift);
    overflow: hidden;
  }
  .sg__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    font-size: 0.92rem;
  }
  .sg__table thead th {
    padding: 0.9rem 0.8rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cs-mid);
    background: linear-gradient(180deg, #171c23 0%, #10141a 100%);
    border-bottom: 1px solid var(--cs-line);
  }
  .sg__table td,
  .sg__table tbody th {
    padding: 0.85rem 0.8rem;
    text-align: left;
    vertical-align: middle;
    color: var(--text-secondary);
    line-height: 1.4;
    border-top: 1px solid var(--cs-line-soft);
  }
  .sg__table tbody tr:first-child td,
  .sg__table tbody tr:first-child th { border-top: 0; }
  .sg__table :is(th, td):nth-child(1) { width: 21%; }
  .sg__table :is(th, td):nth-child(2) { width: 11%; }
  .sg__table :is(th, td):nth-child(3) { width: 13%; }
  .sg__table :is(th, td):nth-child(4) { width: 12%; }
  .sg__table :is(th, td):nth-child(5) { width: 10%; }
  .sg__table :is(th, td):nth-child(6) { width: 7%; }
  .sg__table :is(th, td):nth-child(7) { width: 12%; }
  .sg__table :is(th, td):nth-child(8) { width: 14%; }
  .sg__rowhead a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text-primary, inherit);
    text-decoration: none;
  }
  .sg__rowhead a:hover .sg__name { text-decoration: underline; }
  .sg__thumb {
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }
  .sg__thumb :global(img) { width: 100%; height: 100%; object-fit: contain; display: block; }
  .sg__name { font-weight: 700; }
  .sg__v { color: var(--cs-bright); }
  .sg__v.is-unknown { color: var(--text-secondary); font-style: italic; opacity: 0.8; }
  .sg__btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    width: 100%;
    padding: 0.55rem 0.5rem;
    border-radius: 999px;
    border: 1px solid rgba(120, 176, 255, 0.55);
    background: linear-gradient(180deg, #2f7fe4 0%, #1a55b4 100%);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }
  .sg__btn:hover { filter: brightness(1.1); }
  .sg__btn:focus-visible { outline: 2px solid #dfe4ec; outline-offset: 2px; }
  .sg__note { margin: 0.8rem 0 0; font-size: 0.85rem; color: var(--text-secondary); }

  @media (max-width: 859px) {
    .sg { width: 100%; }
    .sg__frame { border: 0; background: none; overflow: visible; }
    .sg__table, .sg__table tbody, .sg__table tr, .sg__table td, .sg__table tbody th { display: block; width: 100%; }
    .sg__table { table-layout: auto; }
    .sg__table :is(th, td):nth-child(n) { width: 100%; }
    .sg__table thead { position: absolute; clip-path: inset(50%); width: 1px; height: 1px; overflow: hidden; }
    .sg__table tbody tr {
      margin-bottom: 0.9rem;
      border: 1px solid var(--cs-line);
      border-radius: 14px;
      overflow: hidden;
      background: var(--cs-surface-lift);
    }
    .sg__table tbody tr:first-child td, .sg__table tbody tr:first-child th { border-top: 0; }
    .sg__rowhead { padding: 0.9rem 1rem; border-top: 0; border-bottom: 1px solid var(--cs-line-soft); background: rgba(255,255,255,0.025); }
    .sg__table td { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.5rem 1rem; border-top: 0; text-align: right; }
    .sg__table td::before {
      content: attr(data-label);
      flex: 0 0 auto;
      text-align: left;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--cs-low);
    }
    .sg__buy { padding: 0.7rem 1rem 1rem; }
    .sg__buy::before { display: none; }
  }
</style>
