---
/* ============================================================
   BotMatch funnel.

   Ported from the CryptoWatchdog matcher: five stages held in
   one component — landing → quiz → analysing → capture → done.
   Same structure, same perceived-value beat, same honeypot.

   Rewritten as a vanilla island, because this app deliberately
   runs no React on the worker (see astro.config.mjs). No
   framer-motion, no icon library — CSS transitions and inline
   SVG instead.

   To change the questions, edit content/matcher-questions.ts.
   Nothing in here needs to change.
   ============================================================ */

import { ANALYSE_MS, type MatcherQuestion } from "../content/matcher-questions";

interface Props {
  categorySlug: string;
  categoryName: string;
  /* Questions and tasks are PASSED IN, not imported. The component used to
     import one global array, which is how every category ended up sharing the
     pool questionnaire. Making them required props means a caller cannot
     render this funnel without deciding, explicitly, which category's
     questions it is rendering. */
  questions: MatcherQuestion[];
  tasks: string[];
}
const { categorySlug, categoryName, questions, tasks } = Astro.props;

/* Landing copy, per category.

   This block said "for your pool" and "Pool type, size, coverage, power and
   budget" for EVERY category until 6 August 2026, because pool was the only
   one when it was written. It went live on a window URL on 5 August reading
   "Find the right window-cleaning robots for your pool".

   Every line here now names what the category's own questions actually ask.
   A category added later without an entry gets wording that is general but
   still true, never another category's specifics.

   The question count is counted, not typed. It said "Eight short questions"
   while the funnel asked seven. */
/* @extension-point per-category | optional | The funnel falls back to general
   wording — "for you", and a criteria line that does not name the category's
   real inputs. True, but flat, and it wastes the one line that tells a reader
   we understand their problem. */
const COPY: Record<string, { audience: string; criteria: string }> = {
  "robotic-pool-cleaners": {
    audience: "for your pool",
    criteria: "Pool type, size, coverage, power and budget — nothing else.",
  },
  "window-cleaning-robots": {
    audience: "for your windows",
    criteria: "Framed or frameless, which glass, power and budget — nothing else.",
  },
  "robotic-lawn-mowers": {
    audience: "for your lawn",
    criteria: "Lawn size, tree cover, slopes, zones and budget — nothing else.",
  },
  "companion-robots": {
    audience: "for whoever it's for",
    criteria: "Who it's for, subscription tolerance, movement, conversation and budget — nothing else.",
  },
  "pet-camera-robots": {
    audience: "for your home",
    criteria: "Stairs, floors, what you need to do remotely and budget — nothing else.",
  },
  "self-cleaning-litter-boxes": {
    audience: "for your cat",
    criteria: "Cat size, how many cats, litter type, tracking and budget — nothing else.",
  },
  "grill-cleaning-robots": {
    audience: "for your grill",
    criteria: "Grate material, bar spacing, how often you cook and budget — nothing else.",
  },
  "robot-vacuums": {
    audience: "for your floors",
    criteria: "Floor type, hair, clutter, self-emptying and budget — nothing else.",
  },
  "educational-coding-robots": {
    audience: "for the child",
    criteria: "Age, whether a tablet is free, what you want from it and budget — nothing else.",
  },
};
const copy = COPY[categorySlug] ?? {
  audience: "for you",
  criteria: "What you need it to do, where it has to work, and your budget — nothing else.",
};
const COUNT_WORDS = ["no", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten"];
const countWord = COUNT_WORDS[questions.length] ?? String(questions.length);

const payload = JSON.stringify({
  questions,
  tasks,
  analyseMs: ANALYSE_MS,
  categorySlug,
});
---

<div class="bp-mm" data-matcher data-config={payload}>
  <!-- progress -->
  <div class="bp-mm__progress" data-progress-wrap hidden>
    <span class="bp-mm__progress-bar" data-progress></span>
  </div>

  <!-- 1. landing -->
  <section class="bp-mm__stage" data-stage="landing">
    <span class="bp-mm__eyebrow">BotMatch</span>
    <h1 class="bp-mm__title">Find the right {categoryName.toLowerCase()} {copy.audience}</h1>
    <p class="bp-mm__lead">
      {countWord} short questions, about a minute. No account, nothing to install. We match you
      against the robots we have actually researched — and the part that picks your robot
      cannot see prices or commission at all.
    </p>

    <ul class="bp-mm__steps">
      <li><strong>Answer {questions.length} questions</strong><span>Plain English. Tap what sounds like you.</span></li>
      <li><strong>We match on suitability</strong><span>{copy.criteria}</span></li>
      <li><strong>We send your result</strong><span>Your match, why it won, and what it does not do well.</span></li>
    </ul>

    <button class="btn btn--accent bp-mm__cta" type="button" data-start>Start — it takes a minute</button>
    <p class="bp-mm__note">Free. No account needed.</p>
  </section>

  <!-- 2. quiz -->
  <section class="bp-mm__stage" data-stage="quiz" hidden>
    <div class="bp-mm__qhead">
      <button class="bp-mm__back" type="button" data-back aria-label="Previous question">← Back</button>
      <span class="bp-mm__count" data-count></span>
    </div>
    <span class="bp-mm__kicker" data-kicker></span>
    <h2 class="bp-mm__q" data-question></h2>
    <div class="bp-mm__options" data-options></div>
  </section>

  <!-- 3. analysing -->
  <section class="bp-mm__stage" data-stage="analysing" hidden>
    <span class="bp-mm__kicker">Working through it</span>
    <h2 class="bp-mm__q">Matching your pool against what we have researched</h2>
    <ul class="bp-mm__tasks" data-tasks></ul>
  </section>

  <!-- 4. capture -->
  <section class="bp-mm__stage" data-stage="capture" hidden>
    <span class="bp-mm__eyebrow">Result ready</span>
    <h2 class="bp-mm__title bp-mm__title--sm">Where should we send it?</h2>
    <p class="bp-mm__lead">
      Your match, the reasoning behind it, and the honest limitations — sent to you, and saved
      on a page you can come back to.
    </p>

    <form class="bp-mm__form" data-form novalidate>
      <!-- honeypots: never shown, never filled by a person -->
      <div class="bp-mm__hp" aria-hidden="true">
        <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        <label>Website<input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label>
      </div>

      <label class="bp-mm__field">
        <span>First name</span>
        <input type="text" name="firstName" autocomplete="given-name" required />
      </label>
      <label class="bp-mm__field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="bp-mm__consent">
        <input type="checkbox" name="consent" required />
        <span>Yes, email me my BotMatch result. No spam, unsubscribe any time.</span>
      </label>

      <p class="bp-mm__error" data-error hidden></p>
      <button class="btn btn--accent bp-mm__cta" type="submit" data-submit>Send my result</button>
    </form>
  </section>

  <!-- 5. done -->
  <section class="bp-mm__stage" data-stage="done" hidden>
    <span class="bp-mm__eyebrow">On its way</span>
    <h2 class="bp-mm__title bp-mm__title--sm">Check your inbox</h2>
    <p class="bp-mm__lead" data-done-msg>
      Your result is on its way. If it has not arrived shortly, check your spam folder — and
      reply to it if anything about your pool does not match what we have said.
    </p>
    <a class="bp-mm__resultlink" data-result-link hidden href="#">View your recommendation now →</a>
  </section>
</div>

<script>
  type Opt = { label: string; hint?: string; scores?: Record<string, unknown> };
  type Q = { id: string; kicker: string; q: string; options: Opt[] };

  document.querySelectorAll<HTMLElement>("[data-matcher]").forEach((root) => {
    const cfg = JSON.parse(root.dataset.config || "{}") as {
      questions: Q[]; tasks: string[]; analyseMs: number; categorySlug: string;
    };
    const { questions, tasks, analyseMs, categorySlug } = cfg;

    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const stages = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>("[data-stage]").forEach((el) => stages.set(el.dataset.stage!, el));

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const answers: Record<string, string> = {};
    let step = 0;
    let locked = false;
    let resultToken: string | null = null;
    let productName: string | null = null;

    const track = (name: string, params: Record<string, unknown> = {}) => {
      (window as any).gtag?.("event", name, { ...params, category: categorySlug });
    };

    const progressWrap = q<HTMLElement>("[data-progress-wrap]");
    const progressBar = q<HTMLElement>("[data-progress]");

    function show(name: string) {
      stages.forEach((el, key) => { el.hidden = key !== name; });
      progressWrap.hidden = name === "landing";
      const pct = name === "quiz" ? (step / questions.length) * 100
        : name === "analysing" ? 96 : name === "capture" ? 98 : name === "done" ? 100 : 0;
      progressBar.style.width = `${pct}%`;
      if (name !== "landing") root.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    }

    /* ---------- quiz ---------- */
    function renderQuestion() {
      const cur = questions[step];
      q<HTMLElement>("[data-kicker]").textContent = cur.kicker;
      q<HTMLElement>("[data-question]").textContent = cur.q;
      q<HTMLElement>("[data-count]").textContent = `${step + 1} of ${questions.length}`;
      q<HTMLElement>("[data-back]").style.visibility = step === 0 ? "hidden" : "visible";

      const box = q<HTMLElement>("[data-options]");
      box.innerHTML = "";
      cur.options.forEach((opt, i) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "bp-mm__opt";
        b.innerHTML =
          `<span class="bp-mm__opt-key">${String.fromCharCode(65 + i)}</span>` +
          `<span class="bp-mm__opt-text"><strong>${opt.label}</strong>` +
          (opt.hint ? `<span>${opt.hint}</span>` : "") + `</span>`;
        b.addEventListener("click", () => choose(cur, opt, b));
        box.appendChild(b);
      });
      progressBar.style.width = `${(step / questions.length) * 100}%`;
    }

    function choose(cur: Q, opt: Opt, btn: HTMLElement) {
      if (locked) return;
      locked = true;
      btn.classList.add("is-picked");
      answers[cur.id] = opt.label;
      track("matcher_answer", { step: step + 1, question: cur.id, value: opt.label });
      window.setTimeout(() => {
        locked = false;
        if (step + 1 < questions.length) { step += 1; renderQuestion(); }
        else { track("matcher_analysing_view"); runAnalysis(); }
      }, reduce ? 0 : 380);
    }

    /* ---------- analysing ---------- */
    function runAnalysis() {
      show("analysing");
      const list = q<HTMLElement>("[data-tasks]");
      list.innerHTML = "";
      const items = tasks.map((t) => {
        const li = document.createElement("li");
        li.innerHTML = `<span class="bp-mm__tick"></span><span>${t}</span>`;
        list.appendChild(li);
        return li;
      });

      // Ask the real engine for a match while the sequence plays.
      void scoreInBackground();

      const per = Math.max(600, Math.floor(analyseMs / items.length));
      items.forEach((li, i) => window.setTimeout(() => li.classList.add("is-done"), per * (i + 1)));
      window.setTimeout(() => { track("matcher_capture_view"); show("capture"); }, analyseMs);
    }

    /* Folds the chosen options' `scores` fragments into the shape the scoring
       engine expects. Profile-only questions carry no fragment, so they cannot
       reach the scorer even by accident. */
    function toScoringAnswers(): Record<string, unknown> {
      const out: Record<string, unknown> = {};
      for (const question of questions) {
        const chosen = answers[question.id];
        if (!chosen) continue;
        const opt = question.options.find((o) => o.label === chosen);
        if (opt?.scores) Object.assign(out, opt.scores);
      }
      return out;
    }

    async function scoreInBackground() {
      try {
        const res = await fetch("/api/botmatch", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ category: categorySlug, answers: toScoringAnswers() }),
        });
        if (!res.ok) return;
        const data = await res.json();
        resultToken = data.token ?? null;
        productName = data.productName ?? data.product?.name ?? null;
      } catch { /* the funnel must not fail because scoring did */ }
    }

    /* ---------- capture ---------- */
    const form = q<HTMLFormElement>("[data-form]");
    const errBox = q<HTMLElement>("[data-error]");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const firstName = String(fd.get("firstName") || "").trim();
      const email = String(fd.get("email") || "").trim();
      const consent = fd.get("consent") != null;

      const fail = (m: string) => { errBox.textContent = m; errBox.hidden = false; };
      errBox.hidden = true;
      if (!firstName) return fail("Please enter your first name.");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return fail("Please enter a valid email address.");
      if (!consent) return fail("Please tick the box so we can email your result.");

      const btn = q<HTMLButtonElement>("[data-submit]");
      btn.disabled = true;
      btn.textContent = "Sending…";

      try {
        const res = await fetch("/api/matcher-lead", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            firstName, email, consent,
            categorySlug, answers,
            resultToken, productName,
            company: fd.get("company") || "",
            website_url: fd.get("website_url") || "",
            submittedAt: new Date().toISOString(),
            sourcePage: `botmatch/${categorySlug}`,
          }),
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (!data.ok) { btn.disabled = false; btn.textContent = "Send my result"; return fail(data.error || "Something went wrong. Please try again."); }
      } catch {
        btn.disabled = false; btn.textContent = "Send my result";
        return fail("Network problem. Please try again.");
      }

      track("matcher_lead_submit", { sourcePage: `botmatch/${categorySlug}` });
      if (resultToken) {
        const link = q<HTMLAnchorElement>("[data-result-link]");
        link.href = `/recommendation/${resultToken}`;
        link.hidden = false;
      }
      show("done");
    });

    /* ---------- wiring ---------- */
    q<HTMLElement>("[data-start]").addEventListener("click", () => {
      track("matcher_start");
      step = 0; renderQuestion(); show("quiz");
    });

    q<HTMLElement>("[data-back]").addEventListener("click", () => {
      errBox.hidden = true;
      if (step > 0) { step -= 1; renderQuestion(); show("quiz"); }
      else show("landing");
    });

    // ?start=quiz jumps straight in, so a promo card can skip the landing screen.
    if (new URLSearchParams(location.search).get("start") === "quiz") {
      track("matcher_start", { via: "promo" });
      renderQuestion(); show("quiz");
    }
  });
</script>

<style is:global>
  /* Global rather than scoped: the option buttons and task rows are created in
     JavaScript at runtime, so Astro's scoped attribute never lands on them.
     Every selector below is namespaced under .bp-mm, so nothing leaks out. */
  .bp-mm { max-width: 46rem; margin: 0 auto; }

  /* ---------- progress ---------- */
  .bp-mm__progress {
    position: sticky; top: 0; z-index: 5;
    height: 2px; margin-bottom: 2rem; border-radius: 2px;
    background: rgba(200, 208, 222, 0.14);
  }
  .bp-mm__progress-bar {
    display: block; height: 100%; width: 0%; border-radius: 2px;
    background: var(--cs-sheen);
    transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ---------- shared ---------- */
  .bp-mm__eyebrow, .bp-mm__kicker {
    display: inline-block; margin-bottom: 0.9rem;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--cs-sheen); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .bp-mm__title {
    margin: 0; font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.9rem, 5.2vw, 2.8rem); line-height: 1.1; letter-spacing: -0.021em;
    text-wrap: balance;
    background: linear-gradient(172deg, #fff 4%, #e4e9f1 44%, #a2aab8 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .bp-mm__title--sm { font-size: clamp(1.6rem, 4.4vw, 2.2rem); }
  .bp-mm__lead {
    margin: 1.05rem 0 0; max-width: 54ch;
    font-size: 1.0625rem; line-height: 1.66; color: var(--text-secondary);
  }
  .bp-mm__cta { margin-top: 1.9rem; min-height: 3.1rem; padding: 0 1.6rem; }
  .bp-mm__note { margin: 0.85rem 0 0; font-size: 0.85rem; color: var(--text-quaternary); }

  /* ---------- landing steps ---------- */
  .bp-mm__steps { margin: 2rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.85rem; }
  .bp-mm__steps li {
    position: relative; padding: 1.05rem 1.2rem 1.05rem 3.2rem;
    border: 1px solid var(--cs-line-soft); border-radius: 13px; background: var(--cs-surface);
  }
  .bp-mm__steps li::before {
    counter-increment: s; content: counter(s);
    position: absolute; left: 1.1rem; top: 1.05rem;
    display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 999px;
    font-family: var(--font-mono); font-size: 0.66rem; font-weight: 700; color: #0a0d11;
    background: var(--cs-sheen);
  }
  .bp-mm__steps { counter-reset: s; }
  .bp-mm__steps strong { display: block; color: var(--cs-hi); font-size: 1rem; }
  .bp-mm__steps span { display: block; margin-top: 0.25rem; font-size: 0.93rem; line-height: 1.5; color: var(--text-secondary); }

  /* ---------- quiz ---------- */
  .bp-mm__qhead { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.4rem; }
  .bp-mm__back {
    padding: 0.35rem 0; border: 0; background: none; cursor: pointer;
    font-size: 0.9rem; color: var(--cs-mid);
  }
  .bp-mm__back:hover { color: var(--cs-hi); }
  .bp-mm__count { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--text-quaternary); }
  .bp-mm__q {
    margin: 0 0 1.6rem; font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.45rem, 4vw, 1.95rem); line-height: 1.18; letter-spacing: -0.016em;
    text-wrap: balance; color: var(--cs-hi);
  }
  .bp-mm__options { display: grid; gap: 0.7rem; }
  .bp-mm .bp-mm__opt,
  .bp-mm__opt {
    -webkit-appearance: none;
    appearance: none;
    font: inherit;
    color: inherit;
    display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 0.95rem;
    width: 100%; padding: 1.05rem 1.2rem; text-align: left; cursor: pointer;
    border: 1px solid var(--cs-line); border-radius: 13px; background: var(--cs-surface);
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }
  .bp-mm__opt:hover { border-color: rgba(233, 237, 242, 0.5); background: rgba(255, 255, 255, 0.045); }
  .bp-mm__opt.is-picked { border-color: var(--cs-hi); background: rgba(255, 255, 255, 0.075); transform: scale(0.995); }
  .bp-mm__opt-key {
    display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 8px;
    font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: #0a0d11;
    background: var(--cs-sheen);
  }
  .bp-mm__opt-text strong { display: block; font-size: 1rem; color: var(--cs-hi); }
  .bp-mm__opt-text span { display: block; margin-top: 0.18rem; font-size: 0.88rem; color: var(--text-tertiary); }

  /* ---------- analysing ---------- */
  .bp-mm__tasks { margin: 1.75rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.85rem; }
  .bp-mm__tasks li {
    display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 0.85rem;
    font-size: 0.99rem; color: var(--text-quaternary);
    transition: color 0.4s ease;
  }
  .bp-mm__tasks li.is-done { color: var(--text-secondary); }
  .bp-mm__tick {
    position: relative; width: 1.15rem; height: 1.15rem; border-radius: 999px;
    border: 1px solid var(--cs-line);
  }
  .bp-mm__tasks li.is-done .bp-mm__tick { border-color: var(--cs-bright); background: rgba(255,255,255,0.05); }
  .bp-mm__tasks li.is-done .bp-mm__tick::after {
    content: ""; position: absolute; left: 0.36rem; top: 0.17rem;
    width: 0.26rem; height: 0.52rem; transform: rotate(42deg);
    border-right: 1.5px solid var(--cs-hi); border-bottom: 1.5px solid var(--cs-hi);
  }

  /* ---------- capture ---------- */
  .bp-mm__form { margin-top: 1.9rem; display: grid; gap: 1.05rem; }
  .bp-mm__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .bp-mm__field { display: grid; gap: 0.4rem; }
  .bp-mm__field span { font-size: 0.87rem; color: var(--cs-mid); }
  .bp-mm__field input {
    padding: 0.85rem 1rem; border-radius: 11px;
    border: 1px solid var(--cs-line); background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary); font-size: 1rem;
  }
  .bp-mm__field input:focus { outline: 2px solid rgba(233, 237, 242, 0.45); outline-offset: 1px; }
  .bp-mm__consent { display: grid; grid-template-columns: auto 1fr; gap: 0.7rem; align-items: start; font-size: 0.92rem; line-height: 1.5; color: var(--text-secondary); }
  .bp-mm__consent input { margin-top: 0.2rem; width: 1.05rem; height: 1.05rem; }
  .bp-mm__error { margin: 0; font-size: 0.9rem; color: #ffb4b4; }

  .bp-mm__resultlink { display: inline-block; margin-top: 1.4rem; font-weight: 600; color: var(--cs-hi); }

  @media (min-width: 860px) {
    .bp-mm__lead { font-size: 1.1875rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bp-mm__progress-bar, .bp-mm__opt, .bp-mm__tasks li { transition: none; }
  }
</style>
