---
/* ============================================================
   BotPlanet — companion robot capability table.

   FIVE QUESTIONS EVERY BUYER IN THIS CATEGORY ASKS, and which the
   product pages answer inconsistently or not at all: does it
   speak, does it respond to being touched, does it need an app,
   does it work without the internet, and does it want money every
   month.

   THE BLANKS ARE THE FINDING. Casio states Moflin's speech and its
   touch sensing outright. Anki states neither for Vector. Reading
   down a column here shows which manufacturers will tell you what
   their robot does before you own it — which is a real signal, and
   one no product page will ever give you.

   NOTHING IS INFERRED. A silent maker gets "Not published", never
   a "no". Inferring absence from silence would be inventing a
   fact, and inferring presence would be worse. See
   content/decision-tables.ts for why a generic label like
   "Sensors" only fills the touch cell when the recorded value
   actually mentions touch.
   ============================================================ */
import SectionHead from "./SectionHead.astro";
import type { CapabilityRow } from "../content/decision-tables";

interface Props {
  rows: CapabilityRow[];
}

const { rows } = Astro.props;
const labels = rows[0]?.cells.map((c) => c.label) ?? [];

/* Counted, not asserted: the sentence under the table states how thin the
   published record is, and the number has to come from the data or it is the
   kind of claim this component exists to avoid. */
const cells = rows.length * (labels.length || 1);
const published = rows.reduce((n, r) => n + r.cells.filter((c) => c.published).length, 0);
---

{rows.length > 0 && (
  <section class="bp-cap" id="what-each-one-does" aria-label="What each one actually does">
    <SectionHead
      eyebrow="Side by side"
      title="What each one actually does"
      intro="Five questions people ask about a robot pet before anything else, answered only where the manufacturer publishes an answer. Every value is that maker's own wording, taken from the product's review."
    />

    <div class="bp-cap__scroll">
      <table class="bp-cap__table">
        <thead>
          <tr>
            <th scope="col">Robot</th>
            {labels.map((l) => <th scope="col">{l}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row"><a href={r.href}>{r.name}</a></th>
              {r.cells.map((c) => (
                <td data-published={c.published ? "true" : "false"}>{c.value}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="note bp-cap__note">
      Manufacturers publish an answer in {published} of these {cells} cells. The gaps are not
      failings of the robots — they are what each company chooses to tell you before you buy, and
      reading down a column is the fastest way to see who tells you least.
    </p>
  </section>
)}

<style>
  .bp-cap { margin: var(--space-7, 2.5rem) 0; }

  .bp-cap__scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 14px);
    background: var(--panel);
  }

  .bp-cap__table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .bp-cap__table th,
  .bp-cap__table td {
    padding: 0.7rem 0.8rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border-2);
  }

  .bp-cap__table thead th {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: var(--panel-2, var(--panel));
    white-space: nowrap;
  }

  .bp-cap__table tbody th { font-weight: 650; white-space: nowrap; }

  .bp-cap__table td[data-published="false"] {
    color: var(--text-secondary);
    font-style: italic;
  }

  .bp-cap__note { margin-top: 0.75rem; }
</style>
