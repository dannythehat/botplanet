---
/* ============================================================
   BotPlanet — BotMatch call to action

   The ninth element type, and the only one whose job is to move
   the reader somewhere else.

   Modelled on the CryptoWatchdog promo card: it links in with
   ?start=quiz so the reader lands on the first question rather
   than a landing screen they have to get past, and it fires the
   same matcher_promo_click event so the funnel can be measured
   end to end.

   Placed mid-page on purpose — after the sections that show how
   many things there are to weigh up, at the point where "just
   tell me which one" is the honest reaction.

   The image is optional. Without it the panel is a single wide
   column and still looks deliberate.

   MODES
   -----
   "beside"  the default. Rendered copy, a real button, and the
             artwork as a supporting 4:3 figure alongside.

   "poster"  the CryptoWatchdog treatment. The artwork is a finished
             composition — headline, body and button already set into
             the image — so the panel becomes the artwork and nothing
             else. Repeating the words underneath would say the same
             thing twice in two different typefaces.

             The copy does not disappear. It moves to .sr-only, so a
             screen reader still hears the offer and a crawler still
             reads it. The whole poster is one link, named by its alt
             text, and it fires the same event as the button does.
   ============================================================ */

import type { HeroImage } from "./CategoryHero.astro";

/**
 * A poster carries its own frame and ratio, so it needs the intrinsic size
 * to reserve space before the file lands.
 */
export interface PosterImage extends HeroImage {
  width: number;
  height: number;
}

interface Props {
  categorySlug: string;
  /** Big line. Should sound like the reader's own thought. */
  headline: string;
  /** One or two sentences. */
  body: string;
  /** Three short proof points. */
  points: string[];
  ctaLabel: string;
  /** Reassurance under the button. */
  note?: string;
  image?: HeroImage;
  /** Full-bleed artwork that already contains the headline and the button. */
  poster?: PosterImage;
}

const { categorySlug, headline, body, points, ctaLabel, note, image, poster } = Astro.props;
const href = `/botmatch/${categorySlug}/?start=quiz`;
const hasPoster = Boolean(poster?.src);
const hasImage = !hasPoster && Boolean(image?.src);
---

{hasPoster ? (
  <section class="bp-bmcta bp-bmcta--poster" aria-labelledby={`bmcta-${categorySlug}`}>
    {/* Present to assistive technology and to search, absent from the layout:
        every word here is already drawn inside the artwork. */}
    <div class="sr-only">
      <p id={`bmcta-${categorySlug}`}>{headline}</p>
      <p>{body}</p>
      <ul>{points.map((p) => <li>{p}</li>)}</ul>
      {note && <p>{note}</p>}
    </div>

    <a class="bp-bmcta__poster" href={href} data-botmatch-cta={categorySlug}>
      <picture>
        {poster!.mobileSrc && <source media="(max-width: 719px)" srcset={poster!.mobileSrc} />}
        <img
          src={poster!.src}
          width={poster!.width}
          height={poster!.height}
          alt={poster!.alt}
          loading="lazy"
          decoding="async"
        />
      </picture>
    </a>
  </section>
) : (
  <section class="bp-bmcta" data-has-image={hasImage ? "true" : "false"}>
    <div class="bp-bmcta__inner">
      <div class="bp-bmcta__copy">
        <span class="bp-bmcta__eyebrow">BotMatch</span>
        <p class="bp-bmcta__headline">{headline}</p>
        <p class="bp-bmcta__body">{body}</p>

        <ul class="bp-bmcta__points">
          {points.map((p) => <li>{p}</li>)}
        </ul>

        <a class="btn btn--accent bp-bmcta__btn" href={href} data-botmatch-cta={categorySlug}>
          {ctaLabel}
        </a>
        {note && <p class="bp-bmcta__note">{note}</p>}
      </div>

      {hasImage && (
        <figure class="bp-bmcta__figure">
          <picture>
            {image!.mobileSrc && <source media="(max-width: 719px)" srcset={image!.mobileSrc} />}
            <img src={image!.src} alt={image!.alt} loading="lazy" decoding="async"
                 style={image!.focal ? `object-position: ${image!.focal}` : undefined} />
          </picture>
        </figure>
      )}
    </div>
  </section>
)}

<script>
  // Same event name the funnel uses, so promo → start → answer → lead can be
  // followed as one path rather than two disconnected halves.
  document.querySelectorAll<HTMLAnchorElement>("[data-botmatch-cta]").forEach((el) => {
    el.addEventListener("click", () => {
      (window as any).gtag?.("event", "matcher_promo_click", {
        category: el.dataset.botmatchCta,
        placement: "category_mid_page",
      });
    });
  });
</script>

<style is:global>
  .bp-bmcta {
    position: relative;
    /* Same rhythm as the section plates in metal-theme.css — this panel is
       one of the boxes, just the brightest one. */
    margin: 0 0 clamp(1.75rem, 4vw, 2.75rem);
    padding: clamp(1.75rem, 5vw, 3rem);
    border: 1px solid var(--cs-line);
    border-radius: 20px;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 8% -30%, rgba(232, 238, 250, 0.11), transparent 58%),
      radial-gradient(ellipse at 92% 120%, rgba(198, 208, 226, 0.07), transparent 55%),
      linear-gradient(178deg, #141920 0%, #0a0d11 62%, #0e1217 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 28px 64px rgba(0, 0, 0, 0.52);
  }

  /* brighter hairline than the content sections — this one is meant to catch */
  .bp-bmcta::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(246, 248, 252, 0.65) 22%,
      rgba(255, 255, 255, 0.92) 50%,
      rgba(246, 248, 252, 0.6) 78%,
      transparent
    );
  }

  .bp-bmcta__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: center;
  }

  .bp-bmcta__eyebrow {
    display: inline-block;
    margin-bottom: 0.95rem;
    padding: 0.34rem 0.72rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #0a0d11;
    background: var(--cs-sheen);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      inset 0 -1px 0 rgba(0, 0, 0, 0.35),
      0 4px 12px rgba(0, 0, 0, 0.4);
  }

  .bp-bmcta__headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.55rem, 4.4vw, 2.35rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
    text-wrap: balance;
    background: linear-gradient(172deg, #ffffff 4%, #e8ecf3 44%, #a4acb9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bp-bmcta__body {
    margin: 1rem 0 0;
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.64;
    color: var(--text-secondary);
  }

  .bp-bmcta__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.35rem;
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .bp-bmcta__points li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--cs-mid);
  }

  .bp-bmcta__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.38rem;
    height: 0.38rem;
    transform: rotate(45deg);
    background: var(--cs-sheen);
  }

  .bp-bmcta__btn {
    margin-top: 1.85rem;
    min-height: 3.2rem;
    padding: 0 1.75rem;
    font-size: 1rem;
  }

  .bp-bmcta__note {
    margin: 0.85rem 0 0;
    font-size: 0.84rem;
    color: var(--text-quaternary);
  }

  /* ---------- image ---------- */
  .bp-bmcta__figure {
    margin: 0;
    border: 1px solid var(--cs-line-soft);
    border-radius: 14px;
    overflow: hidden;
    background: var(--cs-surface);
  }

  .bp-bmcta__figure img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .bp-bmcta__body { font-size: 1.1rem; }

    .bp-bmcta[data-has-image="true"] .bp-bmcta__inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* ---------- poster mode ---------- */

  /* The section stops being a panel: the artwork is the panel. Padding,
     border and background all belong to the link instead, so the frame sits
     exactly on the edge of the picture with no dark margin inside it. */
  .bp-bmcta--poster {
    padding: 0;
    border: 0;
    background: none;
    box-shadow: none;
  }

  .bp-bmcta--poster::before { display: none; }

  .bp-bmcta__poster {
    display: block;
    max-width: 560px;
    margin: 0 auto;
    border: 1px solid var(--cs-line);
    border-radius: 20px;
    overflow: hidden;
    /* The artwork is dark to its own edge; the outer glow is what separates
       it from the page rather than a lighter background behind it. */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      0 26px 60px rgba(0, 0, 0, 0.55);
    transition:
      transform var(--duration-base, 200ms) ease,
      border-color var(--duration-base, 200ms) ease,
      box-shadow var(--duration-base, 200ms) ease;
  }

  .bp-bmcta__poster img {
    display: block;
    width: 100%;
    height: auto;
  }

  .bp-bmcta__poster:hover,
  .bp-bmcta__poster:focus-visible {
    transform: translateY(-3px);
    border-color: rgba(226, 232, 244, 0.42);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 34px 74px rgba(0, 0, 0, 0.6);
  }

  .bp-bmcta__poster:focus-visible {
    outline: var(--focus-ring, 2px solid #dfe4ec);
    outline-offset: var(--focus-offset, 3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-bmcta__poster,
    .bp-bmcta__poster:hover {
      transform: none;
      transition: none;
    }
  }
</style>
