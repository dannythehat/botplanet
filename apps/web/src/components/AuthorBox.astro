---
/**
 * Who wrote this, and what they are on the hook for.
 *
 * WHY IT EXISTS. Every review on this site carried an author in its structured
 * data and nothing on the page — so a machine knew who wrote it and a reader
 * did not. On a site whose whole position is "we tell you when not to buy",
 * the person making that call being invisible is the wrong way round.
 *
 * WHAT IT DOES NOT DO. It states a role and, where the owner has supplied one,
 * a background. It does not claim testing, hours of use, or a number of units
 * handled, because none of that has happened — see the honesty rule at the top
 * of content/team.ts. A credential invented to fill an author box is worth less
 * than no author box, and on a named individual it is a claim about a real
 * person that they never made.
 *
 * The reviewed-on date sits here rather than in the byline because it is the
 * same fact: who stands behind this, and as of when.
 */
import type { Author } from "../content/team";

interface Props {
  author: Author;
  /** ISO date the page was last checked, where the page has one. */
  reviewed?: string;
  /** A second name to credit alongside, for pages with editorial sign-off. */
  signedOffBy?: Author;
}

const { author, reviewed, signedOffBy } = Astro.props;

const readable = (iso: string | undefined) =>
  iso
    ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "UTC",
      })
    : null;

const on = readable(reviewed);
/* The initials plate. Deliberately not a photograph: we do not hold one, and a
   stock portrait standing in for a real person is the same lie as an invented
   credential. */
const initials = author.name
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? "")
  .join("");
---

<aside class="bp-author" aria-labelledby={`author-${author.id}`}>
  {author.portrait ? (
    <img
      class="bp-author__photo"
      src={author.portrait.src}
      srcset={`/media/authors/${author.id}-104w.webp 104w, /media/authors/${author.id}-220w.webp 220w`}
      sizes="52px"
      width="52"
      height="52"
      alt={author.portrait.alt}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span class="bp-author__plate" aria-hidden="true">{initials}</span>
  )}

  <div class="bp-author__body">
    <p class="bp-author__kicker">Written by</p>
    <p class="bp-author__name" id={`author-${author.id}`}>
      <a href={author.path}>{author.name}</a>
      <span class="bp-author__role">{author.role}</span>
    </p>

    {author.background && <p class="bp-author__bg">{author.background}</p>}

    <p class="bp-author__covers">{author.accountability}</p>

    <p class="bp-author__meta">
      {on && <>Last checked {on}. </>}
      {signedOffBy && signedOffBy.id !== author.id && (
        <>Signed off by <a href={signedOffBy.path}>{signedOffBy.name}</a>. </>
      )}
      <a href="/review-methodology/">How we check things</a>
    </p>
  </div>
</aside>

<style>
  .bp-author {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin: clamp(2rem, 5vw, 3rem) 0;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid rgba(210, 216, 224, 0.16);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent);
  }

  .bp-author__plate {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(210, 216, 224, 0.22);
    background: rgba(255, 255, 255, 0.05);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.04em;
    color: var(--text-secondary, #c8d0dc);
  }

  .bp-author__photo {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(210, 216, 224, 0.22);
  }

  .bp-author__body { min-width: 0; }

  .bp-author__kicker {
    margin: 0 0 2px;
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-tertiary, #8b94a3);
  }

  .bp-author__name {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
  }
  .bp-author__name a { color: inherit; }

  .bp-author__role {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-tertiary, #8b94a3);
  }

  .bp-author__bg,
  .bp-author__covers {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary, #c8d0dc);
  }

  .bp-author__meta {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--text-tertiary, #8b94a3);
  }

  @media (max-width: 520px) {
    .bp-author { flex-direction: column; gap: 12px; }
  }
</style>
