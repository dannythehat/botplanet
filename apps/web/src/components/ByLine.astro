---
import { EDITORIAL } from "../content/team";
interface Props {
  updated?: string;      // ISO or human date
  reviewed?: string;     // last reviewed date
  evidence?: string;     // standing evidence label for the page
  compact?: boolean;
}
const { updated, reviewed, evidence = EDITORIAL.standingLabel, compact = false } = Astro.props;
const a = EDITORIAL.author;
const r = EDITORIAL.reviewer;
---
<div class:list={["byline", { compact }]}>
  <div class="by-who">
    <span class="avatar" aria-hidden="true">{a.name.charAt(0)}</span>
    <div>
      <p class="by-line">By <a href={a.path}>{a.name}</a> · <span class="muted">{a.role}</span></p>
      <p class="by-meta muted">
        {a.id === r.id ? "Written and checked to BotPlanet's editorial standards" : <>Reviewed by <a href={r.path}>{r.name}</a></>}
        {reviewed && <> · Last reviewed {reviewed}</>}
        {updated && <> · Updated {updated}</>}
      </p>
    </div>
  </div>
  <span class="ev-tag" title="How this page's claims are supported">{evidence}</span>
</div>
<style>
  .byline { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; border: 1px solid var(--border); background: var(--panel); border-radius: 12px; padding: 12px 14px; margin: 18px 0; }
  .byline.compact { padding: 9px 12px; }
  .by-who { display: flex; align-items: center; gap: 11px; }
  .avatar { width: 34px; height: 34px; border-radius: 999px; background: linear-gradient(140deg, #2a2a34, #14141a); border: 1px solid var(--border-2); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; color: var(--text); }
  .by-line { margin: 0; font-size: 14px; }
  .by-meta { margin: 2px 0 0; font-size: 12px; }
  .ev-tag { font-size: 11px; font-weight: 600; letter-spacing: 0.03em; color: var(--muted); border: 1px solid var(--border-2); border-radius: 999px; padding: 5px 11px; white-space: nowrap; }
</style>
