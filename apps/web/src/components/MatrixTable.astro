---
/* ============================================================
   BotPlanet — Matrix section (section head + comparison matrix)

   The reusable table for the whole site: debris vs filter here,
   grass length vs cutting height elsewhere, surface type vs
   brush type on the vacuum pages.

   One DOM, two layouts. On a phone each row becomes its own
   card with the column name shown against each value; on a wide
   screen it is an ordinary table. The content is never
   duplicated, so search engines see it once.

   Each row label is a real H3, so the sub-topics stay headings
   in their own right as the approved research requires.
   ============================================================ */

import SectionHead from "./SectionHead.astro";
import type { HeroImage } from "./CategoryHero.astro";

export interface MatrixRow {
  /** Row label — rendered as the H3. */
  label: string;
  /** One entry per column, in the same order as `columns`. */
  cells: string[];
  /** Optional thumbnail. Deliberately small and 3:2 — a different
      treatment from the card sections, so the page stays varied. */
  image?: HeroImage;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro: string;
  /** Column headings, excluding the row-label column. */
  columns: string[];
  rows: MatrixRow[];
  /** Optional caption below the table. */
  note?: string;
}

const { id, eyebrow, title, intro, columns, rows, note } = Astro.props;

import { srcsetFor, sizeOf } from "../lib/srcset";
---

<section class="bp-mx" id={id}>
  <SectionHead eyebrow={eyebrow} title={title} intro={intro} />

  <div class="bp-mx__frame">
    <table class="bp-mx__table">
      <thead>
        <tr>
          <th scope="col">Type</th>
          {columns.map((col) => <th scope="col">{col}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row">
              {row.image?.src && (
                <img
                  class="bp-mx__thumb"
                  src={row.image.src}
                  srcset={srcsetFor(row.image.src)}
                  sizes="(min-width: 760px) 160px, 40vw"
                  width={sizeOf(row.image.src)?.width}
                  height={sizeOf(row.image.src)?.height}
                  alt={row.image.alt}
                  style={row.image.focal ? `object-position: ${row.image.focal}` : undefined}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <h3 class="bp-mx__rowtitle">{row.label}</h3>
            </th>
            {row.cells.map((cell, i) => (
              <td data-label={columns[i]}>{cell}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {note && <p class="bp-mx__note">{note}</p>}
</section>

<style>
  .bp-mx {
    /* Outer spacing, padding, border and background come from the section
       plate rule in metal-theme.css, so every section shares one rhythm. */
  }

  .bp-mx__frame {
    border: 1px solid var(--cs-line);
    border-radius: 16px;
    overflow: hidden;
    background: var(--cs-surface);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.055),
      0 22px 34px rgba(0, 0, 0, 0.42);
  }

  .bp-mx__table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  /* Thumbnail: 3:2 and small, so it reads as a reference picture
     inside a table rather than a card image capping a panel. */
  .bp-mx__thumb {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--cs-line-soft);
    border-radius: 10px;
    margin-bottom: 0.95rem;
  }

  .bp-mx__rowtitle {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.08rem;
    line-height: 1.24;
    letter-spacing: -0.01em;
    color: var(--cs-hi);
  }

  .bp-mx__note {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-tertiary);
  }

  /* ==========  phone: every row becomes a card  ========== */
  @media (max-width: 819px) {
    .bp-mx__frame {
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      overflow: visible;
    }

    /* the header row is redundant once each cell is labelled */
    .bp-mx__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .bp-mx__table,
    .bp-mx__table tbody,
    .bp-mx__table tr,
    .bp-mx__table th,
    .bp-mx__table td {
      display: block;
    }

    .bp-mx__table tr {
      margin-bottom: 1rem;
      padding: clamp(1.35rem, 4vw, 1.75rem);
      border: 1px solid var(--cs-line-soft);
      border-radius: 14px;
      background: var(--cs-surface);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.34);
    }

    .bp-mx__table tr:last-child {
      margin-bottom: 0;
    }

    .bp-mx__table tbody th {
      padding: 0 0 1rem;
      border-bottom: 1px solid var(--cs-line-soft);
    }

    .bp-mx__thumb {
      aspect-ratio: 16 / 9;
    }

    .bp-mx__table td {
      padding: 1rem 0 0;
      font-size: 0.97rem;
      line-height: 1.6;
      color: var(--text-secondary);
    }

    /* column name shown against each value */
    .bp-mx__table td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.35rem;
      font-family: var(--font-mono);
      font-size: 0.63rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      background: var(--cs-sheen);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  /* ==========  wide: an ordinary table  ========== */
  @media (min-width: 820px) {
    .bp-mx__table thead th {
      padding: 1.15rem 1.5rem;
      border-bottom: 1px solid var(--cs-line);
      background: rgba(255, 255, 255, 0.028);
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      background-clip: padding-box;
      color: var(--cs-mid);
      white-space: nowrap;
    }

    .bp-mx__table tbody tr + tr th,
    .bp-mx__table tbody tr + tr td {
      border-top: 1px solid var(--cs-line-soft);
    }

    .bp-mx__table tbody th {
      width: 17.5rem;
      padding: 1.5rem;
      vertical-align: top;
    }

    .bp-mx__table tbody td {
      padding: 1.5rem;
      vertical-align: top;
      font-size: 0.99rem;
      line-height: 1.62;
      color: var(--text-secondary);
    }

    .bp-mx__table tbody tr:nth-child(even) th,
    .bp-mx__table tbody tr:nth-child(even) td {
      background: rgba(255, 255, 255, 0.012);
    }
  }
</style>
