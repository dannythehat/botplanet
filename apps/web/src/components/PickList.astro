---
/* ============================================================
   BotPlanet — the ranked pick list.

   The body of a best-of page. One plate per recommendation:
   the award, the product, why it wins that award, and who
   should not buy it.

   THREE THINGS THIS COMPONENT REFUSES TO DO.

   1. NO PRICE. There is no prop for one. A ranked list is read
      months after it is written and a figure typed into it is
      a figure nobody re-checked. Price lives on the review and
      in the buy box, printed beside the date it was read.

   2. NO SCORE. Awards are jobs, not marks out of ten. A number
      implies the machines were measured against each other on
      one axis, and they were not — a floor-only above-ground
      robot and a 3,875 sq ft flagship are not competing.

   3. NO PICK WITHOUT A RULE-OUT. `wrongFor` is required by the
      type. An award with nobody it is wrong for is an advert,
      and this component would rather fail to compile than
      render one.

   The rank number is presentational only: the order comes from
   the content file, which declares it deliberately.
   ============================================================ */

import SectionHead from "./SectionHead.astro";
import ProductImage from "./ProductImage.astro";
import { readOnLabel, type AmazonRating } from "../content/commerce/amazon-ratings";
import type { EditorialPick } from "../content/editorial";

export interface RenderedPick extends EditorialPick {
  /** Product display name, from the catalogue rather than retyped. */
  name: string;
  /** Canonical review URL. */
  href: string;
  /** Price band label from the catalogue, e.g. "Mid". Never a figure. */
  band: string;
  /** What it cleans, e.g. "Floor · Walls · Waterline". */
  cleans: string;
  /** "Cordless", "Corded", "Solar". */
  power: string;
  /** "Up to 50 ft", "Up to 1,615 sq ft", or the not-disclosed wording. */
  poolSize: string;
  /**
   * The product's category, used only to label the facts honestly.
   *
   * ADDED 8 August 2026 BECAUSE THIS CARD SHIPPED WRONG. The seniors guide
   * rendered "Cleans: companionship · play interaction" and "Rated for: Not
   * disclosed" for a robotic cat. Neither is a defect in the data — the
   * capability column genuinely holds companionship, and a robot pet genuinely
   * has no pool-size rating. Both are pool-era LABELS printed over a category
   * that does not use them, and "Not disclosed" is the worse of the two: it
   * implies a manufacturer withheld a figure that does not exist.
   */
  categorySlug?: string;
  /** Active offer's redirect key, when the product has one. Never a price. */
  redirectKey?: string | null;
  /** Amazon's own rating for the listing, with the day it was read. Not ours; labelled as Amazon's. */
  amazonRating?: AmazonRating;
  /** Stable product id, so the card can show the product's picture from the media registry. */
  productId?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro: string;
  picks: RenderedPick[];
}

const { id, eyebrow, title, intro, picks } = Astro.props;

/* Categories where nothing is cleaned. The list is explicit rather than a
   default-else so that adding a category forces a decision about its label
   instead of inheriting "Cleans" by silence. */
const DOES_NOT_CLEAN = new Set(["companion-robots", "pet-camera-robots", "educational-coding-robots"]);
const doesLabel = (p: RenderedPick): string =>
  p.categorySlug && DOES_NOT_CLEAN.has(p.categorySlug) ? "Does" : "Cleans";

/* "Rated for" is the pool-size axis. A category that does not use it drops the
   row entirely rather than printing "Not disclosed", which reads as a
   manufacturer withholding a figure rather than as a field that does not
   apply. */
const ratedFor = (p: RenderedPick): string | null => {
  if (p.categorySlug && DOES_NOT_CLEAN.has(p.categorySlug)) return null;
  /* "Rated for: Not disclosed" on every card read like a star rating that did not
     exist. The chip is the pool-size limit the maker states, called "Suits up to",
     and it is simply left out when the maker states none. */
  return /not disclosed/i.test(p.poolSize) ? null : p.poolSize;
};
---

<section class="bp-picks" id={id}>
  <SectionHead eyebrow={eyebrow} title={title} intro={intro} />

  <ol class="bp-picks__list">
    {picks.map((p, i) => (
      <li class:list={["bp-picks__item", i === 0 && "is-top"]}>
        {p.productId && (
          <a class="bp-picks__media" href={p.href} tabindex="-1" aria-hidden="true">
            <span class="bp-picks__rank" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <ProductImage productId={p.productId} placement="listing_card" sizes="(min-width: 900px) 300px, 90vw" />
          </a>
        )}

        <div class="bp-picks__body">
          <div class="bp-picks__head">
            <p class="bp-picks__award">{p.award}</p>
            <h3 class="bp-picks__name">
              <a href={p.href}>{p.name}</a>
            </h3>
          </div>

          <ul class="bp-picks__chips" aria-label={`${p.name} at a glance`}>
            <li><span>{doesLabel(p)}</span>{p.cleans}</li>
            {p.amazonRating && (
              <li class="bp-picks__stars" title={`Amazon's rating for this listing, read ${readOnLabel(p.amazonRating.readOn)}`}>
                <span>Amazon rating</span>
                <b><i aria-hidden="true">★</i> {p.amazonRating.rating.toFixed(1)}</b>
                <em>{p.amazonRating.ratingsLabel} ratings · read {readOnLabel(p.amazonRating.readOn)}</em>
              </li>
            )}
            <li><span>Power</span>{p.power}</li>
            {ratedFor(p) && <li><span>Suits up to</span>{ratedFor(p)?.replace(/^Up to /, "")}</li>}
            <li><span>Price band</span>{p.band}</li>
          </ul>

          <p class="bp-picks__why">{p.why}</p>

          {(p.pros?.length || p.cons?.length) && (
            <div class:list={["bp-picks__proscons", !(p.cons?.length) && "is-single"]}>
              {p.pros?.length ? (
                <div class="bp-picks__pc bp-picks__pc--pro">
                  <h4>What is good</h4>
                  <ul>{p.pros.map((x) => <li>{x}</li>)}</ul>
                </div>
              ) : null}
              {p.cons?.length ? (
                <div class="bp-picks__pc bp-picks__pc--con">
                  <h4>What to know</h4>
                  <ul>{p.cons.map((x) => <li>{x}</li>)}</ul>
                </div>
              ) : null}
            </div>
          )}

          <p class="bp-picks__against">
            <span class="bp-picks__against-label">Skip it if</span>
            {p.wrongFor}
          </p>

          <div class="bp-picks__actions">
            {p.redirectKey && (
              <a class="bp-picks__buy" href={`/go/${p.redirectKey}`} rel="sponsored nofollow">
                <span>Check price on Amazon</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            )}
            <a class="bp-picks__more" href={p.href}>
              Read the full {p.name} review
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <p class="bp-picks__note">
    Each pick is chosen for a job, not given a score, and what a product pays us plays no part. Our
    <a href="/editorial-policy/">editorial policy</a> explains how we choose. We do not print prices
    here because they change; each review shows the current price and the date it was checked.
  </p>
</section>

<style>
  .bp-picks__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.4rem; margin-top: 1.1rem; }
  .bp-picks__actions .bp-picks__more { margin-top: 0; }
  .bp-picks__buy {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
    min-height: 2.9rem;
    padding: 0 0.95rem 0 1.2rem;
    border-radius: 11px;
    border: 1px solid rgba(120, 176, 255, 0.55);
    background: linear-gradient(180deg, #2f7fe4 0%, #1a55b4 100%);
    color: #fff;
    font-weight: 700;
    font-size: 0.93rem;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26), 0 6px 16px rgba(16, 60, 130, 0.4);
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }
  .bp-picks__buy svg { width: 1rem; height: 1rem; flex: none; }
  .bp-picks__buy:hover, .bp-picks__buy:focus-visible { transform: translateY(-1px); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 9px 22px rgba(16,60,130,.5); }
  .bp-picks__buy:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  .bp-picks {
    margin: clamp(3rem, 7vw, 5rem) 0;
  }

  .bp-picks__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.4rem);
  }

  .bp-picks__item {
    position: relative;
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.6rem);
    padding: clamp(1rem, 2.4vw, 1.5rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    /* Frosted glass: a lit pane over the page's dark background. */
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.02) 55%, rgba(90, 150, 255, 0.05));
    -webkit-backdrop-filter: blur(16px) saturate(130%);
    backdrop-filter: blur(16px) saturate(130%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 0 0 1px rgba(255, 255, 255, 0.02),
      0 18px 40px rgba(0, 0, 0, 0.35);
  }
  .bp-picks__item.is-top {
    border-color: rgba(120, 176, 255, 0.4);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 0 0 1px rgba(61, 142, 240, 0.25),
      0 22px 48px rgba(10, 40, 100, 0.4);
  }
  @media (min-width: 900px) {
    .bp-picks__item { grid-template-columns: minmax(0, 300px) minmax(0, 1fr); align-items: start; }
  }

  /* The product's picture, on a pale pane so a white-background product shot
     sits in a frame instead of floating on black. */
  .bp-picks__media {
    position: relative;
    display: block;
    border-radius: 16px;
    overflow: hidden;
    background: #0b0e12;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .bp-picks__media :global(img), .bp-picks__media :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .bp-picks__rank {
    position: absolute;
    z-index: 2;
    top: 0.7rem;
    left: 0.7rem;
    min-width: 2.3rem;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    background: rgba(8, 11, 15, 0.82);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .bp-picks__body { min-width: 0; }
  .bp-picks__head { display: block; }

  .bp-picks__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .bp-picks__chips li {
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.045);
    font-size: 0.92rem;
    color: var(--cs-hi);
  }
  .bp-picks__stars b { font-size: 1.05rem; color: var(--cs-hi); }
  .bp-picks__stars i { color: #f5b942; font-style: normal; }
  .bp-picks__stars em { font-style: normal; font-size: 0.72rem; color: var(--text-tertiary); }
  .bp-picks__chips li span {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .bp-picks__proscons {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.1rem;
  }
  @media (min-width: 700px) {
    .bp-picks__proscons { grid-template-columns: 1fr 1fr; }
  }
  .bp-picks__proscons.is-single { grid-template-columns: 1fr; }
  .bp-picks__pc {
    padding: 0.9rem 1rem 1rem;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.035);
  }
  .bp-picks__pc--pro { border-top: 2px solid rgba(76, 201, 140, 0.7); }
  .bp-picks__pc--con { border-top: 2px solid rgba(245, 185, 66, 0.75); }
  .bp-picks__pc h4 {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cs-hi);
  }
  .bp-picks__pc ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.45rem; }
  .bp-picks__pc li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .bp-picks__pc li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
  }
  .bp-picks__pc--pro li::before { content: "✓"; color: #4cc98c; }
  .bp-picks__pc--con li::before { content: "!"; color: #f5b942; left: 0.2rem; }

  .bp-picks__award {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .bp-picks__name {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.2rem, 3.2vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .bp-picks__name a {
    color: var(--cs-hi);
    text-decoration: none;
  }

  .bp-picks__name a:hover { color: #fff; }
  .bp-picks__name a:focus-visible { outline: var(--focus-ring, 2px solid #dfe4ec); outline-offset: 3px; }

  /* Four catalogue facts, so the plate answers "does it fit my pool" before
     the prose asks the reader to take anything on trust. */
  .bp-picks__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem 1.25rem;
    margin: clamp(1rem, 2.6vw, 1.3rem) 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--cs-line-soft);
  }

  .bp-picks__facts dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .bp-picks__facts dd {
    margin: 0.28rem 0 0;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--cs-hi);
  }

  .bp-picks__why {
    margin: clamp(1rem, 2.6vw, 1.3rem) 0 0;
    font-size: 1.0625rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  /* The rule-out is styled to be read, not buried. A best-of page that hides
     its caveats in small grey type is doing the thing it claims not to. */
  .bp-picks__against {
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border-left: 2px solid rgba(61, 142, 240, 0.45);
    border-radius: 0 10px 10px 0;
    background: rgba(255, 255, 255, 0.025);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .bp-picks__against-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cs-hi);
    margin-bottom: 0.32rem;
  }

  .bp-picks__more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--cs-hi);
    text-decoration: none;
    border-bottom: 1px solid rgba(200, 208, 222, 0.4);
    padding-bottom: 2px;
  }

  .bp-picks__more:hover { color: #fff; border-color: rgba(246, 248, 252, 0.9); }
  .bp-picks__more:focus-visible { outline: var(--focus-ring, 2px solid #dfe4ec); outline-offset: 3px; }

  .bp-picks__note {
    margin: clamp(1.25rem, 3vw, 1.6rem) 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-tertiary);
    max-width: 68ch;
  }

  .bp-picks__note a { color: var(--cs-mid); }

  @media (min-width: 900px) {
    .bp-picks__why { font-size: 1.1rem; }
  }
</style>
