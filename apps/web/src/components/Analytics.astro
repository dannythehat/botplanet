---
/**
 * Cloudflare Web Analytics beacon — free, cookieless, privacy-respecting.
 *
 * Loaded ONLY when both conditions hold:
 *  1. the request host is the production domain (never dev, never preview), and
 *  2. a beacon token is configured as the Worker secret CF_WEB_ANALYTICS_TOKEN.
 *
 * Rendered once, from Base.astro only, so there can be no duplicate beacon.
 * The token is public by design (it appears in the served HTML); it is read from
 * configuration rather than hard-coded so it is not baked into the repository.
 *
 * No paid provider and no additional third-party script is introduced here.
 */
import { isPreviewHost } from "../lib/seo";

const host = Astro.request.headers.get("host");
const env = (Astro.locals as App.Locals).runtime?.env;
const token = env?.CF_WEB_ANALYTICS_TOKEN;

// import.meta.env.PROD is false under `astro dev`, so development never loads it.
const enabled = Boolean(token) && import.meta.env.PROD && !isPreviewHost(host);
---
{enabled && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token })}
  />
)}
