---
/**
 * Honest interim product visual. We do NOT display fake or generic robot photos
 * standing in for a specific product (blueprint image-rights rule). Until
 * licensed manufacturer/retailer imagery with usage evidence is loaded into the
 * media library, product tiles render a branded monogram panel that names the
 * exact model — deliberate, not empty, and never misleading.
 *
 * When a real, image exists, pass `src` and it is used instead.
 */
interface Props {
  name: string;
  brand?: string;
  src?: string | null;
  alt?: string;
  ratio?: string; // e.g. "16 / 10"
  small?: boolean;
}
import { srcsetFor, sizeOf } from "../lib/srcset";
const { name, brand, src, alt, ratio = "16 / 10", small = false } = Astro.props;
const initials = (brand ?? name).split(/\s+/).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
---
{src ? (
  <img class="pv-img" src={src} srcset={srcsetFor(src)} sizes="(min-width: 760px) 320px, 45vw" width={sizeOf(src)?.width} height={sizeOf(src)?.height} alt={alt ?? name} loading="lazy" decoding="async" style={`aspect-ratio:${ratio}`} />
) : (
  <div class:list={["pv", { small }]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`${name} — product imagery pending`}>
    <span class="pv-mono" aria-hidden="true">{initials}</span>
    <span class="pv-name">{name}</span>
    {!small && <span class="pv-note">Manufacturer imagery pending rights clearance</span>}
  </div>
)}
<style>
  .pv-img { width: 100%; object-fit: cover; border-radius: 12px; background: var(--panel-2); }
  .pv { width: 100%; border-radius: 12px; border: 1px solid var(--border-2); background:
      radial-gradient(120% 140% at 20% 0%, rgba(90,110,190,0.14), transparent 60%),
      linear-gradient(160deg, #101018, #08080b);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 18px; text-align: center; position: relative; overflow: hidden; }
  .pv::after { content: ""; position: absolute; inset: 0; background-image:
      radial-gradient(1px 1px at 30px 40px, rgba(255,255,255,0.25), transparent),
      radial-gradient(1px 1px at 120px 90px, rgba(255,255,255,0.18), transparent),
      radial-gradient(1.2px 1.2px at 200px 50px, rgba(255,255,255,0.22), transparent);
    background-size: 220px 160px; opacity: 0.6; pointer-events: none; }
  .pv-mono { font-size: 34px; font-weight: 800; letter-spacing: -0.02em; color: #fff; opacity: 0.92; }
  .pv.small .pv-mono { font-size: 22px; }
  .pv-name { font-size: 13px; font-weight: 600; color: var(--text); max-width: 90%; }
  .pv.small .pv-name { font-size: 11.5px; }
  .pv-note { font-size: 10.5px; color: var(--muted); letter-spacing: 0.02em; }
</style>
