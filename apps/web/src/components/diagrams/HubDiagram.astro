---
/**
 * The category hub's diagram, chosen by category.
 *
 * WHY THIS EXISTS RATHER THAN A PROP ON THE HUB. Every category hub is rendered
 * by ONE template — pages/robots/[category]/index.astro — so a hub diagram
 * cannot be passed in the way a guide passes one: there is no per-category page
 * to pass it from. The alternative is a switch inside the hub template, which
 * puts eight component imports and a lookup table in the middle of a file that
 * is already assembling schema, prices and a comparison grid.
 *
 * So the lookup lives here, in one small file whose entire job is "which drawing
 * belongs to this category". Adding one is a line. A category with no entry
 * renders nothing at all, which is the correct default — a hub with no diagram
 * is a hub, and a placeholder would be worse than the gap.
 *
 * WHAT BELONGS HERE, AND WHAT DOES NOT. A hub diagram answers the question the
 * whole category turns on, which is why each of the three below is drawn from a
 * claim the hub already makes in prose immediately above or below it. A drawing
 * that repeats a section rather than replacing one is decoration, and this site
 * does not add decoration to fill space.
 *
 * DELIBERATELY NOT SHARED WITH THE GUIDES. Every figure in the diagrams folder
 * has exactly one home. A reader who walks the hub into its guide should not
 * meet the same picture twice — the second showing teaches nothing and reads as
 * padding, which is the specific failure that made these worth drawing.
 */
import MowingCadence from "./MowingCadence.astro";
import WindowEdgeReach from "./WindowEdgeReach.astro";
import LitterCycleSafety from "./LitterCycleSafety.astro";

interface Props {
  category: string;
}

const { category } = Astro.props;
---
{category === "robotic-lawn-mowers" && <MowingCadence />}
{category === "window-cleaning-robots" && <WindowEdgeReach />}
{category === "self-cleaning-litter-boxes" && <LitterCycleSafety />}
