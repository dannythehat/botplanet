---
// Original BotPlanet graphic — floor / wall / waterline coverage zones.
// Conceptual; not a depiction of any specific product or test.
---
<figure class="dgm">
  <svg viewBox="0 0 640 300" width="100%" role="img" aria-label="Pool cross-section highlighting the three cleaning zones: floor, walls and waterline.">
    <rect x="0" y="0" width="640" height="300" rx="14" fill="var(--panel)" stroke="var(--border)"/>
    <path d="M70 60 L70 250 L570 250 L570 60" fill="none" stroke="#3a4a66" stroke-width="6" stroke-linecap="round"/>
    <rect x="73" y="96" width="494" height="151" fill="#173a4d" opacity="0.8"/>
    <!-- waterline zone -->
    <rect x="73" y="96" width="494" height="16" fill="#4fd1c5" opacity="0.45"/>
    <!-- wall zones -->
    <rect x="70" y="112" width="10" height="135" fill="#7c93ff" opacity="0.5"/>
    <rect x="560" y="112" width="10" height="135" fill="#7c93ff" opacity="0.5"/>
    <!-- floor zone -->
    <rect x="80" y="240" width="480" height="10" fill="#e0b657" opacity="0.6"/>
    <!-- robot -->
    <rect x="300" y="224" width="46" height="24" rx="6" fill="#c9c9d1"/>
    <circle cx="311" cy="248" r="5" fill="#0b0f17"/><circle cx="335" cy="248" r="5" fill="#0b0f17"/>
    <g font-family="system-ui, sans-serif" font-size="13" font-weight="700">
      <rect x="80" y="70" width="14" height="14" rx="3" fill="#4fd1c5" opacity="0.7"/><text x="100" y="82" fill="#c9c9d1">Waterline — grease &amp; scum line</text>
      <rect x="330" y="70" width="14" height="14" rx="3" fill="#7c93ff" opacity="0.7"/><text x="350" y="82" fill="#c9c9d1">Walls — algae &amp; steps</text>
      <rect x="80" y="272" width="14" height="14" rx="3" fill="#e0b657" opacity="0.8"/><text x="100" y="284" fill="#c9c9d1">Floor — silt, sand, leaves (every robot)</text>
    </g>
  </svg>
  <figcaption class="note">Every robot cleans the floor; wall-climbing adds the walls; only some also scrub the waterline. Match the coverage to where your pool actually gets dirty.</figcaption>
</figure>
<style>.dgm{margin:0}.dgm svg{max-width:640px}.dgm .note{margin-top:8px}</style>
