---
// Original BotPlanet explainer — corded vs cordless robotic pool cleaners.
// Conceptual illustration only; does not depict or imply testing of any product.
---
<figure class="dgm">
  <svg viewBox="0 0 640 260" width="100%" role="img" aria-label="Corded pool robots plug into a power supply with a floating cable; cordless robots run on a rechargeable battery with no cable.">
    <rect x="0" y="0" width="640" height="260" rx="14" fill="var(--panel)" stroke="var(--border)"/>
    <line x1="320" y1="24" x2="320" y2="236" stroke="var(--border-2)" stroke-dasharray="4 5"/>
    <!-- corded side -->
    <g>
      <text x="40" y="46" font-size="15" font-weight="700" fill="#f5f5f7">Corded</text>
      <rect x="40" y="70" width="26" height="20" rx="4" fill="#8b8b95"/><text x="72" y="85" font-size="11" fill="#8b8b95">Power unit</text>
      <path d="M53 90 C 90 150, 180 120, 210 168" fill="none" stroke="#7c93ff" stroke-width="3"/>
      <rect x="205" y="168" width="40" height="22" rx="6" fill="#7c93ff"/>
      <circle cx="215" cy="190" r="4" fill="#0b0f17"/><circle cx="235" cy="190" r="4" fill="#0b0f17"/>
      <text x="40" y="222" font-size="11.5" fill="#c9c9d1">Uninterrupted power · no recharge ·</text>
      <text x="40" y="238" font-size="11.5" fill="#c9c9d1">floating cable can tangle</text>
    </g>
    <!-- cordless side -->
    <g>
      <text x="360" y="46" font-size="15" font-weight="700" fill="#f5f5f7">Cordless</text>
      <rect x="470" y="168" width="40" height="22" rx="6" fill="#4fd1c5"/>
      <circle cx="480" cy="190" r="4" fill="#0b0f17"/><circle cx="500" cy="190" r="4" fill="#0b0f17"/>
      <rect x="482" y="158" width="16" height="7" rx="2" fill="#4fd1c5"/>
      <text x="360" y="86" font-size="11" fill="#8b8b95">🔋 On-board battery</text>
      <rect x="360" y="96" width="70" height="12" rx="6" fill="var(--panel-2)" stroke="var(--border-2)"/>
      <rect x="362" y="98" width="48" height="8" rx="4" fill="#4fd1c5"/>
      <text x="360" y="222" font-size="11.5" fill="#c9c9d1">No cable to snag · easy handling ·</text>
      <text x="360" y="238" font-size="11.5" fill="#c9c9d1">runtime-limited · battery ages</text>
    </g>
  </svg>
  <figcaption class="note">Corded units draw constant power through a floating cable; cordless units run on a rechargeable battery with nothing trailing in the water.</figcaption>
</figure>
<style>
  .dgm { margin: 0; } .dgm svg { max-width: 640px; }
  .dgm .note { margin-top: 8px; }
</style>
