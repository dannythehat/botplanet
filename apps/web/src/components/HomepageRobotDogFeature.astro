---
import { srcsetFor } from "../lib/srcset";
---

<section class="home-dog" aria-labelledby="home-dog-title">
  <div class="wrap home-dog__card">
    <figure class="home-dog__media">
      <img
        src="/media/hubs/companion/tile.webp"
        srcset={srcsetFor("/media/hubs/companion/tile.webp")}
        sizes="(min-width: 960px) 46vw, 100vw"
        width="1536"
        height="1024"
        alt="Companion robots, including a robot dog, shown together."
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="home-dog__copy">
      <p class="home-dog__kicker">FEATURED BUYING GUIDE</p>
      <h2 id="home-dog-title">Best robot dog toys &amp; AI robot dogs in 2026</h2>
      <p>
        Robot dog can mean a simple toy for a child, an AI companion such as Loona,
        an open-source coding project or a serious ROS quadruped. Our guide separates
        those choices and shows which type actually fits the buyer.
      </p>
      <div class="home-dog__actions">
        <a class="btn btn--accent btn--lg" href="/guides/robot-dog-toys/">Compare robot dogs</a>
        <a class="btn btn--quiet btn--lg" href="/robots/companion-robots/">Explore companion robots</a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-dog { padding: clamp(1.1rem,2.4vw,2rem) 0 clamp(2rem,4vw,3.5rem); }
  .home-dog__card {
    display:grid;
    grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);
    gap:clamp(24px,4vw,52px);
    align-items:center;
    padding:clamp(1.5rem,4vw,3rem);
    border:1px solid rgba(200,208,222,.2);
    border-radius:22px;
    background:radial-gradient(ellipse at 8% 0%,rgba(143,230,255,.08),transparent 58%),linear-gradient(178deg,#11151b 0%,#0a0d11 62%,#0d1116 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 26px 60px rgba(0,0,0,.5);
  }
  .home-dog__media { margin:0; overflow:hidden; border:1px solid rgba(200,208,222,.16); border-radius:18px; background:#080b0f; }
  .home-dog__media img { display:block; width:100%; height:auto; aspect-ratio:3/2; object-fit:cover; }
  .home-dog__kicker { margin:0 0 12px; color:#8fe6ff; font-family:var(--font-mono); font-size:12px; font-weight:800; letter-spacing:.16em; }
  .home-dog__copy h2 { margin:0; max-width:16ch; font-size:clamp(32px,4vw,54px); line-height:1.02; letter-spacing:-.045em; }
  .home-dog__copy > p:not(.home-dog__kicker) { margin:18px 0 0; max-width:58ch; color:var(--text-secondary); font-size:17px; line-height:1.65; }
  .home-dog__actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:24px; }
  @media(max-width:820px){
    .home-dog__card{grid-template-columns:1fr}
    .home-dog__media{order:-1}
    .home-dog__actions .btn{width:100%;justify-content:center}
  }
</style>
