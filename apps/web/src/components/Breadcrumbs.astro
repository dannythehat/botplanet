---
import type { Crumb } from "../lib/seo";
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
{items.length > 0 && (
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      {items.map((c, i) => (
        <li>
          {i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}
        </li>
      ))}
    </ol>
  </nav>
)}
<style>
  .crumbs { margin: 0 0 20px; }
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; font-size: 13px; color: var(--muted); }
  .crumbs li { display: flex; align-items: center; gap: 6px; }
  .crumbs li:not(:first-child)::before { content: "›"; color: var(--border-2); }
  .crumbs a { color: var(--muted); } .crumbs a:hover { color: var(--text); }
  .crumbs [aria-current] { color: var(--text); }
</style>
