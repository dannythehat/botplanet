---
import type { Crumb } from "../lib/seo";
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
{items.length > 0 && (
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      {items.map((c, i) => (
        <li>
          {i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}
        </li>
      ))}
    </ol>
  </nav>
)}
<style>
  .crumbs { margin: 0 0 var(--space-lg); }

  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    padding: 0;
    margin: 0;
    font-size: var(--type-meta);
    color: var(--text-tertiary);
  }

  .crumbs li { display: flex; align-items: center; gap: var(--space-xs); margin: 0; }

  .crumbs li:not(:first-child)::before {
    content: "/";
    color: var(--text-quaternary);
    font-family: var(--font-mono);
  }

  .crumbs a { color: var(--text-tertiary); padding: 2px 0; }
  .crumbs a:hover { color: var(--text-primary); }
  .crumbs a:focus-visible { outline: var(--focus-ring); outline-offset: 3px; }
  .crumbs [aria-current] { color: var(--text-secondary); }
</style>
