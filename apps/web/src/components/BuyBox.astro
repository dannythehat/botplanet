---
/* ============================================================
   BotPlanet — the buy box.

   THE PROBLEM IT FIXES. The affiliate link existed on the review
   page — it was a "View offer" text link in the last column of a
   six-column table, below the fold, styled like every other cell.
   A reader who had just finished 2,000 words and decided to buy
   had nowhere obvious to go.

   WHAT IT WILL NOT DO. Invent urgency. No countdowns, no "lowest
   price", no "only 3 left". The price carries the date it was
   checked, and if that check is stale the box says so instead of
   showing a number as though it were current.

   Every link is rel="sponsored nofollow" and routes through /go so
   the click is attributed and counted. The disclosure sits inside
   the box, not in a footer nobody reads.
   ============================================================ */
import { srcsetFor } from "../lib/srcset";

export interface BuyOffer {
  retailerName: string;
  /** Marketplace seller, where the retailer is a marketplace. */
  sellerIdentity?: string | null;
  /** Formatted price, or null when no confirmed price exists. */
  price: string | null;
  /** ISO date the price was checked. */
  checkedDate: string | null;
  stock: string | null;
  shipping: string | null;
  /** /go redirect key. Without one there is no link. */
  redirectKey: string | null;
  /** True when this is the offer we would send someone to. */
  primary?: boolean;
}

interface Props {
  productName: string;
  offers: BuyOffer[];
  /** Product artwork for the box. Optional. */
  image?: { src: string; alt: string } | null;
  /** Shown when there is no linkable offer at all. */
  emptyNote?: string;
}

const { productName, offers, image, emptyNote } = Astro.props;
const linkable = offers.filter((o) => o.redirectKey);
const lead = linkable.find((o) => o.primary) ?? linkable[0] ?? null;
const others = linkable.filter((o) => o !== lead);
---

<section class="bp-buy" id="buy" aria-labelledby="buy-heading">
  <div class="bp-buy__plate">
    <p class="bp-buy__eyebrow">Where to buy</p>
    <h2 id="buy-heading">{productName}</h2>

    {lead ? (
      <>
        <div class="bp-buy__lead">
          {image?.src && (
            <a
              class="bp-buy__art"
              href={`/go/${lead.redirectKey}`}
              rel="sponsored nofollow"
              tabindex="-1"
              aria-hidden="true"
            >
              <img
                src={image.src}
                srcset={srcsetFor(image.src)}
                sizes="(min-width: 760px) 260px, 40vw"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </a>
          )}

          <div class="bp-buy__detail">
            <p class="bp-buy__retailer">
              {lead.retailerName}
              {lead.sellerIdentity && <span class="bp-buy__seller">sold by {lead.sellerIdentity}</span>}
            </p>

            <p class="bp-buy__price">
              {lead.price ?? <span class="bp-buy__noprice">Check current price</span>}
            </p>

            <ul class="bp-buy__meta">
              {lead.stock && <li>{lead.stock}</li>}
              {lead.shipping && <li>{lead.shipping}</li>}
              {lead.checkedDate && <li>Price checked {lead.checkedDate}</li>}
            </ul>

            <a class="bp-buy__cta" href={`/go/${lead.redirectKey}`} rel="sponsored nofollow">
              <span>View on {lead.retailerName}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        {others.length > 0 && (
          <ul class="bp-buy__others">
            {others.map((o) => (
              <li>
                <a href={`/go/${o.redirectKey}`} rel="sponsored nofollow">
                  <span class="bp-buy__oname">{o.retailerName}</span>
                  <span class="bp-buy__oprice">{o.price ?? "Check price"}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </>
    ) : (
      <p class="bp-buy__empty">
        {emptyNote ??
          "No verified offer yet. We only show a price once someone has checked the seller's page on a recorded date — we would rather show nothing than a figure that has quietly gone out of date."}
      </p>
    )}

    <p class="bp-buy__disclosure">
      BotPlanet may earn a commission from this link. It never changes which robot we recommend —
      commission is not available to the part of the system that ranks them.
    </p>
  </div>
</section>

<style is:global>
  .bp-buy { margin: clamp(2.5rem, 6vw, 4rem) 0; scroll-margin-top: 5rem; }

  /* Dark plate with a bright milled edge — the counterpart to the silver
     snapshot, so the page opens and closes on the same material. */
  .bp-buy__plate {
    position: relative;
    overflow: hidden;
    padding: clamp(1.4rem, 4vw, 2.4rem);
    border: 1px solid rgba(214, 222, 235, 0.34);
    border-radius: 22px;
    background:
      radial-gradient(120% 90% at 10% -20%, rgba(226, 234, 248, 0.1), transparent 60%),
      linear-gradient(178deg, #151a21 0%, #0a0d11 60%, #0e1218 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 28px 34px rgba(0, 0, 0, 0.55);
  }

  .bp-buy__plate::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(246, 248, 252, 0.7) 30%, rgba(255,255,255,.95) 50%, rgba(246, 248, 252, 0.65) 70%, transparent);
  }

  .bp-buy__eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: var(--cs-sheen);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bp-buy h2 {
    margin: 0 0 clamp(1.1rem, 2.6vw, 1.6rem);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    letter-spacing: -0.022em;
    line-height: 1.14;
    color: var(--cs-hi);
  }

  .bp-buy__lead { display: grid; gap: clamp(1rem, 2.6vw, 1.6rem); align-items: center; }

  .bp-buy__art {
    display: block;
    border: 1px solid var(--cs-line-soft);
    border-radius: 14px;
    overflow: hidden;
    background: var(--cs-surface);
  }

  .bp-buy__art img { display: block; width: 100%; height: auto; }

  .bp-buy__retailer {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--cs-hi);
  }

  .bp-buy__seller { font-family: var(--font-body); font-size: 0.82rem; font-weight: 400; color: var(--text-quaternary); }

  .bp-buy__price {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    background: linear-gradient(172deg, #ffffff 4%, #e8ecf3 46%, #a4acb9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* An unconfirmed price is visibly not a number — it can never be skim-read
     as one, which a blank or a placeholder figure both can. */
  .bp-buy__noprice {
    font-size: 1.15rem;
    font-style: italic;
    letter-spacing: 0;
    -webkit-text-fill-color: var(--text-tertiary);
    color: var(--text-tertiary);
  }

  .bp-buy__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.86rem;
    color: var(--text-tertiary);
  }

  .bp-buy__meta li { position: relative; padding-left: 0.95rem; }
  .bp-buy__meta li::before {
    content: "";
    position: absolute; left: 0; top: 0.5em;
    width: 0.34rem; height: 0.34rem;
    transform: rotate(45deg);
    background: var(--cs-sheen);
  }

  .bp-buy__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.1rem;
    width: min(100%, 22rem);
    min-height: 3.5rem;
    margin: 1.15rem 0 0;
    padding: 0 1.1rem 0 1.4rem;
    border-radius: 13px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    background: linear-gradient(178deg, #ffffff 0%, #e4e9f0 42%, #b9c1cd 100%);
    color: #0a0d11;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95), inset 0 -2px 0 rgba(0,0,0,.18), 0 12px 28px rgba(0, 0, 0, 0.5);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .bp-buy__cta svg { width: 1.1rem; height: 1.1rem; }
  .bp-buy__cta:hover { transform: translateY(-2px); box-shadow: inset 0 1px 0 rgba(255,255,255,.95), inset 0 -2px 0 rgba(0,0,0,.18), 0 18px 38px rgba(0,0,0,.6); }
  .bp-buy__cta:focus-visible { outline: 2px solid #dfe4ec; outline-offset: 3px; }

  .bp-buy__others {
    display: grid;
    gap: 0.5rem;
    margin: 1.2rem 0 0;
    padding: 1.2rem 0 0;
    border-top: 1px solid var(--cs-line-soft);
    list-style: none;
  }

  .bp-buy__others a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--cs-line-soft);
    border-radius: 11px;
    background: var(--cs-surface);
    color: var(--cs-hi);
    text-decoration: none;
    font-size: 0.95rem;
    transition: border-color 0.18s ease;
  }

  .bp-buy__others a:hover { border-color: var(--cs-line); }
  .bp-buy__oname { font-weight: 700; }
  .bp-buy__oprice { color: var(--text-secondary); }

  .bp-buy__empty { margin: 0; font-size: 1rem; line-height: 1.65; color: var(--text-secondary); }

  .bp-buy__disclosure {
    margin: 1.25rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--cs-line-soft);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-quaternary);
  }

  @media (min-width: 760px) {
    .bp-buy__lead { grid-template-columns: 260px 1fr; }
    .bp-buy__others { grid-template-columns: repeat(2, 1fr); }
  }
</style>
