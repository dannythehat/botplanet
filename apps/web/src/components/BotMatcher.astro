---
/* ============================================================
   BotMatch funnel.

   Ported from the CryptoWatchdog matcher: five stages held in
   one component — landing → quiz → analysing → capture → done.
   Same structure, same perceived-value beat, same honeypot.

   Rewritten as a vanilla island, because this app deliberately
   runs no React on the worker (see astro.config.mjs). No
   framer-motion, no icon library — CSS transitions and inline
   SVG instead.

   To change the questions, edit content/matcher-questions.ts.
   Nothing in here needs to change.
   ============================================================ */

import { ANALYSE_MS, type MatcherQuestion } from "../content/matcher-questions";

export interface MatcherCategory {
  slug: string;
  name: string;
  questions: MatcherQuestion[];
  tasks: string[];
  /** False when the catalogue cannot support a pick — see matcher-router.ts. */
  matchable: boolean;
  /** The sentence shown instead of a result when `matchable` is false. */
  emptyState: string;
  hubHref: string;
}

interface Props {
  /* Questions and tasks are PASSED IN, not imported. The component used to
     import one global array, which is how every category ended up sharing the
     pool questionnaire. Making them required props means a caller cannot
     render this funnel without deciding, explicitly, which category's
     questions it is rendering. */
  categories: MatcherCategory[];
  /**
   * "single" — one category, chosen by the URL. The original behaviour.
   * "choose" — the universal entry: ask what job the robot should do first,
   *            then run the chosen categories' own question sets in sequence.
   *
   * BOTH MODES ARE THIS COMPONENT because the second is the first with a
   * question in front of it. A separate universal funnel would have meant two
   * copies of the stage machine, the honeypot, the tie handling and the lead
   * submit, and the second copy would have drifted. It always does.
   */
  mode: "single" | "choose";
  jobs?: { id: string; label: string; description: string; categorySlug: string }[];
}
const { categories, mode, jobs = [] } = Astro.props;

/* In single mode there is exactly one, and the landing copy names it. In
   choose mode the landing is about the site rather than a category. */
const only = categories.length === 1 ? categories[0] : null;
const categorySlug = only?.slug ?? "universal";
const categoryName = only?.name ?? "robot";

/* Landing copy, per category.

   This block said "for your pool" and "Pool type, size, coverage, power and
   budget" for EVERY category until 6 August 2026, because pool was the only
   one when it was written. It went live on a window URL on 5 August reading
   "Find the right window-cleaning robots for your pool".

   Every line here now names what the category's own questions actually ask.
   A category added later without an entry gets wording that is general but
   still true, never another category's specifics.

   The question count is counted, not typed. It said "Eight short questions"
   while the funnel asked seven. */
/* @extension-point per-category | optional | The funnel falls back to general
   wording — "for you", and a criteria line that does not name the category's
   real inputs. True, but flat, and it wastes the one line that tells a reader
   we understand their problem. */
const COPY: Record<string, { audience: string; criteria: string }> = {
  "robotic-pool-cleaners": {
    audience: "for your pool",
    criteria: "Pool type, size, coverage, power and budget — nothing else.",
  },
  "window-cleaning-robots": {
    audience: "for your windows",
    criteria: "Framed or frameless, which glass, power and budget — nothing else.",
  },
  "robotic-lawn-mowers": {
    audience: "for your lawn",
    criteria: "Lawn size, tree cover, slopes, zones and budget — nothing else.",
  },
  "companion-robots": {
    audience: "for whoever it's for",
    criteria: "Who it's for, subscription tolerance, movement, conversation and budget — nothing else.",
  },
  "pet-camera-robots": {
    audience: "for your home",
    criteria: "Stairs, floors, what you need to do remotely and budget — nothing else.",
  },
  "self-cleaning-litter-boxes": {
    audience: "for your cat",
    criteria: "Cat size, how many cats, litter type, tracking and budget — nothing else.",
  },
  "grill-cleaning-robots": {
    audience: "for your grill",
    criteria: "Grate material, bar spacing, how often you cook and budget — nothing else.",
  },
  "robot-vacuums": {
    audience: "for your floors",
    criteria: "Floor type, hair, clutter, self-emptying and budget — nothing else.",
  },
  "educational-coding-robots": {
    audience: "for the child",
    criteria: "Age, whether a tablet is free, what you want from it and budget — nothing else.",
  },
};
const copy = COPY[categorySlug] ?? {
  audience: "for you",
  criteria: "What you need it to do, where it has to work, and your budget — nothing else.",
};
const COUNT_WORDS = ["no", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten"];
/* Counted, never typed. It said "Eight short questions" while the funnel asked
   seven. In choose mode there is no single number to give, because the reader
   has not picked a category yet — so the landing says what is true instead. */
const countWord = only ? (COUNT_WORDS[only.questions.length] ?? String(only.questions.length)) : "";

const payload = JSON.stringify({
  categories: categories.map((c) => ({
    slug: c.slug, name: c.name, questions: c.questions, tasks: c.tasks,
    matchable: c.matchable, emptyState: c.emptyState, hubHref: c.hubHref,
  })),
  jobs,
  mode,
  analyseMs: ANALYSE_MS,
});
---

<div class="bp-mm" data-matcher data-config={payload}>
  <!-- progress -->
  <div class="bp-mm__progress" data-progress-wrap hidden>
    <span class="bp-mm__progress-bar" data-progress></span>
  </div>

  <!-- 1. landing -->
  <section class="bp-mm__stage" data-stage="landing">
    <span class="bp-mm__eyebrow">BotMatch</span>
    {only ? (
      <>
        <h1 class="bp-mm__title">Find the right {categoryName.toLowerCase()} {copy.audience}</h1>
        <p class="bp-mm__lead">
          {countWord} short questions, about a minute. No account, nothing to install. We match you
          against the robots we have actually researched — and the part that picks your robot
          cannot see prices or commission at all.
        </p>
        <ul class="bp-mm__steps">
          <li><strong>Answer {only.questions.length} questions</strong><span>Plain English. Tap what sounds like you.</span></li>
          <li><strong>We match on suitability</strong><span>{copy.criteria}</span></li>
          <li><strong>We send your result</strong><span>Your match, why it won, and what it does not do well.</span></li>
        </ul>
      </>
    ) : (
      <>
        <h1 class="bp-mm__title">Find your robot</h1>
        <p class="bp-mm__lead">
          Start with the job you want done, not with our categories. A minute of questions, no
          account, nothing to install — and the part that picks your robot cannot see prices or
          commission at all.
        </p>
        <ul class="bp-mm__steps">
          <li><strong>Say what you need done</strong><span>Pick one job, or more than one. Not sure? We will show you the list.</span></li>
          <li><strong>Answer a few questions</strong><span>Each job has its own questions. Nothing borrowed from another category.</span></li>
          <li><strong>We send your result</strong><span>Your match, why it won, and what it does not do well.</span></li>
        </ul>
      </>
    )}

    {/* THE BUTTON THAT STARTS THE WHOLE THING, and the one the universal
        rewrite deleted. The landing stage was rebuilt into two branches — one
        category or nine — and the CTA under the old single-category copy went
        with the copy. The script still bound it, unguarded, on the first line
        of its wiring block, so the island threw before it rendered anything and
        EVERY funnel on the site sat dead behind a landing page with no way
        forward. Nothing caught it: the tests read the file as text, and the
        markup was valid. It took a browser.

        Two labels, because in "choose" mode the next thing the reader sees is
        the job list rather than a question, and "it takes a minute" is a promise
        about a questionnaire they have not chosen yet. */}
    <button class="btn btn--accent bp-mm__cta" type="button" data-start>
      {only ? "Start — it takes a minute" : "Start — say what you need done"}
    </button>
    <p class="bp-mm__note">Free. No account needed.</p>
  </section>

  <!-- 1b. chooser (choose mode only) -->
  <section class="bp-mm__stage" data-stage="choose" hidden>
    <span class="bp-mm__kicker">First question</span>
    <h2 class="bp-mm__q">What do you want the robot to do?</h2>
    <p class="bp-mm__choosehint">Pick as many as apply. Each one adds its own short set of questions.</p>
    <div class="bp-mm__jobs" data-jobs></div>
    <button class="bp-mm__notsure" type="button" data-notsure>Not sure yet — show me what these all are</button>
    <button class="btn btn--accent bp-mm__cta" type="button" data-jobs-next disabled>Continue</button>
  </section>

  <!-- 2. quiz -->
  <section class="bp-mm__stage" data-stage="quiz" hidden>
    <div class="bp-mm__qhead">
      <button class="bp-mm__back" type="button" data-back aria-label="Previous question">← Back</button>
      <span class="bp-mm__count" data-count></span>
    </div>
    <span class="bp-mm__kicker" data-kicker></span>
    <h2 class="bp-mm__q" data-question></h2>
    <div class="bp-mm__options" data-options></div>
  </section>

  <!-- 3. analysing -->
  <section class="bp-mm__stage" data-stage="analysing" hidden>
    <span class="bp-mm__kicker">Working through it</span>
    <h2 class="bp-mm__q" data-analysing-title>Matching what you told us against what we have researched</h2>
    <ul class="bp-mm__tasks" data-tasks></ul>
  </section>

  <!-- 4. capture -->
  <section class="bp-mm__stage" data-stage="capture" hidden>
    <span class="bp-mm__eyebrow">Result ready</span>
    <h2 class="bp-mm__title bp-mm__title--sm">Want a copy by email?</h2>
    <p class="bp-mm__lead">
      Your match is ready. Email is optional: send yourself the saved result link, or continue
      straight to the answer on this screen.
    </p>

    <form class="bp-mm__form" data-form novalidate>
      <!-- honeypots: never shown, never filled by a person -->
      <div class="bp-mm__hp" aria-hidden="true">
        <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        <label>Website<input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label>
      </div>

      <label class="bp-mm__field">
        <span>First name</span>
        <input type="text" name="firstName" autocomplete="given-name" required />
      </label>
      <label class="bp-mm__field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="bp-mm__consent">
        <input type="checkbox" name="consent" required />
        <span>Yes, email me my BotMatch result. No spam, unsubscribe any time.</span>
      </label>

      <p class="bp-mm__error" data-error hidden></p>
      <button class="btn btn--accent bp-mm__cta" type="submit" data-submit>Email my result</button>
    </form>
    <button class="bp-mm__skip-email" type="button" data-skip-email>
      Skip email — show my result
    </button>
  </section>

  <!-- 5. done -->
  <section class="bp-mm__stage" data-stage="done" hidden>
    <span class="bp-mm__eyebrow" data-done-eyebrow>Result ready</span>
    <h2 class="bp-mm__title bp-mm__title--sm" data-done-title>Your results</h2>
    <p class="bp-mm__lead" data-done-msg>
      Here is what matches your answers, including where our current evidence cannot separate
      two robots or support a fair comparison.
    </p>
    <div class="bp-mm__results" data-results></div>
  </section>
</div>

<script>
  type Opt = { label: string; hint?: string; scores?: Record<string, unknown> };
  type Q = { id: string; kicker: string; q: string; options: Opt[] };

  document.querySelectorAll<HTMLElement>("[data-matcher]").forEach((root) => {
    type Cat = {
      slug: string; name: string; questions: Q[]; tasks: string[];
      matchable: boolean; emptyState: string; hubHref: string;
    };
    type Job = { id: string; label: string; description: string; categorySlug: string };

    const cfg = JSON.parse(root.dataset.config || "{}") as {
      categories: Cat[]; jobs: Job[]; mode: "single" | "choose"; analyseMs: number;
    };
    const { categories, jobs, mode, analyseMs } = cfg;

    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const stages = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>("[data-stage]").forEach((el) => stages.set(el.dataset.stage!, el));

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ONE RUN PER CATEGORY, IN SEQUENCE. `selected` is what the reader chose in
       choose mode, or the single category in single mode. `catIndex` walks it.
       Answers are kept per category because two question sets can and do share
       question ids — budget is `budget` in all nine — and folding them into one
       object would let a lawn answer overwrite a pool one. */
    let selected: Cat[] = mode === "choose" ? [] : categories.slice();
    let catIndex = 0;
    const answersByCat: Record<string, Record<string, string>> = {};
    const resultsByCat: Record<string, { token: string | null; productName: string | null; equivalent: string[] }> = {};

    let step = 0;
    let locked = false;

    const cur = () => selected[catIndex];
    const answers = () => (answersByCat[cur().slug] ??= {});

    const track = (name: string, params: Record<string, unknown> = {}) => {
      (window as any).gtag?.("event", name, { ...params, category: cur()?.slug ?? "universal", mode });
    };

    const progressWrap = q<HTMLElement>("[data-progress-wrap]");
    const progressBar = q<HTMLElement>("[data-progress]");

    /* Progress across the WHOLE run, not the current category. Two categories
       selected means the bar reaches half way at the end of the first set — a
       bar that filled and reset would read as the funnel starting over. */
    function quizPct() {
      const total = selected.reduce((n, c) => n + c.questions.length, 0) || 1;
      const done = selected.slice(0, catIndex).reduce((n, c) => n + c.questions.length, 0) + step;
      return (done / total) * 92;
    }

    function show(name: string) {
      stages.forEach((el, key) => { el.hidden = key !== name; });
      progressWrap.hidden = name === "landing";
      const pct = name === "quiz" ? quizPct()
        : name === "choose" ? 4 : name === "analysing" ? 96 : name === "capture" ? 98 : name === "done" ? 100 : 0;
      progressBar.style.width = `${pct}%`;
      if (name !== "landing") root.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    }

    /* ---------- 1b. chooser ---------- */
    const chosenJobs = new Set<string>();

    function renderJobs(showDescriptions: boolean) {
      const box = q<HTMLElement>("[data-jobs]");
      box.innerHTML = "";
      jobs.forEach((job) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "bp-mm__job" + (chosenJobs.has(job.id) ? " is-picked" : "");
        b.setAttribute("aria-pressed", chosenJobs.has(job.id) ? "true" : "false");
        b.innerHTML =
          `<span class="bp-mm__job-tick" aria-hidden="true"></span>` +
          `<span class="bp-mm__job-text"><strong>${job.label}</strong>` +
          (showDescriptions ? `<span>${job.description}</span>` : "") + `</span>`;
        b.addEventListener("click", () => {
          if (chosenJobs.has(job.id)) chosenJobs.delete(job.id);
          else chosenJobs.add(job.id);
          renderJobs(showDescriptions);
          q<HTMLButtonElement>("[data-jobs-next]").disabled = chosenJobs.size === 0;
        });
        box.appendChild(b);
      });
    }

    /* ---------- quiz ---------- */
    function renderQuestion() {
      const cat = cur();
      const question = cat.questions[step];
      q<HTMLElement>("[data-kicker]").textContent =
        selected.length > 1 ? `${cat.name} · ${question.kicker}` : question.kicker;
      q<HTMLElement>("[data-question]").textContent = question.q;
      q<HTMLElement>("[data-count]").textContent =
        selected.length > 1
          ? `${cat.name}: ${step + 1} of ${cat.questions.length}`
          : `${step + 1} of ${cat.questions.length}`;
      q<HTMLElement>("[data-back]").style.visibility = step === 0 && catIndex === 0 ? "hidden" : "visible";

      const box = q<HTMLElement>("[data-options]");
      box.innerHTML = "";
      question.options.forEach((opt, i) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "bp-mm__opt";
        b.innerHTML =
          `<span class="bp-mm__opt-key">${String.fromCharCode(65 + i)}</span>` +
          `<span class="bp-mm__opt-text"><strong>${opt.label}</strong>` +
          (opt.hint ? `<span>${opt.hint}</span>` : "") + `</span>`;
        b.addEventListener("click", () => choose(question, opt, b));
        box.appendChild(b);
      });
      progressBar.style.width = `${quizPct()}%`;
    }

    function choose(question: Q, opt: Opt, btn: HTMLElement) {
      if (locked) return;
      locked = true;
      btn.classList.add("is-picked");
      answers()[question.id] = opt.label;
      track("matcher_answer", { step: step + 1, question: question.id, value: opt.label });
      window.setTimeout(() => {
        locked = false;
        if (step + 1 < cur().questions.length) { step += 1; renderQuestion(); }
        else if (catIndex + 1 < selected.length) { catIndex += 1; step = 0; renderQuestion(); }
        else { track("matcher_analysing_view"); runAnalysis(); }
      }, reduce ? 0 : 380);
    }

    /* ---------- analysing ---------- */
    function runAnalysis() {
      show("analysing");
      q<HTMLElement>("[data-analysing-title]").textContent =
        selected.length > 1
          ? `Matching what you told us across ${selected.length} categories`
          : `Matching what you told us against what we have researched`;

      const list = q<HTMLElement>("[data-tasks]");
      list.innerHTML = "";
      /* The tasks belong to the categories being run. With more than one
         selected they are concatenated and de-duplicated — several sets open
         with the same line, and repeating it reads as a stuck progress list. */
      const seen = new Set<string>();
      const taskText = selected.flatMap((c) => c.tasks).filter((t) => !seen.has(t) && seen.add(t));
      const items = taskText.map((t) => {
        const li = document.createElement("li");
        li.innerHTML = `<span class="bp-mm__tick"></span><span>${t}</span>`;
        list.appendChild(li);
        return li;
      });

      void scoreInBackground();

      const per = Math.max(400, Math.floor(analyseMs / Math.max(1, items.length)));
      items.forEach((li, i) => window.setTimeout(() => li.classList.add("is-done"), per * (i + 1)));
      window.setTimeout(() => { track("matcher_capture_view"); show("capture"); }, analyseMs);
    }

    /* Folds the chosen options' `scores` fragments into the shape the scoring
       engine expects. Profile-only questions carry no fragment, so they cannot
       reach the scorer even by accident. Per category, because the fragments
       are only meaningful against that category's own stored config. */
    /* `desired_cleans` UNIONS. EVERYTHING ELSE IS LAST-WINS.

       This was `Object.assign` until 10 August 2026, which meant the last
       question to mention `desired_cleans` threw away every capability the
       reader had asked for before it. A vacuum reader who said hard floors,
       shedding animal, cluttered floor and yes-empty-itself reached the scorer
       wanting ONE capability, and four of their five answers had been
       collected for nothing.

       It must stay identical to mergeScores() in content/matcher-questions.ts,
       which is the server-side twin. Two folders that disagree would mean the
       page scored one thing and the tests asserted another. */
    function toScoringAnswers(cat: Cat): Record<string, unknown> {
      const out: Record<string, unknown> = {};
      const given = answersByCat[cat.slug] ?? {};
      for (const question of cat.questions) {
        const chosen = given[question.id];
        if (!chosen) continue;
        const opt = question.options.find((o) => o.label === chosen);
        if (!opt?.scores) continue;
        for (const [key, value] of Object.entries(opt.scores)) {
          if (key === "desired_cleans" && Array.isArray(value)) {
            const prior = (out.desired_cleans as string[] | undefined) ?? [];
            out.desired_cleans = [...new Set([...prior, ...(value as string[])])];
          } else {
            out[key] = value;
          }
        }
      }
      return out;
    }

    /* ONE CALL PER CATEGORY, TO THE SAME ENDPOINT. /api/botmatch is unchanged:
       it still scores one category against that category's own stored config,
       still refuses to pick a winner out of a tie, and still writes its own
       recommendation row. Nothing about how a product is chosen lives here. */
    async function scoreInBackground() {
      await Promise.all(selected.map(async (cat) => {
        if (!cat.matchable) return;
        try {
          const res = await fetch("/api/botmatch", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ category: cat.slug, answers: toScoringAnswers(cat) }),
          });
          if (!res.ok) return;
          const data = await res.json();
          resultsByCat[cat.slug] = {
            token: data.token ?? null,
            productName: data.productName ?? null,
            equivalent: Array.isArray(data.equivalent) ? data.equivalent : [],
          };
        } catch { /* the funnel must not fail because scoring did */ }
      }));
    }

    /* ---------- capture ---------- */
    const form = q<HTMLFormElement>("[data-form]");
    const errBox = q<HTMLElement>("[data-error]");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const firstName = String(fd.get("firstName") || "").trim();
      const email = String(fd.get("email") || "").trim();
      const consent = fd.get("consent") != null;

      const fail = (m: string) => { errBox.textContent = m; errBox.hidden = false; };
      errBox.hidden = true;
      if (!firstName) return fail("Please enter your first name.");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return fail("Please enter a valid email address.");
      if (!consent) return fail("Please tick the box so we can email your result.");

      const btn = q<HTMLButtonElement>("[data-submit]");
      btn.disabled = true;
      btn.textContent = "Sending…";

      /* ONE EMAIL, FOR THE FIRST CATEGORY THAT PRODUCED A RESULT.
         /api/matcher-lead writes category-specific copy — it reflects the
         reader's own answers back in that category's language — so a combined
         email would need new prose for every combination of nine. Every result
         is saved and linked on this page instead, and the capture copy says so
         rather than implying the inbox will hold all of them. */
      const lead = selected.find((c) => resultsByCat[c.slug]?.token) ?? selected[0];
      const leadResult = lead ? resultsByCat[lead.slug] : undefined;

      try {
        const res = await fetch("/api/matcher-lead", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            firstName, email, consent,
            categorySlug: lead?.slug,
            answers: lead ? (answersByCat[lead.slug] ?? {}) : {},
            resultToken: leadResult?.token ?? null,
            productName: leadResult?.productName ?? null,
            company: fd.get("company") || "",
            website_url: fd.get("website_url") || "",
            submittedAt: new Date().toISOString(),
            sourcePage: mode === "choose" ? "botmatch" : `botmatch/${lead?.slug ?? ""}`,
          }),
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (!data.ok) { btn.disabled = false; btn.textContent = "Email my result"; return fail(data.error || "Something went wrong. Please try again."); }
      } catch {
        btn.disabled = false; btn.textContent = "Email my result";
        return fail("Network problem. Please try again.");
      }

      track("matcher_lead_submit", { sourcePage: mode === "choose" ? "botmatch" : `botmatch/${lead?.slug ?? ""}` });
      q<HTMLElement>("[data-done-eyebrow]").textContent = "On its way";
      q<HTMLElement>("[data-done-title]").textContent = "Check your inbox";
      q<HTMLElement>("[data-done-msg]").textContent =
        "Your result is on its way. If it has not arrived shortly, check your spam folder.";
      renderResults();
      show("done");
    });

    q<HTMLElement>("[data-skip-email]").addEventListener("click", () => {
      track("matcher_result_without_email");
      q<HTMLElement>("[data-done-eyebrow]").textContent = "Result ready";
      q<HTMLElement>("[data-done-title]").textContent = "Your results";
      q<HTMLElement>("[data-done-msg]").textContent =
        "Here is what matches your answers, including where our current evidence cannot separate two robots or support a fair comparison.";
      renderResults();
      show("done");
    });

    /* ---------- done: one block per category ---------- */
    function renderResults() {
      const box = q<HTMLElement>("[data-results]");
      box.innerHTML = "";

      selected.forEach((cat) => {
        const wrap = document.createElement("div");
        wrap.className = "bp-mm__result";

        /* THE HONEST EMPTY STATE. A category we cannot pick from says so and
           sends the reader to the hub. It never falls through to "no match",
           which reads as a failure of their answers rather than of our
           catalogue. */
        if (!cat.matchable) {
          wrap.innerHTML =
            `<h3>${cat.name}</h3><p>${cat.emptyState}</p>` +
            `<a class="bp-mm__resultlink" href="${cat.hubHref}">Read what we know about ${cat.name.toLowerCase()} →</a>`;
          box.appendChild(wrap);
          return;
        }

        const r = resultsByCat[cat.slug];
        if (!r || !r.token) {
          wrap.innerHTML =
            `<h3>${cat.name}</h3><p>We could not complete this match just now. Your answers are safe — the category page has the full comparison.</p>` +
            `<a class="bp-mm__resultlink" href="${cat.hubHref}">Open ${cat.name.toLowerCase()} →</a>`;
          box.appendChild(wrap);
          return;
        }

        /* A TIE IS PRESENTED AS A TIE. The API returns `equivalent` when the
           recorded data cannot separate the top of the ranking, and it is
           named here for the same reason it is named on the result page:
           picking one of them would be inventing a comparison. */
        const body = r.equivalent.length > 1
          ? `<p>Equivalent on current data: <strong>${r.equivalent.join("</strong>, <strong>")}</strong>. We do not hold the attributes that would separate them.</p>`
          : r.productName
            ? `<p>Your match: <strong>${r.productName}</strong>.</p>`
            : `<p>Your result is saved and ready.</p>`;

        wrap.innerHTML =
          `<h3>${cat.name}</h3>${body}` +
          `<a class="bp-mm__resultlink" href="/recommendation/${r.token}">See why, and what it does not do well →</a>`;
        box.appendChild(wrap);
      });
    }

    /* ---------- wiring ---------- */
    function startQuiz() {
      catIndex = 0; step = 0;
      renderQuestion();
      show("quiz");
    }

    q<HTMLElement>("[data-start]").addEventListener("click", () => {
      track("matcher_start");
      if (mode === "choose") { renderJobs(false); show("choose"); }
      else startQuiz();
    });

    if (mode === "choose") {
      q<HTMLElement>("[data-notsure]").addEventListener("click", () => {
        track("matcher_not_sure");
        renderJobs(true);
        q<HTMLElement>("[data-notsure]").hidden = true;
      });

      q<HTMLElement>("[data-jobs-next]").addEventListener("click", () => {
        const wanted = jobs.filter((j) => chosenJobs.has(j.id)).map((j) => j.categorySlug);
        selected = wanted
          .map((slug) => categories.find((c) => c.slug === slug))
          .filter((c): c is Cat => Boolean(c));
        if (!selected.length) return;
        track("matcher_jobs_chosen", { count: selected.length, jobs: [...chosenJobs].join(",") });

        /* A selection of nothing but unmatchable categories has no questions to
           ask, so it goes straight to the honest answer rather than through an
           empty quiz. */
        if (selected.every((c) => !c.matchable)) { renderResults(); show("done"); return; }
        selected = selected.filter((c) => c.matchable).concat(selected.filter((c) => !c.matchable));
        startQuiz();
      });
    }

    q<HTMLElement>("[data-back]").addEventListener("click", () => {
      errBox.hidden = true;
      if (step > 0) { step -= 1; renderQuestion(); show("quiz"); }
      else if (catIndex > 0) { catIndex -= 1; step = selected[catIndex].questions.length - 1; renderQuestion(); show("quiz"); }
      else if (mode === "choose") { renderJobs(false); show("choose"); }
      else show("landing");
    });

    /* ---------- deep links ---------- */
    const params = new URLSearchParams(location.search);

    /* ?job=pool or ?job=pool,lawn — the homepage chips.
       THIS IS THE "ONE CONVERSATION" REQUIREMENT MADE LITERAL. A chip that
       dropped the reader on the landing screen would have made them answer
       "what do you want the robot to do?" immediately after they had just
       answered it by tapping. So a valid job pre-selects and goes straight to
       its first question; the Back button still walks them to the chooser, so
       nothing is lost by arriving this way. */
    const wantedJobs = (params.get("job") ?? "")
      .split(",").map((x) => x.trim()).filter(Boolean);

    if (mode === "choose" && wantedJobs.length) {
      const picked = jobs.filter((j) => wantedJobs.includes(j.id));
      const cats = picked
        .map((j) => categories.find((c) => c.slug === j.categorySlug))
        .filter((c): c is Cat => Boolean(c));
      if (cats.length) {
        picked.forEach((j) => chosenJobs.add(j.id));
        selected = cats.filter((c) => c.matchable).concat(cats.filter((c) => !c.matchable));
        track("matcher_start", { via: "job_link", jobs: wantedJobs.join(",") });
        if (selected.every((c) => !c.matchable)) { renderResults(); show("done"); }
        else startQuiz();
      }
    } else if (params.get("start") === "quiz") {
      // ?start=quiz jumps straight in, so a promo card can skip the landing screen.
      track("matcher_start", { via: "promo" });
      if (mode === "choose") { renderJobs(false); show("choose"); }
      else startQuiz();
    }
  });
</script>

