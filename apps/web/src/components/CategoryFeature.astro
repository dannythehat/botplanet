---
/* ============================================================
   BotPlanet — homepage category feature

   One robot world, given a full-width plate and premium artwork.

   THE RULE THIS COMPONENT EXISTS TO ENFORCE. Not one word and not
   one button is drawn inside the picture. A headline painted into a
   JPEG is invisible to Google and silent to a screen reader, and a
   button drawn into a JPEG is a picture of a button — it cannot be
   focused, cannot be tabbed to, and does nothing when clicked. Every
   line and every destination here is real HTML sitting beside the
   artwork, which is why the artwork is registered as decorative with
   empty alt text: it repeats nothing and it names nothing.

   LAYOUT. The artwork is composed with one side deliberately dark
   and empty. `side` says which side that is, and the copy goes
   there. On desktop the picture becomes the section's own surface
   and the copy sits in the space left for it. Below 1000px overlaid
   text stops being reliably readable at any scrim strength, so the
   picture unhooks from the background and stacks underneath the
   buttons instead — which is also why a portrait `mobileSrc` is
   worth supplying rather than letting a 16:9 file letterbox.

   HONESTY. `state` is the category's real launch state, printed as
   the kicker. A category that is not live must not be dressed as one,
   and its buttons must go somewhere that exists — see the homepage
   for the destinations actually available to a category in
   development.
   ============================================================ */
import { srcsetFor } from "../lib/srcset";

export interface FeatureLink {
  label: string;
  href: string;
}

interface Props {
  /** Small mono line above the heading — the category's real state. */
  state: string;
  heading: string;
  body: string;
  /** Which side of the artwork is the empty, dark one. */
  side: "left" | "right";
  image: {
    src: string;
    /** Composed portrait version. Without it the wide file is reused. */
    mobileSrc?: string;
    width: number;
    height: number;
    /** Horizontal focus for the desktop crop, e.g. "82% center". */
    focal?: string;
  };
  primary: FeatureLink;
  secondary?: FeatureLink;
  /** Quiet text link under the buttons. */
  more?: FeatureLink;
  /** Stable id so the heading can be referenced and linked to. */
  id: string;
  /**
   * The word in `heading` to render in brushed metal — the one that says what
   * the category actually is. Must appear in `heading` verbatim; if it does
   * not, the heading renders plain rather than silently dropping a word.
   */
  metalWord?: string;
}

const { state, heading, body, side, image, primary, secondary, more, id, metalWord } = Astro.props;

/* Split once, around the metal word, so the heading stays a single readable
   string in the DOM. Screen readers and search engines see the same sentence
   either way — the gradient is presentation, not meaning. */
const at = metalWord ? heading.indexOf(metalWord) : -1;
const parts =
  at >= 0
    ? { lead: heading.slice(0, at), metal: metalWord!, tail: heading.slice(at + metalWord!.length) }
    : null;
---

<section
  class="catfeat"
  data-side={side}
  data-mobile-art={image.mobileSrc ? "true" : "false"}
  aria-labelledby={`${id}-heading`}
>
  <div class="wrap">
    {/* One plate. The picture is the plate's surface and the copy sits in the
        half of it the artwork left empty — 50/50, at every width. On a phone
        the portrait file does the same job vertically. */}
    <div class="catfeat__plate">
      <div class="catfeat__media">
        <picture>
          {image.mobileSrc && (
            <source
              media="(max-width: 899px)"
              srcset={srcsetFor(image.mobileSrc) ?? image.mobileSrc}
              sizes="100vw"
            />
          )}
          <img
            src={image.src}
            srcset={srcsetFor(image.src)}
            sizes="(min-width: 1400px) 1320px, 100vw"
            width={image.width}
            height={image.height}
            alt=""
            loading="lazy"
            decoding="async"
            style={image.focal ? `--catfeat-focal: ${image.focal}` : undefined}
          />
        </picture>
      </div>

      <div class="catfeat__copy">
        <p class="catfeat__state">{state}</p>
        <h2 id={`${id}-heading`}>
          {parts ? (
            <Fragment>{parts.lead}<span class="catfeat__metal">{parts.metal}</span>{parts.tail}</Fragment>
          ) : (
            heading
          )}
        </h2>
        <p class="catfeat__body">{body}</p>

        <div class="catfeat__actions">
          <a class="catfeat__btn catfeat__btn--primary" href={primary.href}>
            <span>{primary.label}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          {secondary && (
            <a class="catfeat__btn catfeat__btn--ghost" href={secondary.href}>
              <span>{secondary.label}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          )}
        </div>

        {more && <a class="catfeat__more" href={more.href}>{more.label} &#8594;</a>}
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ============================================================
     A section is one metallic plate. Inside it the artwork is the
     surface and the copy sits in the half the artwork left empty:
     50% picture, 50% words and buttons, at every width.

     On a phone the same thing happens vertically, using the
     composed portrait file — copy over the empty top half, subject
     in the bottom half. It is never a block of text with a picture
     bolted underneath it.
     ============================================================ */

  .catfeat {
    padding: clamp(1.1rem, 2.4vw, 2rem) 0;
    background: #05070a;
  }

  .catfeat__plate {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    border: 1px solid var(--cs-line, rgba(200, 208, 222, 0.2));
    border-radius: 22px;
    background: #05070a;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 30px 70px rgba(0, 0, 0, 0.55);
  }

  /* The brushed highlight along the top edge — the same hairline the section
     plates on the category pages carry, so a page reads as one set of parts. */
  .catfeat__plate::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 3;
    height: 1px;
    border-radius: 22px 22px 0 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(246, 248, 252, 0.32) 24%,
      rgba(246, 248, 252, 0.55) 50%,
      rgba(246, 248, 252, 0.3) 76%,
      transparent
    );
    pointer-events: none;
  }

  /* Both children occupy the same cell: the picture fills the plate and the
     copy is laid over it. That is what makes the split exactly half — the
     copy column is half the plate, and the artwork behind it is the other. */
  .catfeat__media,
  .catfeat__copy { grid-area: 1 / 1; }

  .catfeat__media { position: relative; z-index: 0; }

  .catfeat__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--catfeat-focal, center);
  }

  /* A scrim over the copy half only, easing to nothing before it reaches the
     subject. Enough to carry white text over the artwork, never so much that
     the plate looks like a black panel with a photograph stapled beside it. */
  .catfeat__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .catfeat__copy {
    position: relative;
    z-index: 2;
    align-self: center;
    padding: clamp(1.9rem, 4vw, 3.4rem);
  }

  .catfeat__state {
    margin: 0 0 14px;
    /* Picks up the electric blue that runs through every one of these
       photographs, so the label belongs to the picture behind it. */
    color: #5aa9ff;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .catfeat h2 {
    margin: 0;
    font-size: clamp(34px, 3.6vw, 52px);
    letter-spacing: -0.04em;
    line-height: 1.06;
    text-wrap: balance;
  }

  /* Brushed metal, the same recipe the comparison table and review headers
     use. `color` is set first and only then painted over: if background-clip
     is unsupported the word stays visible in plain silver rather than
     vanishing into a transparent fill. */
  .catfeat__metal {
    color: #dfe4ec;
    /* A diagonal sweep rather than the near-vertical fade used on small text:
       across a large heading a top-to-bottom gradient reads as a shadow, and
       only a highlight travelling through the letterforms reads as metal. */
    background: linear-gradient(118deg, #ffffff 0%, #dfe6f2 26%, #949dad 48%, #f4f7fb 66%, #aeb7c4 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .catfeat__metal { color: transparent; }
  }

  .catfeat__body {
    margin: 16px 0 0;
    max-width: 34ch;
    color: #c6ccd6;
    font-size: clamp(15.5px, 1.15vw, 18px);
    line-height: 1.62;
  }

  /* Stacked and equal width, so the two actions read as one control block
     rather than a row that rewraps at every breakpoint. */
  .catfeat__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
    margin-top: 26px;
  }

  .catfeat__btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: min(100%, 21rem);
    min-height: 3.25rem;
    padding: 0 1.05rem 0 1.35rem;
    border-radius: 12px;
    font-size: 0.97rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform .18s ease, box-shadow .18s ease, background .18s ease, border-color .18s ease;
  }

  .catfeat__btn svg { width: 1.1rem; height: 1.1rem; flex: 0 0 auto; opacity: .9; }

  .catfeat__btn--primary {
    color: #fff;
    background: linear-gradient(135deg, #2f7fe4 0%, #1f66d0 52%, #1a55b4 100%);
    border: 1px solid rgba(120, 176, 255, .55);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.28), 0 10px 26px rgba(20, 74, 158, .42);
  }

  .catfeat__btn--primary:hover { transform: translateY(-2px); box-shadow: inset 0 1px 0 rgba(255,255,255,.34), 0 16px 34px rgba(20, 74, 158, .52); }

  .catfeat__btn--ghost {
    color: #eaf0f8;
    background: rgba(8, 13, 21, .62);
    border: 1px solid rgba(126, 160, 205, .42);
    backdrop-filter: blur(4px);
  }

  .catfeat__btn--ghost:hover { border-color: rgba(170, 200, 240, .72); background: rgba(16, 26, 42, .74); }

  .catfeat__btn:focus-visible { outline: var(--focus-ring, 2px solid #dfe4ec); outline-offset: 3px; }

  .catfeat__more {
    display: inline-block;
    margin-top: 20px;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(200, 205, 212, 0.32);
    color: #c8cdd4;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .catfeat__more:hover { color: #fff; border-color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .catfeat__btn, .catfeat__btn:hover { transform: none; transition: none; }
  }

  /* ---------- phone: copy on top, picture beneath ---------- */
  @media (max-width: 899px) {
    /* Two real rows rather than an overlay. The portrait files carry an empty
       upper half, and laying the copy over that half meant the copy's height
       decided how much of the machine survived — on a long body paragraph it
       cut the robot's head off. Given its own row the picture is never
       covered by anything and never cropped by the length of a sentence. */
    .catfeat__plate { grid-template-rows: auto auto; min-height: 0; }
    .catfeat__copy { grid-area: 1 / 1; align-self: start; width: 100%; padding: clamp(1.5rem, 5vw, 2rem); }
    .catfeat__media { grid-area: 2 / 1; }

    /* The portrait files carry an empty upper half because that half used to
       sit behind the copy. With the copy in its own row above, that emptiness
       would just be a black gap between the words and the machine — so the
       picture is anchored to its bottom edge and the dead top is cropped off.
       3/4 keeps roughly the lower three-quarters, which is enough to hold the
       subject in every one of the six without clipping it. */
    .catfeat__media img { aspect-ratio: 3 / 4; height: auto; object-fit: cover; object-position: center bottom; }
    .catfeat__media::after { background: none; }

    /* Tightened deliberately: every pixel the copy gives back is a pixel of
       the photograph that fits on the screen with it. */
    .catfeat h2 { font-size: 30px; }
    .catfeat__body { margin-top: 12px; font-size: 15px; line-height: 1.55; max-width: 32ch; }
    .catfeat__actions { margin-top: 20px; gap: 9px; }
    .catfeat__btn { min-height: 3rem; font-size: 0.93rem; }
    .catfeat__more { margin-top: 16px; }
  }

  /* ---------- desktop: the split runs left to right ---------- */
  @media (min-width: 900px) {
    .catfeat { padding: clamp(1.4rem, 2.6vw, 2.4rem) 0; }
    .catfeat__plate { min-height: min(34rem, 46vw); }

    /* Exactly half. The copy column is one half of the plate and the artwork
       fills the whole plate behind it, so the subject — which the artwork puts
       in its own far half — lands in the half the copy does not occupy. */
    .catfeat__copy { width: 50%; padding: clamp(2.2rem, 3.4vw, 3.6rem); }
    .catfeat[data-side="right"] .catfeat__copy { justify-self: end; }

    .catfeat__media::after {
      background: linear-gradient(
        90deg,
        rgba(5, 7, 10, 0.93) 0%,
        rgba(5, 7, 10, 0.88) 32%,
        rgba(5, 7, 10, 0.55) 47%,
        rgba(5, 7, 10, 0.12) 62%,
        transparent 74%
      );
    }

    .catfeat[data-side="right"] .catfeat__media::after {
      background: linear-gradient(
        270deg,
        rgba(5, 7, 10, 0.9) 0%,
        rgba(5, 7, 10, 0.86) 32%,
        rgba(5, 7, 10, 0.55) 47%,
        rgba(5, 7, 10, 0.12) 62%,
        transparent 74%
      );
    }
  }
</style>
