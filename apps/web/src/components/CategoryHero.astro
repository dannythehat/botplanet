---
/* ============================================================
   BotPlanet — Category hero
   Reusable across every robot category. Content comes in as
   props; nothing here is pool-specific.

   The image is optional. With no image the hero renders as a
   single wide column — it still looks finished, and no public
   placeholder is ever shown.
   ============================================================ */

export interface HeroCta {
  label: string;
  href: string;
}

export interface HeroImage {
  /** Desktop / default source, e.g. "/media/pool/hero-desktop.jpg" */
  src: string;
  /** Optional narrow-screen crop. Falls back to `src`. */
  mobileSrc?: string;
  /** Describes the picture for screen readers and search. Required. */
  alt: string;
  /** Focal point when the image is cropped, e.g. "50% 40%". */
  focal?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
  image?: HeroImage;
}

const { eyebrow, title, subtitle, primaryCta, secondaryCta, image } = Astro.props;
const hasImage = Boolean(image?.src);
---

<section class="chero" data-has-image={hasImage ? "true" : "false"}>
  <div class="chero__inner">
    <div class="chero__copy">
      {eyebrow && <span class="chero__eyebrow">{eyebrow}</span>}
      <h1 class="chero__title">{title}</h1>
      <p class="chero__subtitle">{subtitle}</p>

      {(primaryCta || secondaryCta) && (
        <div class="chero__actions">
          {primaryCta && (
            <a class="btn btn--accent chero__cta" href={primaryCta.href}>{primaryCta.label}</a>
          )}
          {secondaryCta && (
            <a class="chero__cta chero__cta--ghost" href={secondaryCta.href}>{secondaryCta.label}</a>
          )}
        </div>
      )}
    </div>

    {hasImage && (
      <figure class="chero__figure" data-hero-image>
        <picture>
          {image!.mobileSrc && (
            <source media="(max-width: 719px)" srcset={image!.mobileSrc} />
          )}
          <img
            src={image!.src}
            alt={image!.alt}
            style={image!.focal ? `object-position: ${image!.focal}` : undefined}
            width="1200"
            height="900"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </figure>
    )}
  </div>
</section>

<style>
  /* ---------- shell ---------- */
  .chero {
    position: relative;
    margin: 0 0 var(--space-2xl, 3rem);
    padding: clamp(1.5rem, 5vw, 3.25rem);
    border: 1px solid rgba(207, 213, 221, 0.17);
    border-radius: 20px;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 12% -20%, rgba(232, 235, 239, 0.09), transparent 55%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.04), transparent 32%),
      linear-gradient(180deg, #11151a 0%, #080a0d 60%, #0c0f12 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 26px 64px rgba(0, 0, 0, 0.5);
  }

  /* brushed-metal hairline along the top edge */
  .chero::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(244, 246, 248, 0.55) 22%,
      rgba(244, 246, 248, 0.75) 50%,
      rgba(244, 246, 248, 0.45) 78%,
      transparent
    );
  }

  .chero__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  /* ---------- copy ---------- */
  .chero__copy {
    min-width: 0;
  }

  .chero__eyebrow {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: #08090b;
    background: linear-gradient(90deg, #f1f3f5, #7e858f);
  }

  .chero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 6.2vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.023em;
    text-wrap: balance;
    background: linear-gradient(174deg, #ffffff 6%, #e6e9ed 42%, #9aa1ab 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .chero__subtitle {
    margin: 1.15rem 0 0;
    max-width: 56ch;
    font-size: 1.0625rem; /* 17px — blueprint mobile floor */
    line-height: 1.62;
    color: var(--text-secondary);
  }

  /* ---------- actions ---------- */
  .chero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.85rem;
  }

  .chero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0 1.4rem;
    border-radius: 10px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .chero__cta--ghost {
    color: var(--text-primary);
    border: 1px solid rgba(202, 208, 216, 0.3);
    background: rgba(255, 255, 255, 0.025);
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  .chero__cta--ghost:hover {
    border-color: rgba(233, 237, 242, 0.6);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-1px);
  }

  /* ---------- image ---------- */
  .chero__figure {
    position: relative;
    margin: 0;
    border: 1px solid rgba(204, 210, 218, 0.18);
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(160deg, #171b20, #090b0e);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 18px 44px rgba(0, 0, 0, 0.45);
  }

  .chero__figure img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center;
  }

  /* ---------- desktop ---------- */
  @media (min-width: 900px) {
    .chero {
      padding: clamp(2.75rem, 4vw, 4rem);
    }

    .chero[data-has-image="true"] .chero__inner {
      grid-template-columns: 1.02fr 0.98fr;
    }

    .chero__subtitle {
      font-size: 1.1875rem; /* 19px */
    }

    .chero__figure img {
      aspect-ratio: 4 / 3;
    }
  }

  /* Without an image the copy gets the full width but stays readable. */
  .chero[data-has-image="false"] .chero__subtitle {
    max-width: 62ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .chero__cta--ghost {
      transition: none;
    }
    .chero__cta--ghost:hover {
      transform: none;
    }
  }
</style>
