---
import { PRIMARY_NAV, navCategories, routes, LAUNCH_CATEGORY } from "../content/nav";

const cats = navCategories();
const botmatchHref = routes.botmatch(LAUNCH_CATEGORY);
const path = Astro.url.pathname;
const isActive = (href: string) => href !== "/" && path.startsWith(href.replace(/\/$/, ""));
---
<header class="site">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="BotPlanet — home">
      <img src="/logo/logo-desktop.png" alt="BotPlanet" class="logo-d" height="52" />
      <img src="/logo/logo-mobile.png" alt="BotPlanet" class="logo-m" height="40" />
    </a>

    <nav class="main" aria-label="Primary">
      {PRIMARY_NAV.map((item) =>
        item.mega ? (
          <div class="has-mega">
            <a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]} aria-haspopup="true">{item.label} <span class="caret">▾</span></a>
            <div class="mega" role="menu">
              <div class="mega-inner">
                <div class="mega-col">
                  <p class="mega-h">By job to be done</p>
                  {cats.map((c) => (
                    <a class:list={["mega-item", { soon: c.launch !== "live" }]} href={c.launch === "live" ? routes.category(c.slug) : "#"} aria-disabled={c.launch !== "live"}>
                      <span class="mega-jtbd">{c.jtbd}</span>
                      <span class="mega-sub">{c.name}{c.launch !== "live" && <em class="soon-tag">Coming soon</em>}</span>
                    </a>
                  ))}
                </div>
                <div class="mega-col">
                  <p class="mega-h">Robotic pool cleaners</p>
                  <a class="mega-item" href={routes.category(LAUNCH_CATEGORY)}><span class="mega-jtbd">Browse all pool robots</span><span class="mega-sub">The full US launch catalogue</span></a>
                  <a class="mega-item" href={routes.best()}><span class="mega-jtbd">Best pool robots</span><span class="mega-sub">Our top picks by use case</span></a>
                  <a class="mega-item" href={routes.compare(LAUNCH_CATEGORY)}><span class="mega-jtbd">Compare</span><span class="mega-sub">Head-to-head, winner by pool</span></a>
                  <a class="mega-item" href={routes.guides()}><span class="mega-jtbd">Buying &amp; care guides</span><span class="mega-sub">How they work, what to know</span></a>
                </div>
                <div class="mega-col mega-feature">
                  <p class="mega-h">Not sure which?</p>
                  <a class="mega-cta" href={botmatchHref}>Try BotMatch →<span>Answer a few questions, get one clear recommendation on suitability — never commission.</span></a>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={["nav-link", { active: isActive(item.href), soon: item.state === "coming_soon" }]}>{item.label}{item.state === "coming_soon" && <em class="soon-tag">Soon</em>}</a>
        )
      )}
    </nav>

    <div class="head-actions">
      <button class="icon-btn" type="button" id="btn-search" aria-label="Search" title="Search">⌕</button>
      <button class="icon-btn" type="button" id="btn-saved" aria-label="Saved products" title="Saved">♡<span class="saved-count" id="saved-count" hidden>0</span></button>
      <span class="market" title="Market">🇺🇸 US</span>
      <a class="cta" href={botmatchHref}>Find My Robot</a>
      <button class="icon-btn burger" type="button" id="btn-menu" aria-label="Menu" aria-expanded="false">☰</button>
    </div>
  </div>
</header>

<!-- Overlays live OUTSIDE the backdrop-filtered header so position:fixed is
     relative to the viewport, not trapped in the 66px header containing block. -->

  <!-- Mobile drawer -->
  <div class="drawer" id="drawer" hidden>
    <div class="drawer-panel" role="dialog" aria-label="Menu">
      <div class="drawer-head">
        <img src="/logo/logo-mobile.png" alt="BotPlanet" style="height:34px;width:auto" />
        <button class="icon-btn" type="button" id="btn-close" aria-label="Close menu">✕</button>
      </div>
      <a class="drawer-cta" href={botmatchHref}>✦ Find My Robot</a>
      <div class="drawer-group">
        <p class="drawer-h">Shop robots</p>
        {cats.map((c) => (
          c.launch === "live"
            ? <a class="drawer-link" href={routes.category(c.slug)}>{c.jtbd} <em>{c.name}</em></a>
            : <span class="drawer-link soon">{c.jtbd} <em>{c.name} · soon</em></span>
        ))}
      </div>
      <div class="drawer-group">
        {PRIMARY_NAV.filter((i) => !i.mega).map((i) => (
          <a class="drawer-link" href={i.href}>{i.label}{i.state === "coming_soon" && <em>soon</em>}</a>
        ))}
      </div>
    </div>
    <div class="drawer-scrim" id="drawer-scrim"></div>
  </div>

  <!-- Search overlay -->
  <div class="search-ov" id="search-ov" hidden>
    <div class="search-box" role="dialog" aria-label="Search">
      <input type="search" id="search-input" placeholder="Search robots, guides, comparisons…" autocomplete="off" />
      <ul class="search-results" id="search-results"></ul>
      <p class="search-hint muted">More of the catalogue becomes searchable as content lands.</p>
    </div>
    <div class="search-scrim" id="search-scrim"></div>
  </div>

<script define:vars={{ cats, nav: PRIMARY_NAV, botmatchHref }}>
  const $ = (id) => document.getElementById(id);
  // --- mobile drawer ---
  const drawer = $("drawer");
  const openDrawer = () => { drawer.hidden = false; $("btn-menu").setAttribute("aria-expanded", "true"); document.body.style.overflow = "hidden"; };
  const closeDrawer = () => { drawer.hidden = true; $("btn-menu").setAttribute("aria-expanded", "false"); document.body.style.overflow = ""; };
  $("btn-menu")?.addEventListener("click", openDrawer);
  $("btn-close")?.addEventListener("click", closeDrawer);
  $("drawer-scrim")?.addEventListener("click", closeDrawer);

  // --- saved (localStorage) ---
  function savedIds() { try { return JSON.parse(localStorage.getItem("bp_saved") || "[]"); } catch { return []; } }
  function refreshSaved() {
    const n = savedIds().length; const el = $("saved-count");
    if (el) { el.textContent = n; el.hidden = n === 0; }
    document.querySelectorAll("[data-save]").forEach((b) => {
      const on = savedIds().includes(b.getAttribute("data-save"));
      b.classList.toggle("is-saved", on); b.setAttribute("aria-pressed", on ? "true" : "false");
    });
  }
  window.bpToggleSave = function (id) {
    let s = savedIds(); s = s.includes(id) ? s.filter((x) => x !== id) : [...s, id];
    localStorage.setItem("bp_saved", JSON.stringify(s)); refreshSaved();
  };
  document.addEventListener("click", (e) => {
    const b = e.target.closest("[data-save]"); if (!b) return;
    e.preventDefault(); window.bpToggleSave(b.getAttribute("data-save"));
  });
  $("btn-saved")?.addEventListener("click", () => {
    const s = savedIds();
    location.href = s.length ? "/saved/" : "/robots/robotic-pool-cleaners/";
  });
  refreshSaved();

  // --- recently viewed (record current product if the page declares one) ---
  const rv = document.querySelector('meta[name="bp:product"]');
  if (rv) {
    try {
      const item = { slug: rv.getAttribute("data-slug"), name: rv.getAttribute("data-name"), href: location.pathname };
      let list = JSON.parse(localStorage.getItem("bp_recent") || "[]").filter((x) => x.slug !== item.slug);
      list.unshift(item); localStorage.setItem("bp_recent", JSON.stringify(list.slice(0, 8)));
    } catch {}
  }

  // --- search overlay (nav + categories; upgraded with catalogue via window.__BP_INDEX__) ---
  const base = [
    ...cats.filter((c) => c.launch === "live").map((c) => ({ name: c.name, href: "/robots/" + c.slug + "/", kind: "Category" })),
    { name: "Find My Robot (BotMatch)", href: botmatchHref, kind: "Tool" },
    ...nav.filter((n) => !n.mega && n.state !== "coming_soon").map((n) => ({ name: n.label, href: n.href, kind: "Page" })),
  ];
  const ov = $("search-ov"), input = $("search-input"), results = $("search-results");
  const openSearch = () => { ov.hidden = false; setTimeout(() => input.focus(), 20); render(""); };
  const closeSearch = () => { ov.hidden = true; input.value = ""; };
  function render(q) {
    const idx = [...base, ...(window.__BP_INDEX__ || [])];
    const ql = q.trim().toLowerCase();
    const hits = (ql ? idx.filter((i) => i.name.toLowerCase().includes(ql)) : idx).slice(0, 8);
    results.innerHTML = hits.map((h) => `<li><a href="${h.href}"><span>${h.name}</span><em>${h.kind}</em></a></li>`).join("") || `<li class="none">No matches</li>`;
  }
  $("btn-search")?.addEventListener("click", openSearch);
  $("search-scrim")?.addEventListener("click", closeSearch);
  input?.addEventListener("input", (e) => render(e.target.value));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") { closeSearch(); closeDrawer(); }
    if ((e.key === "/" || (e.key === "k" && (e.metaKey || e.ctrlKey))) && ov.hidden && !/input|textarea|select/i.test(document.activeElement?.tagName || "")) { e.preventDefault(); openSearch(); }
  });
</script>

<style>
  .bar { display: flex; align-items: center; gap: 22px; height: 76px; }
  .logo { display: flex; align-items: center; flex: 0 0 auto; }
  .logo-d { height: 52px; width: auto; display: block; }
  .logo-m { display: none; height: 40px; width: auto; }

  nav.main { display: flex; gap: 4px; align-items: center; margin-left: 6px; }
  .nav-link { color: var(--muted); font-weight: 500; font-size: 14px; padding: 8px 11px; border-radius: 8px; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px; }
  .nav-link:hover, .nav-link.active { color: var(--text); background: var(--panel-2); }
  .caret { font-size: 9px; opacity: 0.7; }
  .soon-tag { font-style: normal; font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--border-2); border-radius: 5px; padding: 1px 4px; margin-left: 5px; }

  .has-mega { position: relative; }
  .mega { position: absolute; top: calc(100% + 10px); left: 0; min-width: 720px; background: rgba(10,10,13,0.98); border: 1px solid var(--border-2); border-radius: 16px; padding: 8px; opacity: 0; visibility: hidden; transform: translateY(-6px); transition: 0.16s ease; box-shadow: 0 24px 60px rgba(0,0,0,0.6); backdrop-filter: blur(14px); }
  .has-mega:hover .mega, .has-mega:focus-within .mega { opacity: 1; visibility: visible; transform: translateY(0); }
  .mega-inner { display: grid; grid-template-columns: 1.1fr 1.1fr 1fr; gap: 6px; }
  .mega-col { padding: 12px; } .mega-feature { background: var(--panel-2); border-radius: 12px; }
  .mega-h { font-size: 11px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); margin: 4px 6px 10px; }
  .mega-item { display: flex; flex-direction: column; gap: 1px; padding: 9px 10px; border-radius: 9px; }
  .mega-item:hover { background: var(--panel); }
  .mega-item.soon { opacity: 0.5; pointer-events: none; }
  .mega-jtbd { font-weight: 600; font-size: 14px; color: var(--text); }
  .mega-sub { font-size: 12.5px; color: var(--muted); display: flex; align-items: center; }
  .mega-cta { display: block; padding: 12px; border-radius: 11px; background: #fff; color: #050507; font-weight: 700; }
  .mega-cta span { display: block; font-weight: 500; font-size: 12.5px; color: #333; margin-top: 6px; line-height: 1.5; }

  .head-actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .icon-btn { background: transparent; border: 1px solid var(--border); color: var(--muted); width: 36px; height: 36px; border-radius: 9px; font-size: 17px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; position: relative; }
  .icon-btn:hover { color: var(--text); border-color: var(--border-2); }
  .saved-count { position: absolute; top: -5px; right: -5px; background: #fff; color: #050507; font-size: 10px; font-weight: 700; min-width: 15px; height: 15px; border-radius: 999px; display: flex; align-items: center; justify-content: center; padding: 0 3px; }
  .market { font-size: 13px; color: var(--muted); padding: 0 4px; }
  .cta { background: #fff; color: #050507; padding: 9px 17px; border-radius: 999px; font-weight: 600; font-size: 14px; white-space: nowrap; }
  .cta:hover { background: #e7e7ea; color: #050507; }
  .burger { display: none; }

  /* drawer */
  .drawer { position: fixed; inset: 0; z-index: 60; }
  .drawer-scrim { position: absolute; inset: 0; background: rgba(0,0,0,0.6); }
  .drawer-panel { position: absolute; top: 0; right: 0; width: min(340px, 86vw); height: 100%; background: var(--bg); border-left: 1px solid var(--border-2); padding: 18px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; }
  .drawer-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .drawer-cta { background: #fff; color: #050507; text-align: center; padding: 13px; border-radius: 11px; font-weight: 700; margin-bottom: 8px; }
  .drawer-group { border-top: 1px solid var(--border); padding-top: 10px; margin-top: 4px; }
  .drawer-h { font-size: 11px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); margin: 2px 0 8px; }
  .drawer-link { display: flex; justify-content: space-between; align-items: center; padding: 11px 8px; border-radius: 9px; font-weight: 600; font-size: 15px; }
  .drawer-link em { font-style: normal; font-weight: 500; font-size: 12px; color: var(--muted); }
  .drawer-link:hover { background: var(--panel-2); }
  .drawer-link.soon { color: var(--muted); }

  /* search */
  .search-ov { display: none; position: fixed; inset: 0; z-index: 70; justify-content: center; align-items: flex-start; }
  .search-ov:not([hidden]) { display: flex; }
  .search-scrim { position: absolute; inset: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(3px); }
  .search-box { position: relative; z-index: 1; width: min(560px, 92vw); margin-top: 12vh; background: var(--panel); border: 1px solid var(--border-2); border-radius: 14px; padding: 14px; box-shadow: 0 30px 80px rgba(0,0,0,0.6); }
  .search-box input { width: 100%; font-size: 17px; }
  .search-results { list-style: none; margin: 12px 0 0; padding: 0; }
  .search-results li a { display: flex; justify-content: space-between; align-items: center; padding: 11px 12px; border-radius: 9px; }
  .search-results li a:hover { background: var(--panel-2); }
  .search-results em { font-style: normal; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .search-results .none { padding: 12px; color: var(--muted); }
  .search-hint { margin: 10px 4px 2px; font-size: 12px; }

  @media (max-width: 900px) {
    nav.main, .market, .cta { display: none; }
    .burger { display: inline-flex; }
    .bar { height: 62px; }
    .logo-d { display: none; }
    .logo-m { display: block; }
    .head-actions { gap: 6px; }
    .icon-btn { width: 34px; height: 34px; }
  }
  /* small phones: brand + menu only, uncrowded */
  @media (max-width: 440px) {
    #btn-search, #btn-saved { display: none; }
    .logo-m { height: 36px; }
  }
</style>
