---
/**
 * Honest placeholder for a route the sitemap requires to exist while a later
 * job owns its content.
 *
 * Rules it enforces:
 *  - returns a real 200 with a real explanation — never a fake article, never
 *    a dead end, never a misleading "coming soon" that implies work is done;
 *  - is noindex, so a thin page cannot enter the index;
 *  - always offers onward routes that ARE live, so the visitor is never stuck.
 */
import { LAUNCH_CATEGORY, categoryRoutes } from "../content/routes";
import { shellJourney } from "../content/journeys";

interface Props {
  title: string;
  /** What this route will hold, stated plainly. No marketing claims. */
  summary: string;
  /** Which job owns the content, for internal honesty. */
  owner?: string;
}
const { title, summary, owner } = Astro.props;
const cat = categoryRoutes(LAUNCH_CATEGORY);
const journey = shellJourney();
---
<div class="ph">
  <span class="pill pill--warn">Not published yet</span>
  <h1>{title}</h1>
  <p class="lede">{summary}</p>
  <p class="note">
    This route exists so its address is stable and links to it never break.
    It is deliberately excluded from search results until it holds genuine
    content{owner ? ` (${owner})` : ""}.
  </p>

  <h2>What is live right now</h2>
  <ul class="ph-links">
    <li><a class="link" href={cat.hub}>Browse robotic pool cleaners</a> — the full US launch catalogue</li>
    <li><a class="link" href={cat.compare}>Compare pool cleaners</a> — head to head</li>
    <li><a class="link" href={journey.href}>{journey.ctaLabel}</a> — {journey.explanation}</li>
    <li><a class="link" href="/robots/">All robot categories</a> — what is live and what is coming</li>
  </ul>
</div>

<style>
  .ph { max-width: var(--width-editorial); padding-block: var(--space-lg) var(--space-2xl); }
  .ph h1 { margin-top: var(--space-sm); }
  .ph h2 { font-size: var(--type-subheading); margin-top: var(--space-2xl); }
  .ph .note { margin-top: var(--space-md); max-width: 62ch; }
  .ph-links { list-style: none; padding: 0; margin: var(--space-md) 0 0; display: grid; gap: var(--space-sm); }
  .ph-links li { color: var(--text-tertiary); font-size: var(--type-body-sm); margin: 0; }
  .ph-links a { font-weight: var(--weight-semibold); color: var(--text-primary); }
</style>
