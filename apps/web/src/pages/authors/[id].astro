---
import Base from "../../layouts/Base.astro";
import { AUTHORS, EDITORIAL, authorForReview } from "../../content/team";
import { REVIEWS } from "../../content/reviews";
import { CATEGORIES as NAV_CATEGORIES } from "../../content/nav";
import { productPath } from "../../content/routes";
import { personSchema, webPageSchema, breadcrumbSchema } from "../../lib/seo";
const author=AUTHORS[Astro.params.id??""];
if(!author)return new Response(null,{status:404});
const categoryName=new Map(NAV_CATEGORIES.map(category=>[category.slug,category.name]));
const written=Object.values(REVIEWS).filter(review=>authorForReview(review.authorId).id===author.id).map(review=>({title:review.title.replace(/ review$/i,""),href:productPath(review.slug,review.categorySlug),category:categoryName.get(review.categorySlug)??review.categorySlug})).sort((a,b)=>a.category===b.category?a.title.localeCompare(b.title):a.category.localeCompare(b.category));
const groups=Array.from(written.reduce((map,item)=>{const rows=map.get(item.category)??[];rows.push(item);map.set(item.category,rows);return map},new Map<string,typeof written>()).entries()).map(([category,items])=>({category,items}));
const readable=(iso:string)=>new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric",timeZone:"UTC"});
const work=[...(author.notableWork??[])].sort((a,b)=>b.date.localeCompare(a.date));
const TITLE=`${author.name} | ${author.role} at BotPlanet`;
const DESCRIPTION=`${author.name} is ${author.role} at BotPlanet. ${author.accountability}`.slice(0,158);
const schema=[webPageSchema({path:author.path,name:TITLE,description:DESCRIPTION,type:"AboutPage"}),personSchema({name:author.name,jobTitle:author.role,description:author.background?`${author.bio} ${author.background}`:author.bio,path:author.path}),breadcrumbSchema([{name:"Home",path:"/"},{name:"Authors",path:"/authors/"},{name:author.name,path:author.path}])];
---
<Base title={TITLE} description={DESCRIPTION} path={author.path} ogImage={author.portrait?.src} schema={schema}>
  <header class="author-hero"><figure>{author.portrait&&<img src={author.portrait.src} srcset={`/media/authors/${author.id}-220w.webp 220w, /media/authors/${author.id}-440w.webp 440w`} sizes="(min-width:800px) 360px,220px" width="440" height="440" alt={author.portrait.alt} loading="eager" fetchpriority="high" decoding="async" />}</figure><div><p class="kicker">{author.role.toUpperCase()}</p><h1>{author.name}</h1><p>{author.bio}</p>{author.background&&<p class="background"><strong>Before BotPlanet</strong><span>{author.background}</span></p>}</div></header>
  <section class="accountable" aria-labelledby="accountable-title"><div><p class="kicker">NAMED ACCOUNTABILITY</p><h2 id="accountable-title">What {author.name.split(" ")[0]} owns</h2></div><blockquote>{author.accountability}<footer>{author.covers}</footer></blockquote></section>
  {work.length>0&&<section class="record" aria-labelledby="record-title"><header><p class="kicker">CALLS ON THE RECORD</p><h2 id="record-title">Judgement you can check</h2><p>Specific editorial decisions, dated, with the outcome still visible on the affected page.</p></header><ol>{work.map(item=><li><time datetime={item.date}>{readable(item.date)}</time><p>{item.what}</p></li>)}</ol></section>}
  <section class="standard" aria-labelledby="standard-title"><div><p class="kicker">THE WORKING STANDARD</p><h2 id="standard-title">Research is labelled as research.</h2><p>{EDITORIAL.method}</p><p>A page uses a hands-on label only when BotPlanet physically used the product under the published method. No star rating is invented to make researched evidence look like testing.</p></div><nav><a href="/review-methodology/">Review methodology <span aria-hidden="true">→</span></a><a href="/editorial-policy/">Editorial policy <span aria-hidden="true">→</span></a><a href="/affiliate-disclosure/">How the site earns <span aria-hidden="true">→</span></a></nav></section>
  {written.length>0&&<section class="work" aria-labelledby="work-title"><header><p class="kicker">PUBLISHED WORK</p><h2 id="work-title">{written.length} {written.length===1?"review":"reviews"} by {author.name}</h2></header><div class="work__groups">{groups.map(group=><section><h3>{group.category}<span>{group.items.length}</span></h3><ul>{group.items.map(item=><li><a href={item.href}>{item.title}<span aria-hidden="true">→</span></a></li>)}</ul></section>)}</div></section>}
  <aside class="corrections"><div><strong>Found something that needs correcting?</strong><span>A correction is made on the page where the error appeared.</span></div><a class="btn btn--accent" href="/contact/">Contact BotPlanet</a></aside>
</Base>
<style>
  .kicker{margin:0 0 .8rem;color:var(--text-tertiary);font:700 .7rem/1 var(--font-mono);letter-spacing:.18em}.author-hero{display:grid;grid-template-columns:360px minmax(0,1fr);gap:clamp(2rem,6vw,6rem);align-items:center;max-width:1120px;margin:0 auto;padding:clamp(3rem,7vw,6rem) 0}.author-hero figure{overflow:hidden;margin:0;aspect-ratio:1;border:1px solid var(--border-default);border-radius:1.4rem;background:var(--surface-raised)}.author-hero img{width:100%;height:100%;object-fit:cover}.author-hero h1{margin:0;font-size:clamp(3.3rem,6vw,6rem);line-height:.95;letter-spacing:-.06em}.author-hero>div>p:not(.kicker,.background){max-width:44rem;color:var(--text-secondary);font-size:clamp(1.02rem,1.5vw,1.18rem);line-height:1.68}.background{display:flex;gap:.8rem;margin-top:1.4rem;padding-top:1.2rem;border-top:1px solid var(--border-subtle)}.background span{color:var(--text-secondary)}.accountable,.record,.standard,.work,.corrections{max-width:1120px;margin:0 auto clamp(5rem,8vw,7rem)}.accountable{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,5vw,5rem);align-items:center}.accountable h2,.record h2,.standard h2,.work h2{margin:0;font-size:clamp(2.2rem,4.3vw,4rem);line-height:1.03;letter-spacing:-.05em}.accountable blockquote{margin:0;padding:clamp(1.6rem,4vw,2.8rem);border:1px solid rgba(119,222,255,.3);border-radius:1.2rem;background:linear-gradient(120deg,rgba(69,171,210,.13),var(--surface-raised) 60%);font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.6}.accountable footer{margin-top:1rem;color:var(--text-secondary);font-size:.9rem}.record>header,.work>header{max-width:50rem;margin:0 auto 2rem;text-align:center}.record>header>p:last-child{color:var(--text-secondary)}.record ol{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin:0;padding:0;list-style:none}.record li{padding:1.5rem;border:1px solid var(--border-subtle);border-radius:1rem;background:var(--surface-raised)}.record time{color:var(--accent);font:700 .7rem var(--font-mono);letter-spacing:.08em;text-transform:uppercase}.record li p{color:var(--text-secondary);line-height:1.6}.standard{display:grid;grid-template-columns:1fr .75fr;gap:clamp(2rem,5vw,5rem);align-items:center}.standard p{color:var(--text-secondary);line-height:1.65}.standard nav{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--border-subtle);border-radius:1rem;background:var(--surface-raised)}.standard nav a{display:flex;justify-content:space-between;padding:1rem 1.2rem}.standard nav a+a{border-top:1px solid var(--border-subtle)}.work__groups{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;align-items:start}.work__groups>section{overflow:hidden;border:1px solid var(--border-subtle);border-radius:1rem;background:var(--surface-raised)}.work__groups h3{display:flex;justify-content:space-between;margin:0;padding:1rem 1.2rem;border-bottom:1px solid var(--border-subtle)}.work__groups h3 span{color:var(--accent);font-family:var(--font-mono);font-size:.8rem}.work__groups ul{margin:0;padding:0;list-style:none}.work__groups li+li{border-top:1px solid var(--border-subtle)}.work__groups a{display:flex;justify-content:space-between;gap:1rem;padding:.85rem 1.2rem;color:var(--text-secondary)}.work__groups a:hover{color:var(--text-primary)}.corrections{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.4rem;border-top:1px solid var(--border-subtle)}.corrections strong,.corrections span{display:block}.corrections span{margin-top:.25rem;color:var(--text-secondary)}
  @media(max-width:800px){.author-hero{grid-template-columns:180px 1fr}.accountable,.standard{grid-template-columns:1fr}.record ol,.work__groups{grid-template-columns:1fr}}@media(max-width:580px){.author-hero{grid-template-columns:1fr}.author-hero figure{max-width:220px}.background{flex-direction:column}.corrections{align-items:stretch;flex-direction:column}.corrections .btn{justify-content:center}}
</style>
