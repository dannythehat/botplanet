---
/**
 * Comparison hub — one per category.
 *
 * TWO SHAPES, AND THE CATEGORY'S RESEARCH DECIDES WHICH. A category with a
 * record in content/compare-page.ts gets the full argument: brand-versus-brand
 * sections, prose, FAQ and schema. One without gets the generated comparison
 * table and nothing else — which is the honest floor rather than a stub. Window
 * has eleven products and no comparison research, so it gets a table and no
 * argument, instead of an argument nobody measured.
 *
 * WHAT WAS HERE BEFORE, AND WHY IT CHANGED. A bare table with an H1 over it and
 * a price column. Page 4 of the pool map has been ruled CREATE since 1 August
 * and this was standing in for it. The price column went with the rewrite: it
 * was reading offers straight out of D1 with no freshness gate, which is how
 * the BuBlue Bubot's card came to be publishing the retired Dolphin Premier's
 * $1,299 on a machine that sells for about $800. Bands here, figures on the
 * review beside the date they were read.
 */
import Base from "../../layouts/Base.astro";
import { getDb, schema } from "../../lib/db";
import { and, eq } from "drizzle-orm";
import { breadcrumbsFor } from "../../lib/routing";
import { categoryRoutes } from "../../content/routes";
import ComparisonTable from "../../components/ComparisonTable.astro";
import BrandPairs from "../../components/BrandPairs.astro";
import type { RenderedPair } from "../../components/BrandPairs.astro";
import ArticleContents from "../../components/ArticleContents.astro";
import BotMatchCta from "../../components/BotMatchCta.astro";
import FaqList from "../../components/FaqList.astro";
import ArticleFooter from "../../components/ArticleFooter.astro";
import { comparisonRows, type ComparableProduct } from "../../content/comparison";
import { comparePageFor, comparePageIsSubstantive } from "../../content/compare-page";
import { botMatchCtaFor } from "../../content/category-sections";
import { srcsetFor } from "../../lib/srcset";
import { applyInternalLinks } from "../../lib/internal-linker";
import { anchorsFor } from "../../content/internal-links";
import { articleSchema, faqPageSchema, itemListSchema, webPageSchema } from "../../lib/seo";
import { FOUNDER } from "../../content/team";
import "../../styles/prose.css";

/* Compiled at build time, alongside the best-of and guide prose. */
const ARTICLE_PROSE = import.meta.glob<{ compiledContent: () => string | Promise<string> }>(
  "../../articles/*.md",
  { eager: true },
);

const { category } = Astro.params;
const db = getDb(Astro.locals);

const cat = (
  await db.select().from(schema.categories).where(eq(schema.categories.slug, category!)).limit(1)
)[0];
if (!cat) return new Response("Category not found", { status: 404 });

const products = await db
  .select()
  .from(schema.products)
  .where(and(eq(schema.products.categoryId, cat.id), eq(schema.products.status, "published")));

const comparable = (p: (typeof products)[number]): ComparableProduct => ({
  id: p.id,
  slug: p.slug,
  name: p.name,
  environments: p.environments as string[],
  cleans: p.cleans as string[],
  powerType: p.powerType,
  priceTier: p.priceTier,
  maxPoolLengthFt: p.maxPoolLengthFt,
  maxPoolAreaSqFt: (p as { maxPoolAreaSqFt?: number | null }).maxPoolAreaSqFt ?? null,
});

const rows = comparisonRows(products.map(comparable), cat.slug);
const byId = new Map(rows.map((r) => [r.productId, r]));
const crumbs = breadcrumbsFor(Astro.url.pathname);

const article = comparePageFor(cat.slug);

/* Pairs are joined to the catalogue the same way picks are on a best-of page:
   the content file declares a slug and an argument, every fact beside it comes
   from the row. A pair naming an unpublished product loses that machine rather
   than rendering a claim with nothing behind it. */
const pairs: RenderedPair[] = (article?.pairs ?? []).map((pair) => ({
  ...pair,
  machines: pair.picks
    .map((pick) => {
      const product = products.find((p) => p.slug === pick.slug);
      const row = product ? byId.get(product.id) : undefined;
      if (!row) {
        if (import.meta.env.DEV) {
          console.warn(`[compare] ${cat.slug}: ${pick.slug} is not published — dropped from "${pair.heading}"`);
        }
        return null;
      }
      return {
        name: row.name,
        href: row.href,
        why: pick.why,
        cleans: row.cleans,
        power: row.power,
        poolSize: row.poolSize,
      };
    })
    .filter((m): m is NonNullable<typeof m> => m !== null),
}));

let body = "";
if (article) {
  const mod = ARTICLE_PROSE[`../../articles/${article.prose}.md`];
  if (!mod) throw new Error(`No prose at src/articles/${article.prose}.md for /compare/${cat.slug}/`);
  const html = await mod.compiledContent();
  body = applyInternalLinks(html, anchorsFor(cat.slug), `/compare/${cat.slug}/`).html;
}

const PATH = `/compare/${cat.slug}/`;
const pageSchema = article
  ? [
      articleSchema({
        headline: article.title,
        description: article.metaDescription,
        path: PATH,
        dateModified: article.lastReviewed,
        authorName: FOUNDER.name,
        authorPath: FOUNDER.path,
      }),
      rows.length ? itemListSchema(rows.map((r) => ({ name: r.name, path: r.href })), article.title) : null,
      faqPageSchema(article.faq, PATH),
    ]
  : [
      webPageSchema({
        path: PATH,
        name: `Compare ${cat.name}`,
        description: `Every ${cat.name.toLowerCase().replace(/s$/, "")} we hold, side by side.`,
      }),
      rows.length ? itemListSchema(rows.map((r) => ({ name: r.name, path: r.href })), `${cat.name} compared`) : null,
    ];

const bmCta = products.length > 0 ? botMatchCtaFor(cat.slug) : undefined;

/* Indexability is read from the catalogue, not from the route registry — see
   comparePageIsSubstantive(). A category with nothing published gets the empty
   state and a noindex, and starts asking to be indexed on its own the moment a
   second machine goes live. */
const substantive = comparePageIsSubstantive(cat.slug, products.length);
/**
 * What this page calls its category, which is not always the category's name.
 *
 * TWO REASONS IT DIFFERS. "Self-Cleaning Litter Boxes" singularised by
 * chopping a trailing "s" gives "self-cleaning litter boxe", which shipped in
 * the meta description. And "Companion Robots & Robot Pets" contains "robot
 * pet" — the 8,100/mo head term this page cedes to the hub — so a comparison
 * table led with the phrase it had agreed not to compete for.
 *
 * The category keeps its name everywhere else. This is only what the
 * comparison page calls it.
 */
const COMPARE_NAME: Record<string, { plural: string; singular: string }> = {
  "companion-robots": { plural: "companion robots", singular: "companion robot" },
  "self-cleaning-litter-boxes": { plural: "self-cleaning litter boxes", singular: "self-cleaning litter box" },
  "robot-vacuums": { plural: "robot vacuums", singular: "robot vacuum" },
};
const namePlural = COMPARE_NAME[cat.slug]?.plural ?? cat.name.toLowerCase();
const nameSingular =
  COMPARE_NAME[cat.slug]?.singular ?? cat.name.toLowerCase().replace(/s$/, "");

---

<Base
  title={article?.seoTitle ?? `Compare ${namePlural} — every model, one table`}
  description={
    article?.metaDescription ??
    /* WAS A POOL SENTENCE ON EVERY CATEGORY. The fallback read "…side by
       side on what it cleans, THE POOL IT IS RATED FOR and how it is
       powered", which the companion, coding, litter, lawn and pet-camera
       comparison pages were all serving to Google. A robot pet is not rated
       for a pool. Same failure as the ComparisonTable column headings, which
       said "Pool size" on every category until 8 August: pool was the first
       category and its vocabulary got left in the shared template. This one
       names only what every category actually has. */
    `Every ${nameSingular} we hold, side by side on the same columns: what it is rated for, what it does, how it is powered and where its price sits.`
  }
  breadcrumbs={crumbs}
  schema={pageSchema}
  noindex={!substantive}
>
  {article ? (
    <header class="bp-cmp-head">
      <span class="eyebrow">{article.eyebrow}</span>
      <h1 class="bp-cmp-head__h1">{article.title}</h1>
      <p class="bp-cmp-head__stand">{article.standfirst}</p>
      <p class="bp-cmp-head__index">
        <a href="/compare/">Every comparison table BotPlanet publishes</a>
      </p>
      {article.image?.src && (
        <figure class="bp-cmp-head__hero">
          <img
            src={article.image.src}
            srcset={srcsetFor(article.image.src)}
            sizes="(min-width: 1100px) 1040px, 100vw"
            alt={article.image.alt}
            style={article.image.focal ? `object-position: ${article.image.focal}` : undefined}
            width="1672"
            height="941"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}
    </header>
  ) : (
    <header class="bp-cmp-head">
      <span class="eyebrow">Compare</span>
      <h1 class="bp-cmp-head__h1">Compare {namePlural}</h1>
      <p class="bp-cmp-head__stand">
        Every {nameSingular} we hold, side by side on what it is rated for, what it does and how it
        is powered. No prices here — those live on each review with the date they were checked.
      </p>
      {/* The index, linked from the prose. /compare/ was reachable only from
          the menu, which a crawler treats as furniture. */}
      <p class="bp-cmp-head__index">
        <a href="/compare/">Every comparison table BotPlanet publishes</a>
      </p>
    </header>
  )}

  {article && <ArticleContents html={body} extra={[
    ...(rows.length > 1 ? [{ id: "table", text: "Every machine, side by side" }] : []),
    { id: "matchups", text: "Brand matchups" },
  ]} />}

  {rows.length > 1 && (
    <ComparisonTable
      categorySlug={cat.slug}
      id="table"
      eyebrow="Side by side"
      title={`Every ${cat.name.toLowerCase().replace(/s$/, "")} we hold`}
      intro={`All ${rows.length} of them, on the four things that decide whether one fits. Where a manufacturer does not publish a figure the cell says so rather than guessing.`}
      rows={rows}
      note={`Ordered by price band, then alphabetically — not by what we earn. The size column shows a maximum length where the maker publishes one and a maximum area where it publishes that instead; the two are not interchangeable.`}
    />
  )}

  {pairs.length > 0 && (
    <BrandPairs
      id="matchups"
      eyebrow="Brand matchups"
      title="The matchups people actually search for"
      intro="Each of these is a section rather than its own page, because the demand behind them is small and splitting it would produce several thin pages competing with each other. The verdict comes first; the machine named under each brand is the one that answers for it."
      pairs={pairs}
    />
  )}

  {article && <article class="bp-prose" set:html={body} />}

  {bmCta && (
    <BotMatchCta
      categorySlug={cat.slug}
      headline={bmCta.headline}
      body={bmCta.body}
      points={bmCta.points}
      ctaLabel={bmCta.ctaLabel}
      note={bmCta.note}
      image={bmCta.image}
    />
  )}

  {article && article.faq.length > 0 && (
    <FaqList
      id="faq"
      eyebrow="Questions"
      title="Questions people actually ask"
      intro="The questions this comparison gets asked, answered in a sentence or two each."
      items={article.faq}
    />
  )}

  {products.length === 0 && (
    <div class="empty">
      <p class="empty__title">No products published in this category yet</p>
      <p>
        Published products appear here automatically. In the meantime,{" "}
        <a href={categoryRoutes(cat.slug).hub}>{cat.name.toLowerCase()}</a> has what we know about
        the category so far.
      </p>
    </div>
  )}

  {article && <ArticleFooter lastReviewed={article.lastReviewed} />}
</Base>

<style>
  .bp-cmp-head {
    max-width: 62ch;
    margin: 0 0 clamp(2rem, 5vw, 3rem);
  }

  .bp-cmp-head__h1 {
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5.6vw, 3.1rem);
    line-height: 1.06;
    letter-spacing: -0.024em;
    text-wrap: balance;
    background: linear-gradient(172deg, #ffffff 4%, #e4e9f1 44%, #a2aab8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bp-cmp-head__hero {
    margin: var(--space-6) 0 0;
    border-radius: var(--radius-lg, 14px);
    overflow: hidden;
  }
  .bp-cmp-head__hero img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1672 / 941;
    object-fit: cover;
  }

  .bp-cmp-head__index { margin: 0.6rem 0 0; font-size: 0.92rem; }
  .bp-cmp-head__index a { font-weight: 600; }

  .bp-cmp-head__stand {
    margin: 1.2rem 0 0;
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-secondary);
  }
</style>
