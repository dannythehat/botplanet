---
/**
 * Saved products. Device-local only (localStorage) — there is no account and
 * no cloud sync, and the page states that rather than implying one.
 */
import Base from "../../layouts/Base.astro";
import { LAUNCH_CATEGORY, categoryRoutes } from "../../content/routes";
const cat = categoryRoutes(LAUNCH_CATEGORY);
---
<Base
  title="Saved products — BotPlanet"
  description="Products you have saved on this device."
  noindex={true}
  narrow={true}
>
  <h1>Saved products</h1>
  <p class="note">
    Saved items are stored on this device only. There is no BotPlanet account and nothing is synced to a server, so
    clearing your browser data clears this list.
  </p>

  <div id="saved-list" class="mt-lg" aria-live="polite">
    <div class="empty">
      <p class="empty__title">Nothing saved yet</p>
      <p>Tap the heart on any product to keep it here. Start with <a class="link" href={cat.hub}>robotic pool cleaners</a>.</p>
    </div>
  </div>
</Base>
<script is:inline>
  (function () {
    var el = document.getElementById("saved-list");
    if (!el) return;
    var ids = [];
    try { ids = JSON.parse(localStorage.getItem("bp_saved") || "[]"); } catch (e) { ids = []; }
    if (!ids.length) return;
    var recent = [];
    try { recent = JSON.parse(localStorage.getItem("bp_recent") || "[]"); } catch (e) { recent = []; }
    var byId = {};
    recent.forEach(function (r) { if (r && r.slug) byId["prod-" + r.slug] = r; });
    var rows = ids.map(function (id) {
      var r = byId[id];
      return r
        ? '<li><a class="link" href="' + r.href + '">' + r.name + '</a></li>'
        : '<li class="muted">' + String(id).replace(/^prod-/, "").replace(/-/g, " ") + '</li>';
    });
    el.innerHTML =
      '<p class="note">' + ids.length + ' saved on this device.</p><ul class="results">' + rows.join("") + '</ul>';
  })();
</script>
<style>
  .results { list-style: none; padding: 0; display: grid; gap: var(--space-sm); margin-top: var(--space-md); }
  .results li { margin: 0; }
</style>
