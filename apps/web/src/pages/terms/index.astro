---
import Base from "../../layouts/Base.astro";
import RoutePlaceholder from "../../components/RoutePlaceholder.astro";
import { routeFor } from "../../content/routes";
import { breadcrumbsFor } from "../../lib/routing";

const route = routeFor("/terms/")!;
const crumbs = breadcrumbsFor("/terms/");
---
<Base
  title={`${route.label} of use — using BotPlanet and the links it carries`}
  description={route.summary ?? route.label}
  noindex={!route.indexable}
  breadcrumbs={crumbs}
  narrow={true}
>
  <RoutePlaceholder title="Terms" summary="The terms that apply when you use BotPlanet." owner="legal copy pending owner sign-off" />
</Base>
