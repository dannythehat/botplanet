---
import Base from "../layouts/Base.astro";
import { getDb, schema } from "../lib/db";
import { eq } from "drizzle-orm";
import { shellJourney } from "../content/journeys";
import { LAUNCH_CATEGORY, categoryRoutes } from "../content/routes";

const db = getDb(Astro.locals);
const products = await db
  .select({ id: schema.products.id })
  .from(schema.products)
  .where(eq(schema.products.status, "published"));

const live = categoryRoutes(LAUNCH_CATEGORY);
const journey = shellJourney();

const categories = [
  { name: "Pool cleaning", description: "Robots that scrub floors, walls and waterlines.", state: "Live", href: live.hub, code: "01" },
  { name: "Window cleaning", description: "Glass-cleaning robots for homes and high-rise surfaces.", state: "In development", code: "02" },
  { name: "Lawn & garden", description: "Autonomous mowers, irrigation and outdoor maintenance.", state: "In development", code: "03" },
  { name: "Floor care", description: "Vacuum, mop and specialist indoor cleaning robots.", state: "Planned", code: "04" },
  { name: "Security", description: "Patrol, monitoring and property-protection robotics.", state: "Planned", code: "05" },
  { name: "Companion & service", description: "Useful home, hospitality and personal-assistance robots.", state: "Planned", code: "06" },
];
---

<Base
  title="BotPlanet — the world of real-world robots"
  description="Discover, compare and choose real-world robots across home, garden, cleaning, security and service categories. Robotic pool cleaners are the first live category."
  bleed={true}
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__marker">THE WORLD OF REAL-WORLD ROBOTS</p>
        <h1>Robots are leaving the lab.<br /><span>We help you choose the right ones.</span></h1>
        <p class="hero__lede">
          BotPlanet is building the premium destination for robots that do useful work in homes, gardens, businesses and everyday life. We compare the machines, verify the claims and track where they can actually be bought.
        </p>
        {/* The artwork shows six kinds of robot; only one category is live, so
            the primary action names it rather than promising the other five.
            A visitor who wants the wider picture gets the directory link. */}
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href={live.hub}>Explore robotic pool cleaners</a>
          <a class="btn btn--lg" href={`/botmatch/${LAUNCH_CATEGORY}/`}>Find my pool robot</a>
          <a class="hero__more" href="#robot-worlds">See all six robot worlds &#8595;</a>
        </div>
        <div class="hero__proof">
          <span><strong>{products.length}</strong> verified launch models</span>
          <span><strong>6</strong> robot worlds mapped</span>
          <span><strong>1</strong> category live now</span>
        </div>
      </div>

      <figure class="hero__art">
        <picture>
          <source media="(max-width: 720px)" srcset="/media/home/hero-mobile.webp" width="941" height="1672" />
          <img
            src="/media/home/hero-desktop.webp"
            width="1672"
            height="941"
            alt="A night-time home where six kinds of robot are working at once: a pool cleaner in the water, a window cleaner on the glass, a mower on the lawn, a vacuum on the terrace, a four-legged patrol robot and a companion robot at the door, beneath the BotPlanet logo and the Earth."
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </figure>
    </div>
  </section>

  <section class="worlds" id="robot-worlds">
    <div class="wrap">
      <div class="section-intro">
        <p class="kicker">BOTPLANET DIRECTORY</p>
        <h2>One planet. Every useful robot.</h2>
        <p>
          Pool cleaners are where we begin, not where BotPlanet ends. Each new category will receive its own evidence model, comparisons, buying guidance and category-specific recommendation journey.
        </p>
      </div>

      <div class="world-grid">
        {categories.map((category) => (
          category.href ? (
            <a class="world world--live" href={category.href}>
              <span class="world__code">{category.code}</span>
              <span class="world__state">{category.state}</span>
              <h3>{category.name}</h3>
              <p>{category.description}</p>
              <span class="world__action">Explore category <span aria-hidden="true">→</span></span>
            </a>
          ) : (
            <article class="world">
              <span class="world__code">{category.code}</span>
              <span class="world__state">{category.state}</span>
              <h3>{category.name}</h3>
              <p>{category.description}</p>
              <span class="world__action world__action--quiet">Category system being built</span>
            </article>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="live-category">
    <div class="wrap live-category__grid">
      <div>
        <p class="kicker">FIRST LIVE ROBOT WORLD</p>
        <h2>Robotic pool cleaners</h2>
        <p class="large">
          Our first complete category is live with {products.length} verified models. This is the proving ground for BotPlanet’s evidence, comparison, offer and recommendation systems before they expand across the wider robotics market.
        </p>
      </div>
      <div class="live-category__actions">
        <a class="btn btn--primary btn--lg" href={live.hub}>Browse pool-cleaning robots</a>
        <a class="btn btn--lg" href={journey.href}>{journey.ctaLabel}</a>
        <a class="text-link" href={live.compare}>Compare the live models →</a>
      </div>
    </div>
  </section>

  <section class="system">
    <div class="wrap">
      <div class="section-intro section-intro--compact">
        <p class="kicker">THE BOTPLANET STANDARD</p>
        <h2>Built to separate robotics from marketing.</h2>
      </div>
      <div class="system-grid">
        <article><span>01</span><h3>Exact product identity</h3><p>No sibling models, regional variants or accessories silently mixed together.</p></article>
        <article><span>02</span><h3>Evidence behind claims</h3><p>Specifications, limitations and conflicts remain tied to their sources.</p></article>
        <article><span>03</span><h3>Current commercial truth</h3><p>Retailer, stock, price and delivery data are dated instead of presented as permanent facts.</p></article>
        <article><span>04</span><h3>Suitability before commission</h3><p>The right robot is chosen first. The purchase route is considered afterwards.</p></article>
      </div>
    </div>
  </section>

  <section class="close">
    <div class="wrap close__inner">
      <img src="/logo/botplanet-metal.svg" alt="BotPlanet" width="380" height="80" />
      <p>The robotics market is expanding fast. BotPlanet is building the map.</p>
      <a class="btn btn--primary btn--lg" href="#robot-worlds">Explore the planet</a>
    </div>
  </section>
</Base>

<style>
  /* The artwork now carries the height the hero used to get from a full
     viewport of empty space, so the padding comes down and the call to action
     stays above the fold instead of two scrolls beneath a headline. */
  .hero { display: grid; align-items: center; padding: clamp(26px, 3.5vw, 48px) 0 clamp(48px, 6vw, 84px); overflow: hidden; position: relative; }
  .hero::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 75% 44%, rgba(219,224,230,.11), transparent 24rem); pointer-events: none; }
  /* One column, artwork first to the eye and the H1 first in the source. The
     picture carries the brand and the six categories in one frame; putting it
     beside the copy at half width would shrink six robots into a thumbnail. */
  /* Stacked by default — on a phone the artwork leads and the copy follows.
     Two columns from 1100px, where a 16:9 frame beside the copy still reads at
     full composition AND leaves the buttons above the fold. A full-width
     picture on a laptop is a whole viewport of image and nothing to click. */
  .hero__grid { display: grid; grid-template-columns: 1fr; gap: clamp(26px, 4vw, 44px); justify-items: center; text-align: center; }
  .hero__copy { max-width: 62rem; }
  @media (min-width: 1100px) {
    .hero__grid { grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr); gap: clamp(32px, 4vw, 56px); align-items: center; justify-items: stretch; text-align: left; }
    .hero__art { order: 0; }
    /* Three lines, not five: the column is narrower than a full-width hero
       and a headline that stacks into a ladder stops reading as a sentence. */
    .hero__copy h1 { font-size: clamp(32px, 2.7vw, 43px); }
    .hero__lede { margin-left: 0; margin-right: 0; font-size: 17px; }
    .hero__actions, .hero__proof { justify-content: flex-start; }
  }
  .hero__art {
    order: -1;
    width: 100%;
    margin: 0;
    border: 1px solid rgba(206, 214, 228, 0.22);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 30px 70px rgba(0,0,0,.55);
  }
  .hero__art img { display: block; width: 100%; height: auto; }
  .hero__more { display: inline-flex; align-items: center; align-self: center; margin-left: 6px; color: var(--text-tertiary); font-size: 14px; text-decoration: none; }
  .hero__more:hover { color: #f3f5f7; text-decoration: underline; }
  .hero__marker,.kicker { color: #aeb4bc; font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: .18em; margin: 0 0 14px; }
  h1 { max-width: 980px; margin: 0 auto; font-size: clamp(50px,7.2vw,94px); line-height: .98; letter-spacing: -.055em; }
  /* Smaller than a text-only hero would need: the picture above it is doing
     the shouting, and a headline that fills the screen buries the buttons. */
  .hero__copy h1 { font-size: clamp(34px, 4.4vw, 58px); line-height: 1.04; letter-spacing: -.04em; }
  h1 span { color: #9ba2ac; }
  .hero__lede { max-width: 700px; margin: 20px auto 0; color: var(--text-secondary); font-size: clamp(18px,2vw,22px); line-height: 1.55; }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px; margin-top: 26px; }
  .hero__proof { display: flex; flex-wrap: wrap; justify-content: center; gap: 26px; margin-top: 30px; padding-top: 20px; border-top: 1px solid rgba(210,216,224,.14); color: var(--text-tertiary); font-size: 13px; }
  .hero__proof strong { display: block; color: #f3f5f7; font-size: 24px; }
  .worlds,.system { padding: var(--section-gap) 0; background: linear-gradient(180deg,rgba(255,255,255,.025),transparent); border-top: 1px solid rgba(210,216,224,.1); }
  .section-intro { max-width: 820px; margin-bottom: 46px; }.section-intro--compact { margin-bottom: 30px; }
  .section-intro h2,.live-category h2,.system h2 { margin: 0; font-size: clamp(38px,5vw,64px); letter-spacing: -.045em; }
  .section-intro > p:last-child,.live-category .large { color: var(--text-secondary); font-size: 19px; line-height: 1.65; }
  .world-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
  .world { min-height: 290px; display: flex; flex-direction: column; padding: 25px; color: inherit; text-decoration: none; background: linear-gradient(145deg,rgba(255,255,255,.04),transparent 36%),#0a0d10; border: 1px solid rgba(207,213,220,.14); border-radius: 18px; transition: transform .2s ease,border-color .2s ease,background .2s ease; }
  .world--live { background: linear-gradient(145deg,rgba(255,255,255,.12),transparent 36%),linear-gradient(180deg,#171b20,#090b0e); border-color: rgba(228,232,237,.42); }
  .world--live:hover { transform: translateY(-4px); border-color: #e4e8ec; }
  .world__code { color: #686f78; font: 700 12px/1 var(--font-mono); letter-spacing: .15em; }
  .world__state { align-self: flex-end; margin-top: -12px; color: #aeb4bc; font: 700 10px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .world h3 { margin: auto 0 12px; font-size: 27px; }.world p { color: var(--text-secondary); line-height: 1.55; }
  .world__action { margin-top: 18px; color: #eef0f3; font-weight: 700; }.world__action--quiet { color: #747b85; font-size: 13px; }
  .live-category { padding: var(--section-gap) 0; border-top: 1px solid rgba(210,216,224,.1); border-bottom: 1px solid rgba(210,216,224,.1); background: radial-gradient(circle at 75% 40%,rgba(229,233,238,.09),transparent 25rem),#080a0d; }
  .live-category__grid { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(310px,.8fr); gap: 70px; align-items: center; }
  .live-category__actions { display: grid; gap: 13px; }.text-link { color: #c8cdd4; text-align: center; text-decoration: none; font-weight: 700; }
  .system-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; }
  .system-grid article { padding: 25px; background: #090c0f; border: 1px solid rgba(207,213,220,.13); border-radius: 16px; }
  .system-grid span { color: #747b85; font: 700 12px/1 var(--font-mono); }.system-grid h3 { margin: 34px 0 12px; }.system-grid p { color: var(--text-secondary); line-height: 1.55; }
  .close { padding: clamp(70px,10vw,140px) 0; }.close__inner { text-align: center; }.close img { width: min(520px,82vw); height: auto; }.close p { margin: 20px auto 30px; color: var(--text-secondary); font-size: 20px; }
  @media(max-width:960px){.live-category__grid{grid-template-columns:1fr}.world-grid{grid-template-columns:repeat(2,1fr)}.system-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:620px){.hero{min-height:auto;padding:48px 0 70px}.hero__grid{gap:26px}h1{font-size:40px}.world-grid,.system-grid{grid-template-columns:1fr}.world{min-height:235px}.hero__proof{gap:18px}.hero__proof span{flex:1 1 28%}.live-category__grid{gap:30px}.section-intro h2,.live-category h2,.system h2{font-size:40px}}
</style>
