---
import Base from "../layouts/Base.astro";
import { LAUNCH_CATEGORY, categoryRoutes, liveCategories, productPath } from "../content/routes";
import { srcsetFor } from "../lib/srcset";
import CategoryFeature from "../components/CategoryFeature.astro";
import { webPageSchema, SITE_URL } from "../lib/seo";
import { REVIEWS } from "../content/reviews";

const live = categoryRoutes(LAUNCH_CATEGORY);

/**
 * The reviews, listed on the homepage.
 *
 * Until the audit of 4 August 2026 this page linked to the hub eleven times
 * and to a review not once — so eleven pages carrying every piece of original
 * work on this site sat two clicks from the front door, and the homepage
 * passed no authority to any of them. Reading REVIEWS rather than a hand-typed
 * list means a review that ships tomorrow appears here the same day, and one
 * that is renamed cannot leave a dead link behind.
 */
const reviews = Object.values(REVIEWS)
  .filter((r) => r.categorySlug === LAUNCH_CATEGORY)
  .map((r) => ({
    slug: r.slug,
    title: r.title.replace(/ review$/i, ""),
    href: productPath(r.slug, r.categorySlug),
    bestFor: r.facts?.find((f) => f.label === "Cleans")?.value ?? null,
    price: r.facts?.find((f) => f.label.startsWith("Max"))?.value ?? null,
    image: r.image,
  }))
  .sort((a, b) => a.title.localeCompare(b.title));

/* BotMatch section artwork, supplied as a composed desktop/mobile pair. */
const matcherImage = {
  src: "/media/botmatch/explainer-desktop.webp",
  mobileSrc: "/media/botmatch/explainer-mobile.webp",
  width: 1672,
  height: 941,
  mobileWidth: 941,
  mobileHeight: 1672,
  /* The tile-by-tile list went with the Security cancellation of 6 August: it
     named the artwork's six drawn tiles as though they were the site's
     categories, and one of them no longer is. What it describes now is what
     the picture is actually of. */
  alt:
    "A BotMatch panel at the centre of linked category tiles, showing a best-match result being confirmed.",
};

/* Category feature artwork. The sections' words and buttons are real HTML
   beside the picture and never drawn into it, and each file is composed with
   one side dark and empty, which is what `side` on the component names. The
   pictures are described rather than marked decorative — see CategoryFeature
   for why that changed. */
const featureImage = {
  src: "/media/pool-category/feature-desktop.webp",
  mobileSrc: "/media/pool-category/feature-mobile.webp",
  width: 1672,
  height: 941,
  alt: "A robotic pool cleaner working the floor of a lit in-ground swimming pool at dusk, its cable trailing to the edge.",
};

const windowFeatureImage = {
  src: "/media/window-category/feature-desktop.webp",
  mobileSrc: "/media/window-category/feature-mobile.webp",
  width: 1672,
  height: 941,
  /* Pulled left of centre so the machine on the glass survives the crop when
     the section is shorter than the file's own 16:9. */
  focal: "24% center",
  alt: "A window-cleaning robot gripping the glass of a tall window at dusk, water spread across the pane behind it.",
};

const lawnFeatureImage = {
  src: "/media/lawn-category/feature-desktop.webp",
  mobileSrc: "/media/lawn-category/feature-mobile.webp",
  width: 1672,
  height: 941,
  /* Right of centre: the mower and the lit house are both over there, and a
     centre crop would push the machine off the edge on a short section. */
  focal: "78% center",
  alt: "A robot lawn mower cutting a striped lawn in the evening, a lit house behind it.",
};

const floorFeatureImage = {
  src: "/media/floor-category/feature-desktop.webp",
  mobileSrc: "/media/floor-category/feature-mobile.webp",
  width: 1672,
  height: 941,
  /* Left of centre: the machine and the lit room are both over there, and the
     right of the frame is bare wall that survives any crop. */
  focal: "22% center",
  alt: "A robot vacuum crossing the hard floor of a lit living room, its docking station against the wall behind.",
};

const companionFeatureImage = {
  src: "/media/companion-category/feature-desktop.webp",
  mobileSrc: "/media/companion-category/feature-mobile.webp",
  width: 1612,
  height: 881,
  /* Right of centre, where the robot and the lit living room both sit. */
  focal: "76% center",
  alt: "A small companion robot on a side table in a warmly lit living room, someone seated beyond it.",
};

/**
 * THE DIRECTORY, READ FROM THE REGISTRY RATHER THAN TYPED HERE.
 *
 * This was a hand-written list of six, and every line of it had gone stale.
 * It called window and lawn "in development" and floor care, companion and
 * security "planned" while five of those categories were live and published;
 * it listed Security, which was cancelled on 6 August; and it did not mention
 * pet cameras, litter boxes, grill robots or coding robots at all. The front
 * door of the site was describing a roadmap from before four categories
 * shipped.
 *
 * A hand-typed copy of the registry cannot stay true, so this no longer keeps
 * one. liveCategories() is the same function the header, the footer, the
 * /robots/ index and the sitemap read, which means a category is on this page
 * the day it goes live and cannot be on it a day before.
 */
/**
 * Artwork for the directory tiles, one per category.
 *
 * TWO RULES DECIDED EVERY CHOICE HERE, AND ONE OF THEM RULED OUT THE OBVIOUS
 * PICKS. Nothing with a word painted into it, and nothing that is not the
 * category's best frame.
 *
 * The obvious files were each hub's own `hero`, and for pool and window those
 * are the two on the site with type burnt in: /media/pool/hero-desktop.webp
 * carries the BotPlanet wordmark, and /media/window/hero-desktop.webp carries
 * the wordmark plus a "Window Cleaning Robots / Crystal-clear views" headline.
 * A headline drawn into a JPEG is invisible to Google, silent to a screen
 * reader and impossible to translate, and at tile size it would be unreadable
 * anyway. Those two use their category feature file instead, which is the same
 * subject shot clean.
 *
 * `focal` is where the subject actually sits, because a 16:9 master cropped to
 * a 3:2 tile loses the sides — centre-cropping the vacuums frame walks the
 * robot straight out of it.
 *
 * FIVE OF THESE ARE THE OWNER'S OWN PHOTOGRAPHS, supplied 8 August 2026, and
 * they replaced BotPlanet artwork on pool, companion, grill and pet camera.
 * Pet camera had nothing at all until they arrived — it was the one hub that
 * had never had any artwork, and its tile was rendering an empty plate.
 */
const TILE_ART: Record<string, { src: string; focal?: string; alt: string }> = {
  "robotic-pool-cleaners": {
    src: "/media/hubs/pool/tile.webp",
    alt: "A tracked robotic pool cleaner resting on a white cover at the edge of a sunlit blue pool.",
  },
  "window-cleaning-robots": {
    src: "/media/window-category/feature-desktop.webp",
    focal: "24% center",
    alt: "A window-cleaning robot gripping the glass of a hillside house at dusk, the view beyond.",
  },
  "robotic-lawn-mowers": {
    src: "/media/hubs/lawn/hero.webp",
    alt: "A robot mower on a striped lawn at sunset, a lit stone house behind it.",
  },
  "robot-vacuums": {
    src: "/media/hubs/vacuums/hero.webp",
    focal: "70% center",
    alt: "A round robot vacuum crossing the wood floor of a sunlit open-plan living room.",
  },
  "companion-robots": {
    src: "/media/hubs/companion/tile.webp",
    alt: "Four rendered companion robots standing together against a pale background, including a robot dog.",
  },
  "self-cleaning-litter-boxes": {
    src: "/media/hubs/litter/hero.webp",
    focal: "60% center",
    alt: "A long-haired tabby walking towards a white self-cleaning litter box in a utility room.",
  },
  "grill-cleaning-robots": {
    src: "/media/hubs/grill/tile.webp",
    alt: "A red grill-cleaning robot sitting on stainless steel grill grates between a pair of tongs and a spatula.",
  },
  "pet-camera-robots": {
    /* The tile crop, not the master. The supplied file is nearly square and
       carries a phone showing the live view; a 3:2 window centred on it cuts
       the phone in half, which reads as a rendering fault. See the note on
       hub-petcam-tile in the media register. */
    src: "/media/hubs/petcam/tile.webp",
    alt: "A pet camera robot on its wheels beside its white charging dock.",
  },
  "educational-coding-robots": {
    src: "/media/hubs/coding/hero.webp",
    focal: "60% center",
    alt: "A child's hands beside a small tracked coding robot on a kitchen table, parts laid out around it.",
  },
};

const categories = liveCategories()
  .slice()
  .sort((a, b) => a.order - b.order)
  .map((c, i) => ({
    name: c.name,
    description: c.short,
    jtbd: c.jtbd,
    href: categoryRoutes(c.slug).hub,
    code: String(i + 1).padStart(2, "0"),
    art: TILE_ART[c.slug] ?? null,
  }));

/* The homepage is a directory of categories, and until now its markup said so
   to a reader but not to a crawler: the graph described a company and a
   website and never the thing the page actually lists.

   Every entry carries a url now, because every category listed is live and has
   a page. The old list mixed built categories with roadmap ones and gave a URL
   only to the first. */
const categoryList = {
  "@type": "ItemList",
  "@id": `${SITE_URL}/#robot-categories`,
  name: "Robot categories on BotPlanet",
  numberOfItems: categories.length,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: categories.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    description: c.description,
    ...(c.href ? { url: `${SITE_URL}${c.href}` } : {}),
  })),
};

const homeSchema = [
  webPageSchema({
    path: "/",
    name: "BotPlanet — the world of real-world robots",
    description:
      "Discover, compare and choose real-world robots for the US — pool, window, lawn, vacuum, companion, pet camera, litter, grill and coding robots, with the evidence behind every pick.",
    type: "CollectionPage",
  }),
  categoryList,
];
---

<Base
  title="BotPlanet — the world of real-world robots"
  description="Compare real-world robots for the US — pool cleaners, window robots, companion pets and coding robots. Evidence, honest rule-outs, and what we could not verify."
  bleed={true}
  schema={homeSchema}
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__marker">THE WORLD OF REAL-WORLD ROBOTS</p>
        <h1>Robots are leaving the lab.<br /><span>We help you choose the right ones.</span></h1>
        <p class="hero__lede">
          BotPlanet is building the premium destination for robots that do useful work in homes, gardens, businesses and everyday life. We compare the machines, verify the claims and track where they can actually be bought.
        </p>
        {/* One action, not three. BotMatch used to sit here as a second button
            and again below as a third — the same tool asked for twice before
            the reader knew what it was. It now has its own section instead. */}
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href={live.hub}>Explore robotic pool cleaners</a>
          <a class="hero__more" href="#robot-worlds">See all {categories.length} robot worlds &#8595;</a>
        </div>
      </div>

      <figure class="hero__art">
        <picture>
          <source
            media="(max-width: 720px)"
            srcset={srcsetFor("/media/home/hero-mobile.webp")}
            sizes="100vw"
            width="941"
            height="1672"
          />
          <img
            src="/media/home/hero-desktop.webp"
            srcset={srcsetFor("/media/home/hero-desktop.webp")}
            sizes="(min-width: 1100px) 58vw, 100vw"
            width="1672"
            height="941"
            alt="A night-time home where several kinds of robot are working at once: a pool cleaner in the water, a window cleaner on the glass, a mower on the lawn, a vacuum on the terrace and a companion robot at the door, beneath the BotPlanet logo and the Earth."
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </figure>
    </div>
  </section>

  <section class="worlds" id="robot-worlds">
    <div class="wrap">
      <div class="section-intro">
        <p class="kicker">BOTPLANET DIRECTORY</p>
        <h2>One planet. Every useful robot.</h2>
        <p>
          {categories.length} categories are live, each with its own evidence model, comparisons, buying
          guidance and its own recommendation journey. The questions that decide a mower are not the
          questions that decide a pool robot, so no category borrows another's.
        </p>
      </div>

      {/* Generated from the registry — see the note above `categories`. The
          section stood empty for a while and the hero still pointed a reader
          at it, so the anchor landed on a heading and nothing to click. */}
      <ul class="worlds__grid">
        {categories.map((c) => (
          <li>
            <a class="card card--interactive worlds__card" href={c.href}>
              {c.art ? (
                <img
                  class="worlds__img"
                  src={c.art.src}
                  srcset={srcsetFor(c.art.src)}
                  sizes="(min-width: 900px) 33vw, (min-width: 520px) 50vw, 100vw"
                  alt={c.art.alt}
                  loading="lazy"
                  decoding="async"
                  style={c.art.focal ? `object-position: ${c.art.focal}` : undefined}
                />
              ) : (
                /* An empty plate, not a stand-in. Borrowing another category's
                   photograph would be the one thing worse than having none. */
                <span class="worlds__img worlds__img--none" aria-hidden="true"></span>
              )}
              <span class="worlds__text">
                <span class="worlds__code" aria-hidden="true">{c.code}</span>
                <h3 class="worlds__name">{c.name}</h3>
                <p class="worlds__body">{c.description}</p>
                <span class="worlds__jtbd">{c.jtbd}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="botmatch" id="botmatch">
    {/* Three blocks, in the order a reader needs them: what it is, what it
        looks like, how it works — and the button last. The section used to
        put the button in the middle and keep talking afterwards, with the
        picture stranded below all of it on a phone. Nothing follows the
        call to action now. */}
    <div class="wrap botmatch__grid">
      <div class="botmatch__intro">
        <p class="kicker">BOTMATCH</p>
        <h2>One matcher per robot world. Each one asks what its own job needs.</h2>
        <p class="large">
          Specifications only matter once you translate them into your home. BotMatch does that translation — a handful of plain questions about the space a machine has to work in, and a shortlist of the ones that actually suit it, with the ones to rule out and why. Every category gets its own, because the questions that decide a mower are not the questions that decide a pool robot or a window cleaner.
        </p>
      </div>

      {matcherImage && (
        <figure class="botmatch__art">
          <picture>
            <source
              media="(max-width: 720px)"
              srcset={srcsetFor(matcherImage.mobileSrc)}
              sizes="100vw"
              width={matcherImage.mobileWidth}
              height={matcherImage.mobileHeight}
            />
            <img
              src={matcherImage.src}
              srcset={srcsetFor(matcherImage.src)}
              sizes="(min-width: 1000px) 46vw, 100vw"
              width={matcherImage.width}
              height={matcherImage.height}
              alt={matcherImage.alt}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
      )}

      <div class="botmatch__detail">
        <ol class="botmatch__steps">
          <li>
            <span class="botmatch__step">01</span>
            <h3>It asks about your space, not about models</h3>
            <p>Size, shape, surface, and what you are tired of doing yourself. No model numbers and no jargon, whichever robot world you are in.</p>
          </li>
          <li>
            <span class="botmatch__step">02</span>
            <h3>It rules machines out before it ranks them</h3>
            <p>A machine rated below what your space needs is excluded outright, not quietly ranked lower. Where a maker publishes nothing, that reads as unknown — never as unsuitable.</p>
          </li>
          <li>
            <span class="botmatch__step">03</span>
            <h3>You get a result you can check</h3>
            <p>Every recommendation shows what it was matched on, so you can disagree with it. We email the result and keep it on a page you can return to.</p>
          </li>
        </ol>

        <p class="botmatch__note">
          <strong>Every live category has its own matcher.</strong> {categories.length} of them, each with its own questions and its own scoring — a new one arrives with the category rather than after it.
        </p>

        <p class="botmatch__integrity">
          What BotMatch cannot see is what we earn. Commission is not available to the part of the system that chooses your robot — that is enforced in the code, not promised in a policy.
        </p>

        <div class="botmatch__actions">
          <a class="btn btn--primary btn--lg" href="/how-botmatch-works/">How BotMatch works</a>
          <a class="btn btn--quiet btn--lg" href={`/botmatch/${LAUNCH_CATEGORY}/`}>Try the pool matcher</a>
          
        </div>
      </div>
    </div>
  </section>

  <CategoryFeature
    id="live-pool"
    state="Live category"
    heading="Robotic pool cleaners"
    metalWord="pool"
    body="Find verified robots that scrub floors, walls and waterlines."
    side="left"
    image={{ ...featureImage, focal: "82% center" }}
    primary={{ label: "Browse pool-cleaning robots", href: live.hub }}
    secondary={{ label: "Find My Pool Cleaner", href: live.botmatch }}
    more={{ label: "Compare live models", href: live.compare }}
  />

  {/* Every review, named and linked. The homepage used to send all of its
      traffic to the hub and let the reader find the work from there; a list of
      real model names is both the better click and the better signal. */}
  <section class="reviews" id="pool-reviews">
    <div class="wrap">
      <div class="section-intro section-intro--compact">
        <p class="kicker">EVERY MODEL WE HAVE REVIEWED</p>
        <h2>{reviews.length} robots, checked against the maker's own words.</h2>
        <p>
          Each review names its sources, records what the manufacturer will not state, and
          says plainly who should buy something else. Prices are checked automatically and
          dated on the page.
        </p>
      </div>

      <ul class="reviews__grid">
        {reviews.map((r) => (
          <li class="reviews__item">
            <a href={r.href}>
              <img
                src={r.image.src}
                srcset={srcsetFor(r.image.src)}
                sizes="(min-width: 900px) 22vw, 45vw"
                width="1254"
                height="1254"
                alt={r.image.alt}
                loading="lazy"
                decoding="async"
              />
              <div class="reviews__body">
                <h3>{r.title}</h3>
                {r.bestFor && <p class="reviews__meta">{r.bestFor}</p>}
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="reviews__actions">
        <a class="btn btn--quiet btn--lg" href={live.hub}>See the full category</a>
        <a class="btn btn--quiet btn--lg" href={live.compare}>Compare them side by side</a>
      </div>
    </div>
  </section>

  {/* THESE FOUR ARE LIVE, AND THIS BLOCK USED TO SAY THEY WERE NOT.
      Window and lawn read "In development", floor care and companion read
      "Planned category", and all four sent the reader to /robots/ or back to
      the pool — while all four had a hub, a comparison page, a matcher and
      published products. A section that describes a built category as
      unbuilt costs the click it was put there to earn.

      Security was here too, on the same "Planned category" line. It was
      cancelled on 6 August, so the section is gone rather than restated. */}
  <CategoryFeature
    id="next-window"
    state="Live category"
    heading="Window-cleaning robots"
    metalWord="Window-cleaning"
    body="Robots that grip glass and clean windows, balcony doors and high panes you would rather not reach."
    side="right"
    image={windowFeatureImage}
    primary={{ label: "Browse window-cleaning robots", href: categoryRoutes("window-cleaning-robots").hub }}
    secondary={{ label: "Find My Window Robot", href: categoryRoutes("window-cleaning-robots").botmatch }}
    more={{ label: "Compare live models", href: categoryRoutes("window-cleaning-robots").compare }}
  />

  <CategoryFeature
    id="next-lawn"
    state="Live category"
    heading="Robotic lawn mowers"
    metalWord="lawn mowers"
    body="Mowers that cut a little every day and keep the lawn level, on a boundary wire or without one."
    side="left"
    image={lawnFeatureImage}
    primary={{ label: "Browse robotic lawn mowers", href: categoryRoutes("robotic-lawn-mowers").hub }}
    secondary={{ label: "Find My Robot Mower", href: categoryRoutes("robotic-lawn-mowers").botmatch }}
    more={{ label: "Compare live models", href: categoryRoutes("robotic-lawn-mowers").compare }}
  />

  <CategoryFeature
    id="next-floor"
    state="Live category"
    heading="Robot vacuums and mops"
    metalWord="vacuums"
    body="Vacuum and mop robots that map the house, empty themselves and keep hard floors and carpet clean without being asked."
    side="right"
    image={floorFeatureImage}
    primary={{ label: "Browse robot vacuums", href: categoryRoutes("robot-vacuums").hub }}
    secondary={{ label: "Find My Robot Vacuum", href: categoryRoutes("robot-vacuums").botmatch }}
    more={{ label: "Compare live models", href: categoryRoutes("robot-vacuums").compare }}
  />

  <CategoryFeature
    id="next-companion"
    state="Live category"
    heading="Companion robots and robot pets"
    metalWord="Companion"
    body="Robot pets and desk companions built for company rather than chores — for a child's room, a desk, or somebody living on their own."
    side="left"
    image={companionFeatureImage}
    primary={{ label: "Browse companion robots", href: categoryRoutes("companion-robots").hub }}
    secondary={{ label: "Find My Companion Robot", href: categoryRoutes("companion-robots").botmatch }}
    more={{ label: "Compare live models", href: categoryRoutes("companion-robots").compare }}
  />

  <section class="system">
    <div class="wrap">
      <div class="section-intro section-intro--compact">
        <p class="kicker">THE BOTPLANET STANDARD</p>
        <h2>Built to separate robotics from marketing.</h2>
      </div>
      <div class="system-grid">
        <article><span>01</span><h3>Exact product identity</h3><p>No sibling models, regional variants or accessories silently mixed together.</p></article>
        <article><span>02</span><h3>Evidence behind claims</h3><p>Specifications, limitations and conflicts remain tied to their sources.</p></article>
        <article><span>03</span><h3>Current commercial truth</h3><p>Retailer, stock, price and delivery data are dated instead of presented as permanent facts.</p></article>
        <article><span>04</span><h3>Suitability before commission</h3><p>The right robot is chosen first. The purchase route is considered afterwards.</p></article>
      </div>
    </div>
  </section>

  <section class="close">
    <div class="wrap close__inner">
      <img src="/logo/botplanet-metal.svg" alt="BotPlanet" width="380" height="80" />
      <p>The robotics market is expanding fast. BotPlanet is building the map.</p>
      <a class="btn btn--primary btn--lg" href="#robot-worlds">Explore the planet</a>
    </div>
  </section>
</Base>

<style>
  /* The artwork now carries the height the hero used to get from a full
     viewport of empty space, so the padding comes down and the call to action
     stays above the fold instead of two scrolls beneath a headline. */
  .hero { display: grid; align-items: center; padding: clamp(14px, 2vw, 30px) 0 clamp(48px, 6vw, 84px); overflow: hidden; position: relative; }
  .hero::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 75% 44%, rgba(219,224,230,.11), transparent 24rem); pointer-events: none; }
  /* One column, artwork first to the eye and the H1 first in the source. The
     picture carries the brand and the whole range in one frame; putting it
     beside the copy at half width would shrink every robot into a thumbnail. */
  /* Stacked by default — on a phone the artwork leads and the copy follows.
     Two columns from 1100px, where a 16:9 frame beside the copy still reads at
     full composition AND leaves the buttons above the fold. A full-width
     picture on a laptop is a whole viewport of image and nothing to click. */
  .hero__grid { display: grid; grid-template-columns: 1fr; gap: clamp(26px, 4vw, 44px); justify-items: center; text-align: center; }
  .hero__copy { max-width: 62rem; }
  @media (min-width: 1100px) {
    .hero__grid { grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr); gap: clamp(32px, 4vw, 56px); align-items: center; justify-items: stretch; text-align: left; }
    .hero__art { order: 0; }
    /* Three lines, not five: the column is narrower than a full-width hero
       and a headline that stacks into a ladder stops reading as a sentence. */
    .hero__copy h1 { font-size: clamp(32px, 2.7vw, 43px); }
    .hero__lede { margin-left: 0; margin-right: 0; font-size: 17px; }
    .hero__actions { justify-content: flex-start; }
  }
  .hero__art {
    order: -1;
    width: 100%;
    margin: 0;
    border: 1px solid rgba(206, 214, 228, 0.22);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 30px 70px rgba(0,0,0,.55);
  }
