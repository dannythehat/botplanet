---
import Base from "../layouts/Base.astro";
import { getDb, schema } from "../lib/db";
import { eq } from "drizzle-orm";

const db = getDb(Astro.locals);
const products = await db
  .select({ slug: schema.products.slug, name: schema.products.name })
  .from(schema.products)
  .where(eq(schema.products.status, "published"))
  .limit(6);
---

<!--
  Job 5 applies the global design system to the EXISTING homepage content only —
  same three blocks, same copy, no new sections and no new claims. The full
  homepage story belongs to Job 7.
-->
<Base title="BotPlanet — Find your perfect robot">
  <section class="hero">
    <span class="eyebrow">Real-world robots · United States</span>
    <h1>Shop the planet yourself,<br />or let BotPlanet find your perfect robot.</h1>
    <p>
      Browse and compare real-world robots normally — or answer a few questions and
      BotMatch recommends the right one for your needs, on suitability, never commission.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary btn--lg" href="/botmatch/robotic-pool-cleaners/">Start BotMatch</a>
      <a class="btn btn--lg" href="/robots/robotic-pool-cleaners/">Browse pool robots</a>
    </div>
  </section>

  <section class="section section--tight">
    <div class="section-head section-head--row">
      <div>
        <span class="eyebrow">Launch category</span>
        <h2 class="mt-0">Robotic pool cleaners</h2>
        <p>Our first fully-built category. {products.length} products indexed for the US market.</p>
      </div>
      <a class="btn" href="/robots/robotic-pool-cleaners/">View all</a>
    </div>

    {products.length === 0 ? (
      <div class="empty">
        <p class="empty__title">No products published yet</p>
        <p>The launch catalogue appears here as soon as products are published.</p>
      </div>
    ) : (
      <div class="grid grid--products">
        {products.map((p) => (
          <a class="card reveal" href={`/robots/robotic-pool-cleaners/${p.slug}/`}>
            <span class="pill pill--strong">Pool cleaner</span>
            <h3>{p.name}</h3>
            <span class="note">View details &amp; offers →</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section section--tight">
    <div class="section-head">
      <span class="eyebrow">How we work</span>
      <h2 class="mt-0">Why BotPlanet is different</h2>
    </div>
    <div class="feature-rows">
      <div class="feature-row reveal">
        <span class="feature-row__index" aria-hidden="true">01</span>
        <div class="feature-row__body">
          <h3>Suitability first</h3>
          <p>BotMatch chooses the best product for you before it ever looks at which retailer pays us.</p>
        </div>
      </div>
      <div class="feature-row reveal">
        <span class="feature-row__index" aria-hidden="true">02</span>
        <div class="feature-row__body">
          <h3>Honest freshness</h3>
          <p>Every price shows when it was last checked. No stale "deals".</p>
        </div>
      </div>
      <div class="feature-row reveal">
        <span class="feature-row__index" aria-hidden="true">03</span>
        <div class="feature-row__body">
          <h3>Real evidence</h3>
          <p>Claims are labelled by evidence level — researched vs hands-on tested.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
