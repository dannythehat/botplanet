---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";
---
<Base title="About BotPlanet" description="Who is behind BotPlanet, how the site earns its money, and why a comparison site that tells you when not to buy is worth more than one that never does.">
  <h1>About BotPlanet</h1>
  <p class="muted" style="font-size:18px; max-width:680px;">
    BotPlanet helps people find and buy the right real-world robot — pool cleaners today, more categories soon.
    You can browse and compare normally, or let BotMatch recommend one based on your needs.
  </p>

  <h2>Our promise</h2>
  <p>Recommendations are based on <strong>suitability, not commission</strong>. Our BotMatch engine chooses the best product for you before it ever looks at which retailer pays us. We disclose affiliate relationships, label manufacturer claims we haven't independently verified, and show when every price was last checked.</p>

  <h2>Who writes this</h2>
  <div class="card" style="max-width:640px;">
    <h3>{SITE.founder.name}</h3>
    <p class="muted">{SITE.founder.title}</p>
    <p>{SITE.founder.bio}</p>
  </div>

  <h2>How we make money</h2>
  <p>When you buy through a retailer link we may earn a commission — at no extra cost to you. That commission never changes which product BotMatch recommends. See our <a href="/affiliate-disclosure/">affiliate disclosure</a>.</p>

  <h2>Contact</h2>
  <p>Questions or corrections: <a href={`mailto:${SITE.business.contactEmail}`}>{SITE.business.contactEmail}</a>.</p>
</Base>
