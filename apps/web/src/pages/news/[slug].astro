---
/**
 * News article route pattern.
 *
 * The sitemap requires this URL shape to exist so links to future articles
 * never break, but no article content is invented to fill it. Until Job 19 onward
 * publishes content, every slug is genuinely unknown and returns a real 404
 * rather than a thin or fabricated page.
 */
const { slug } = Astro.params;
void slug;
return new Response("Not found", { status: 404 });
---
