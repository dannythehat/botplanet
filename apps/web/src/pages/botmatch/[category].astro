---
import Base from "../../layouts/Base.astro";
import { getDb, schema } from "../../lib/db";
import { eq } from "drizzle-orm";
import { breadcrumbsFor } from "../../lib/routing";

const { category } = Astro.params;
const db = getDb(Astro.locals);
const cat = (
  await db.select().from(schema.categories).where(eq(schema.categories.slug, category!)).limit(1)
)[0];
if (!cat) return new Response("Category not found", { status: 404 });
const crumbs = breadcrumbsFor(Astro.url.pathname);
---

<Base
  title={`Find My Pool Cleaner — BotMatch | BotPlanet`}
  description="Answer a few pool-specific questions and BotMatch recommends one robotic pool cleaner on suitability — never commission — with the reasoning shown."
  breadcrumbs={crumbs}
>
  <div style="max-width:560px; margin:0 auto;">
    <span class="eyebrow">BotMatch · deterministic · suitability-first</span>
    <h1 class="mt-0">Find your {cat.name.toLowerCase().replace(/s$/, "")}</h1>
    <p class="lede">
      Six questions about your pool. One recommendation, with the reasoning shown — chosen on suitability before
      BotMatch is ever allowed to see which retailer pays us.
    </p>

    <div class="card" style="margin-top:20px;">
      <form id="botmatch" data-category={cat.slug}>
        <div class="fld">
          <label>What kind of pool do you have?</label>
          <select name="environment">
            <option value="in_ground">In-ground</option>
            <option value="above_ground">Above-ground</option>
          </select>
        </div>
        <div class="fld">
          <label>What's your main problem?</label>
          <select name="primary_need">
            <option value="full_clean">Full clean (floor, walls, waterline)</option>
            <option value="floor_debris">Mostly floor debris</option>
            <option value="surface_debris">Floating surface debris</option>
          </select>
        </div>
        <div class="fld">
          <label>What should it clean?</label>
          <div class="checks">
            <label class="chk"><input type="checkbox" name="cleans" value="floor" checked /> Floor</label>
            <label class="chk"><input type="checkbox" name="cleans" value="walls" checked /> Walls</label>
            <label class="chk"><input type="checkbox" name="cleans" value="waterline" checked /> Waterline</label>
            <label class="chk"><input type="checkbox" name="cleans" value="water_surface" /> Water surface</label>
          </div>
        </div>
        <div class="fld">
          <label>Power preference?</label>
          <select name="power_pref">
            <option value="no_pref">No preference</option>
            <option value="cordless">Cordless</option>
            <option value="corded">Corded</option>
          </select>
        </div>
        <div class="fld">
          <label>Budget?</label>
          <select name="budget_tier">
            <option value="no_pref">No preference</option>
            <option value="budget">Budget</option>
            <option value="mid">Mid-range</option>
            <option value="premium">Premium</option>
            <option value="ultra">Ultra / top-tier</option>
          </select>
        </div>
        <div class="fld">
          <label>Longest side of the pool (feet)? <span class="muted" style="font-weight:400">optional</span></label>
          <input type="number" name="pool_length_ft" min="0" placeholder="e.g. 30" />
        </div>
        <button type="submit" class="btn primary" style="width:100%; padding:13px; font-size:16px;">Get my recommendation</button>
        <p id="bm-error" style="color:#ff9b9b; display:none; margin-top:10px;"></p>
      </form>
    </div>
    <p class="note" style="margin-top:14px;">Your answers are used only to compute your recommendation. Surface skimmers only appear when floating debris is your main need.</p>

    <div class="stack mt-lg">
      <div class="card card--pad-sm">
        <h2 class="mt-0" style="font-size:16px;">How the recommendation is made</h2>
        <p class="mt-sm" style="margin-bottom:0;">
          BotMatch scores every published robot against your answers using recorded product facts — coverage, power,
          rated pool length, price tier. Robots your pool rules out are excluded, not down-ranked. The scoring engine
          is structurally unable to see prices or commission while it chooses the product; commercial data only enters
          afterwards, to pick the best current offer for the robot already chosen. Same answers, same result, every
          time — and every recommendation stores its reasoning so we can prove commission never moved it.
          <a class="link" href="/how-botmatch-works/">Read the full explanation</a>.
        </p>
      </div>
      <div class="card card--pad-sm">
        <h2 class="mt-0" style="font-size:16px;">What you get — and your privacy</h2>
        <p class="mt-sm" style="margin-bottom:0;">
          A single recommendation page with the why, who it suits, its honest limitations, and current dated offers.
          Your answers compute the result and are never attached to outbound links or analytics. Prefer to browse
          instead? The <a class="link" href={`/robots/${cat.slug}/`}>category hub</a> and
          <a class="link" href={`/best-robots/${cat.slug}/`}>best-of guide</a> cover the same ground at your own pace.
        </p>
      </div>
    </div>
  </div>

  <style>
    .fld { margin-bottom: 20px; }
    .fld > label { display: block; font-weight: 600; margin-bottom: 8px; }
    select, input[type="number"] { width: 100%; }
    .checks { display: flex; gap: 10px; flex-wrap: wrap; }
    .chk {
      display: inline-flex; align-items: center; gap: 7px; padding: 8px 13px; border-radius: 999px;
      background: var(--panel-2); border: 1px solid var(--border-2); font-weight: 600; cursor: pointer;
    }
  </style>

  <script>
    const form = document.getElementById("botmatch") as HTMLFormElement;
    const errEl = document.getElementById("bm-error") as HTMLParagraphElement;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Thinking…";
      errEl.style.display = "none";
      const fd = new FormData(form);
      const lengthVal = fd.get("pool_length_ft") as string;
      const answers = {
        environment: fd.get("environment"),
        primary_need: fd.get("primary_need"),
        desired_cleans: fd.getAll("cleans"),
        power_pref: fd.get("power_pref"),
        budget_tier: fd.get("budget_tier"),
        pool_length_ft: lengthVal ? Number(lengthVal) : null,
      };
      try {
        const res = await fetch("/api/botmatch", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ category: form.dataset.category, answers }),
        });
        if (!res.ok) throw new Error(`Server error (${res.status})`);
        const data = (await res.json()) as { token?: string };
        if (!data.token) throw new Error("No recommendation returned");
        window.location.href = `/recommendation/${data.token}`;
      } catch (err) {
        errEl.textContent = err instanceof Error ? err.message : "Something went wrong";
        errEl.style.display = "block";
        btn.disabled = false;
        btn.textContent = "Get my recommendation";
      }
    });
  </script>
</Base>
