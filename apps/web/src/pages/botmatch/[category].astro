---
import Base from "../../layouts/Base.astro";
import { getDb, schema } from "../../lib/db";
import { eq } from "drizzle-orm";
import { breadcrumbsFor } from "../../lib/routing";
import PoolMatcher from "../../components/PoolMatcher.astro";

const { category } = Astro.params;
const db = getDb(Astro.locals);
const cat = (
  await db.select().from(schema.categories).where(eq(schema.categories.slug, category!)).limit(1)
)[0];
if (!cat) return new Response("Category not found", { status: 404 });
const crumbs = breadcrumbsFor(Astro.url.pathname);
---

<Base
  title={`BotMatch — ${cat.name}`}
  description="Answer a few questions and get a personalised, suitability-first recommendation."
  breadcrumbs={crumbs}
  noindex
>
  <PoolMatcher categorySlug={cat.slug} categoryName={cat.name} />
</Base>
