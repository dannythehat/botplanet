---
import Base from "../../layouts/Base.astro";
import { getDb, schema } from "../../lib/db";
import { and, eq } from "drizzle-orm";
import { breadcrumbsFor } from "../../lib/routing";
import BotMatcher from "../../components/BotMatcher.astro";
import { canMatch, emptyStateFor } from "../../content/matcher-router";
import { questionsFor, tasksFor } from "../../content/matcher-questions";

const { category } = Astro.params;
const db = getDb(Astro.locals);
const cat = (
  await db.select().from(schema.categories).where(eq(schema.categories.slug, category!)).limit(1)
)[0];
if (!cat) return new Response("Category not found", { status: 404 });

/* No question set, no funnel. A category without its own questions must NOT
   fall back to another category's — that is how the window matcher spent
   5 August asking people about their swimming pool. 404 is the honest answer:
   this questionnaire does not exist yet. */
const questions = questionsFor(cat.slug);
const tasks = tasksFor(cat.slug);
if (!questions || !tasks) {
  return new Response("No questionnaire for this category yet", { status: 404 });
}

/* The published count decides whether this funnel may pick anything at all.
   Same rule as the universal entry, read from the same place — a category
   cannot be matchable on one route and not on the other. */
const published = await db
  .select({ id: schema.products.id })
  .from(schema.products)
  .where(and(eq(schema.products.categoryId, cat.id), eq(schema.products.status, "published")));

const crumbs = breadcrumbsFor(Astro.url.pathname);
---

<Base
  title={`BotMatch — ${cat.name}`}
  description="Answer a few questions and get a personalised, suitability-first recommendation."
  breadcrumbs={crumbs}
  noindex
>
  <BotMatcher
    mode="single"
    categories={[
      {
        slug: cat.slug,
        name: cat.name,
        questions,
        tasks,
        matchable: canMatch(published.length),
        emptyState: emptyStateFor(cat.name, published.length),
        hubHref: `/robots/${cat.slug}/`,
      },
    ]}
  />
</Base>
