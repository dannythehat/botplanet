---
import Base from "../../layouts/Base.astro";
import RoutePlaceholder from "../../components/RoutePlaceholder.astro";
import { routeFor } from "../../content/routes";
import { breadcrumbsFor } from "../../lib/routing";

const route = routeFor("/deals/")!;
const crumbs = breadcrumbsFor("/deals/");
---
<Base
  title={`${route.label} — BotPlanet`}
  description={route.summary ?? route.label}
  noindex={!route.indexable}
  breadcrumbs={crumbs}
  narrow={true}
>
  <RoutePlaceholder title="Deals" summary="Verified price drops on robots we cover. Nothing appears here until a price is confirmed at the retailer and stamped with the date it was checked." owner="Job 10 owns offer and price truth" />
</Base>
