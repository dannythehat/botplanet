---
import Base from "../../layouts/Base.astro";
import RoutePlaceholder from "../../components/RoutePlaceholder.astro";
import { routeFor } from "../../content/routes";
import { breadcrumbsFor } from "../../lib/routing";

const route = routeFor("/deals/robotic-pool-cleaners/")!;
const crumbs = breadcrumbsFor("/deals/robotic-pool-cleaners/");
---
<Base
  title={`${route.label} — BotPlanet`}
  description={route.summary ?? route.label}
  noindex={!route.indexable}
  breadcrumbs={crumbs}
  narrow={true}
>
  <RoutePlaceholder title="Robotic pool cleaner deals" summary="Confirmed price drops on robotic pool cleaners, each stamped with the date the price was checked." owner="Job 10 owns offer and price truth" />
</Base>
