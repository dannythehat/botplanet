---
import Base from "../layouts/Base.astro";
import BotMatchExplainer from "../components/diagrams/BotMatchExplainer.astro";
import { breadcrumbsFor } from "../lib/routing";
import { webPageSchema } from "../lib/seo";

const PATH = "/how-botmatch-works/";
const TITLE = "How BotMatch Works: Choosing the Right Robot | BotPlanet";
const DESCRIPTION =
  "See exactly how BotMatch turns your needs into a robot recommendation, excludes poor fits and keeps retailer commission out of product selection.";
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path={PATH}
  ogImage="/media/botmatch/finder-universal.webp"
  breadcrumbs={breadcrumbsFor(PATH)}
  schema={[webPageSchema({ path: PATH, name: TITLE, description: DESCRIPTION })]}
>
  <header class="bm-how-hero">
    <div class="bm-how-hero__copy">
      <p class="bm-kicker">A RECOMMENDATION YOU CAN AUDIT</p>
      <h1>How BotMatch chooses your robot</h1>
      <p>
        BotMatch is deterministic: the same answers produce the same result. It rules out machines
        that cannot do the job, scores the remaining products on suitability and only looks at
        retailer offers after the product has been chosen.
      </p>
      <a class="btn btn--accent btn--lg" href="/botmatch/">Find your robot</a>
    </div>
    <figure class="bm-how-hero__media">
      <img
        src="/media/botmatch/finder-universal.webp"
        srcset="/media/botmatch/finder-universal-360w.webp 360w, /media/botmatch/finder-universal-640w.webp 640w, /media/botmatch/finder-universal-960w.webp 960w, /media/botmatch/finder-universal.webp 1200w"
        sizes="(min-width: 1000px) 48vw, 100vw"
        width="1200"
        height="900"
        alt="A group of useful household robots representing the different jobs BotMatch can help choose."
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </header>

  <section class="bm-proof" aria-label="BotMatch principles">
    <div><strong>Same answers, same result</strong><span>No hidden editorial override.</span></div>
    <div><strong>Poor fits are excluded</strong><span>A robot that cannot do the job cannot win.</span></div>
    <div><strong>Commission stays downstream</strong><span>Money cannot change the chosen product.</span></div>
  </section>

  <section class="bm-diagram" aria-labelledby="bm-diagram-title">
    <header>
      <p class="bm-kicker">THE ORDER OF OPERATIONS</p>
      <h2 id="bm-diagram-title">Suitability first. Offers second.</h2>
      <p>The separation is enforced in the scoring system, not left as a promise in the copy.</p>
    </header>
    <BotMatchExplainer />
  </section>

  <section class="bm-steps" aria-labelledby="bm-steps-title">
    <header>
      <p class="bm-kicker">FOUR STEPS</p>
      <h2 id="bm-steps-title">From the job to one clear recommendation</h2>
    </header>
    <ol>
      <li><span>01</span><div><h3>Choose what you need done</h3><p>Pool, floors, lawn, windows, pets, learning or another supported job. Each category has its own questions.</p></div></li>
      <li><span>02</span><div><h3>Answer the deciding questions</h3><p>Surface, environment, capacity, power, safety and budget—the factors that genuinely change which machine fits.</p></div></li>
      <li><span>03</span><div><h3>Rule out the machines that cannot fit</h3><p>Wrong environment, insufficient capacity or an incompatible design means exclusion, not a quietly lower rank.</p></div></li>
      <li><span>04</span><div><h3>See the result and the reason</h3><p>The answer shows why the product fits, what to watch for and a direct link to its full page.</p></div></li>
    </ol>
  </section>

  <section class="bm-record" aria-labelledby="bm-record-title">
    <div>
      <p class="bm-kicker">RECORDED, NOT IMPROVISED</p>
      <h2 id="bm-record-title">Every result carries its workings</h2>
      <p>
        The recommendation records the answers, engine version and candidate scores. That makes a
        result explainable today and reproducible later if the catalogue changes.
      </p>
    </div>
    <a class="btn btn--accent btn--lg" href="/botmatch/">Start BotMatch</a>
  </section>
</Base>

<style>
  .bm-kicker { margin: 0 0 .8rem; color: var(--text-tertiary); font: 700 .7rem/1 var(--font-mono); letter-spacing: .18em; }
  .bm-how-hero { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:clamp(2rem,5vw,5rem); align-items:center; max-width:1360px; margin:0 auto; padding:clamp(3rem,7vw,6rem) 0; }
  .bm-how-hero__copy h1 { max-width:12ch; margin:0; font-size:clamp(3rem,5.5vw,5.5rem); line-height:.98; letter-spacing:-.055em; }
  .bm-how-hero__copy > p:not(.bm-kicker) { max-width:39rem; margin:1.4rem 0 1.7rem; color:var(--text-secondary); font-size:clamp(1.05rem,1.6vw,1.25rem); line-height:1.62; }
  .bm-how-hero__media { overflow:hidden; margin:0; aspect-ratio:4/3; border:1px solid var(--border-default); border-radius:1.5rem; background:var(--surface-raised); box-shadow:var(--shadow-lg); }
  .bm-how-hero__media img { display:block; width:100%; height:100%; object-fit:cover; }
  .bm-proof { display:grid; grid-template-columns:repeat(3,1fr); max-width:1120px; margin:0 auto clamp(4rem,8vw,7rem); overflow:hidden; border:1px solid var(--border-subtle); border-radius:1.2rem; background:var(--surface-raised); }
  .bm-proof div { padding:1.5rem; }
  .bm-proof div + div { border-left:1px solid var(--border-subtle); }
  .bm-proof strong,.bm-proof span { display:block; }
  .bm-proof span { margin-top:.35rem; color:var(--text-secondary); font-size:.9rem; }
  .bm-diagram,.bm-steps { max-width:1120px; margin:0 auto clamp(4rem,8vw,7rem); }
  .bm-diagram > header,.bm-steps > header { max-width:46rem; margin:0 auto 2rem; text-align:center; }
  .bm-diagram h2,.bm-steps h2,.bm-record h2 { margin:0; font-size:clamp(2rem,4vw,3.6rem); letter-spacing:-.04em; }
  .bm-diagram header p:last-child { color:var(--text-secondary); }
  .bm-steps ol { display:grid; grid-template-columns:repeat(2,1fr); gap:1rem; margin:0; padding:0; list-style:none; }
  .bm-steps li { display:grid; grid-template-columns:auto 1fr; gap:1rem; padding:1.5rem; border:1px solid var(--border-subtle); border-radius:1rem; background:var(--surface-raised); }
  .bm-steps li > span { color:var(--accent); font-family:var(--font-mono); font-size:.72rem; }
  .bm-steps h3 { margin:0; font-size:1.2rem; }
  .bm-steps li p { margin:.55rem 0 0; color:var(--text-secondary); }
  .bm-record { display:flex; align-items:center; justify-content:space-between; gap:2rem; max-width:1120px; margin:0 auto; padding:clamp(1.6rem,4vw,3rem); border:1px solid rgba(119,222,255,.28); border-radius:1.2rem; background:linear-gradient(120deg,rgba(69,171,210,.12),var(--surface-raised) 55%); }
  .bm-record p:last-child { max-width:45rem; margin:.75rem 0 0; color:var(--text-secondary); }
  .bm-record .btn { flex:0 0 auto; }
  @media(max-width:900px){.bm-how-hero{grid-template-columns:1fr}.bm-proof{grid-template-columns:1fr}.bm-proof div+div{border-top:1px solid var(--border-subtle);border-left:0}}
  @media(max-width:650px){.bm-how-hero{padding-top:2rem}.bm-steps ol{grid-template-columns:1fr}.bm-record{align-items:stretch;flex-direction:column;text-align:center}.bm-record .btn,.bm-how-hero .btn{width:100%;justify-content:center}}
</style>
