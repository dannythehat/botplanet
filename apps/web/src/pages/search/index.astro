---
/**
 * Search results route. The header overlay is the fast path; this page exists
 * so search is reachable without JavaScript and so a shared or bookmarked
 * search URL resolves. It is noindex: query variants must never create
 * indexable near-duplicate pages.
 */
import Base from "../../layouts/Base.astro";
import { getDb, schema } from "../../lib/db";
import { eq } from "drizzle-orm";
import { LAUNCH_CATEGORY, categoryRoutes } from "../../content/routes";

const q = (Astro.url.searchParams.get("q") ?? "").trim();
const db = getDb(Astro.locals);
const cat = categoryRoutes(LAUNCH_CATEGORY);

const all = await db
  .select({ slug: schema.products.slug, name: schema.products.name })
  .from(schema.products)
  .where(eq(schema.products.status, "published"));
const products = q ? all.filter((p) => p.name.toLowerCase().includes(q.toLowerCase())) : [];
---
<Base
  title={q ? `Search: ${q} — BotPlanet` : "Search — BotPlanet"}
  description="Search BotPlanet."
  noindex={true}
  narrow={true}
>
  <h1>Search</h1>
  <form class="search-form" method="get" action="/search/" role="search">
    <label class="sr-only" for="q">Search BotPlanet</label>
    <input type="search" id="q" name="q" value={q} placeholder="Search robots, guides, comparisons…" />
    <button class="btn btn--primary" type="submit">Search</button>
  </form>

  {q === "" ? (
    <div class="empty mt-lg">
      <p class="empty__title">Type what you're looking for</p>
      <p>Try a product name, or start from <a class="link" href={cat.hub}>robotic pool cleaners</a>.</p>
    </div>
  ) : products.length === 0 ? (
    <div class="empty mt-lg">
      <p class="empty__title">No matches for “{q}”</p>
      <p>
        Only the robotic pool cleaner catalogue is searchable today. Browse
        <a class="link" href={cat.hub}> all pool cleaners</a>, or
        <a class="link" href={cat.botmatch}> answer a few questions</a> instead.
      </p>
    </div>
  ) : (
    <ul class="results mt-lg">
      {products.map((p) => (
        <li><a class="link" href={`/robots/${LAUNCH_CATEGORY}/${p.slug}/`}>{p.name}</a></li>
      ))}
    </ul>
  )}
</Base>
<style>
  .search-form { display: flex; gap: var(--space-sm); margin-top: var(--space-md); flex-wrap: wrap; }
  .search-form input { flex: 1 1 260px; }
  .results { list-style: none; padding: 0; display: grid; gap: var(--space-sm); }
  .results li { margin: 0; }
</style>
