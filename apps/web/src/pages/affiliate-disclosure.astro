---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";
import { breadcrumbsFor } from "../lib/routing";
import { webPageSchema } from "../lib/seo";
const PATH="/affiliate-disclosure/";
const TITLE="Affiliate Disclosure | How BotPlanet Earns Money";
const DESCRIPTION="How BotPlanet earns affiliate commission, how retailer links are marked and why commercial relationships cannot change a recommendation.";
---
<Base title={TITLE} description={DESCRIPTION} path={PATH} ogImage="/media/botmatch/explainer-desktop.webp" breadcrumbs={breadcrumbsFor(PATH)} schema={[webPageSchema({path:PATH,name:TITLE,description:DESCRIPTION})]}>
  <header class="affiliate-hero"><div><p class="kicker">FULL COMMERCIAL DISCLOSURE</p><h1>We may earn commission.<br /><span>The verdict stays independent.</span></h1><p>Some retailer links are affiliate links. If you buy after following one, BotPlanet may be paid by the retailer or affiliate network—at no extra cost to you.</p></div><figure><img src="/media/botmatch/explainer-desktop.webp" srcset="/media/botmatch/explainer-desktop-360w.webp 360w, /media/botmatch/explainer-desktop-640w.webp 640w, /media/botmatch/explainer-desktop-960w.webp 960w, /media/botmatch/explainer-desktop-1440w.webp 1440w" sizes="(min-width:900px) 48vw,100vw" width="1440" height="960" alt="BotMatch separates suitability scoring from retailer offers and commission." loading="eager" fetchpriority="high" decoding="async" /></figure></header>
  <section class="order" aria-labelledby="order-title"><header><p class="kicker">THE ORDER IS THE SAFEGUARD</p><h2 id="order-title">The product is chosen before the offer.</h2></header><ol><li><span>01</span><strong>Your needs</strong><p>BotMatch records the job, environment, limits and budget.</p></li><li><span>02</span><strong>Product suitability</strong><p>Poor fits are excluded and the remaining machines are scored.</p></li><li><span>03</span><strong>Product chosen</strong><p>The result is fixed before retailer data is allowed into the process.</p></li><li><span>04</span><strong>Offers ranked</strong><p>Only then are current price, delivery, warranty and retailer considered.</p></li></ol></section>
  <section class="rules" aria-labelledby="rules-title"><div><p class="kicker">WHAT THIS MEANS IN PRACTICE</p><h2 id="rules-title">Four rules that do not bend</h2></div><ul><li><strong>Commission never changes the recommended product.</strong><span>A product without an affiliate relationship can still win.</span></li><li><strong>Paid placement cannot buy a ranking.</strong><span>Sponsored work, if accepted, is labelled and kept outside editorial results.</span></li><li><strong>Affiliate links are marked.</strong><span>Readers are told before an outbound retailer action may generate revenue.</span></li><li><strong>Prices are snapshots.</strong><span>The retailer's current price, stock, delivery and terms must be checked before purchase.</span></li></ul></section>
  <aside class="tracking"><div><strong>What passes through an affiliate link?</strong><p>A tracking redirect may include a click identifier so a purchase can be attributed. BotMatch questionnaire answers and personal details are not added to that retailer URL.</p></div><a href="/privacy/">Read the privacy policy <span aria-hidden="true">→</span></a></aside>
  <section class="questions"><p>Questions about a relationship, link or disclosure?</p><a class="btn btn--accent" href={`mailto:${SITE.business.contactEmail}`}>{SITE.business.contactEmail}</a></section>
</Base>
<style>
  .kicker{margin:0 0 .8rem;color:var(--text-tertiary);font:700 .7rem/1 var(--font-mono);letter-spacing:.18em}.affiliate-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(2rem,5vw,5rem);align-items:center;max-width:1360px;margin:0 auto;padding:clamp(3rem,7vw,6rem) 0}.affiliate-hero h1{margin:0;font-size:clamp(3rem,5.2vw,5.5rem);line-height:.96;letter-spacing:-.055em}.affiliate-hero h1 span{color:var(--text-tertiary)}.affiliate-hero div>p:last-child{max-width:39rem;color:var(--text-secondary);font-size:clamp(1.05rem,1.5vw,1.22rem);line-height:1.65}.affiliate-hero figure{overflow:hidden;margin:0;aspect-ratio:3/2;border:1px solid var(--border-default);border-radius:1.4rem;background:var(--surface-raised)}.affiliate-hero img{width:100%;height:100%;object-fit:cover}.order,.rules,.tracking,.questions{max-width:1120px;margin:0 auto clamp(5rem,8vw,7rem)}.order>header{max-width:48rem;margin:0 auto 2rem;text-align:center}.order h2,.rules h2{margin:0;font-size:clamp(2.2rem,4.3vw,4rem);letter-spacing:-.05em}.order ol{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin:0;padding:0;list-style:none}.order li{padding:1.4rem;border:1px solid var(--border-subtle);border-radius:1rem;background:var(--surface-raised)}.order li>span{display:block;color:var(--accent);font-family:var(--font-mono);font-size:.72rem}.order strong{display:block;margin:1.8rem 0 .5rem}.order p,.rules span,.tracking p{color:var(--text-secondary);line-height:1.55}.rules{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,5vw,5rem)}.rules ul{overflow:hidden;margin:0;padding:0;border:1px solid var(--border-subtle);border-radius:1.2rem;background:var(--surface-raised);list-style:none}.rules li{padding:1.25rem 1.4rem}.rules li+li{border-top:1px solid var(--border-subtle)}.rules strong,.rules span{display:block}.rules span{margin-top:.35rem;font-size:.92rem}.tracking{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:clamp(1.5rem,4vw,2.5rem);border:1px solid rgba(119,222,255,.3);border-radius:1.2rem;background:linear-gradient(120deg,rgba(69,171,210,.13),var(--surface-raised) 60%)}.tracking>div{max-width:48rem}.questions{display:flex;align-items:center;justify-content:center;gap:1.5rem;text-align:center}
  @media(max-width:900px){.affiliate-hero,.rules{grid-template-columns:1fr}.order ol{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.affiliate-hero{padding-top:2rem}.order ol{grid-template-columns:1fr}.tracking,.questions{align-items:stretch;flex-direction:column}.questions .btn{justify-content:center}}
</style>
