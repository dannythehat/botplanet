---
import Admin from "../../layouts/Admin.astro";
import { getDb, schema } from "../../lib/db";
import { sql, eq, and } from "drizzle-orm";
import { AMAZON_ASSOCIATE_TAG, AMAZON_ASSOCIATE_TAG_STATUS } from "../../lib/site";
import { AIPER_PROGRAMME_TERMS, AIPER_FEED, CJ_PUBLISHER_ID, CJ_AIPER_ADVERTISER_ID } from "../../content/media/cj";

const db = getDb(Astro.locals);

/**
 * Amazon status is DERIVED from the authoritative configuration the offer
 * system uses (lib/site.ts), never restated here. While the tag is null,
 * Associates ownership and approval are unverified, outbound Amazon links are
 * untagged, and this dashboard must not present Amazon as a live earning
 * programme — a working retail link is not an Associates relationship.
 */
const amazonTagged = Boolean(AMAZON_ASSOCIATE_TAG);
const amazonHeadline = amazonTagged ? "TAGGED" : "UNTAGGED";
const amazonTone = amazonTagged ? "var(--ok)" : "var(--warn)";
const amazonCardNote = amazonTagged
  ? `tag ${AMAZON_ASSOCIATE_TAG} on outbound links`
  : "retailer links only · earning no commission";

const accounts = await db.select().from(schema.affiliateAccounts);
const programmes = await db.select().from(schema.affiliatePrograms);

const count = async (table: any, where?: any): Promise<number> => {
  const q = db.select({ n: sql<number>`count(*)` }).from(table);
  const rows = where ? await q.where(where) : await q;
  return Number(rows[0]?.n ?? 0);
};
const productsN = await count(schema.products, eq(schema.products.status, "published"));
const activeOffersN = await count(schema.offers, eq(schema.offers.offerStatus, "active"));
const liveLinksN = await count(schema.redirectLinks, eq(schema.redirectLinks.active, true));
const clicksN = await count(schema.clickEvents);

const statusTag = (s: string) =>
  s === "approved" ? "ok" : s === "pending" ? "warn" : s === "closed" || s === "rejected" ? "bad" : "";

// Action queue: accounts that have a next action, blocked first.
const queue = [...accounts]
  .filter((a) => a.nextAction)
  .sort((a, b) => (a.currentBlocker ? 0 : 1) - (b.currentBlocker ? 0 : 1));
---
<Admin title="Supplier & Affiliate Operations" section="dash">
  <p class="sub">Phase 1 admin — programme state, blockers, offers and <span class="mono">/go</span> control. Commercial data is private; do not share this page.</p>

  <div class="grid">
    <div class="card"><div class="muted">Amazon outbound links</div><div style={`font-size:20px;font-weight:800;color:${amazonTone}`}>{amazonHeadline}</div><div class="muted">{amazonCardNote}</div></div>
    <div class="card"><div class="muted">Published products</div><div style="font-size:20px;font-weight:800">{productsN}</div><div class="muted">{activeOffersN} active offers · {liveLinksN} live links</div></div>
    <div class="card"><div class="muted">Attribution</div><div style="font-size:20px;font-weight:800">{clicksN}</div><div class="muted">click events logged</div></div>
    <div class="card"><div class="muted">Affiliate programmes</div><div style="font-size:20px;font-weight:800">{programmes.length}</div><div class="muted">{accounts.length} accounts tracked</div></div>
  </div>

  <h2>Action queue</h2>
  <div class="card" style="padding:0;">
    <table>
      <thead><tr><th>Network</th><th>Status</th><th>Blocker</th><th>Next action</th><th>Owner</th></tr></thead>
      <tbody>
        {queue.map((a) => (
          <tr>
            <td><strong>{a.network}</strong>{a.externalAccountRef && <div class="muted mono">{a.externalAccountRef}</div>}</td>
            <td><span class={`tag ${statusTag(a.status)}`}>{a.status}</span><div class="muted" style="margin-top:4px">{a.applicationStage}</div></td>
            <td class="muted">{a.currentBlocker ?? "—"}</td>
            <td>{a.nextAction}</td>
            <td class="muted">{a.nextAction?.toLowerCase().startsWith("danny") ? "Danny" : "Claude"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Quick reference</h2>
  <div class="card">
    <ul style="margin:0; padding-left:18px; line-height:1.9;">
      <li><strong>Amazon</strong> — retailer destinations work, but Associates <span style="color:var(--warn)">{AMAZON_ASSOCIATE_TAG_STATUS.split(" — ")[0]}</span>. Outbound links are {amazonTagged ? "tagged" : "untagged"} and BotPlanet currently earns no Amazon commission. The historical tag is unverified history, not configuration. No affiliate links in email.</li>
      <li><strong>CJ / Aiper</strong> (<span class="mono">{CJ_PUBLISHER_ID}</span> → adv <span class="mono">{CJ_AIPER_ADVERTISER_ID}</span>) — <span style="color:var(--ok)">{AIPER_PROGRAMME_TERMS.relationship}</span>: {AIPER_PROGRAMME_TERMS.baseCommissionPercent}% base, up to {AIPER_PROGRAMME_TERMS.promotionalCommissionMaxPercent}% promotional, {AIPER_PROGRAMME_TERMS.cookieDays}-day cookie. Feed has {AIPER_FEED.productCount} products; direct-link scope <span style="color:var(--warn)">{AIPER_PROGRAMME_TERMS.directLinkPolicy.status === "restricted_unclarified" ? "unresolved — product-level deep links blocked" : AIPER_PROGRAMME_TERMS.directLinkPolicy.status}</span>.</li>
      <li><strong>Awin</strong> (<span class="mono">3012175</span>) — joined WYBOT programme is <em>EU/UK only</em>, never for US traffic; WYBOTICS INC US (adv <span class="mono">76816</span>) <span style="color:var(--warn)">applied, awaiting advertiser decision</span>.</li>
      <li><strong>Impact</strong> — <span style="color:var(--bad)">declined</span> (£30/mo fee).</li>
    </ul>
  </div>
</Admin>
