---
import Base from "../../layouts/Base.astro";
import RoutePlaceholder from "../../components/RoutePlaceholder.astro";
import { routeFor } from "../../content/routes";
import { breadcrumbsFor } from "../../lib/routing";

const route = routeFor("/best-robots/robotic-pool-cleaners/")!;
const crumbs = breadcrumbsFor("/best-robots/robotic-pool-cleaners/");
---
<Base
  title={`${route.label} — BotPlanet`}
  description={route.summary ?? route.label}
  noindex={!route.indexable}
  breadcrumbs={crumbs}
  narrow={true}
>
  <RoutePlaceholder title="Best robotic pool cleaners" summary="Our top picks for robotic pool cleaners, with the reasoning, the evidence level and who each one is wrong for." owner="Job 18 owns best-of content" />
</Base>
