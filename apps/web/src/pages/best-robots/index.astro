---
import Base from "../../layouts/Base.astro";
import { builtBestOfCategories, categoryRoutes, liveCategories } from "../../content/routes";
import { CATEGORY_DIRECTORY_ART } from "../../content/category-directory-art";
import { breadcrumbsFor } from "../../lib/routing";
import { itemListSchema, webPageSchema } from "../../lib/seo";
import { srcsetFor } from "../../lib/srcset";

const PATH = "/best-robots/";
const TITLE = "Best Robots for Every Job | BotPlanet";
const DESCRIPTION =
  "Find the best robots for your home, garden, pool, pets and family. Start with the job, then see our ranked picks, evidence and honest limitations.";

const ranked = builtBestOfCategories();
const rankedArt: Record<string, { src: string; alt: string; focal?: string }> = {
  "robotic-pool-cleaners": {
    src: "/media/editorial/best-robotic-pool-cleaners.webp",
    alt: "A tracked robotic pool cleaner working across the floor of a large illuminated pool at dusk.",
    focal: "50% 60%",
  },
  "robotic-lawn-mowers": {
    src: "/media/editorial/best-lawn-mowers.webp",
    alt: "A silver robot mower working across a steep grass bank above a lakeside town at night.",
    focal: "55% 60%",
  },
};

const categories = liveCategories()
  .slice()
  .sort((a, b) => {
    const aRanked = ranked.has(a.slug) ? 0 : 1;
    const bRanked = ranked.has(b.slug) ? 0 : 1;
    return aRanked - bRanked || a.order - b.order;
  })
  .map((category) => {
    const hasRankedGuide = ranked.has(category.slug);
    return {
      ...category,
      hasRankedGuide,
      href: hasRankedGuide ? categoryRoutes(category.slug).best : categoryRoutes(category.slug).hub,
      art: rankedArt[category.slug] ?? CATEGORY_DIRECTORY_ART[category.slug] ?? null,
      badge: hasRankedGuide ? "Ranked guide" : "Best picks inside",
      action: hasRankedGuide ? "View ranked picks" : "See the best options",
    };
  });

const crumbs = breadcrumbsFor(PATH);
const schema = [
  webPageSchema({
    path: PATH,
    name: TITLE,
    description: DESCRIPTION,
    type: "CollectionPage",
  }),
  itemListSchema(
    categories.map((category) => ({ name: category.name, path: category.href })),
    "Best robots and category picks on BotPlanet",
  ),
];
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path={PATH}
  ogImage="/media/home/hero-desktop.webp"
  breadcrumbs={crumbs}
  schema={schema}
>
  <header class="best-hero">
    <div class="best-hero__copy">
      <p class="kicker">BOTPLANET EDITOR'S PICKS</p>
      <h1>The best robots for every job</h1>
      <p class="best-hero__lede">
        There is no single best robot. The right machine depends on the job, the space and the
        limits you cannot compromise on. Start with what you want done, then see the strongest
        options we have researched and exactly who should avoid them.
      </p>
      <div class="best-hero__actions">
        <a class="btn btn--accent btn--lg" href="#best-by-job">Choose a job</a>
        <a class="btn btn--outline btn--lg" href="/botmatch/">Let BotMatch help</a>
      </div>
    </div>

    <div class="best-hero__method" aria-label="How to use this page">
      <article>
        <span>01</span>
        <div>
          <strong>Start with the job</strong>
          <p>Pool, floors, lawn, windows, pets, company or learning.</p>
        </div>
      </article>
      <article>
        <span>02</span>
        <div>
          <strong>Rule out the wrong fit</strong>
          <p>Size, surfaces, safety, power and support matter before features.</p>
        </div>
      </article>
      <article>
        <span>03</span>
        <div>
          <strong>See why a pick wins</strong>
          <p>Every recommendation names its evidence and its honest limitations.</p>
        </div>
      </article>
    </div>
  </header>

  <section class="best-trust" aria-label="How BotPlanet chooses">
    <div>
      <span>INDEPENDENT</span>
      <strong>Price and commission stay out of the decision.</strong>
    </div>
    <div>
      <span>USE-CASE FIRST</span>
      <strong>A winner for one home can be wrong for another.</strong>
    </div>
    <div>
      <span>HONEST LIMITS</span>
      <strong>Every pick says who should not buy it.</strong>
    </div>
  </section>

  <section class="best-section" id="best-by-job" aria-labelledby="best-by-job-title">
    <header class="best-section__head">
      <div>
        <p class="kicker">BEST BY JOB</p>
        <h2 id="best-by-job-title">What do you want the robot to do?</h2>
      </div>
      <p>
        Choose the job first. Where a full ranked guide exists, it opens here. Everywhere else,
        the category comparison carries the best options so you still reach a useful answer.
      </p>
    </header>

    <ul class="best-grid">
      {categories.map((category) => (
        <li>
          <a class="best-card" href={category.href}>
            {category.art && (
              <span class="best-card__media">
                <img
                  src={category.art.src}
                  srcset={srcsetFor(category.art.src)}
                  sizes="(min-width: 1080px) 33vw, (min-width: 680px) 50vw, 100vw"
                  alt={category.art.alt}
                  loading="lazy"
                  decoding="async"
                  style={category.art.focal ? `object-position: ${category.art.focal}` : undefined}
                />
                <span class:list={["best-card__badge", { "best-card__badge--ranked": category.hasRankedGuide }]}>
                  {category.badge}
                </span>
              </span>
            )}
            <span class="best-card__copy">
              <span class="best-card__job">{category.jtbd}</span>
              <h3>{category.name}</h3>
              <p>{category.short}</p>
              <span class="best-card__action">{category.action}<span aria-hidden="true"> →</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="finder-panel" aria-labelledby="best-finder-title">
    <div>
      <p class="kicker">NOT SURE WHERE TO START?</p>
      <h2 id="best-finder-title">Tell BotMatch what you need done.</h2>
      <p>
        Answer a few practical questions and see the researched robots that fit. Email is optional,
        and every result links directly to the product review.
      </p>
    </div>
    <a class="btn btn--accent btn--lg" href="/botmatch/">Find your robot</a>
  </section>
</Base>

<style>
  .kicker {
    margin: 0 0 14px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .18em;
  }

  .best-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(330px, .84fr);
    gap: clamp(34px, 6vw, 86px);
    align-items: center;
    padding: clamp(48px, 8vw, 104px) 0 clamp(44px, 7vw, 88px);
  }

  .best-hero h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(48px, 7vw, 86px);
    line-height: .98;
    letter-spacing: -.055em;
  }

  .best-hero__lede {
    max-width: 67ch;
    margin: 24px 0 0;
    color: var(--text-secondary);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.62;
  }

  .best-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .best-hero__method {
    overflow: hidden;
    border: 1px solid rgba(200, 208, 222, .22);
    border-radius: 24px;
    background:
      radial-gradient(circle at 100% 0%, rgba(84, 217, 255, .10), transparent 38%),
      linear-gradient(160deg, #131820 0%, #080b0f 76%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06), 0 30px 70px rgba(0, 0, 0, .42);
  }

  .best-hero__method article {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    padding: 24px;
  }

  .best-hero__method article + article { border-top: 1px solid rgba(200, 208, 222, .14); }

  .best-hero__method article > span {
    padding-top: 3px;
    color: #70ddff;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .12em;
  }

  .best-hero__method strong { display: block; color: var(--text-primary); font-size: 17px; }
  .best-hero__method p { margin: 6px 0 0; color: var(--text-secondary); font-size: 14px; line-height: 1.55; }

  .best-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
    margin-bottom: clamp(64px, 8vw, 106px);
    border: 1px solid rgba(200, 208, 222, .17);
    border-radius: 18px;
    background: #090c10;
  }

  .best-trust > div { padding: 20px 22px; }
  .best-trust > div + div { border-left: 1px solid rgba(200, 208, 222, .14); }
  .best-trust span {
    display: block;
    margin-bottom: 7px;
    color: #70ddff;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
  }
  .best-trust strong { color: var(--text-secondary); font-size: 14px; line-height: 1.45; }

  .best-section__head {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(340px, 1.1fr);
    gap: clamp(28px, 6vw, 80px);
    align-items: end;
    margin-bottom: 30px;
  }

  .best-section__head h2 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.05;
    letter-spacing: -.04em;
  }

  .best-section__head > p {
    max-width: 66ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: 17px;
    line-height: 1.65;
  }

  .best-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .best-grid > li { display: flex; margin: 0; }

  .best-card {
    display: flex;
    width: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(200, 208, 222, .20);
    border-radius: 20px;
    background:
      radial-gradient(ellipse at 10% -12%, rgba(226, 232, 244, .05), transparent 58%),
      linear-gradient(178deg, #11151b 0%, #080b0f 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05), 0 22px 48px rgba(0, 0, 0, .34);
    color: inherit;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .best-card:hover {
    transform: translateY(-4px);
    border-color: rgba(112, 221, 255, .55);
  }

  .best-card:focus-visible { outline: var(--focus-ring); outline-offset: 4px; }

  .best-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid rgba(200, 208, 222, .17);
    background: #070a0d;
  }

  .best-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .45s var(--ease-out), filter .45s var(--ease-out);
  }

  .best-card:hover .best-card__media img { transform: scale(1.025); filter: brightness(1.06); }

  .best-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 7px 10px;
    border: 1px solid rgba(224, 230, 240, .35);
    border-radius: 999px;
    background: rgba(5, 8, 12, .82);
    backdrop-filter: blur(12px);
    color: #e7ecf3;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .best-card__badge--ranked {
    border-color: rgba(112, 221, 255, .66);
    color: #8ce6ff;
  }

  .best-card__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px;
  }

  .best-card__job {
    margin-bottom: 10px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .best-card h3 { margin: 0; font-size: 21px; line-height: 1.25; letter-spacing: -.02em; }
  .best-card p { margin: 12px 0 22px; color: var(--text-secondary); font-size: 15px; line-height: 1.55; }

  .best-card__action {
    margin-top: auto;
    color: #81e3ff;
    font-weight: 700;
  }

  .finder-panel {
    display: flex;
    gap: 30px;
    align-items: center;
    justify-content: space-between;
    margin: clamp(64px, 8vw, 108px) 0 clamp(48px, 7vw, 84px);
    padding: clamp(28px, 5vw, 52px);
    border: 1px solid rgba(200, 208, 222, .22);
    border-radius: 24px;
    background:
      radial-gradient(circle at 0% 100%, rgba(84, 217, 255, .09), transparent 38%),
      linear-gradient(145deg, #12171e 0%, #080b0f 78%);
  }

  .finder-panel h2 { margin: 0; font-size: clamp(30px, 4vw, 48px); letter-spacing: -.04em; }
  .finder-panel p:not(.kicker) { max-width: 66ch; margin: 14px 0 0; color: var(--text-secondary); line-height: 1.65; }
  .finder-panel .btn { flex: 0 0 auto; }

  @media (max-width: 1000px) {
    .best-hero { grid-template-columns: 1fr; }
    .best-hero__method { display: grid; grid-template-columns: repeat(3, 1fr); }
    .best-hero__method article { grid-template-columns: 1fr; }
    .best-hero__method article + article { border-top: 0; border-left: 1px solid rgba(200, 208, 222, .14); }
    .best-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 700px) {
    .best-hero { padding-top: 40px; }
    .best-hero__actions { align-items: stretch; flex-direction: column; }
    .best-hero__actions .btn { width: 100%; }
    .best-hero__method { grid-template-columns: 1fr; }
    .best-hero__method article { grid-template-columns: 38px 1fr; }
    .best-hero__method article + article { border-top: 1px solid rgba(200, 208, 222, .14); border-left: 0; }
    .best-trust { grid-template-columns: 1fr; }
    .best-trust > div + div { border-top: 1px solid rgba(200, 208, 222, .14); border-left: 0; }
    .best-section__head { grid-template-columns: 1fr; }
    .best-grid { grid-template-columns: 1fr; }
    .finder-panel { align-items: stretch; flex-direction: column; }
    .finder-panel .btn { width: 100%; }
  }
</style>
