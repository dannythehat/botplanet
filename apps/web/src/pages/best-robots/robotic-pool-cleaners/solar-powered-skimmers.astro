---
/**
 * Best-of guide — solar-powered pool skimmers.
 *
 * Planned on the 6 August run at 6,600/mo for "solar powered pool skimmer" and
 * held back by the gate "a one-product page is thin whatever the volume". The
 * owner chose the four best-selling solar skimmers on Amazon US on 1 October
 * 2026 and supplied each listing's images, so the gate is met: four machines,
 * one of them with first-party documentation and three on listing evidence.
 *
 * A CHILD ROUTE of the pool best-of, because a skimmer is a different product
 * class from a cleaner and the parent is where that distinction is drawn.
 */

import Base from "../../../layouts/Base.astro";
import EditorialArticle from "../../../components/EditorialArticle.astro";
import { editorialFor } from "../../../content/editorial";
import { buildEditorialPage } from "../../../lib/editorial-page";
import { breadcrumbsFor } from "../../../lib/routing";
import { articleSchema, faqPageSchema, itemListSchema, imageObjectSchema } from "../../../lib/seo";
import { MEDIA_ASSETS } from "../../../content/media/assets";
import { FOUNDER } from "../../../content/team";
import ProductCard from "../../../components/ProductCard.astro";
import ProductImage from "../../../components/ProductImage.astro";
import { getDb, schema } from "../../../lib/db";
import { redirectKeysByProduct } from "../../../lib/catalogue-redirects";
import { productPath } from "../../../content/routes";
import { and, eq, inArray } from "drizzle-orm";

const PATH = "/best-robots/robotic-pool-cleaners/solar-powered-skimmers/";
const article = editorialFor(PATH)!;
const { html, picks, comparison } = await buildEditorialPage(
  article,
  Astro.locals,
  import.meta.env.DEV,
);

const crumbs = breadcrumbsFor(PATH);

/* MORE POOL ROBOTS, AND A BUY BUTTON FOR EACH ARRIVAL. A reader who reaches a
   skimmer page is a pool owner, and the next question is usually the floor.
   These four are the cleaners the rest of the pool pages recommend most; each
   card carries its own check-price action, the same as the hub's. */
const FLOOR_SLUGS = ["aiper-scuba-s1", "wybot-c1", "beatbot-aquasense-2-ultra", "dolphin-nautilus-cc-plus"];
const db = getDb(Astro.locals);
const redirects = await redirectKeysByProduct(db);
const floorRows = (
  await db
    .select()
    .from(schema.products)
    .where(and(eq(schema.products.status, "published"), inArray(schema.products.slug, FLOOR_SLUGS)))
).sort((a, b) => FLOOR_SLUGS.indexOf(a.slug) - FLOOR_SLUGS.indexOf(b.slug));
const titleCase = (v: string) => v.replace(/_/g, " ").replace(/^\w/, (c) => c.toUpperCase());
const buyRows = comparison.filter((r) => r.redirectKey);

/* The page's own artwork, used as the social preview and as Article schema's
   image. Without this a share of this page shows the BotPlanet logo rather
   than the picture at the top of it, and Article schema carries no image at
   all — the same defect the elderly-pets guide was fixed for on its own. */
const lead = article.image?.src ?? null;

/* An ImageObject per picture this page renders: the lead, then each figure
   the injector places. Built from the same list, so nothing is claimed in
   markup that a reader cannot see. */
const renderedImages = [lead, ...(article.figures ?? []).map((f) => f.src)]
  .filter((src): src is string => Boolean(src))
  .map((src) => MEDIA_ASSETS.find((a) => a.src === src))
  .filter((a): a is NonNullable<typeof a> => Boolean(a?.width) && Boolean(a?.height));

const pageSchema = [
  articleSchema({
    headline: article.title,
    description: article.metaDescription,
    path: PATH,
    dateModified: article.lastReviewed,
    authorName: FOUNDER.name,
    authorPath: FOUNDER.path,
    image: lead ?? undefined,
  }),
  ...renderedImages.map((a) =>
    imageObjectSchema({ path: a.src, caption: a.altText ?? "", width: a.width!, height: a.height! }),
  ),
  picks.length ? itemListSchema(picks.map((p) => ({ name: p.name, path: p.href })), article.title) : null,
  faqPageSchema(article.faq, PATH),
];
---

<Base
  title={article.seoTitle}
  description={article.metaDescription}
  ogImage={lead ?? undefined}
  breadcrumbs={crumbs}
  schema={pageSchema}
>
  <EditorialArticle
    article={article}
    html={html}
    picks={picks}
    comparison={comparison}
  >
    <Fragment slot="after-comparison">
      {buyRows.length > 0 && (
        <section class="sk-buy" id="where-to-buy" aria-labelledby="sk-buy-h">
          <h2 id="sk-buy-h" class="sk-h">Where to buy the four</h2>
          <p class="sk-lede">
            Each button goes to that machine's own Amazon listing. Check the title names the model and
            colour you want before you add it to a basket, because Amazon sells colours, bundles and
            refurbished units as separate listings.
          </p>
          <ul class="sk-buy__grid">
            {buyRows.map((r) => (
              <li class="sk-buy__item">
                <a class="sk-buy__thumb" href={r.href} aria-label={`${r.name} review`}>
                  <ProductImage productId={r.productId} placement="comparison" compact sizes="72px" />
                </a>
                <div class="sk-buy__text">
                  <a class="sk-buy__name" href={r.href}>{r.name}</a>
                  <span class="sk-buy__sub">Read the review first</span>
                </div>
                <a class="sk-buy__btn" href={`/go/${r.redirectKey}`} rel="sponsored nofollow">
                  Check price on Amazon
                </a>
              </li>
            ))}
          </ul>
          <p class="sk-note">
            We earn a commission on qualifying Amazon purchases made through these links, at no extra cost to
            you. It does not decide the order or the awards above.
          </p>
        </section>
      )}

      <section class="sk-more" id="more-pool-robots" aria-labelledby="sk-more-h">
        <h2 id="sk-more-h" class="sk-h">If the floor is the problem, start here</h2>
        <p class="sk-lede">
          A skimmer works the surface and nothing else. These are the floor-and-wall robots our pool pages
          recommend most, and each pairs with any skimmer above. The full ranking is on the{" "}
          <a href="/best-robots/robotic-pool-cleaners/">best robotic pool cleaners</a> page.
        </p>
        <div class="grid grid--products">
          {floorRows.map((p, i) => (
            <ProductCard
              href={productPath(p.slug, "robotic-pool-cleaners")}
              name={p.name}
              classification={titleCase(p.productClass)}
              meta={[titleCase(p.powerType), ...(p.environments as string[]).slice(0, 2).map(titleCase)]}
              productId={p.id}
              variant={i}
              saveId={p.id}
              buyKey={redirects.get(p.id) ?? null}
            />
          ))}
        </div>
        <ul class="sk-links">
          <li><a href="/robots/robotic-pool-cleaners/">Every robotic pool cleaner we cover</a></li>
          <li><a href="/best-robots/robotic-pool-cleaners/cordless/">Best cordless robotic pool cleaners</a></li>
          <li><a href="/best-robots/robotic-pool-cleaners/above-ground-pools/">Best for above-ground pools</a></li>
          <li><a href="/botmatch/robotic-pool-cleaners/">BotMatch: score your own pool</a></li>
          <li><a href="/guides/are-robotic-pool-cleaners-worth-it/">Are robotic pool cleaners worth it?</a></li>
        </ul>
      </section>
    </Fragment>
  </EditorialArticle>
</Base>

<style>
  .sk-buy,
  .sk-more {
    max-width: 68rem;
    margin: 2.5rem auto 0;
    padding: 0 1rem;
  }
  .sk-h {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    margin: 0 0 0.6rem;
  }
  .sk-lede {
    max-width: 46rem;
    margin: 0 0 1.2rem;
    color: var(--text-secondary);
  }
  .sk-buy__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .sk-buy__item {
    display: grid;
    grid-template-columns: 72px 1fr;
    grid-template-areas: "thumb text" "btn btn";
    gap: 0.6rem 0.9rem;
    align-items: center;
    padding: 0.9rem;
    border: 1px solid var(--cs-line, rgba(255, 255, 255, 0.12));
    border-radius: 14px;
    background: var(--cs-surface-lift, rgba(255, 255, 255, 0.03));
  }
  .sk-buy__thumb {
    grid-area: thumb;
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }
  .sk-buy__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .sk-buy__text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .sk-buy__name {
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }
  .sk-buy__name:hover {
    text-decoration: underline;
  }
  .sk-buy__sub {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }
  .sk-buy__btn {
    grid-area: btn;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    color: #10141a;
    background: #f5b942;
  }
  .sk-buy__btn:hover {
    background: #ffc95c;
  }
  .sk-buy__btn:focus-visible {
    outline: 2px solid #dfe4ec;
    outline-offset: 2px;
  }
  .sk-note {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .sk-links {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
  }
  @media (max-width: 720px) {
    .sk-buy__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
