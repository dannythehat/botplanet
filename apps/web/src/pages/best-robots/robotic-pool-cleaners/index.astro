---
/**
 * Best-of guide — robotic pool cleaners.
 *
 * Page 2 of the pool map in docs/seo/pool-research-findings.md, targeting the
 * "best robotic pool cleaner" cluster (6,600/mo, KD 13). Google groups the
 * "best robot pool cleaner", "top rated" and "for inground pools" phrasings
 * into the same cluster, so there is no separate inground page — the inground
 * argument is a section of this one.
 *
 * Everything except the prose comes from content/editorial.ts and the
 * catalogue. See lib/editorial-page.ts for the assembly.
 */
import Base from "../../../layouts/Base.astro";
import EditorialArticle from "../../../components/EditorialArticle.astro";
import { editorialFor } from "../../../content/editorial";
import { buildEditorialPage } from "../../../lib/editorial-page";
import { breadcrumbsFor } from "../../../lib/routing";
import { articleSchema, faqPageSchema, itemListSchema } from "../../../lib/seo";
import { FOUNDER } from "../../../content/team";

const PATH = "/best-robots/robotic-pool-cleaners/";
const article = editorialFor(PATH)!;
const { html, picks, comparison } = await buildEditorialPage(
  article,
  Astro.locals,
  import.meta.env.DEV,
);

const crumbs = breadcrumbsFor(PATH);

/* ItemList carries the ranked picks in the order the page ranks them — which
   is the one place on this page where the order is an editorial claim rather
   than a sort. No Product or Offer nodes: this page publishes no price. */
const pageSchema = [
  articleSchema({
    headline: article.title,
    description: article.metaDescription,
    path: PATH,
    dateModified: article.lastReviewed,
    authorName: FOUNDER.name,
    authorPath: FOUNDER.path,
  }),
  picks.length ? itemListSchema(picks.map((p) => ({ name: p.name, path: p.href })), article.title) : null,
  faqPageSchema(article.faq, PATH),
];
---

<Base
  title={article.seoTitle}
  description={article.metaDescription}
  breadcrumbs={crumbs}
  schema={pageSchema}
>
  <EditorialArticle article={article} html={html} picks={picks} comparison={comparison} />
</Base>
