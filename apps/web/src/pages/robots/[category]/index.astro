---
import Base from "../../../layouts/Base.astro";
import PoolDiagram from "../../../components/PoolDiagram.astro";
import ProductCard from "../../../components/ProductCard.astro";
import { getDb, schema } from "../../../lib/db";
import { usd, titleCase } from "../../../lib/format";
import { and, eq, inArray } from "drizzle-orm";

const { category } = Astro.params;
const db = getDb(Astro.locals);

const cat = (
  await db.select().from(schema.categories).where(eq(schema.categories.slug, category!)).limit(1)
)[0];
if (!cat) return new Response("Category not found", { status: 404 });

const products = await db
  .select()
  .from(schema.products)
  .where(and(eq(schema.products.categoryId, cat.id), eq(schema.products.status, "published")));

const ids = products.map((p) => p.id);
const offers = ids.length
  ? await db.select().from(schema.offers).where(inArray(schema.offers.productId, ids))
  : [];

function minPrice(productId: string): number | null {
  const prices = offers
    .filter((o) => o.productId === productId && o.basePriceMinor != null)
    .map((o) => o.basePriceMinor as number);
  return prices.length ? Math.min(...prices) : null;
}
---

<Base title={`${cat.name} — BotPlanet`} description={`Compare ${cat.name.toLowerCase()} for the US.`}>
  <div class="section-head section-head--row">
    <div>
      <span class="eyebrow">Category</span>
      <h1 class="mt-0">{cat.name}</h1>
      <p class="note">{products.length} products · US market · suitability-ranked by BotMatch</p>
    </div>
    <a class="btn btn--primary" href={`/botmatch/${cat.slug}/`}>Find my robot</a>
  </div>

  <div class="mt-lg mb-lg"><PoolDiagram /></div>

  {products.length === 0 ? (
    <div class="empty">
      <p class="empty__title">No products published in this category yet</p>
      <p>Published products appear here automatically.</p>
    </div>
  ) : (
    <div class="grid grid--products">
      {products.map((p, i) => (
        <ProductCard
          href={`/robots/${cat.slug}/${p.slug}/`}
          name={p.name}
          classification={titleCase(p.productClass)}
          meta={[titleCase(p.powerType), ...(p.environments as string[]).slice(0, 2).map(titleCase)]}
          price={minPrice(p.id) != null ? `from ${usd(minPrice(p.id))}` : null}
          priceNote="Snapshot price · confirm at retailer"
          variant={i}
          saveId={p.id}
        />
      ))}
    </div>
  )}
</Base>
