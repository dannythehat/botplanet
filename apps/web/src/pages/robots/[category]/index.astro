---
import Base from "../../../layouts/Base.astro";
import ProductCard from "../../../components/ProductCard.astro";
import { RETIRED_SLUGS } from "../../../content/product-names";
import { productPath } from "../../../content/routes";
import { categoryBySlug } from "../../../content/nav";
import { journeyFor } from "../../../content/journeys";
import { getDb, schema } from "../../../lib/db";
import { usd, titleCase } from "../../../lib/format";
import { cataloguePrices, checkedNote } from "../../../lib/catalogue-prices";
import { redirectKeysByProduct } from "../../../lib/catalogue-redirects";
import { and, eq } from "drizzle-orm";
import { breadcrumbsFor } from "../../../lib/routing";
import { collectionPageSchema, imageObjectSchema, faqPageSchema, itemListSchema } from "../../../lib/seo";
import CategoryHero from "../../../components/CategoryHero.astro";
import { heroFor } from "../../../content/category-hero";
import DecisionCards from "../../../components/DecisionCards.astro";
import CoverageRows from "../../../components/CoverageRows.astro";
import DecisionSplit from "../../../components/DecisionSplit.astro";
import MatrixTable from "../../../components/MatrixTable.astro";
import ComparisonTable from "../../../components/ComparisonTable.astro";
import BrandPairs from "../../../components/BrandPairs.astro";
import type { RenderedPair } from "../../../components/BrandPairs.astro";
import { comparisonRows } from "../../../content/comparison";
import { comparePageFor } from "../../../content/compare-page";
import CheckList from "../../../components/CheckList.astro";
import JumpLinks from "../../../components/JumpLinks.astro";
import TrustStrip from "../../../components/TrustStrip.astro";
import ArticleFooter from "../../../components/ArticleFooter.astro";
import BotMatchCta from "../../../components/BotMatchCta.astro";
import BotFinderCard from "../../../components/BotFinderCard.astro";
import { finderCardFor } from "../../../content/finder-cards";
import { canMatch } from "../../../content/matcher-router";
import PriceLadder from "../../../components/PriceLadder.astro";
import VerdictPanel from "../../../components/VerdictPanel.astro";
import FaqList from "../../../components/FaqList.astro";
import { decisionSectionFor, coverageSectionFor, splitSectionFor, matrixSectionFor, checkSectionFor, priceSectionFor, verdictSectionFor, faqSectionFor, botMatchCtaFor } from "../../../content/category-sections";
import { MEDIA_ASSETS } from "../../../content/media/assets";
import { editorialForCategory } from "../../../content/editorial";
import { applyInternalLinks } from "../../../lib/internal-linker";
import { anchorsFor } from "../../../content/internal-links";
import { srcsetFor } from "../../../lib/srcset";
import HubDiagram from "../../../components/diagrams/HubDiagram.astro";
import HubTable from "../../../components/HubTable.astro";
import "../../../styles/prose.css";

const ARTICLE_PROSE = import.meta.glob<{ compiledContent: () => string | Promise<string> }>(
  "../../../articles/*.md",
  { eager: true },
);

const { category } = Astro.params;
const db = getDb(Astro.locals);

const cat = (
  await db.select().from(schema.categories).where(eq(schema.categories.slug, category!)).limit(1)
)[0];
if (!cat) return new Response("Category not found", { status: 404 });

/* A HIDDEN CATEGORY HAS NO HUB, and this route has to enforce it because it
   reads D1 and D1 has no launch column. Seeding robot-snow-blowers on 11 August
   2026 made this page render immediately: 200, `index, follow`, a bare H1 and
   nothing else — a thin indexable page that the sitemap deliberately excludes,
   which is the worst pair of properties a URL can have.

   `hidden` means "reserved slug, noindex, not linked in nav" (see nav.ts). The
   honest rendering of a hub that does not exist is 404, not an empty page with
   a heading on it. The products beneath it are unaffected: [slug].astro never
   reads the category's launch state, which is what lets a real review live
   under a category with no front door. */
if (categoryBySlug(category!)?.launch === "hidden") {
  return new Response("Not found", { status: 404 });
}

const journey = journeyFor(category);

/* A RETIRED SLUG IS STILL PUBLISHED IN D1 AND MUST NOT APPEAR HERE.
   Merging the three surplus WINBOTs on 7 August 2026 left their D1 rows exactly
   where they were — deliberately, because the rows carry the offers and the
   evidence, and deleting them would throw both away. But the grid reads D1
   directly, so all eleven kept rendering and three of the cards linked to a URL
   that 301s straight back out again. An internal link to a redirect is a link
   that leaks its own signal.

   Filtered against RETIRED_SLUGS rather than by unpublishing in production:
   the redirect map is versioned, reviewable and already the single source of
   truth for which URLs are no longer their own page. A production write would
   put that fact somewhere no test can see it. */
const rows = await db
  .select()
  .from(schema.products)
  .where(and(eq(schema.products.categoryId, cat.id), eq(schema.products.status, "published")));
const products = rows.filter((p) => !(p.slug in RETIRED_SLUGS));

/* WHO GETS A BUY LINK IN THE TABLE, NOT WHAT THE TABLE IS SORTED BY.
   See lib/catalogue-redirects.ts: a redirect key carries no price or
   commission and plays no part in the sort above. */
const redirectByProduct = await redirectKeysByProduct(db);

/* PRICES COME FROM THE CHECKER, NOT FROM THE SEEDED OFFER ROWS.
   This used to read `offers.base_price_minor` and print the lowest — a figure
   with no check date and no freshness gate. On 6 August 2026 that was found
   publishing the retired Dolphin Premier's $1,299 against the BuBlue Bubot,
   which the checker had read at $799.97 two days earlier: the record had
   changed product, the offer row had not. See lib/catalogue-prices.ts. */
const prices = await cataloguePrices(Astro.locals.runtime.env.DB);
const crumbs = breadcrumbsFor(Astro.url.pathname);

const hero = heroFor(category);
const decision = decisionSectionFor(category);
const coverage = coverageSectionFor(category);
const split = splitSectionFor(category);
const matrix = matrixSectionFor(category);
const check = checkSectionFor(category);
const price = priceSectionFor(category);
const verdict = verdictSectionFor(category);
const faq = faqSectionFor(category);
/* A matcher with no products is not advertised — PRE-BUILD-PROCESS.md Stage 5b.
   The rule used to be enforced by deleting the panel's copy out of
   category-sections.ts, which meant turning it back on was a rewrite and
   depended on somebody remembering. The copy now stays written and the gate
   sits here, on the thing that is actually true: this category's count of
   published products. Zero products, no panel. First product, panel appears —
   no flag to flip and no second deploy.

   The review page renders the same panel unconditionally, and that is correct:
   a review existing means a product exists. */
/* GATED ON HAVING SOMETHING TO RECOMMEND, exactly as the written panel below
   already was. "A matcher with no products is not advertised" —
   PRE-BUILD-PROCESS.md Stage 5b — and the finder card walked straight past
   that rule when it was added: the grill hub shipped a "Find my grill bot"
   button pointing at a matcher that holds zero products and can therefore
   answer nobody.

   AND THE THRESHOLD IS canMatch, NOT "more than nothing". The first version of
   this gate read products.length > 0, which was right until grill gained its
   first product and promptly advertised a matcher that still could not run —
   MIN_PRODUCTS_FOR_A_MATCH is 2, because scoring a questionnaire against a
   single product and announcing it as the match tells a reader a comparison
   happened when nothing was compared. One source of truth for "can this
   category answer anybody", used by the card, the written panel and the
   matcher page alike. */
const finderCard = canMatch(products.length) ? finderCardFor(cat.slug) : undefined;
const bmCta = canMatch(products.length) ? botMatchCtaFor(category) : undefined;

/* Built from the catalogue rather than written out, so a product that changes
   model cannot leave a stale row behind. */

/**
 * THE PRODUCTS WERE ALL AT THE BOTTOM, BELOW THE SIGN-OFF.
 *
 * Every hub rendered its entire catalogue in one block AFTER ArticleFooter —
 * after the affiliate disclosure and the "last reviewed" line. The full-site
 * audit measured the grid starting 84% of the way down the companion hub's
 * document. A reader who scrolled through three thousand words of category
 * argument reached the end of the page before meeting a single machine, and
 * anyone who stopped early met none.
 *
 * THREE CLUSTERS, PLACED WHERE THE READER HAS JUST EARNED THEM. The first
 * follows the decision cards — the reader now knows which kind of machine
 * suits them and wants to see some. The second follows the comparison table,
 * which is the moment they are actually choosing. The third follows the price
 * ladder, for the reader who came down to budget. Split evenly, in the order
 * the catalogue already sorts, so no cluster is a favoured slot.
 *
 * The FIRST cluster keeps id="products", because every hub hero's primary CTA
 * points at #products and it should land on the first machines, not the last.
 */
const cluster = (n: 0 | 1 | 2) => {
  if (products.length === 0) return [];
  const size = Math.ceil(products.length / 3);
  return products.slice(n * size, (n + 1) * size);
};

const compareRows = comparisonRows(
  products.map((p) => ({
    id: p.id,
    slug: p.slug,
    name: p.name,
    environments: p.environments as string[],
    cleans: p.cleans as string[],
    powerType: p.powerType,
    priceTier: p.priceTier,
    maxPoolLengthFt: p.maxPoolLengthFt,
    maxPoolAreaSqFt: (p as { maxPoolAreaSqFt?: number | null }).maxPoolAreaSqFt ?? null,
    redirectKey: redirectByProduct.get(p.id) ?? null,
  })),
  cat.slug,
);

/* The only retired comparison page with unique editorial work is pool. Its
   research now lives on the category hub that owns the same search intent. */
const comparisonArticle = comparePageFor(cat.slug);
const comparisonByProduct = new Map(compareRows.map((row) => [row.productId, row]));
const comparisonPairs: RenderedPair[] = (comparisonArticle?.pairs ?? []).map((pair) => ({
  ...pair,
  machines: pair.picks
    .map((pick) => {
      const product = products.find((item) => item.slug === pick.slug);
      const row = product ? comparisonByProduct.get(product.id) : undefined;
      return row
        ? {
            name: row.name,
            href: row.href,
            why: pick.why,
            cleans: row.cleans,
            power: row.power,
            poolSize: row.poolSize,
          }
        : null;
    })
    .filter((machine): machine is NonNullable<typeof machine> => machine !== null),
}));

let comparisonBody = "";
if (comparisonArticle) {
  const mod = ARTICLE_PROSE[`../../../articles/${comparisonArticle.prose}.md`];
  if (!mod) throw new Error(`No comparison prose for ${cat.slug}`);
  comparisonBody = applyInternalLinks(
    await mod.compiledContent(),
    anchorsFor(cat.slug),
    `/robots/${cat.slug}/`,
  ).html;
}

/* The retired pool-guide directory was a list, not an article. Preserve its
   useful destinations here and retire the duplicate URL. */
const mergedGuides =
  cat.slug === "robotic-pool-cleaners"
    ? editorialForCategory(cat.slug).filter(
        (entry) =>
          entry.path.startsWith("/guides/") &&
          entry.path !== "/guides/robotic-pool-cleaners/",
      )
    : [];

/* Jump links are derived from the sections this page actually renders, so the
   list can never name a heading that is not there. Label is the section's
   eyebrow — short enough for a chip, unlike the full H2. */
const jumpTargets = [
  ...[decision, coverage, split, matrix]
    .filter((sec): sec is NonNullable<typeof sec> => Boolean(sec?.id && sec?.eyebrow))
    .map((sec) => ({ id: sec.id, label: sec.eyebrow! })),
  /* The comparison table is not a content section, so it is not in the list
     above — but it is the section most readers actually want, and leaving it
     out of the jump nav hid it behind eight scrolls. Inserted where it renders
     rather than appended, so the nav order matches the page order. */
  ...(comparisonArticle ? [{ id: "brand-comparisons", label: "Brand comparisons" }] : []),
  ...(compareRows.length > 1 ? [{ id: "compare", label: "Compare all" }] : []),
  ...[check, price, verdict, faq]
    .filter((sec): sec is NonNullable<typeof sec> => Boolean(sec?.id && sec?.eyebrow))
    .map((sec) => ({ id: sec.id, label: sec.eyebrow! })),
  ...(mergedGuides.length ? [{ id: "buying-advice", label: "Buying advice" }] : []),
];

/* Every figure below is real. Nothing claims hands-on testing — the evidence
   model here is desk research plus dated manual checks. */
const LAST_REVIEWED = comparisonArticle?.lastReviewed ?? "2026-08-03";
const trustItems = [
  /* A category whose catalogue is not seeded yet would otherwise open with
     "0 robotic lawn mowers researched", which reads as a broken page rather
     than an honest one. Pages are built before their products on the owner's
     instruction of 6 August 2026, so this case is expected, not an error —
     the strip says what is actually true instead of counting to zero. */
  products.length
    ? { value: `${products.length}`, label: `${cat.name.toLowerCase()} researched` }
    : { value: "Research first", label: "Keywords and market mapped before any product goes live" },
  { value: "Suitability first", label: "Commission never picks your robot", href: "/editorial-policy/" },
  { value: "Dated", label: "Every price carries the date it was checked" },
  { value: comparisonArticle ? "6 Aug 2026" : "3 Aug 2026", label: "Last reviewed", href: "/review-methodology/" },
];

/* Schema is built from the images this page actually renders, so every
   ImageObject has visible content behind it. Product, Review and
   AggregateRating are deliberately absent from a category hub. */
/* DIMENSIONS COME FROM THE REGISTRY, NOT FROM THE SURFACE. These were
   hardcoded per slot — 1600x900 for a hero, 800x500 for a card — which is the
   size the layout renders at rather than the size of the file. An ImageObject
   states the dimensions of the image, so a consumer given 800x500 for a file
   that is 1448x1086 has been told something untrue about an asset it can
   fetch and measure. The registry knows; ask it, and fall back to the slot
   default only for a path it does not hold. */
const dims = (path: string, w: number, h: number) => {
  const a = MEDIA_ASSETS.find((x) => x.src === path);
  return { width: a?.width ?? w, height: a?.height ?? h };
};

const editorialImages = [
  hero?.image?.src
    ? { path: hero.image.src, caption: hero.image.alt, ...dims(hero.image.src, 1600, 900) }
    : null,
  comparisonArticle?.image?.src
    ? {
        path: comparisonArticle.image.src,
        caption: comparisonArticle.image.alt,
        ...dims(comparisonArticle.image.src, 1672, 941),
      }
    : null,
  ...(decision?.cards ?? [])
    .filter((c) => c.image?.src)
    .map((c) => ({ path: c.image!.src, caption: c.image!.alt, ...dims(c.image!.src, 800, 500) })),
  coverage?.image?.src
    ? { path: coverage.image.src, caption: coverage.image.alt, ...dims(coverage.image.src, 1600, 900) }
    : null,
  /* The coverage ROWS were missing entirely. Both the grill hub and the pet
     camera hub carry a thumbnail per row as of 9 August 2026, and every one of
     them rendered on the page with no ImageObject behind it — the schema said
     the page had four pictures when it had seven. */
  ...(coverage?.rows ?? [])
    .filter((r) => r.image?.src)
    .map((r) => ({ path: r.image!.src, caption: r.image!.alt, ...dims(r.image!.src, 700, 467) })),
  ...(matrix?.rows ?? [])
    .filter((r) => r.image?.src)
    .map((r) => ({ path: r.image!.src, caption: r.image!.alt, ...dims(r.image!.src, 700, 467) })),
].filter(Boolean) as { path: string; caption: string; width: number; height: number }[];

const pageSchema = hero
  ? [
      collectionPageSchema({
        path: `/robots/${cat.slug}/`,
        name: hero.title,
        description: hero.metaDescription,
        images: editorialImages,
      }),
      ...editorialImages.map(imageObjectSchema),
      /* The products this page actually lists, in the order the comparison
         table shows them. Built from the same rows, so the two can never
         disagree about what is on the page or how it is ordered. No Product,
         Offer or AggregateRating node: a hub links to products, it does not
         sell them, and this page publishes no price. */
      compareRows.length
        ? itemListSchema(
            compareRows.map((r) => ({ name: r.name, path: r.href })),
            `${cat.name} compared`,
          )
        : null,
      mergedGuides.length
        ? itemListSchema(
            mergedGuides.map((guide) => ({ name: guide.title, path: guide.path })),
            "Robotic pool cleaner buying advice",
          )
        : null,
      faqPageSchema(
        [...(faq?.items ?? []), ...(comparisonArticle?.faq ?? [])],
        `/robots/${cat.slug}/`,
      ),
    ]
  : [];

/* Same reasoning as the review page's cache-control: nothing here is keyed on
   the visitor, only on the category slug, so the edge can serve repeat
   requests — including repeat crawler fetches — without a fresh D1 read. */
Astro.response.headers.set("cache-control", "public, max-age=300, stale-while-revalidate=86400");
---

<Base
  title={hero?.seoTitle ?? `${cat.name} — BotPlanet`}
  description={hero?.metaDescription ?? `Compare ${cat.name.toLowerCase()} for the US.`}
  /* A category's own hero previews far better than the site-wide brand card,
     and it is original artwork we own, so it may be shared. Falls back to the
     brand card when a category has no hero yet. */
  ogImage={hero?.image?.src}
  breadcrumbs={crumbs}
  schema={pageSchema}
>
  {hero ? (
    <CategoryHero
      eyebrow={hero.eyebrow}
      title={hero.title}
      subtitle={hero.subtitle}
      primaryCta={hero.primaryCta}
      secondaryCta={hero.secondaryCta}
      image={hero.image}
      imageLayout={hero.imageLayout}
    />
  ) : (
    <div class="section-head section-head--row">
      <div>
        <span class="eyebrow">Category</span>
        <h1 class="mt-0">{cat.name}</h1>
        <p class="note">{products.length} products · US market · suitability-ranked by BotMatch</p>
      </div>
      {journey && <a class="btn btn--accent" href={journey.href}>{journey.ctaLabel}</a>}
    </div>
  )}

  <JumpLinks targets={jumpTargets} />

  <TrustStrip items={trustItems} />

  {decision && (
    <DecisionCards
      id={decision.id}
      eyebrow={decision.eyebrow}
      title={decision.title}
      intro={decision.intro}
      cards={decision.cards}
    linkCategory={cat.slug} />
  )}

  {/* THE HUB'S ONE DRAWING, directly under the decision it belongs to.
      The decision section states the constraint that rules machines out — the
      cat's weight against the chamber, the yard's area against a weekly rating,
      the pane's border against a path that turns before the frame — and each of
      those is a mechanism the reader has to picture before the three cards mean
      anything. Categories with no entry render nothing; see HubDiagram.astro.

      It sits between the cards and the coverage rows rather than at the top,
      because the hero is already an image and two pictures before any text is a
      brochure. */}
  <HubDiagram category={cat.slug} />

  {cluster(0).length > 0 && (
    <div class="grid grid--products" id="products">
      {cluster(0).map((p, i) => (
        <ProductCard
          href={productPath(p.slug, cat.slug)}
          name={p.name}
          classification={titleCase(p.productClass)}
          meta={[titleCase(p.powerType), ...(p.environments as string[]).slice(0, 2).map(titleCase)]}
          price={prices.get(p.id) ? usd(prices.get(p.id)!.priceMinor) : null}
          priceNote={prices.get(p.id) ? checkedNote(prices.get(p.id)!.checkedDate) : undefined}
          productId={p.id}
          variant={i + 0}
          saveId={p.id}
        />
      ))}
    </div>
  )}


  {coverage && (
    <CoverageRows
      id={coverage.id}
      eyebrow={coverage.eyebrow}
      title={coverage.title}
      intro={coverage.intro}
      image={coverage.image}
      rows={coverage.rows}
    linkCategory={cat.slug} />
  )}

  {split && (
    <DecisionSplit id={split.id} eyebrow={split.eyebrow} title={split.title} intro={split.intro} panels={split.panels} linkCategory={cat.slug} />
  )}

  {matrix && (
    <MatrixTable id={matrix.id} eyebrow={matrix.eyebrow} title={matrix.title} intro={matrix.intro} columns={matrix.columns} rows={matrix.rows} note={matrix.note} linkCategory={cat.slug} />
  )}

  {/* BEFORE the generic comparison grid, deliberately. The grid compares the
      whole catalogue on four fixed columns; this answers the one question the
      category actually turns on — which of six near-identically named WINBOTs,
      or which robot pet does what — and a reader who gets that answer first
      reads the grid better. Categories with no entry render nothing. */}
  <HubTable category={cat.slug} />

  {comparisonArticle && (
    <section class="bp-merged-comparison" id="brand-comparisons">
      <span class="eyebrow">Brand comparison</span>
      <h2>{comparisonArticle.title}</h2>
      <p class="bp-merged-comparison__standfirst">{comparisonArticle.standfirst}</p>
      {comparisonArticle.image?.src && (
        <figure class="bp-merged-comparison__figure">
          <img
            src={comparisonArticle.image.src}
            srcset={srcsetFor(comparisonArticle.image.src)}
            sizes="(min-width: 1100px) 1040px, 100vw"
            alt={comparisonArticle.image.alt}
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )}
      {comparisonBody && <article class="bp-prose" set:html={comparisonBody} />}
    </section>
  )}

  {compareRows.length > 1 && (
    <ComparisonTable
      categorySlug={cat.slug}
      id="compare"
      eyebrow="Side by side"
      title={`Compare every ${cat.name.toLowerCase().replace(/s$/, "")}`}
      {/* "whether one fits YOUR POOL" until 12 August 2026 — on every hub, in a
          template that renders nine categories. A window buyer, a cat owner and
          somebody choosing a lawn mower were all asked about their pool. Same
          disease as the "Pool size" column header found on 8 August: this
          template was written for the launch category and its copy was never
          re-read when eight more categories arrived. Found by an external audit
          of the window hub.

          THE SHELL IS STILL WRONG AND IS NOT FIXED HERE. The header CTA, the
          drawer CTA and the mega panel all say "Find My Pool Cleaner" on all
          nine hubs, because shellJourney() resolves one journey site-wide. That
          needs per-page resolution and it is its own job — a one-word patch
          here would have hidden it. */}
      intro={`All ${compareRows.length} ${cat.name.toLowerCase()} we hold, on the four things that most often rule a machine out. Where a manufacturer does not publish a figure the cell says so rather than guessing.`}
      rows={compareRows}
      note={`Ordered by price band, then alphabetically — not by what we earn. The size column shows a maximum length where the maker publishes one and a maximum area where it publishes that instead; the two are not interchangeable.`}
    />
  )}

  {comparisonPairs.length > 0 && (
    <BrandPairs
      id="brand-matchups"
      eyebrow="Brand matchups"
      title="The matchups people actually search for"
      intro="The verdict comes first. Each machine underneath is the model that best answers for its brand."
      pairs={comparisonPairs}
    />
  )}

  {comparisonArticle && comparisonArticle.faq.length > 0 && (
    <FaqList
      id="comparison-questions"
      eyebrow="Comparison questions"
      title="Questions people ask before choosing a brand"
      intro="Direct answers to the questions that repeatedly come up when these machines are compared."
      items={comparisonArticle.faq}
    />
  )}

  {cluster(1).length > 0 && (
    <div class="grid grid--products">
      {cluster(1).map((p, i) => (
        <ProductCard
          href={productPath(p.slug, cat.slug)}
          name={p.name}
          classification={titleCase(p.productClass)}
          meta={[titleCase(p.powerType), ...(p.environments as string[]).slice(0, 2).map(titleCase)]}
          price={prices.get(p.id) ? usd(prices.get(p.id)!.priceMinor) : null}
          priceNote={prices.get(p.id) ? checkedNote(prices.get(p.id)!.checkedDate) : undefined}
          productId={p.id}
          variant={i + 4}
          saveId={p.id}
        />
      ))}
    </div>
  )}

  {check && (
    <CheckList id={check.id} eyebrow={check.eyebrow} title={check.title} intro={check.intro} boxLabel={check.boxLabel} items={check.items} linkCategory={cat.slug} />
  )}

  {mergedGuides.length > 0 && (
    <section class="bp-merged-guides" id="buying-advice">
      <div class="section-head">
        <span class="eyebrow">Buying advice</span>
        <h2>Understand the machine before you choose one</h2>
        <p>
          These guides answer the questions a ranking cannot: how the cleaner works,
          what it will not fix and when buying one is worth it.
        </p>
      </div>
      <div class="bp-merged-guides__grid">
        {mergedGuides.map((guide) => (
          <a class="card card--interactive" href={guide.path}>
            <span class="pill pill--strong">Guide</span>
            <h3>{guide.title}</h3>
            <p>{guide.standfirst}</p>
          </a>
        ))}
      </div>
      <p class="bp-merged-guides__next">
        Want a ranked shortlist instead? See the{" "}
        <a href="/best-robots/robotic-pool-cleaners/">best robotic pool cleaners</a>, compare the{" "}
        <a href="/best-robots/robotic-pool-cleaners/cordless/">best cordless models</a>, or let{" "}
        <a href="/botmatch/robotic-pool-cleaners/">BotMatch</a> score your pool.
      </p>
    </section>
  )}

  {/* A composed Bot Finder card where one exists for this category, and the
      written panel everywhere else. NOT BOTH: the card carries the same pitch
      in its own pixels, so showing the two together would say everything
      twice. Eight categories still have no artwork and keep the panel, which
      is why both paths stay. */}
  {finderCard ? (
    <div class="bp-hub-finder">
      <BotFinderCard
        src={finderCard.src}
        alt={finderCard.alt}
        label={finderCard.label}
        href={`/botmatch/${cat.slug}/`}
        width={finderCard.width}
        height={finderCard.height}
        cta={finderCard.cta}
      />
    </div>
  ) : bmCta ? (
    <BotMatchCta
      categorySlug={cat.slug}
      headline={bmCta.headline}
      body={bmCta.body}
      points={bmCta.points}
      ctaLabel={bmCta.ctaLabel}
      note={bmCta.note}
      image={bmCta.image}
    />
  ) : null}

  {price && (
    <PriceLadder id={price.id} eyebrow={price.eyebrow} title={price.title} intro={price.intro} rungs={price.rungs} note={price.note} linkCategory={cat.slug} />
  )}

  {cluster(2).length > 0 && (
    <div class="grid grid--products">
      {cluster(2).map((p, i) => (
        <ProductCard
          href={productPath(p.slug, cat.slug)}
          name={p.name}
          classification={titleCase(p.productClass)}
          meta={[titleCase(p.powerType), ...(p.environments as string[]).slice(0, 2).map(titleCase)]}
          price={prices.get(p.id) ? usd(prices.get(p.id)!.priceMinor) : null}
          priceNote={prices.get(p.id) ? checkedNote(prices.get(p.id)!.checkedDate) : undefined}
          productId={p.id}
          variant={i + 8}
          saveId={p.id}
        />
      ))}
    </div>
  )}

  {verdict && (
    <VerdictPanel id={verdict.id} eyebrow={verdict.eyebrow} title={verdict.title} intro={verdict.intro} verdict={verdict.verdict} body={verdict.body} against={verdict.against} linkCategory={cat.slug} />
  )}

  {faq && (
    <FaqList id={faq.id} eyebrow={faq.eyebrow} title={faq.title} intro={faq.intro} items={faq.items} linkCategory={cat.slug} />
  )}

  {products.length === 0 && (
    /* Carries id="products" so the hero's own "Compare …" button lands here
       rather than nowhere. Landing on "none yet" is the honest answer to the
       question the button asks. */
    <div class="empty" id="products">
      <p class="empty__title">No products published in this category yet</p>
      <p>Published products appear here automatically.</p>
    </div>
  )}

  <ArticleFooter lastReviewed={LAST_REVIEWED} />
</Base>

<style>
  .bp-merged-comparison,
  .bp-merged-guides { margin: clamp(3rem, 7vw, 5rem) 0; scroll-margin-top: 5.5rem; }
  .bp-merged-comparison > h2 { max-width: 22ch; margin: 0.75rem 0 0; }
  .bp-merged-comparison__standfirst { max-width: 68ch; font-size: clamp(1.05rem, 2vw, 1.2rem); }
  .bp-merged-comparison__figure { margin: 1.5rem 0 2rem; overflow: hidden; border-radius: 18px; }
  .bp-merged-comparison__figure img { display: block; width: 100%; height: auto; aspect-ratio: 1672 / 941; object-fit: cover; }
  .bp-merged-guides__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1rem; }
  .bp-merged-guides__grid h3 { margin: 0; font-size: var(--type-card); }
  .bp-merged-guides__next { max-width: 70ch; margin: 1.25rem 0 0; }
</style>
