---
import Base from "../../../layouts/Base.astro";
import { getDb, schema } from "../../../lib/db";
import { usd, freshnessLabel, titleCase } from "../../../lib/format";
import { and, eq } from "drizzle-orm";
import { breadcrumbsFor } from "../../../lib/routing";
import { buildOffers, publicationFor } from "../../../lib/offer-truth";
import { retailer } from "../../../content/commerce/registry";
import { catalogueStatusOf, CATALOGUE_WITHDRAWALS } from "../../../content/products";
import { resolveSlug, removedRedirect } from "../../../content/product-names";
import { latestAcceptedForProduct } from "../../../lib/providers/refresh-store";
import ReviewArticle from "../../../components/ReviewArticle.astro";
import { reviewFor } from "../../../content/reviews";
import { reviewSchema, articleSchema, webPageSchema } from "../../../lib/seo";
import { FOUNDER } from "../../../content/team";

/* Review prose, loaded by slug. A product with a review renders the article;
   one without keeps the plain specification page, so adding a review is two
   files and no change here. */
const REVIEW_PROSE = import.meta.glob<{ compiledContent: () => string | Promise<string> }>("../../../reviews/*.md", { eager: true });

const { category, slug } = Astro.params;
const db = getDb(Astro.locals);

/* A slug lives in D1 and can go stale relative to what the record now holds.
   The repo declares the correct URL; a request on the old one is redirected
   permanently rather than answered with a page that contradicts its address. */
const { storedSlug, redirectTo } = resolveSlug(slug!);
if (redirectTo) return Astro.redirect(`/robots/${category}/${redirectTo}/`, 301);

/* A product that has left the catalogue keeps its archived row but loses its
   page. The URL was indexed, so it goes to the category rather than 404ing. */
const gone = removedRedirect(slug!);
if (gone) return Astro.redirect(gone, 301);

const product = (
  await db.select().from(schema.products).where(eq(schema.products.slug, storedSlug)).limit(1)
)[0];
if (!product) return new Response("Product not found", { status: 404 });

const brand = (
  await db.select().from(schema.brands).where(eq(schema.brands.id, product.brandId)).limit(1)
)[0];

const offers = await db
  .select()
  .from(schema.offers)
  .where(and(eq(schema.offers.productId, product.id), eq(schema.offers.offerStatus, "active")));

/**
 * THE LIVE PRICE COMES FROM D1; THE GATES COME FROM THE ENGINE.
 *
 * `refresh_observations` is written by the scheduled refresh and is the
 * production source for price, seller, availability, delivery and check date.
 * One query, for this product only — not one per card, and not a
 * whole-catalogue read to render a single page.
 *
 * The committed snapshot remains ONLY as a fallback for D1 being unreachable.
 * It cannot make stale data look current: `buildOffers` takes whichever source
 * was CHECKED MOST RECENTLY, so an older fallback never displaces a newer row,
 * and if both are past their freshness window the price is suppressed either
 * way. Fail-closed survives the fallback.
 *
 * Only `accepted = 1` rows are read. An observation the refresh refused stays
 * in the table as evidence and never reaches this page.
 */
let live: Awaited<ReturnType<typeof latestAcceptedForProduct>> = null;
let liveSource: "d1" | "fallback_snapshot" = "d1";
try {
  live = await latestAcceptedForProduct(Astro.locals.runtime.env.DB, product.id);
  if (!live) liveSource = "fallback_snapshot";
} catch (err) {
  // Explicit and logged. A silent fallback is how a site starts showing last
  // month's price while looking perfectly healthy.
  liveSource = "fallback_snapshot";
  console.error(`[offers] D1 unavailable for ${product.id}; falling back to the committed snapshot`, err);
}

const engineOffers = buildOffers(new Date(), { live: live ? [live] : [] })
  .filter((o) => o.productId === product.id)
  .map((o) => ({ offer: o, pub: publicationFor(o) }))
  .filter((x) => x.pub.showable);

const withdrawn = catalogueStatusOf(product.id) !== "active";
const withdrawal = CATALOGUE_WITHDRAWALS[product.id] ?? null;

const evidence = await db
  .select()
  .from(schema.evidence)
  .where(eq(schema.evidence.productId, product.id));

const crumbs = breadcrumbsFor(Astro.url.pathname, product.name);

const review = reviewFor(product.slug);
const proseModule = review ? REVIEW_PROSE[`../../../reviews/${product.slug}.md`] : undefined;

/* A review entry with no prose file is a half-built page; render the plain
   specification page rather than an article with a hole where the body goes.
 *
 * `await` because compiledContent() is async in Astro 5 — awaiting a plain
 * string is harmless, so this is right either way. The try/catch is the real
 * lesson: the first version threw here and the response simply stopped after
 * the breadcrumbs. A blank page is far worse than a plain one, so a failure
 * now falls back to the specification page and says so in the log. */
let reviewHtml: string | null = null;
if (proseModule) {
  try {
    reviewHtml = await proseModule.compiledContent();
  } catch (err) {
    console.error(`[review] could not compile prose for ${product.slug}; falling back to the plain page`, err);
  }
}
const hasReview = Boolean(review && reviewHtml);

/* Review + Article, and no rating anywhere in it — see reviewSchema for why a
   star is the one thing this site has not earned. */
const reviewGraph = hasReview
  ? [
      webPageSchema({
        path: Astro.url.pathname,
        name: review!.title,
        description: review!.metaDescription,
      }),
      reviewSchema({
        itemName: product.name,
        itemBrand: brand?.name ?? null,
        headline: review!.title,
        description: review!.metaDescription,
        path: Astro.url.pathname,
        dateModified: review!.lastReviewed,
        authorName: FOUNDER.name,
        authorPath: FOUNDER.path,
        image: review!.image?.src,
        reviewBody: review!.verdict,
        positiveNotes: [review!.bestFor],
        negativeNotes: [review!.notIdealFor],
      }),
      articleSchema({
        headline: review!.title,
        description: review!.metaDescription,
        path: Astro.url.pathname,
        dateModified: review!.lastReviewed,
        authorName: FOUNDER.name,
        authorPath: FOUNDER.path,
        image: review!.image?.src,
      }),
    ]
  : [];
---

<Base
  title={hasReview ? review!.seoTitle : `${product.name} — BotPlanet`}
  description={hasReview ? review!.metaDescription : `${product.name}: specs, offers and suitability.`}
  ogImage={hasReview ? review!.image?.src : undefined}
  ogType={hasReview ? "article" : undefined}
  breadcrumbs={crumbs}
  schema={reviewGraph}
  narrow={hasReview}
>
  <p class="muted"><a href={`/robots/${category}/`}>← {titleCase(category!)}</a></p>

  {hasReview && <ReviewArticle review={review!} html={reviewHtml!} productName={product.name} />}

  {/* The review supplies its own H1, verdict and key facts, so the plain
      product header would be a second H1 saying the same thing in a weaker
      voice. Products without a review still need it. */}
  {!hasReview && (
    <>
      <div class="row" style="justify-content:space-between; align-items:flex-start;">
        <div>
          <h1>{product.name}</h1>
          <div class="row">
            <span class="pill class">{titleCase(product.productClass)}</span>
            <span class="pill">{titleCase(product.powerType)}</span>
            <span class="pill">{(product.environments as string[]).map(titleCase).join(" / ")}</span>
            <span class="pill">{brand?.name}</span>
          </div>
        </div>
        <a class="btn primary" href={`/botmatch/${category}/`}>Is this right for my pool?</a>
      </div>

      <h2>Cleans</h2>
      <div class="row">
        {(product.cleans as string[]).map((c) => <span class="pill class">{titleCase(c)}</span>)}
      </div>
    </>
  )}

  <h2 id="where-to-buy">Current offers</h2>
  {withdrawn ? (
    <p class="note">
      This robot is no longer part of the BotPlanet launch selection, so we do not link to a seller for it or
      recommend it. Its record stays published because the research behind it is still worth reading.
      {withdrawal && <span class="muted"> {withdrawal.reason}</span>}
    </p>
  ) : engineOffers.length === 0 ? (
    <p class="note">
      No verified offer yet. We only show a price once someone has checked the seller's page on a recorded date —
      we would rather show nothing than a figure that has quietly gone out of date.
    </p>
  ) : (
    <>
      <p class="note">
        Every price below carries the date it was checked. Offer selection favours suitability and freshness, never
        commission.
      </p>
      <table>
        <thead>
          <tr><th>Retailer</th><th>Price</th><th>Availability</th><th>Delivery</th><th>Checked</th><th></th></tr>
        </thead>
        <tbody>
          {engineOffers.map(({ offer, pub }) => (
            <tr>
              <td>
                {retailer(offer.retailerId)?.displayName ?? offer.retailerId}
                {offer.destination.sellerIdentity && (
                  <div class="muted" style="font-size:12px">sold by {offer.destination.sellerIdentity}</div>
                )}
              </td>
              <td class="price" style="font-size:16px;">
                {pub.priceShowable && offer.basePriceMinor !== null ? usd(offer.basePriceMinor) : <span class="muted">not confirmed</span>}
              </td>
              <td class="muted">{pub.stockShowable ? titleCase(offer.stock.state.replace(/_/g, " ")) : "—"}</td>
              <td class="muted">{pub.shippingShowable && offer.shipping.sourceWording ? offer.shipping.sourceWording : "—"}</td>
              <td class="muted" style="font-size:12px">
                {offer.sourceCheckedDate ?? "—"}
                {liveSource === "fallback_snapshot" && <div style="font-size:10px">last recorded check</div>}
              </td>
              <td>
                {pub.linkable && offer.redirectKey ? (
                  <a class="btn" href={`/go/${offer.redirectKey}`} rel="sponsored nofollow">View offer</a>
                ) : null}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {evidence.length > 0 && (
    <>
      <h2>Evidence</h2>
      {evidence.map((e) => (
        <p><span class="pill class">{titleCase(e.evidenceLevel)}</span> {e.claim} {e.sourceUrl && <a href={e.sourceUrl} rel="nofollow">source</a>}</p>
      ))}
    </>
  )}
  <p class="note" style="margin-top:24px;">Affiliate disclosure: BotPlanet may earn a commission from retailer links. This never affects which product is recommended.</p>
</Base>
