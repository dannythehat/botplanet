---
import Base from "../../../layouts/Base.astro";
import { getDb, schema } from "../../../lib/db";
import { usd, freshnessLabel, titleCase } from "../../../lib/format";
import { and, eq } from "drizzle-orm";
import { breadcrumbsFor } from "../../../lib/routing";
import { buildOffers, publicationFor } from "../../../lib/offer-truth";
import { retailer } from "../../../content/commerce/registry";
import { catalogueStatusOf, CATALOGUE_WITHDRAWALS, productEditorialById } from "../../../content/products";

const { category, slug } = Astro.params;
const db = getDb(Astro.locals);

const product = (
  await db.select().from(schema.products).where(eq(schema.products.slug, slug!)).limit(1)
)[0];
if (!product) return new Response("Product not found", { status: 404 });

const brand = (
  await db.select().from(schema.brands).where(eq(schema.brands.id, product.brandId)).limit(1)
)[0];

const offers = await db
  .select()
  .from(schema.offers)
  .where(and(eq(schema.offers.productId, product.id), eq(schema.offers.offerStatus, "active")));

/**
 * OFFERS COME FROM THE OFFER ENGINE, NOT FROM D1.
 *
 * The D1 rows are the pre-Job-10 research snapshots: prices copied during an
 * early pass, for retailers BotPlanet has no relationship with, none of them
 * ever re-checked. Rendering those was the site claiming to know prices it did
 * not know. The engine builds offers from the destination, retailer and
 * programme registries and gates each one, so anything that reaches this page
 * has an approved seller, a verified destination and a dated price behind it.
 *
 * Everything shown here is what `publicationFor` permits — the price appears
 * only with the date it was checked, because an undated price implies it is
 * live and that is the one thing it is not.
 */
const engineOffers = buildOffers()
  .filter((o) => o.productId === product.id)
  .map((o) => ({ offer: o, pub: publicationFor(o) }))
  .filter((x) => x.pub.showable);

const withdrawn = catalogueStatusOf(product.id) !== "active";
const withdrawal = CATALOGUE_WITHDRAWALS[product.id] ?? null;

const evidence = await db
  .select()
  .from(schema.evidence)
  .where(eq(schema.evidence.productId, product.id));

const crumbs = breadcrumbsFor(Astro.url.pathname, product?.name);
---

<Base title={`${product.name} — BotPlanet`} description={`${product.name}: specs, offers and suitability.`} breadcrumbs={crumbs}>
  <p class="muted"><a href={`/robots/${category}/`}>← {titleCase(category!)}</a></p>
  <div class="row" style="justify-content:space-between; align-items:flex-start;">
    <div>
      <h1>{product.name}</h1>
      <div class="row">
        <span class="pill class">{titleCase(product.productClass)}</span>
        <span class="pill">{titleCase(product.powerType)}</span>
        <span class="pill">{(product.environments as string[]).map(titleCase).join(" / ")}</span>
        <span class="pill">{brand?.name}</span>
      </div>
    </div>
    <a class="btn primary" href={`/botmatch/${category}/`}>Is this right for my pool?</a>
  </div>

  <h2>Cleans</h2>
  <div class="row">
    {(product.cleans as string[]).map((c) => <span class="pill class">{titleCase(c)}</span>)}
  </div>

  <h2>Current offers</h2>
  {withdrawn ? (
    <p class="note">
      This robot is no longer part of the BotPlanet launch selection, so we do not link to a seller for it or
      recommend it. Its record stays published because the research behind it is still worth reading.
      {withdrawal && <span class="muted"> {withdrawal.reason}</span>}
    </p>
  ) : engineOffers.length === 0 ? (
    <p class="note">
      No verified offer yet. We only show a price once someone has checked the seller's page on a recorded date —
      we would rather show nothing than a figure that has quietly gone out of date.
    </p>
  ) : (
    <>
      <p class="note">
        Every price below carries the date it was checked. Offer selection favours suitability and freshness, never
        commission.
      </p>
      <table>
        <thead>
          <tr><th>Retailer</th><th>Price</th><th>Availability</th><th>Delivery</th><th>Checked</th><th></th></tr>
        </thead>
        <tbody>
          {engineOffers.map(({ offer, pub }) => (
            <tr>
              <td>
                {retailer(offer.retailerId)?.displayName ?? offer.retailerId}
                {offer.destination.sellerIdentity && (
                  <div class="muted" style="font-size:12px">sold by {offer.destination.sellerIdentity}</div>
                )}
              </td>
              <td class="price" style="font-size:16px;">
                {pub.priceShowable && offer.basePriceMinor !== null ? usd(offer.basePriceMinor) : <span class="muted">not confirmed</span>}
              </td>
              <td class="muted">{pub.stockShowable ? titleCase(offer.stock.state.replace(/_/g, " ")) : "—"}</td>
              <td class="muted">{pub.shippingShowable && offer.shipping.sourceWording ? offer.shipping.sourceWording : "—"}</td>
              <td class="muted" style="font-size:12px">{offer.sourceCheckedDate ?? "—"}</td>
              <td>
                {pub.linkable && offer.redirectKey ? (
                  <a class="btn" href={`/go/${offer.redirectKey}`} rel="sponsored nofollow">View offer</a>
                ) : null}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {evidence.length > 0 && (
    <>
      <h2>Evidence</h2>
      {evidence.map((e) => (
        <p><span class="pill class">{titleCase(e.evidenceLevel)}</span> {e.claim} {e.sourceUrl && <a href={e.sourceUrl} rel="nofollow">source</a>}</p>
      ))}
    </>
  )}
  <p class="note" style="margin-top:24px;">Affiliate disclosure: BotPlanet may earn a commission from retailer links. This never affects which product is recommended.</p>
</Base>
