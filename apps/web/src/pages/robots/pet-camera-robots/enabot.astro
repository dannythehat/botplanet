---
/**
 * The Enabot range page.
 *
 * A STATIC ROUTE INSIDE A DYNAMIC SEGMENT'S SPACE, deliberately. Astro gives
 * static routes precedence over `[category]/[slug]`, so this file answers
 * /robots/pet-camera-robots/enabot/ and the product route never sees it. That
 * matters because "enabot" is not a product: there is no D1 row for it, and the
 * dynamic route would answer 404.
 *
 * WHY IT IS NOT A HUB SECTION AND NOT PART OF THE AIR 2 REVIEW. "enabot"
 * measures 9,900/mo at KD 4 against 480 for "pet camera robot". Its SERP shares
 * three domains with the hub's — amazon, instagram, reddit — and discounting
 * the universal ones leaves zero. Against the Air 2 review it shares five, four
 * of which are amazon, instagram, reddit and facebook. Separate page on both
 * counts, measured 8 August 2026 for $0.1356.
 *
 * THE GAP THIS FILLS. Every editorial result on that SERP reviews ONE model —
 * YouTube on the Air 2 Plus, YouTube on the ROLA Mini, CNET on the Air 2.
 * Nobody had written the page explaining the range.
 *
 * NO PRICES IN THE PROSE, and the first draft had them everywhere. An
 * editorial page states no figure: the whole argument here is what the extra
 * money buys, which is exactly the argument that goes stale silently. The
 * ranking is by position in the range and the live prices come from the offer
 * engine with the date they were read.
 */
import Base from "../../../layouts/Base.astro";
import EditorialArticle from "../../../components/EditorialArticle.astro";
import { editorialFor } from "../../../content/editorial";
import { buildEditorialPage } from "../../../lib/editorial-page";
import { breadcrumbsFor } from "../../../lib/routing";
import { articleSchema, faqPageSchema, itemListSchema } from "../../../lib/seo";
import { FOUNDER } from "../../../content/team";

const PATH = "/robots/pet-camera-robots/enabot/";
const article = editorialFor(PATH)!;
const { html, picks, comparison } = await buildEditorialPage(
  article,
  Astro.locals,
  import.meta.env.DEV,
);

const crumbs = breadcrumbsFor(PATH, article.title);

const pageSchema = [
  articleSchema({
    headline: article.title,
    description: article.metaDescription,
    path: PATH,
    dateModified: article.lastReviewed,
    authorName: FOUNDER.name,
    authorPath: FOUNDER.path,
  }),
  picks.length ? itemListSchema(picks.map((p) => ({ name: p.name, path: p.href })), article.title) : null,
  faqPageSchema(article.faq, PATH),
];
---

<Base
  title={article.seoTitle}
  description={article.metaDescription}
  breadcrumbs={crumbs}
  schema={pageSchema}
>
  <EditorialArticle article={article} html={html} picks={picks} comparison={comparison} />
</Base>
