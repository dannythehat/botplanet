---
/* TEMPORARY design preview for the category hero.
   Not linked from anywhere, noindex, prerendered so it needs no database.
   Delete once the hero is signed off. */
export const prerender = true;

import CategoryHero from "../../components/CategoryHero.astro";
import { heroFor } from "../../content/category-hero";
import DecisionCards from "../../components/DecisionCards.astro";
import CoverageRows from "../../components/CoverageRows.astro";
import DecisionSplit from "../../components/DecisionSplit.astro";
import MatrixTable from "../../components/MatrixTable.astro";
import CheckList from "../../components/CheckList.astro";
import JumpLinks from "../../components/JumpLinks.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import ArticleFooter from "../../components/ArticleFooter.astro";
import BotMatchCta from "../../components/BotMatchCta.astro";
import PriceLadder from "../../components/PriceLadder.astro";
import VerdictPanel from "../../components/VerdictPanel.astro";
import FaqList from "../../components/FaqList.astro";
import { decisionSectionFor, coverageSectionFor, splitSectionFor, matrixSectionFor, checkSectionFor, priceSectionFor, verdictSectionFor, faqSectionFor, botMatchCtaFor } from "../../content/category-sections";
import { collectionPageSchema, imageObjectSchema, schemaGraph, breadcrumbSchema } from "../../lib/seo";

import "../../styles/tokens.css";
import "../../styles/base.css";
import "../../styles/layout.css";
import "../../styles/depth.css";
import "../../styles/components.css";
import "../../styles/metal-theme.css";

const hero = heroFor("robotic-pool-cleaners")!;
const decision = decisionSectionFor("robotic-pool-cleaners")!;
const coverage = coverageSectionFor("robotic-pool-cleaners")!;
const split = splitSectionFor("robotic-pool-cleaners")!;
const matrix = matrixSectionFor("robotic-pool-cleaners")!;
const check = checkSectionFor("robotic-pool-cleaners")!;
const verdict = verdictSectionFor("robotic-pool-cleaners")!;
const faq = faqSectionFor("robotic-pool-cleaners")!;
const price = priceSectionFor("robotic-pool-cleaners")!;
const bmCta = botMatchCtaFor("robotic-pool-cleaners")!;
const jumpTargets = [decision, coverage, split, matrix, check, price, verdict, faq]
  .map((sec) => ({ id: sec.id, label: sec.eyebrow! }));
const trustItems = [
  { value: "9", label: "robotic pool cleaners researched" },
  { value: "Suitability first", label: "Commission never picks your robot", href: "/editorial-policy/" },
  { value: "Dated", label: "Every price carries the date it was checked" },
  { value: "3 Aug 2026", label: "Last reviewed", href: "/review-methodology/" },
];

const editorialImages = [
  { path: hero.image!.src, caption: hero.image!.alt, width: 1600, height: 900 },
  ...decision.cards.filter((c) => c.image?.src)
    .map((c) => ({ path: c.image!.src, caption: c.image!.alt, width: 800, height: 500 })),
];
const graph = schemaGraph(
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Robots", path: "/robots/" },
    { name: "Robotic Pool Cleaners", path: "/robots/robotic-pool-cleaners/" },
  ]),
  collectionPageSchema({
    path: "/robots/robotic-pool-cleaners/",
    name: hero.title,
    description: hero.metaDescription,
    images: editorialImages,
  }),
  ...editorialImages.map(imageObjectSchema),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hero preview — BotPlanet</title>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <main class="wrap" style="padding-top: 2rem; padding-bottom: 4rem;">
      <CategoryHero
        eyebrow={hero.eyebrow}
        title={hero.title}
        subtitle={hero.subtitle}
        primaryCta={hero.primaryCta}
        secondaryCta={hero.secondaryCta}
        image={hero.image}
        imageLayout={hero.imageLayout}
      />
      <JumpLinks targets={jumpTargets} />
      <TrustStrip items={trustItems} />
      <DecisionCards
        id={decision.id}
        eyebrow={decision.eyebrow}
        title={decision.title}
        intro={decision.intro}
        cards={decision.cards}
      />
      <CoverageRows
        id={coverage.id}
        eyebrow={coverage.eyebrow}
        title={coverage.title}
        intro={coverage.intro}
        image={coverage.image}
        rows={coverage.rows}
      />
      <DecisionSplit id={split.id} eyebrow={split.eyebrow} title={split.title} intro={split.intro} panels={split.panels} />
      <MatrixTable id={matrix.id} eyebrow={matrix.eyebrow} title={matrix.title} intro={matrix.intro} columns={matrix.columns} rows={matrix.rows} note={matrix.note} />
      <CheckList id={check.id} eyebrow={check.eyebrow} title={check.title} intro={check.intro} boxLabel={check.boxLabel} items={check.items} />
      <BotMatchCta categorySlug="robotic-pool-cleaners" headline={bmCta.headline} body={bmCta.body} points={bmCta.points} ctaLabel={bmCta.ctaLabel} note={bmCta.note} image={bmCta.image} poster={bmCta.poster} />
      <PriceLadder id={price.id} eyebrow={price.eyebrow} title={price.title} intro={price.intro} rungs={price.rungs} note={price.note} />
      <VerdictPanel id={verdict.id} eyebrow={verdict.eyebrow} title={verdict.title} intro={verdict.intro} verdict={verdict.verdict} body={verdict.body} against={verdict.against} />
      <FaqList id={faq.id} eyebrow={faq.eyebrow} title={faq.title} intro={faq.intro} items={faq.items} />
      <ArticleFooter lastReviewed="2026-08-03" />
    </main>
  </body>
</html>
