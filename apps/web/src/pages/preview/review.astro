---
/* TEMPORARY preview of the review article template. Prerendered,
   noindex, not linked. Delete once the template is signed off.

   The real review lives on the DB-backed product page — Notion's
   rule is one canonical page per model — so this preview exists
   only to show the layout without a database. */
export const prerender = true;

import ReviewHeader from "../../components/ReviewHeader.astro";
import SpecTable from "../../components/SpecTable.astro";
import ArticleFooter from "../../components/ArticleFooter.astro";
import BotMatchCta from "../../components/BotMatchCta.astro";
import { reviewFor } from "../../content/reviews";
import { botMatchCtaFor } from "../../content/category-sections";
import { Content as ReviewBody } from "../../reviews/dolphin-nautilus-cc-plus.md";

import "../../styles/tokens.css";
import "../../styles/base.css";
import "../../styles/layout.css";
import "../../styles/depth.css";
import "../../styles/components.css";
import "../../styles/metal-theme.css";

const review = reviewFor("dolphin-nautilus-cc-plus")!;
const bmCta = botMatchCtaFor("robotic-pool-cleaners")!;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{review.seoTitle}</title>
  </head>
  <body>
    <main class="wrap" style="padding-top:2.5rem;padding-bottom:5rem;">
      <ReviewHeader
        eyebrow={review.eyebrow}
        title={review.title}
        verdict={review.verdict}
        bestFor={review.bestFor}
        notIdealFor={review.notIdealFor}
        image={review.image}
        facts={review.facts}
      />

      <article class="bp-prose">
        <ReviewBody />
      </article>

      <SpecTable
        id="specifications"
        eyebrow="Specifications"
        title="The full specification"
        intro="Every figure below comes from the manufacturer's own product page for the exact SKU named underneath. Where a value is not published, it says so rather than borrowing a number from elsewhere."
        groups={review.specGroups}
        skuNote={review.skuNote}
      />

      <BotMatchCta
        categorySlug="robotic-pool-cleaners"
        headline={bmCta.headline}
        body={bmCta.body}
        points={bmCta.points}
        ctaLabel={bmCta.ctaLabel}
        note={bmCta.note}
      />

      <ArticleFooter lastReviewed={review.lastReviewed} />
    </main>
  </body>
</html>

<style is:global>
  /* Long-form review prose. Measure is the whole point — anything
     wider than about 70 characters gets tiring on a big screen. */
  .bp-prose {
    max-width: 70ch;
    margin: 0 0 clamp(3rem, 7vw, 5rem);
  }

  .bp-prose h2 {
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.45rem, 3.8vw, 1.9rem);
    line-height: 1.18;
    letter-spacing: -0.018em;
    text-wrap: balance;
    color: var(--cs-hi);
  }

  .bp-prose h3 {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.08rem, 2.4vw, 1.2rem);
    line-height: 1.28;
    color: var(--cs-hi);
  }

  .bp-prose p {
    margin: 1.05rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  .bp-prose strong { color: var(--cs-hi); font-weight: 600; }
  .bp-prose em { color: var(--cs-mid); }

  .bp-prose ul { margin: 1.1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; }

  .bp-prose li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 1.0625rem;
    line-height: 1.66;
    color: var(--text-secondary);
  }

  .bp-prose li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.38rem;
    height: 0.38rem;
    transform: rotate(45deg);
    background: var(--cs-sheen);
  }

  .bp-prose hr {
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--cs-line), transparent 70%);
  }

  .bp-prose blockquote {
    margin: 1.5rem 0 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--cs-line);
    color: var(--cs-mid);
  }

  @media (min-width: 900px) {
    .bp-prose p, .bp-prose li { font-size: 1.1rem; }
  }
</style>
