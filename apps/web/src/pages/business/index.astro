---
import Base from "../../layouts/Base.astro";
import RoutePlaceholder from "../../components/RoutePlaceholder.astro";
import { routeFor } from "../../content/routes";
import { breadcrumbsFor } from "../../lib/routing";

const route = routeFor("/business/")!;
const crumbs = breadcrumbsFor("/business/");
---
<Base
  title={`${route.label} — BotPlanet`}
  description={route.summary ?? route.label}
  noindex={!route.indexable}
  breadcrumbs={crumbs}
  narrow={true}
>
  <RoutePlaceholder title="For Business" summary="Commercial cleaning, inspection and service robots, handled as a separate track. No affiliate links and no BotMatch on this route." owner="a later commercial job owns the lead flow" />
</Base>
