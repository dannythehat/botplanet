---
import Base from "../../layouts/Base.astro";
import { FOUNDER } from "../../content/team";
import { SITE } from "../../lib/site";
import { breadcrumbsFor } from "../../lib/routing";
import { webPageSchema } from "../../lib/seo";
const PATH="/contact/";
const TITLE="Contact BotPlanet | Corrections, Product Data & Press";
const DESCRIPTION="Contact BotPlanet about a correction, product data, imagery rights, a commercial relationship or press question.";
---
<Base title={TITLE} description={DESCRIPTION} path={PATH} ogImage={FOUNDER.portrait?.src} breadcrumbs={breadcrumbsFor(PATH)} schema={[webPageSchema({path:PATH,name:TITLE,description:DESCRIPTION,type:"ContactPage"})]}>
  <header class="contact-hero"><div><p class="kicker">A PERSON READS EVERY MESSAGE</p><h1>Contact BotPlanet</h1><p>Send a correction, a source we should see, a question about the method or a commercial enquiry. BotPlanet is a small independent operation; email is the direct route.</p><a class="btn btn--accent btn--lg" href={`mailto:${SITE.business.contactEmail}`}>Email {SITE.business.contactEmail}</a></div><figure>{FOUNDER.portrait && <img src={FOUNDER.portrait.src} srcset={`/media/authors/${FOUNDER.id}-220w.webp 220w, /media/authors/${FOUNDER.id}-440w.webp 440w`} sizes="(max-width: 640px) 100vw, 440px" width="640" height="640" alt={FOUNDER.portrait.alt} loading="eager" fetchpriority="high" decoding="async" />}<figcaption><strong>{FOUNDER.name}</strong><span>{FOUNDER.role}</span></figcaption></figure></header>
  <section class="send" aria-labelledby="send-title"><header><p class="kicker">HELP US ROUTE IT QUICKLY</p><h2 id="send-title">What to include</h2></header><div class="send__grid"><article><span>01</span><h3>A correction</h3><p>Send the page URL, the statement you believe is wrong and the strongest source available. Material corrections are made on the page.</p></article><article><span>02</span><h3>Product data or imagery</h3><p>Manufacturers and retailers: include the product, market, source date and the rights basis for any media supplied.</p></article><article><span>03</span><h3>Press or methodology</h3><p>State the deadline and the specific claim, scoring rule or independence question you want addressed.</p></article><article><span>04</span><h3>A commercial enquiry</h3><p>Tell us who you represent and the proposed relationship. Payment cannot buy a recommendation, rank or independent verdict.</p></article></div></section>
  <section class="boundaries" aria-labelledby="boundaries-title"><div><p class="kicker">EDITORIAL BOUNDARIES</p><h2 id="boundaries-title">What we will not sell</h2><p>A better position in a comparison, a positive review, a BotMatch result or the removal of an accurate limitation is not available for purchase.</p></div><nav><a href="/editorial-policy/">Editorial policy <span aria-hidden="true">→</span></a><a href="/affiliate-disclosure/">Affiliate disclosure <span aria-hidden="true">→</span></a><a href="/review-methodology/">Review method <span aria-hidden="true">→</span></a></nav></section>
  <aside class="reply"><strong>One address. No ticket maze.</strong><span>{SITE.business.contactEmail}</span><a class="btn btn--accent" href={`mailto:${SITE.business.contactEmail}`}>Write to BotPlanet</a></aside>
</Base>
<style>
  .kicker{margin:0 0 .8rem;color:var(--text-tertiary);font:700 .7rem/1 var(--font-mono);letter-spacing:.18em}.contact-hero{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:clamp(2rem,6vw,6rem);align-items:center;max-width:1100px;margin:0 auto;padding:clamp(3rem,7vw,6rem) 0}.contact-hero h1{margin:0;font-size:clamp(3.3rem,6vw,6rem);line-height:.95;letter-spacing:-.06em}.contact-hero div>p:not(.kicker){max-width:40rem;margin:1.4rem 0 1.7rem;color:var(--text-secondary);font-size:clamp(1.05rem,1.6vw,1.22rem);line-height:1.65}.contact-hero figure{overflow:hidden;margin:0;border:1px solid var(--border-default);border-radius:1.4rem;background:var(--surface-raised)}.contact-hero img{display:block;width:100%;aspect-ratio:1;object-fit:cover}.contact-hero figcaption{padding:1rem 1.2rem}.contact-hero figcaption strong,.contact-hero figcaption span{display:block}.contact-hero figcaption span{margin-top:.2rem;color:var(--text-secondary);font-size:.9rem}.send,.boundaries,.reply{max-width:1120px;margin:0 auto clamp(5rem,8vw,7rem)}.send>header{max-width:46rem;margin:0 auto 2rem;text-align:center}.send h2,.boundaries h2{margin:0;font-size:clamp(2.2rem,4.3vw,4rem);letter-spacing:-.05em}.send__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.send article{padding:1.5rem;border:1px solid var(--border-subtle);border-radius:1rem;background:var(--surface-raised)}.send article>span{color:var(--accent);font-family:var(--font-mono);font-size:.72rem}.send h3{margin:1.8rem 0 .55rem}.send p,.boundaries p{color:var(--text-secondary);line-height:1.6}.boundaries{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,5vw,5rem);align-items:center;padding:clamp(1.6rem,4vw,3rem);border:1px solid rgba(119,222,255,.3);border-radius:1.25rem;background:linear-gradient(120deg,rgba(69,171,210,.13),var(--surface-raised) 60%)}.boundaries nav{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--border-subtle);border-radius:1rem}.boundaries nav a{display:flex;justify-content:space-between;padding:1rem 1.2rem}.boundaries nav a+a{border-top:1px solid var(--border-subtle)}.reply{display:flex;align-items:center;justify-content:center;gap:1.5rem;text-align:center}.reply span{color:var(--text-secondary)}
  @media(max-width:800px){.contact-hero{grid-template-columns:1fr}.contact-hero figure{max-width:360px}.boundaries{grid-template-columns:1fr}}@media(max-width:600px){.contact-hero{padding-top:2rem}.send__grid{grid-template-columns:1fr}.contact-hero .btn{width:100%;justify-content:center}.reply{align-items:stretch;flex-direction:column}.reply .btn{justify-content:center}}
</style>
