---
/**
 * Guide — cheap robot lawn mowers.
 *
 * 390/mo at KD 11 on the exact phrase, and it also carries the price cluster:
 * "robot lawn mower price" (1,900) and "robotic lawn mower price" (1,600) were
 * assigned to the hub by the first pass and moved here, because a price-first
 * searcher wants the cheap end explained rather than a category overview.
 *
 * THE CLOSEST CALL OF THE THREE LAWN GUIDES. 4/10 shared domains with "best
 * robot lawn mower" — enough separation to justify a URL, not so much that the
 * ruling is obvious. Recorded as the first guide to fold back into the hub if
 * it underperforms, so that decision is made on evidence rather than mood.
 *
 * No picks: no lawn mower is in the catalogue yet. See the wire-free guide for
 * the full reasoning.
 */
import Base from "../../layouts/Base.astro";
import EditorialArticle from "../../components/EditorialArticle.astro";
import { editorialFor } from "../../content/editorial";
import { buildEditorialPage } from "../../lib/editorial-page";
import { breadcrumbsFor } from "../../lib/routing";
import { articleSchema, faqPageSchema } from "../../lib/seo";
import { FOUNDER } from "../../content/team";

const PATH = "/guides/cheap-robot-lawn-mower/";
const article = editorialFor(PATH)!;
const { html, picks, comparison } = await buildEditorialPage(
  article,
  Astro.locals,
  import.meta.env.DEV,
);

const crumbs = breadcrumbsFor(PATH, article.title);

const pageSchema = [
  articleSchema({
    headline: article.title,
    description: article.metaDescription,
    path: PATH,
    dateModified: article.lastReviewed,
    authorName: FOUNDER.name,
    authorPath: FOUNDER.path,
  }),
  faqPageSchema(article.faq, PATH),
];
---

<Base
  title={article.seoTitle}
  description={article.metaDescription}
  breadcrumbs={crumbs}
  schema={pageSchema}
>
  <EditorialArticle article={article} html={html} picks={picks} comparison={comparison} />
</Base>
