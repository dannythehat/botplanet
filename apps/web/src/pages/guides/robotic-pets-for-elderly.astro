---
/**
 * Guide — robotic pets for elderly relatives.
 *
 * ~1,090/mo across four phrasings, every one at KD 0. The reader is genuinely
 * different from the hub's: somebody buying for another person, often at a
 * distance, sometimes for a care setting. That is a different question, not a
 * narrower version of the same one.
 *
 * THE HUB GAVE THE TERM UP TO BUILD THIS. "robotic pet for elderly" was a
 * secondary on /robots/companion-robots/ until this page existed. Leaving it
 * there would have put two of our own pages into one result set for a query
 * only one of them can win, so the hub now cedes it here and the keyword
 * register and page plan both record that.
 *
 * No picks: no companion robot is in the catalogue yet, and this is the last
 * category where a borrowed shortlist would be acceptable — the reader is
 * making a decision on somebody else's behalf.
 */
import Base from "../../layouts/Base.astro";
import EditorialArticle from "../../components/EditorialArticle.astro";
import { editorialFor } from "../../content/editorial";
import { buildEditorialPage } from "../../lib/editorial-page";
import { breadcrumbsFor } from "../../lib/routing";
import { articleSchema, faqPageSchema, imageObjectSchema } from "../../lib/seo";
import { MEDIA_ASSETS } from "../../content/media/assets";
import { FOUNDER } from "../../content/team";

const PATH = "/guides/robotic-pets-for-elderly/";
const article = editorialFor(PATH)!;
const { html, picks, comparison } = await buildEditorialPage(
  article,
  Astro.locals,
  import.meta.env.DEV,
);

const crumbs = breadcrumbsFor(PATH, article.title);

/* THE LEAD IMAGE IS THE og:image, and it was not. This page has carried its
   own artwork since it was built and the social preview still fell back to
   the site default — every share of it showed the BotPlanet logo instead of
   the picture at the top of the page. Article schema had no image either. */
const lead = article.image?.src ?? null;

/* An ImageObject per picture this page renders: the lead, then each figure
   the injector places. Built from the same list, so nothing is claimed in
   markup that a reader cannot see. */
const renderedImages = [lead, ...(article.figures ?? []).map((f) => f.src)]
  .filter((src): src is string => Boolean(src))
  .map((src) => MEDIA_ASSETS.find((a) => a.src === src))
  .filter((a): a is NonNullable<typeof a> => Boolean(a?.width) && Boolean(a?.height));

const pageSchema = [
  articleSchema({
    headline: article.title,
    description: article.metaDescription,
    path: PATH,
    dateModified: article.lastReviewed,
    authorName: FOUNDER.name,
    authorPath: FOUNDER.path,
    image: lead ?? undefined,
  }),
  ...renderedImages.map((a) =>
    imageObjectSchema({ path: a.src, caption: a.altText ?? "", width: a.width!, height: a.height! }),
  ),
  faqPageSchema(article.faq, PATH),
];
---

<Base
  title={article.seoTitle}
  description={article.metaDescription}
  breadcrumbs={crumbs}
  schema={pageSchema}
  ogImage={lead ?? undefined}
  ogType="article"
>
  <EditorialArticle article={article} html={html} picks={picks} comparison={comparison} />
</Base>
