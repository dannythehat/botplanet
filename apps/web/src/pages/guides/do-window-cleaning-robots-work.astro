---
/**
 * Guide — do window cleaning robots work?
 *
 * Page 9 of the window map and the last of it. Three query families merged
 * into one page: "do window cleaning robots work" (90), "how do window
 * cleaning robots work" (40) and "are window cleaning robots worth it" (30).
 * One intent behind all three, so one page — three URLs would be three thin
 * pages competing for one answer.
 *
 * NO PICKS, for the pool worth-it guide's reason rather than the lawn guides'.
 * There are eleven machines in this catalogue and they are ranked on the
 * best-of. A guide that also named a winner would split one argument across
 * two URLs competing for a single result.
 *
 * THE ANSWER HAS TO CONTAIN A REAL NO. The SERP here is Reddit and forums —
 * people asking each other whether these are a gimmick. A page answering "yes,
 * absolutely" loses to a thread saying the edges are rubbish, because the
 * edges are rubbish. That is the finding this page opens with.
 */
import Base from "../../layouts/Base.astro";
import EditorialArticle from "../../components/EditorialArticle.astro";
import WindowAdhesion from "../../components/diagrams/WindowAdhesion.astro";
import DecisionTable from "../../components/DecisionTable.astro";
import { windowGlassTable } from "../../content/decision-tables";
import { editorialFor } from "../../content/editorial";
import { buildEditorialPage } from "../../lib/editorial-page";
import { breadcrumbsFor } from "../../lib/routing";
import { articleSchema, faqPageSchema, imageObjectSchema } from "../../lib/seo";
import { MEDIA_ASSETS } from "../../content/media/assets";
import { FOUNDER } from "../../content/team";

const PATH = "/guides/do-window-cleaning-robots-work/";
const article = editorialFor(PATH)!;
const { html, picks, comparison } = await buildEditorialPage(
  article,
  Astro.locals,
  import.meta.env.DEV,
);

const crumbs = breadcrumbsFor(PATH, article.title);

/* The page's own artwork, used as the social preview and as Article schema's
   image. Without this a share of this page shows the BotPlanet logo rather
   than the picture at the top of it, and Article schema carries no image at
   all — the same defect the elderly-pets guide was fixed for on its own. */
const lead = article.image?.src ?? null;

/* An ImageObject per picture this page renders: the lead, then each figure
   the injector places. Built from the same list, so nothing is claimed in
   markup that a reader cannot see. */
const renderedImages = [lead, ...(article.figures ?? []).map((f) => f.src)]
  .filter((src): src is string => Boolean(src))
  .map((src) => MEDIA_ASSETS.find((a) => a.src === src))
  .filter((a): a is NonNullable<typeof a> => Boolean(a?.width) && Boolean(a?.height));

const pageSchema = [
  articleSchema({
    headline: article.title,
    description: article.metaDescription,
    path: PATH,
    dateModified: article.lastReviewed,
    authorName: FOUNDER.name,
    authorPath: FOUNDER.path,
    image: lead ?? undefined,
  }),
  ...renderedImages.map((a) =>
    imageObjectSchema({ path: a.src, caption: a.altText ?? "", width: a.width!, height: a.height! }),
  ),
  faqPageSchema(article.faq, PATH),
];
---

<Base
  title={article.seoTitle}
  description={article.metaDescription}
  ogImage={lead ?? undefined}
  breadcrumbs={crumbs}
  schema={pageSchema}
>
  <EditorialArticle
    article={article}
    html={html}
    picks={picks}
    comparison={comparison}
    splitAt={["how-they-actually-stay-on-the-glass"]}
  >
    {/* Two of this page's three merged queries are "how do they work" and
        "are they worth it", and the answer to the second depends entirely on
        believing the first. The reader who cannot picture the seal assumes the
        tether is holding the robot up; the drawing puts the three defences in
        their real order before the prose explains any of them. */}
    <WindowAdhesion slot="diagram-1" />
  </EditorialArticle>

  {/* The page's blunt answer is "yes in the middle, no at the edges". A reader
      who accepts that immediately needs the next thing: whether any of them
      will work on THEIR glass, which is the constraint that rules machines out
      before any other. The last row names the three whose makers do not say. */}
  <DecisionTable table={windowGlassTable()} eyebrow="If the answer is yes" />
</Base>
