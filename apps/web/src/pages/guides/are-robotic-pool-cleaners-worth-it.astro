---
/**
 * Guide — are robotic pool cleaners worth it?
 *
 * Page 11 of the pool map. The exact phrase is only 40/mo, which would not
 * justify a URL on its own. What justifies it is that "Is a robot pool cleaner
 * worth it?" is the NUMBER ONE People Also Ask entry on the 40,500 head term —
 * a featured-snippet and AI-overview play that feeds the hub.
 *
 * NO PICKS, DELIBERATELY. A guide that ranks products is a best-of wearing a
 * hat, and it would compete with the two best-of pages for the same result set.
 * This one answers the question and hands the reader on.
 */
import Base from "../../layouts/Base.astro";
import EditorialArticle from "../../components/EditorialArticle.astro";
import CoverageZones from "../../components/diagrams/CoverageZones.astro";
import DecisionTable from "../../components/DecisionTable.astro";
import { poolCordedCordlessTable } from "../../content/decision-tables";
import { editorialFor } from "../../content/editorial";
import { buildEditorialPage } from "../../lib/editorial-page";
import { breadcrumbsFor } from "../../lib/routing";
import { articleSchema, faqPageSchema, imageObjectSchema } from "../../lib/seo";
import { MEDIA_ASSETS } from "../../content/media/assets";
import { FOUNDER } from "../../content/team";

const PATH = "/guides/are-robotic-pool-cleaners-worth-it/";
const article = editorialFor(PATH)!;
const { html, picks, comparison } = await buildEditorialPage(
  article,
  Astro.locals,
  import.meta.env.DEV,
);

const crumbs = breadcrumbsFor(PATH, article.title);

/* The page's own artwork, used as the social preview and as Article schema's
   image. Without this a share of this page shows the BotPlanet logo rather
   than the picture at the top of it, and Article schema carries no image at
   all — the same defect the elderly-pets guide was fixed for on its own. */
const lead = article.image?.src ?? null;

/* An ImageObject per picture this page renders: the lead, then each figure
   the injector places. Built from the same list, so nothing is claimed in
   markup that a reader cannot see. */
const renderedImages = [lead, ...(article.figures ?? []).map((f) => f.src)]
  .filter((src): src is string => Boolean(src))
  .map((src) => MEDIA_ASSETS.find((a) => a.src === src))
  .filter((a): a is NonNullable<typeof a> => Boolean(a?.width) && Boolean(a?.height));

const pageSchema = [
  articleSchema({
    headline: article.title,
    description: article.metaDescription,
    path: PATH,
    dateModified: article.lastReviewed,
    authorName: FOUNDER.name,
    authorPath: FOUNDER.path,
    image: lead ?? undefined,
  }),
  ...renderedImages.map((a) =>
    imageObjectSchema({ path: a.src, caption: a.altText ?? "", width: a.width!, height: a.height! }),
  ),
  faqPageSchema(article.faq, PATH),
];
---

<Base
  title={article.seoTitle}
  description={article.metaDescription}
  ogImage={lead ?? undefined}
  breadcrumbs={crumbs}
  schema={pageSchema}
>
  <EditorialArticle
    article={article}
    html={html}
    picks={picks}
    comparison={comparison}
    splitAt={["robot-suction-or-pressure"]}
  >
    {/* The section below distinguishes three product classes and ends on the
        point that decides most purchases: the waterline is robot-only, and not
        every robot does it. That is a claim about WHERE a machine cleans, which
        is a picture rather than a sentence. Placed before the classes so the
        reader has the zones in mind while reading what each class can reach. */}
    <CoverageZones slot="diagram-1" />
  </EditorialArticle>

  {/* AFTER THE ARGUMENT, NOT INSIDE IT. The prose answers "is one worth it";
      this answers "then which kind", which is the next question and a
      different one. Placed below so a reader who has not yet decided is not
      handed a shortlist before the case is made. */}
  <DecisionTable table={poolCordedCordlessTable()} eyebrow="If you have decided" />
</Base>
