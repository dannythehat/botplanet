    verdict:
      "Bittle X V2 is for the buyer who wants to understand and change the robot. Petoi positions Bittle as an open-source quadruped platform, and the Amazon variants we checked let you choose between a construction kit and a pre-assembled machine.",
    facts: [
      ["Construction kit", "$319", "lite-servos variant seen in stock"],
      ["Pre-assembled", "$399", "alloy-servos variant; low stock seen"],
      ["Best for", "STEM + makers", "coding, gait and robotics experiments"],
    ],
    pros: [
      "Open-source maker orientation",
      "Construction and pre-assembled choices",
      "Useful bridge from coding to physical robotics",
      "Compact enough for a desk or home lab",
    ],
    cons: [
      "You want a cuddly or highly social robot pet",
      "You want zero setup",
      "Your real goal is advanced mapping and autonomous navigation",
    ],
    amazonHref: "https://www.amazon.com/s?k=Petoi+Bittle+X+V2&tag=botplanet-20",
    amazonLabel: "See Bittle X V2 on Amazon",
    internalHref: "/robots/educational-coding-robots/",
    internalLabel: "Explore coding robots",
  },
  {
    id: "puppypi",
    number: "06",
