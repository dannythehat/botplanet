    setup: "Medium–high",
    amazonSignal: "3.8★ · 15 reviews shown",
    facts: [
      ["Standard", "$299.99", "in stock at snapshot"],
      ["Advanced", "$399.99", "higher-spec option"],
      ["Ultimate", "$499.99", "higher-spec option"],
      ["Coding", "3 paths", "Scratch, Python, Arduino"],
