d-strip a:last-child{border-right:0}.keyword-strip strong{display:block}.keyword-strip small{display:block;color:rgba(255,255,255,.48);margin-top:4px}.intro-grid{display:grid;grid-template-columns:.83fr 1.17fr;gap:70px;padding:88px 0}.body-copy p,.section-head>p,.method-note p,.affiliate-box p{color:rgba(255,255,255,.69);line-height:1.72}.body-copy p:first-child{margin-top:0}h2{margin:8px 0 16px;font-size:clamp(2rem,4.5vw,4rem);line-height:1;letter-spacing:-.04em}.section-head{max-width:800px;margin-bottom:34px}.matrix{padding:78px 0;border-top:1px solid rgba(255,255,255,.1)}.matrix--top{padding-top:20px;border-top:0}.table-wrap{overflow-x:auto;border:1px solid rgba(255,255,255,.1);border-radius:20px}table{width:100%;border-collapse:collapse;min-width:800px;background:rgba(255,255,255,.02)}th,td{padding:17px;text-align:left;vertical-align:top;border-bottom:1px solid rgba(255,255,255,.08)}th{color:#8fe6ff;font-size:.74rem;text-transform:uppercase;letter-spacing:.08em}td{color:rgba(255,255,255,.7);line-height:1.5}tbody tr:last-child td{border-bottom:0}td a{color:#fff;text-decoration:none}.picks{padding:30px 0 85px}.pick{display:grid;grid-template-columns:92px 1fr;gap:22px;padding:38px 0;border-top:1px solid rgba(255,255,255,.12);scroll-margin-top:80px}.pick--hero{margin:24px 0 14px;padding:36px;border:1px solid rgba(143,230,255,.25);border-radius:28px;background:linear-gradient(135deg,rgba(143,230,255,.075),rgba(255,255,255,.015))}.pick-number{font-size:3rem;font-weight:900;color:rgba(255,255,255,.13);letter-spacing:-.05em}.pick-topline{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.award,.status{display:inline-flex;padding:7px 10px;border-radius:999px;font-size:.7rem;font-weight:850;text-transform:uppercase;letter-spacing:.07em;border:1px solid rgba(255,255,255,.14)}.award{color:#8fe6ff;border-color:rgba(143,230,255,.3)}.status{color:rgba(255,255,255,.58)}.status--verified{color:#c4ffd9;border-color:rgba(145,255,187,.25)}.status--warning{color:#ffd9a7;borde