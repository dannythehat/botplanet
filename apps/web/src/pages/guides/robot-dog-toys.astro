    amazonHref: "/go/comp-loona-amazon",
    amazonLabel: "Check Loona price on Amazon",
    internalHref: "/robots/companion-robots/loona/",
    internalLabel: "Read the full Loona review",
  },
  {
    id: "ruko",
    number: "02",
    award: "Best robot dog toy for kids",
    name: "Ruko 18011 Robot Dog",
    status: "In stock at snapshot",
    image: IMAGE.ruko,
    imageAlt: "A child playing with a friendly black-and-gold interactive robot dog in a modern home.",
    imageCaption: "Editorial lifestyle image based on the black-and-gold interactive-toy category. Check the listing for exact colour and accessories.",
    verdict: "Ruko is the easiest mainstream recommendation for a child who wants a robot dog now, not a robotics course. It is playful, relatively affordable and has remote control, gesture control, programmable actions and more than 30 LED-face expressions without requiring serious setup.",
