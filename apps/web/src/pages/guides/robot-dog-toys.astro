---
import Base from "../../layouts/Base.astro";
import "../../styles/robot-dog-guide.css";
import {
  articleSchema,
  faqPageSchema,
  itemListSchema,
  webPageSchema,
} from "../../lib/seo";
import { FOUNDER } from "../../content/team";

const PATH = "/guides/robot-dog-toys/";
const SEO_TITLE = "Best Robot Dog Toys 2026: AI Pets, Coding Robots & Gifts";
const H1 = "Best robot dog toys & AI robot dogs for Christmas 2026";
const DESCRIPTION =
  "Compare the best robot dog toys, AI robot pets and programmable quadrupeds for Christmas 2026, with head-to-head picks for kids, families, programmers, robotics enthusiasts and older adults.";

const MEDIA = "/images/guides/robot-dog-toys/";
const IMAGE = {
  hero: `${MEDIA}file_000000009b5c820ab534e72adacdb919.png`,
