    status: "In stock at snapshot",
    verdict: "YESHIN is the budget pick for somebody who specifically wants the look and movement of a quadruped robot dog without paying $300–$700 for serious robotics hardware. It sits firmly in the toy category: remote and voice control, programmable actions and lifelike-style movement rather than open-source development.",
    price: "$65.99",
    deal: "$59.39 coupon shown",
    audience: "Kids 6+ / gift buyers",
    control: "Remote + voice",
    coding: "Programmable toy actions",
    ai: "Low",
    setup: "Low",
    amazonSignal: "4.1★ · 10 reviews shown",
    facts: [
      ["Observed price", "$65.99", "$59.39 coupon shown"],
      ["Positioning", "Ages 6+", "interactive STEM toy"],
      ["Control", "Remote + voice", "programmable actions"],
      ["Best fit", "Budget quadruped", "robot-dog look for less"],
    ],
    fit: [["Easy gift",91,"Excellent"],["AI / autonomy",24,"Low"],["Coding depth",30,"Basic"],["Pet-like feel",58,"Medium"]],
