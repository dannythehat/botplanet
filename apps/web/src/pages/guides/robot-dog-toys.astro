      ["Observed price", "~$59.49", "black & gold variant"],
      ["Age positioning", "3–8", "Amazon listing language"],
      ["Play", "30+ LED faces", "remote + gesture control"],
      ["Best fit", "Instant fun", "easy Christmas gift"],
    ],
    fit: [["Easy gift",97,"Excellent"],["AI / autonomy",28,"Low"],["Coding depth",35,"Basic"],["Pet-like feel",72,"High"]],
    pros: ["Simple child-friendly controls","Programmable without becoming a coding project","Strong review count versus many clone listings","Comfortable Christmas gift price band"],
    cons: ["The recipient wants real coding depth","You want recognition / advanced AI","You are shopping for a serious robotics platform"],
    amazonHref: "https://www.amazon.com/s?k=Ruko+18011+Robot+Dog+Toy&tag=botplanet-20",
    amazonLabel: "See Ruko 18011 on Amazon",
  },
  {
