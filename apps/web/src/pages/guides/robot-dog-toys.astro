---
/**
 * ChatGPT December 2026 Amazon challenge page.
 *
 * DataForSEO — US — 27 Sep 2026:
 *   robot dog toy             14,800/mo · 49,500 Nov 2025 · 33,100 Dec 2025 · KD 0
 *   ai robot dog               3,600/mo · 12,100 Dec 2025 · KD 0
 *   interactive robot dog      1,600/mo ·  5,400 Dec 2025 · KD 10
 *   loona robot dog            1,000/mo ·  5,400 Dec 2025 · KD 3
 *   interactive robot dog toy  1,000/mo · KD 0
 *
 * Canonical-intent rule: this URL owns the generic robot-dog buying cluster.
 * Branded Loona intent remains with the Loona product review; coding-robot and
 * companion-robot category head terms remain with their category hubs.
 */
import Base from "../../layouts/Base.astro";
import {
  articleSchema,
  faqPageSchema,
  itemListSchema,
  webPageSchema,
} from "../../lib/seo";
import { FOUNDER } from "../../content/team";

const PATH = "/guides/robot-dog-toys/";
const SEO_TITLE = "Best Robot Dog Toys 2026: AI, Kids, Coding & Seniors";
const H1 = "Best robot dog toys and AI robot dogs for 2026";
const DESCRIPTION =
  "Compare the best robot dog toys and AI robot dogs for Christmas 2026, with picks for kids, adult coders, makers and seniors — from Loona to PuppyPi.";

const MEDIA = "/images/guides/robot-dog-toys/";
const IMAGE = {
