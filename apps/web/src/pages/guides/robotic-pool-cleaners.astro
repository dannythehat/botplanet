---
import Base from "../../layouts/Base.astro";
import RoutePlaceholder from "../../components/RoutePlaceholder.astro";
import { routeFor } from "../../content/routes";
import { breadcrumbsFor } from "../../lib/routing";

const route = routeFor("/guides/robotic-pool-cleaners/")!;
const crumbs = breadcrumbsFor("/guides/robotic-pool-cleaners/");
---
<Base
  title={`${route.label} — BotPlanet`}
  description={route.summary ?? route.label}
  noindex={!route.indexable}
  breadcrumbs={crumbs}
  narrow={true}
>
  <RoutePlaceholder title="Robotic pool cleaner guides" summary="How robotic pool cleaners work, what actually matters when choosing one, and how to keep one running." owner="Job 19 owns educational content" />
</Base>
