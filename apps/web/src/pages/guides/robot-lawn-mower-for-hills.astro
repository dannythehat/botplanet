---
/**
 * Guide — robot lawn mowers for hills.
 *
 * The smallest of the three lawn guides at 200/mo and the one with the
 * cleanest evidence: "best robot lawn mower for hills" shares 7/10 domains with
 * "do robot lawn mowers work on hills" and only 3/10 with "best robot lawn
 * mower". The two hills queries are one page, and that page is not the hub.
 *
 * THE SLUG DROPS "best" DELIBERATELY. The page serves the informational half of
 * that pair as much as the commercial half — a reader measuring a bank is not
 * yet shopping — and "best" in a URL that currently ranks nothing would be a
 * promise the page does not keep.
 *
 * No picks: no lawn mower is in the catalogue yet. See the wire-free guide for
 * the full reasoning.
 */
import Base from "../../layouts/Base.astro";
import EditorialArticle from "../../components/EditorialArticle.astro";
import { editorialFor } from "../../content/editorial";
import { buildEditorialPage } from "../../lib/editorial-page";
import { breadcrumbsFor } from "../../lib/routing";
import { articleSchema, faqPageSchema } from "../../lib/seo";
import { FOUNDER } from "../../content/team";

const PATH = "/guides/robot-lawn-mower-for-hills/";
const article = editorialFor(PATH)!;
const { html, picks, comparison } = await buildEditorialPage(
  article,
  Astro.locals,
  import.meta.env.DEV,
);

const crumbs = breadcrumbsFor(PATH, article.title);

const pageSchema = [
  articleSchema({
    headline: article.title,
    description: article.metaDescription,
    path: PATH,
    dateModified: article.lastReviewed,
    authorName: FOUNDER.name,
    authorPath: FOUNDER.path,
  }),
  faqPageSchema(article.faq, PATH),
];
---

<Base
  title={article.seoTitle}
  description={article.metaDescription}
  breadcrumbs={crumbs}
  schema={pageSchema}
>
  <EditorialArticle article={article} html={html} picks={picks} comparison={comparison} />
</Base>
