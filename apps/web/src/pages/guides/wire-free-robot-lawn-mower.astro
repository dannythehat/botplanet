---
/**
 * Guide — wire-free robot lawn mowers.
 *
 * 720/mo at KD 0 on the exact phrase, ~1,670 across the wire-free, RTK, GPS
 * and LiDAR phrasings. It is a URL rather than a section of the hub on measured
 * evidence: 2/10 shared domains with "robot lawn mower", which is a different
 * SERP rather than a different phrasing of the same one.
 *
 * NO PICKS, AND NOT FOR THE POOL GUIDE'S REASON. The pool worth-it guide has no
 * picks because ranking products there would compete with two best-of pages.
 * Here there is simply nothing to rank: no lawn mower is in the catalogue, and
 * a shortlist assembled from other people's shortlists is the one thing this
 * site exists not to publish. The page says so in its own words rather than
 * padding around the gap, and gains a ranked list when the catalogue does.
 */
import Base from "../../layouts/Base.astro";
import EditorialArticle from "../../components/EditorialArticle.astro";
import BoundaryMethods from "../../components/diagrams/BoundaryMethods.astro";
import { editorialFor } from "../../content/editorial";
import { buildEditorialPage } from "../../lib/editorial-page";
import { breadcrumbsFor } from "../../lib/routing";
import { articleSchema, faqPageSchema, imageObjectSchema } from "../../lib/seo";
import { MEDIA_ASSETS } from "../../content/media/assets";
import { FOUNDER } from "../../content/team";

const PATH = "/guides/wire-free-robot-lawn-mower/";
const article = editorialFor(PATH)!;
const { html, picks, comparison } = await buildEditorialPage(
  article,
  Astro.locals,
  import.meta.env.DEV,
);

const crumbs = breadcrumbsFor(PATH, article.title);

/* The page's own artwork, used as the social preview and as Article schema's
   image. Without this a share of this page shows the BotPlanet logo rather
   than the picture at the top of it, and Article schema carries no image at
   all — the same defect the elderly-pets guide was fixed for on its own. */
const lead = article.image?.src ?? null;

/* An ImageObject per picture this page renders: the lead, then each figure
   the injector places. Built from the same list, so nothing is claimed in
   markup that a reader cannot see. */
const renderedImages = [lead, ...(article.figures ?? []).map((f) => f.src)]
  .filter((src): src is string => Boolean(src))
  .map((src) => MEDIA_ASSETS.find((a) => a.src === src))
  .filter((a): a is NonNullable<typeof a> => Boolean(a?.width) && Boolean(a?.height));

const pageSchema = [
  articleSchema({
    headline: article.title,
    description: article.metaDescription,
    path: PATH,
    dateModified: article.lastReviewed,
    authorName: FOUNDER.name,
    authorPath: FOUNDER.path,
    image: lead ?? undefined,
  }),
  ...renderedImages.map((a) =>
    imageObjectSchema({ path: a.src, caption: a.altText ?? "", width: a.width!, height: a.height! }),
  ),
  faqPageSchema(article.faq, PATH),
];
---

<Base
  title={article.seoTitle}
  description={article.metaDescription}
  ogImage={lead ?? undefined}
  breadcrumbs={crumbs}
  schema={pageSchema}
>
  <EditorialArticle
    article={article}
    html={html}
    picks={picks}
    comparison={comparison}
    splitAt={["three-technologies-one-label"]}
  >
    {/* "Wire-free" is a marketing word covering two technologies that fail in
        opposite gardens — satellite dies under trees, vision dies at dusk and
        at a soft lawn edge. The section says so in prose; the drawing shows the
        same garden three times so the difference is in the method, not the
        plot, which is what the reader has to hold to make the choice. */}
    <BoundaryMethods slot="diagram-1" />
  </EditorialArticle>
</Base>
