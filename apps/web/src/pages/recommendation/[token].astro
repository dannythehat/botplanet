---
import Base from "../../layouts/Base.astro";
import ProductImage from "../../components/ProductImage.astro";
import { getDb, schema } from "../../lib/db";
import { usd, freshnessLabel } from "../../lib/format";
import { eq } from "drizzle-orm";

const { token } = Astro.params;
const db = getDb(Astro.locals);

const rec = (
  await db.select().from(schema.recommendations).where(eq(schema.recommendations.secureToken, token!)).limit(1)
)[0];
if (!rec) return new Response("Recommendation not found", { status: 404 });

const products = await db.select().from(schema.products);
const productById = (id: string | null) => (id ? products.find((p) => p.id === id) : undefined);
const chosen = productById(rec.chosenProductId);

const chosenOffer = rec.chosenOfferId
  ? (await db.select().from(schema.offers).where(eq(schema.offers.id, rec.chosenOfferId)).limit(1))[0]
  : undefined;

const scores = await db
  .select()
  .from(schema.recommendationScores)
  .where(eq(schema.recommendationScores.recommendationId, rec.id));

const alternatives = scores
  .filter((s) => !s.excluded && s.productId !== rec.chosenProductId)
  .sort((a, b) => b.suitabilityScore - a.suitabilityScore)
  .slice(0, 3);

const explanationJson = rec.explanationJson as { text?: string; equivalent?: string[] } | null;
const explanation = explanationJson?.text ?? "";

/**
 * THE TIED GROUP, WHEN THERE IS ONE.
 *
 * `chosenProductId` is null and `equivalent` holds two or more product ids when
 * the matcher could not separate the top of the ranking on recorded data. That
 * is a real result, not a failure, and it renders as a group rather than
 * falling through to "no perfect match" — which would be wrong in the opposite
 * direction, since these all fit.
 */
const equivalent = (explanationJson?.equivalent ?? [])
  .map((id) => productById(id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .sort((a, b) => a.name.localeCompare(b.name));
/**
 * THE CATEGORY, READ FROM THE PRODUCTS RATHER THAN ASSUMED.
 *
 * This was hard-coded to "robotic-pool-cleaners" from when pool was the only
 * category with a matcher. There are nine now, so a litter-box result was
 * linking at /robots/robotic-pool-cleaners/litter-robot-4/ and sending "start
 * over" to the pool questions. Taken from whichever products this
 * recommendation actually names.
 */
const categories = await db.select().from(schema.categories);
const catSlugOf = (p: { categoryId: string } | undefined) =>
  categories.find((c) => c.id === p?.categoryId)?.slug ?? "robotic-pool-cleaners";
const catSlug = catSlugOf(chosen ?? equivalent[0]);
const hrefFor = (p: { categoryId: string; slug: string }) => `/robots/${catSlugOf(p)}/${p.slug}/`;
---

<Base title="Your BotPlanet recommendation" description="Your personalised, suitability-first robot recommendation.">
  <p class="muted">Your personalised recommendation · saved at this link</p>
  {equivalent.length > 1 ? (
    <>
      <div class="hero">
        <span class="pill class">Equivalent on current data</span>
        <h1 style="margin-top:10px;">{equivalent.length} machines, and we cannot separate them</h1>
        <p style="font-size:17px;">{explanation}</p>
        {/* A tie is still an answer, and the reader still has to choose. A bare
            list of names asks them to do that blind. */}
        <div class="grid" style="margin-top:18px;">
          {equivalent.map((p) => (
            <a class="card rec-alt" href={hrefFor(p)}>
              <span class="rec-alt__art">
                <ProductImage
                  productId={p.id}
                  placement="listing_card"
                  types={["product_hero", "product_alternate_view", "branded_placeholder"]}
                  sizes="(min-width: 900px) 260px, 45vw"
                />
              </span>
              <h3>{p.name}</h3>
              <span class="muted">View details →</span>
            </a>
          ))}
        </div>
        <p class="muted" style="margin-top:16px;">
          Naming one of these as the winner would mean picking it out of a tie, and we would rather tell you the
          truth about what we know. When the attributes that separate them are recorded, this answer gets sharper.
        </p>
      </div>
    </>
  ) : chosen ? (
    <>
      {/* THE PAGE THE EMAIL SENDS PEOPLE TO HAD NO PICTURE OF ANYTHING.
          A reader who has answered five questions, been emailed a link and
          clicked it is the most committed visitor this site gets, and they
          arrived at a page of text with a price on it. Every one of these
          machines has artwork in the media registry — the same resolver the
          listing cards use, so a withdrawn asset empties this too. */}
      <div class="hero">
        <div class="rec-hero__art">
          <ProductImage
            productId={chosen.id}
            placement="listing_card"
            types={["product_hero", "product_alternate_view", "branded_placeholder"]}
            sizes="(min-width: 900px) 420px, 90vw"
            priority
          />
        </div>
        <span class="pill class">BotPlanet recommends</span>
        <h1 style="margin-top:10px;">{chosen.name}</h1>
        <p style="font-size:17px;">{explanation}</p>
        {chosenOffer && (
          <div class="row" style="margin-top:16px; align-items:center;">
            <span class="price">{usd(chosenOffer.basePriceMinor)}</span>
            <span class="pill">{freshnessLabel(chosenOffer.freshnessClass)}</span>
            {chosenOffer.redirectKey && (
              <a class="btn primary" href={`/go/${chosenOffer.redirectKey}`} rel="sponsored nofollow">See current offer</a>
            )}
            <a class="btn" href={hrefFor(chosen)}>Full details</a>
          </div>
        )}
      </div>

      {alternatives.length > 0 && (
        <>
          <h2>Strong alternatives</h2>
          <div class="grid">
            {alternatives.map((a) => {
              const p = productById(a.productId);
              return p ? (
                <a class="card rec-alt" href={hrefFor(p)}>
                  <span class="rec-alt__art">
                    <ProductImage
                      productId={p.id}
                      placement="listing_card"
                      types={["product_hero", "product_alternate_view", "branded_placeholder"]}
                      sizes="(min-width: 900px) 260px, 45vw"
                    />
                  </span>
                  <span class="pill">Suitability {a.suitabilityScore}/100</span>
                  <h3>{p.name}</h3>
                  <span class="muted">View details →</span>
                </a>
              ) : null;
            })}
          </div>
        </>
      )}
    </>
  ) : (
    <>
      <h1>No perfect match — yet</h1>
      <p class="muted">None of our current products fit those answers. Try widening your criteria or <a href={`/botmatch/${catSlug}/`}>start again</a>.</p>
    </>
  )}

  {chosen && (
    <div class="card" style="max-width:480px; margin-top:28px;">
      <h3 style="margin:0;">📧 Email my result</h3>
      <p class="muted" style="margin:4px 0 12px;">We'll send this recommendation link to your inbox. No spam.</p>
      <form id="emailform" data-token={token}>
        <div class="row">
          <input type="email" name="email" required placeholder="you@example.com" style="flex:1; min-width:200px;" />
          <button type="submit" class="btn primary">Send</button>
        </div>
        <p id="emailmsg" class="note" style="margin-top:10px;"></p>
      </form>
    </div>
    <script>
      const ef = document.getElementById("emailform") as HTMLFormElement;
      const msg = document.getElementById("emailmsg") as HTMLElement;
      ef?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = ef.querySelector('button[type="submit"]') as HTMLButtonElement;
        btn.disabled = true;
        const email = (ef.elements.namedItem("email") as HTMLInputElement).value;
        try {
          const res = await fetch("/api/email-result", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ token: ef.dataset.token, email }),
          });
          const data = (await res.json()) as { note?: string; error?: string };
          msg.textContent = data.note ?? data.error ?? "Done.";
        } catch {
          msg.textContent = "Something went wrong — please try again.";
        } finally {
          btn.disabled = false;
        }
      });
    </script>
  )}

  <p class="note" style="margin-top:26px;">
    Chosen on suitability, not commission. Prices are research snapshots — confirm at the retailer.
    Affiliate disclosure: BotPlanet may earn a commission from retailer links.
  </p>
  <p style="margin-top:16px;"><a class="btn" href={`/botmatch/${catSlug}/`}>Start over</a></p>
</Base>

<style>
  .rec-hero__art {
    max-width: 420px;
    margin: 0 0 18px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--panel, #0d1017);
  }
  .rec-hero__art :global(img) { display: block; width: 100%; height: auto; }

  .rec-alt__art {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 10px;
    background: var(--panel, #0d1017);
  }
  .rec-alt__art :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
