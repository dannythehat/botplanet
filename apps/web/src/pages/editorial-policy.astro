---
import Base from "../layouts/Base.astro";
import { FOUNDER } from "../content/team";
import { SITE } from "../lib/site";
import { breadcrumbsFor } from "../lib/routing";
import { webPageSchema } from "../lib/seo";

const PATH = "/editorial-policy/";
const TITLE = "BotPlanet Editorial Policy | Independence, Sources & Corrections";
const DESCRIPTION = "How BotPlanet keeps commercial relationships out of verdicts, sources product claims, maintains published pages and handles corrections.";
---

<Base title={TITLE} description={DESCRIPTION} path={PATH} ogImage={FOUNDER.portrait?.src} breadcrumbs={breadcrumbsFor(PATH)} schema={[webPageSchema({ path: PATH, name: TITLE, description: DESCRIPTION })]}>
  <header class="policy-hero">
    <div class="policy-hero__copy"><p class="kicker">OUR EDITORIAL CONTRACT</p><h1>The verdict is not for sale.</h1><p>BotPlanet can earn from a retailer link. It cannot earn the right to change which product wins, hide a limitation or turn a manufacturer claim into a fact.</p><a class="btn btn--accent btn--lg" href="/review-methodology/">See the review method</a></div>
    <div class="firewall" role="img" aria-label="Editorial verdicts are separated from retailer offers and commission"><div class="firewall__side"><span>EDITORIAL INPUT</span><strong>Evidence<br />Fit<br />Limitations</strong></div><div class="firewall__bar"><span>FIREWALL</span></div><div class="firewall__side"><span>COMMERCIAL INPUT</span><strong>Price<br />Delivery<br />Retailer</strong></div><p>Product selection happens on the left. Offers are considered only after a product has been chosen.</p></div>
  </header>

  <section class="rules" aria-labelledby="rules-title"><header><p class="kicker">NON-NEGOTIABLE RULES</p><h2 id="rules-title">What readers can hold us to</h2></header><div class="rules__grid">
    <article><span>01</span><h3>Independence</h3><p>Commission cannot improve a score or buy a recommendation. Suppliers cannot preview or edit an independent verdict.</p></article>
    <article><span>02</span><h3>Source discipline</h3><p>Technical and commercial facts come from attributable sources. Unverified maker claims are labelled as claims.</p></article>
    <article><span>03</span><h3>Visible limitations</h3><p>A review names the conditions in which a product will not work and the people who should buy something else.</p></article>
    <article><span>04</span><h3>Honest evidence labels</h3><p>Research is not called testing. A hands-on label appears only when BotPlanet physically used the machine.</p></article>
  </div></section>

  <section class="lifecycle" aria-labelledby="lifecycle-title"><div><p class="kicker">AFTER PUBLICATION</p><h2 id="lifecycle-title">A page is maintained, not abandoned.</h2><p>Robot models, prices and support policies change. Each material fact is treated according to its shelf life.</p></div><ol><li><strong>Prices and stock</strong><span>Display when they were checked. Stale snapshots lose any claim to be current.</span></li><li><strong>Specifications</strong><span>Are corrected against first-party evidence and never silently borrowed from a sibling model.</span></li><li><strong>Verdicts</strong><span>Are revisited when a product changes, disappears, loses support or is replaced.</span></li><li><strong>Corrections</strong><span>Material corrections are made on the page, where readers will see them.</span></li></ol></section>

  <section class="accountability" aria-labelledby="accountability-title">
    {FOUNDER.portrait && <img src={FOUNDER.portrait.src} srcset={`/media/authors/${FOUNDER.id}-220w.webp 220w, /media/authors/${FOUNDER.id}-440w.webp 440w`} sizes="320px" width="320" height="320" alt={FOUNDER.portrait.alt} loading="lazy" decoding="async" />}
    <div><p class="kicker">NAMED ACCOUNTABILITY</p><h2 id="accountability-title">{FOUNDER.name}</h2><p>{FOUNDER.accountability} A policy only matters if somebody is answerable when the work falls short.</p><nav><a href={FOUNDER.path}>See the editorial record <span aria-hidden="true">→</span></a><a href={`mailto:${SITE.business.contactEmail}`}>Report an error <span aria-hidden="true">→</span></a></nav></div>
  </section>

  <aside class="disclosure"><strong>Commercial relationships are disclosed.</strong><span>Sponsored work, if accepted, must be clearly labelled and kept outside rankings, comparisons and BotMatch.</span><a href="/affiliate-disclosure/">Read the affiliate disclosure</a></aside>
</Base>

<style>
  .kicker{margin:0 0 .8rem;color:var(--text-tertiary);font:700 .7rem/1 var(--font-mono);letter-spacing:.18em}.policy-hero{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(2rem,5vw,5rem);align-items:center;max-width:1280px;margin:0 auto;padding:clamp(3rem,7vw,6rem) 0}.policy-hero h1{max-width:10ch;margin:0;font-size:clamp(3.4rem,6vw,6.4rem);line-height:.94;letter-spacing:-.06em}.policy-hero__copy>p:not(.kicker){max-width:38rem;margin:1.4rem 0 1.7rem;color:var(--text-secondary);font-size:clamp(1.05rem,1.6vw,1.25rem);line-height:1.65}.firewall{display:grid;grid-template-columns:1fr 54px 1fr;overflow:hidden;border:1px solid var(--border-default);border-radius:1.4rem;background:var(--surface-raised);box-shadow:var(--shadow-lg)}.firewall__side{padding:clamp(1.5rem,4vw,3rem)}.firewall__side span,.firewall__side strong{display:block}.firewall__side span{color:var(--text-tertiary);font:700 .65rem/1.3 var(--font-mono);letter-spacing:.12em}.firewall__side strong{margin-top:1.4rem;font-size:clamp(1.25rem,2vw,1.8rem);line-height:1.7}.firewall__bar{display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,var(--accent),#297ba4)}.firewall__bar span{color:#031018;font:800 .65rem/1 var(--font-mono);letter-spacing:.15em;writing-mode:vertical-rl}.firewall>p{grid-column:1/-1;margin:0;padding:1.1rem 1.5rem;border-top:1px solid var(--border-subtle);color:var(--text-secondary);font-size:.9rem}.rules,.lifecycle,.accountability,.disclosure{max-width:1120px;margin:0 auto clamp(5rem,9vw,8rem)}.rules>header{max-width:46rem;margin:0 auto 2rem;text-align:center}.rules h2,.lifecycle h2,.accountability h2{margin:0;font-size:clamp(2.2rem,4.4vw,4rem);line-height:1.02;letter-spacing:-.05em}.rules__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.rules article{padding:1.5rem;border:1px solid var(--border-subtle);border-radius:1rem;background:var(--surface-raised)}.rules article>span{color:var(--accent);font-family:var(--font-mono);font-size:.72rem}.rules h3{margin:2rem 0 .6rem}.rules p,.lifecycle p,.accountability p{color:var(--text-secondary);line-height:1.6}.lifecycle{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,5vw,5rem);align-items:start}.lifecycle ol{overflow:hidden;margin:0;padding:0;border:1px solid var(--border-subtle);border-radius:1.2rem;background:var(--surface-raised);list-style:none}.lifecycle li{display:grid;grid-template-columns:.55fr 1.45fr;gap:1rem;padding:1.25rem 1.4rem}.lifecycle li+li{border-top:1px solid var(--border-subtle)}.lifecycle li span{color:var(--text-secondary);line-height:1.55}.accountability{display:grid;grid-template-columns:200px 1fr;gap:2rem;align-items:center;padding:1.5rem;border:1px solid var(--border-subtle);border-radius:1.3rem;background:var(--surface-raised)}.accountability img{display:block;width:200px;height:200px;object-fit:cover;border-radius:1rem}.accountability nav{display:flex;gap:1.4rem;flex-wrap:wrap;margin-top:1rem}.accountability a{font-weight:700}.disclosure{display:grid;grid-template-columns:auto 1fr auto;gap:1.5rem;align-items:center;padding:1.4rem 0;border-top:1px solid var(--border-subtle)}.disclosure span{color:var(--text-secondary);font-size:.9rem;line-height:1.5}
  @media(max-width:950px){.policy-hero{grid-template-columns:1fr}.rules__grid{grid-template-columns:repeat(2,1fr)}.lifecycle{grid-template-columns:1fr}.disclosure{grid-template-columns:1fr}}@media(max-width:620px){.policy-hero{padding-top:2rem}.rules__grid{grid-template-columns:1fr}.firewall{grid-template-columns:1fr}.firewall__bar{min-height:34px}.firewall__bar span{writing-mode:horizontal-tb}.firewall>p{grid-column:1}.lifecycle li{grid-template-columns:1fr}.accountability{grid-template-columns:80px 1fr}.accountability img{width:80px;height:80px}.accountability p,.accountability nav{grid-column:1/-1}.policy-hero .btn{width:100%;justify-content:center}}
</style>
